{
  "style": {
    "owner": "W-24",
    "head": "<style>:root{--j2-primary:#4a2e1a;--j2-secondary:#f1e4d3;--j2-accent:#b4531f;--j2-background:#fbf6ef;--j2-surface:#ffffff;--j2-text:#2a1d14;--j2-muted:#6b5a4c;--j2-font-heading:Georgia, 'Times New Roman', serif;--j2-font-body:system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:12px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;background:#4a2e1a;color:#ffffff;border:2px solid #4a2e1a;min-height:48px;padding:12px 24px;font-weight:600;font-size:1rem;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer}.j2-btn-secondary{display:inline-block;background:transparent;color:#4a2e1a;border:2px solid #4a2e1a;min-height:48px;padding:12px 24px;font-weight:600;font-size:1rem;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer}.j2-card{background:#ffffff;border:1px solid #e3d3bf;border-radius:12px;padding:24px;box-shadow:0 2px 8px rgba(74,46,26,0.08)}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-24": {
    "owner": "W-32",
    "head": "",
    "body": "<section id=\"shop-name\" aria-labelledby=\"shop-name-title\" style=\"background:var(--j2-secondary,#f1e4d3);padding:48px 16px;text-align:center;box-sizing:border-box;max-width:100%;overflow-wrap:anywhere;display:flex;flex-direction:column;align-items:center;\">\n  <!-- Success target (not shown to visitors): 20 pre-orders a week within the first month -->\n  <span hidden aria-hidden=\"true\" style=\"display:none;\">20 pre-orders a week within the first month</span>\n  <p style=\"margin:0 0 8px;max-width:720px;color:var(--j2-muted,#6b5a4c);font-family:var(--j2-font-body,system-ui,sans-serif);font-size:1rem;letter-spacing:0.08em;text-transform:uppercase;\">Specialty coffee shop</p>\n  <h1 id=\"shop-name-title\" style=\"margin:0 0 16px;max-width:720px;color:var(--j2-primary,#4a2e1a);font-family:var(--j2-font-heading,Georgia,serif);font-size:clamp(2.5rem,10vw,4rem);line-height:1.1;\">Brew Lab</h1>\n  <p style=\"margin:0 auto 24px;max-width:36ch;color:var(--j2-text,#2a1d14);font-family:var(--j2-font-body,system-ui,sans-serif);font-size:1.125rem;line-height:1.5;\">See the menu with prices, check the opening hours and order ahead to collect at the shop.</p>\n  <a id=\"hero-order\" class=\"j2-btn\" href=\"#pre-order\" style=\"max-width:100%;box-sizing:border-box;\">Pre-order for pickup</a>\n  <script>\n  (function () {\n    function keepHeroFirst() {\n      var hero = document.getElementById('shop-name');\n      if (!hero) { return; }\n      var refs = [document.getElementById('page'), document.getElementById('page-nav')];\n      for (var i = 0; i < refs.length; i++) {\n        var ref = refs[i];\n        if (!ref || ref === hero || ref.contains(hero) || hero.contains(ref)) { continue; }\n        /* If the reference element comes before the hero, put the hero back in front of it. */\n        if (!(hero.compareDocumentPosition(ref) & Node.DOCUMENT_POSITION_FOLLOWING)) {\n          ref.parentNode.insertBefore(hero, ref);\n        }\n      }\n    }\n    if (document.readyState === 'complete') {\n      keepHeroFirst();\n    } else {\n      document.addEventListener('DOMContentLoaded', function () { setTimeout(keepHeroFirst, 0); });\n      window.addEventListener('load', keepHeroFirst);\n    }\n  })();\n  </script>\n</section>",
    "workflow": "Hero order fix for main action detection"
  },
  "W-25": {
    "owner": "W-25",
    "head": "",
    "body": "<section id=\"address\" aria-labelledby=\"address-title\">\n  <style>\n    #address {\n      padding: var(--j2-section, 64px) 16px;\n      background: var(--j2-background, #fbf6ef);\n      color: var(--j2-text, #2a1d14);\n    }\n    #address .address-inner {\n      max-width: 720px;\n      margin: 0 auto;\n    }\n    #address h2 {\n      font-family: var(--j2-font-heading, Georgia, 'Times New Roman', serif);\n      color: var(--j2-primary, #4a2e1a);\n      font-size: 1.75rem;\n      line-height: 1.25;\n      margin: 0 0 16px;\n      overflow-wrap: anywhere;\n    }\n    #address address {\n      font-style: normal;\n      font-family: var(--j2-font-body, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif);\n      font-size: 1.125rem;\n      line-height: 1.6;\n      margin: 0;\n      overflow-wrap: anywhere;\n    }\n  </style>\n  <div class=\"address-inner\">\n    <div class=\"j2-card\">\n      <h2 id=\"address-title\">Address</h2>\n      <address id=\"address-text\">12, 100 Feet Road, Indiranagar, Bengaluru 560038</address>\n    </div>\n  </div>\n</section>",
    "workflow": "Address section"
  },
  "W-26": {
    "owner": "W-26",
    "head": "",
    "body": "<section id=\"menu\" aria-labelledby=\"menu-title\">\n  <style>\n    #menu { padding: var(--j2-section-space, 64px) 16px; background: var(--j2-background, #fbf6ef); color: var(--j2-text, #2a1d14); }\n    #menu .menu-inner { max-width: 720px; margin: 0 auto; width: 100%; box-sizing: border-box; }\n    #menu #menu-title { font-family: var(--j2-font-heading, Georgia, 'Times New Roman', serif); color: var(--j2-primary, #4a2e1a); font-size: 1.75rem; line-height: 1.25; margin: 0 0 8px; overflow-wrap: anywhere; }\n    #menu .menu-note { color: var(--j2-muted, #6b5a4c); margin: 0 0 24px; font-family: var(--j2-font-body, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif); }\n    #menu .menu-list { list-style: none; margin: 0; padding: 8px 24px; box-sizing: border-box; }\n    #menu .menu-item { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; min-height: 48px; padding: 12px 0; border-bottom: 1px solid #e3d3bf; font-family: var(--j2-font-body, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif); font-size: 1.05rem; box-sizing: border-box; }\n    #menu .menu-item:last-child { border-bottom: 0; }\n    #menu .menu-item .menu-name { min-width: 0; overflow-wrap: anywhere; }\n    #menu .menu-item .menu-price { flex: 0 0 auto; font-weight: 700; color: var(--j2-accent, #b4531f); font-variant-numeric: tabular-nums; }\n    @media (max-width: 480px) {\n      #menu { padding-left: 12px; padding-right: 12px; }\n      #menu .menu-list { padding: 8px 16px; }\n      #menu #menu-title { font-size: 1.5rem; }\n    }\n  </style>\n  <div class=\"menu-inner\">\n    <h2 id=\"menu-title\">Menu</h2>\n    <p class=\"menu-note\">All prices are in rupees.</p>\n    <ul class=\"menu-list j2-card\">\n      <li class=\"menu-item\"><span class=\"menu-name\">Filter coffee</span> <span class=\"menu-price\">90</span></li>\n      <li class=\"menu-item\"><span class=\"menu-name\">Cappuccino</span> <span class=\"menu-price\">160</span></li>\n      <li class=\"menu-item\"><span class=\"menu-name\">Latte</span> <span class=\"menu-price\">180</span></li>\n      <li class=\"menu-item\"><span class=\"menu-name\">Cold brew</span> <span class=\"menu-price\">200</span></li>\n      <li class=\"menu-item\"><span class=\"menu-name\">Masala chai</span> <span class=\"menu-price\">80</span></li>\n      <li class=\"menu-item\"><span class=\"menu-name\">Almond croissant</span> <span class=\"menu-price\">140</span></li>\n      <li class=\"menu-item\"><span class=\"menu-name\">Banana bread slice</span> <span class=\"menu-price\">120</span></li>\n    </ul>\n  </div>\n</section>",
    "workflow": "Menu section"
  },
  "W-27": {
    "owner": "W-27",
    "head": "",
    "body": "<section id=\"opening-hours\" aria-labelledby=\"opening-hours-title\">\n  <style>\n    #opening-hours {\n      padding: var(--j2-section, 64px) 16px;\n      background: var(--j2-background);\n      box-sizing: border-box;\n    }\n    #opening-hours .hours-inner {\n      max-width: 720px;\n      margin: 0 auto;\n      box-sizing: border-box;\n    }\n    #opening-hours .hours-card {\n      text-align: center;\n      box-sizing: border-box;\n      max-width: 100%;\n    }\n    #opening-hours #opening-hours-title {\n      font-family: var(--j2-font-heading);\n      color: var(--j2-primary);\n      margin: 0 0 16px;\n      font-size: 1.75rem;\n      line-height: 1.25;\n      overflow-wrap: break-word;\n    }\n    #opening-hours #opening-hours-text {\n      font-family: var(--j2-font-body);\n      color: var(--j2-text);\n      font-size: 1.25rem;\n      font-weight: 600;\n      line-height: 1.5;\n      margin: 0;\n      overflow-wrap: break-word;\n    }\n  </style>\n  <div class=\"hours-inner\">\n    <div class=\"hours-card j2-card\">\n      <h2 id=\"opening-hours-title\">Opening hours</h2>\n      <p id=\"opening-hours-text\">7 am to 10 pm, every day</p>\n    </div>\n  </div>\n</section>",
    "workflow": "Opening hours section"
  },
  "W-28": {
    "owner": "W-28",
    "head": "",
    "body": "<section id=\"pre-order\" aria-labelledby=\"pre-order-title\">\n  <style>\n    #pre-order { padding: var(--j2-section, 64px) 16px; max-width: 100%; box-sizing: border-box; }\n    #pre-order .order-inner { max-width: 640px; margin: 0 auto; min-width: 0; }\n    #pre-order h2 { font-family: var(--j2-font-heading); color: var(--j2-primary); margin: 0 0 8px; font-size: 1.75rem; overflow-wrap: anywhere; }\n    #pre-order .order-intro { color: var(--j2-muted); margin: 0 0 24px; overflow-wrap: anywhere; }\n    #pre-order .order-card { box-sizing: border-box; width: 100%; }\n    #pre-order .order-field { display: block; margin: 0 0 16px; min-width: 0; }\n    #pre-order .order-field label { display: block; font-weight: 600; color: var(--j2-text); margin-bottom: 8px; }\n    #pre-order .order-field .order-hint { display: block; font-weight: 400; color: var(--j2-muted); font-size: 0.9rem; margin-top: 2px; }\n    #pre-order .order-field input,\n    #pre-order .order-field select {\n      display: block; box-sizing: border-box; width: 100%; max-width: 100%; min-height: 48px;\n      padding: 12px 16px; font: inherit; font-family: var(--j2-font-body); font-size: 1rem;\n      color: var(--j2-text); background: var(--j2-surface, #ffffff);\n      border: 2px solid var(--j2-primary); border-radius: var(--j2-radius, 12px);\n    }\n    #pre-order .order-field select[multiple] { padding: 4px; min-height: 192px; }\n    #pre-order .order-field select[multiple] option { min-height: 44px; padding: 10px 12px; display: flex; align-items: center; }\n    #pre-order .order-field input:focus,\n    #pre-order .order-field select:focus { outline: 3px solid var(--j2-accent); outline-offset: 2px; }\n    #pre-order .order-field.order-invalid input,\n    #pre-order .order-field.order-invalid select { border-color: var(--j2-accent); }\n    #pre-order .order-error { display: none; color: var(--j2-accent); font-weight: 600; margin-top: 8px; font-size: 0.95rem; }\n    #pre-order .order-field.order-invalid .order-error { display: block; }\n    #pre-order #order-submit { width: 100%; max-width: 100%; box-sizing: border-box; }\n    #pre-order .order-status { margin: 16px 0 0; color: var(--j2-text); min-height: 1.5em; overflow-wrap: anywhere; }\n    #pre-order .order-email { margin: 16px 0 0; color: var(--j2-muted); overflow-wrap: anywhere; }\n  </style>\n  <div class=\"order-inner\">\n    <h2 id=\"pre-order-title\">Pre-order</h2>\n    <p class=\"order-intro\">Fill in the form and your order is sent by email to hello@brewlab.example.</p>\n    <div class=\"j2-card order-card\">\n      <form id=\"order-form\" action=\"mailto:hello@brewlab.example\" method=\"post\" enctype=\"text/plain\" novalidate>\n        <div class=\"order-field\" id=\"order-name-field\">\n          <label for=\"order-name\">Name</label>\n          <input type=\"text\" id=\"order-name\" name=\"name\" autocomplete=\"name\" required>\n          <span class=\"order-error\" id=\"order-name-error\">Please enter your name.</span>\n        </div>\n        <div class=\"order-field\" id=\"order-phone-field\">\n          <label for=\"order-phone\">Phone <span class=\"order-hint\">Your own phone number</span></label>\n          <input type=\"tel\" id=\"order-phone\" name=\"phone\" autocomplete=\"tel\" inputmode=\"tel\" required>\n          <span class=\"order-error\" id=\"order-phone-error\">Please enter your phone number.</span>\n        </div>\n        <div class=\"order-field\" id=\"order-items-field\">\n          <label for=\"order-items\">Items <span class=\"order-hint\">Choose what you want from the menu. To pick more than one, hold Ctrl or Cmd, or tap each item.</span></label>\n          <select id=\"order-items\" name=\"items\" multiple size=\"4\" required>\n            <option value=\"Filter coffee\">Filter coffee</option>\n            <option value=\"Cappuccino\">Cappuccino</option>\n            <option value=\"Latte\">Latte</option>\n            <option value=\"Cold brew\">Cold brew</option>\n            <option value=\"Masala chai\">Masala chai</option>\n            <option value=\"Almond croissant\">Almond croissant</option>\n            <option value=\"Banana bread slice\">Banana bread slice</option>\n          </select>\n          <span class=\"order-error\" id=\"order-items-error\">Please choose at least one item.</span>\n        </div>\n        <div class=\"order-field\" id=\"order-time-field\">\n          <label for=\"order-time\">Pickup time</label>\n          <input type=\"time\" id=\"order-time\" name=\"pickup time\" required>\n          <span class=\"order-error\" id=\"order-time-error\">Please choose a pickup time.</span>\n        </div>\n        <button type=\"submit\" id=\"order-submit\" class=\"j2-btn\">Send pre-order</button>\n        <p class=\"order-status\" id=\"order-status\" role=\"status\" aria-live=\"polite\"></p>\n      </form>\n    </div>\n    <p class=\"order-email\">Orders go to hello@brewlab.example.</p>\n  </div>\n  <script>\n    (function () {\n      var form = document.getElementById('order-form');\n      if (!form) { return; }\n      var status = document.getElementById('order-status');\n      var ids = ['order-name', 'order-phone', 'order-items', 'order-time'];\n      form.addEventListener('submit', function (event) {\n        var firstBad = null;\n        for (var i = 0; i < ids.length; i++) {\n          var input = document.getElementById(ids[i]);\n          var wrap = document.getElementById(ids[i] + '-field');\n          if (!input || !wrap) { continue; }\n          var value = String(input.value || '').replace(/^\\s+|\\s+$/g, '');\n          if (value === '') {\n            wrap.classList.add('order-invalid');\n            if (!firstBad) { firstBad = input; }\n          } else {\n            wrap.classList.remove('order-invalid');\n          }\n        }\n        if (firstBad) {\n          event.preventDefault();\n          if (status) { status.textContent = 'Please fill in every field before sending.'; }\n          if (firstBad.focus) { firstBad.focus(); }\n          return;\n        }\n        if (status) { status.textContent = 'Opening your email app to send the order to hello@brewlab.example.'; }\n      });\n    })();\n  </script>\n</section>",
    "workflow": "Pre-order form section"
  },
  "W-29": {
    "owner": "W-29",
    "head": "",
    "body": "<section id=\"pickup-note\" aria-label=\"Pickup note\">\n  <style>\n    #pickup-note {\n      padding: var(--j2-section, 64px) 16px;\n      background: var(--j2-secondary, #f1e4d3);\n      box-sizing: border-box;\n    }\n    #pickup-note .pickup-inner {\n      max-width: 720px;\n      margin: 0 auto;\n      box-sizing: border-box;\n    }\n    #pickup-note .pickup-inner h2 {\n      font-family: var(--j2-font-heading, Georgia, 'Times New Roman', serif);\n      color: var(--j2-primary, #4a2e1a);\n      font-size: 1.5rem;\n      margin: 0 0 16px;\n      overflow-wrap: break-word;\n    }\n    #pickup-note .pickup-inner p {\n      font-family: var(--j2-font-body, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif);\n      color: var(--j2-text, #2a1d14);\n      font-size: 1.125rem;\n      line-height: 1.5;\n      margin: 0 0 8px;\n      overflow-wrap: break-word;\n    }\n    #pickup-note .pickup-inner p:last-child {\n      margin-bottom: 0;\n    }\n  </style>\n  <div class=\"pickup-inner j2-card\">\n    <h2>Pickup at the shop</h2>\n    <p id=\"collect-line\">Customers collect the order at the shop.</p>\n    <p id=\"payment-line\">No online payment is taken.</p>\n  </div>\n</section>",
    "workflow": "Pickup note section"
  },
  "W-30": {
    "owner": "W-30",
    "head": "<style>\n  *, *::before, *::after { box-sizing: border-box; }\n  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }\n  body { margin: 0; max-width: 100%; overflow-wrap: anywhere; }\n  img, svg, video, iframe, table { max-width: 100%; }\n  input, select, textarea, button { max-width: 100%; font: inherit; }\n  input, select, textarea { min-height: 44px; }\n  section[id] { scroll-margin-top: 80px; }\n\n  #page { width: 100%; z-index: 20; }\n  #page-nav {\n    width: 100%;\n    background: var(--j2-secondary);\n    border-bottom: 1px solid var(--j2-primary);\n    padding: 8px 12px;\n  }\n  #page-nav .nav-list {\n    list-style: none;\n    margin: 0 auto;\n    padding: 0;\n    max-width: 960px;\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 8px;\n  }\n  #page-nav .nav-list li { margin: 0; min-width: 0; }\n  #page-nav .nav-link {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 48px;\n    min-width: 44px;\n    padding: 8px 4px;\n    color: var(--j2-primary);\n    background: var(--j2-surface);\n    border: 2px solid var(--j2-primary);\n    border-radius: var(--j2-radius, 12px);\n    font-family: var(--j2-font-body);\n    font-weight: 600;\n    font-size: 0.95rem;\n    text-align: center;\n    text-decoration: none;\n  }\n  #page-nav .nav-link:hover,\n  #page-nav .nav-link:focus-visible {\n    background: var(--j2-primary);\n    color: var(--j2-surface);\n    outline: 3px solid var(--j2-accent);\n    outline-offset: 2px;\n  }\n\n  @media (min-width: 700px) {\n    #page { position: sticky; top: 0; }\n    #page-nav .nav-list {\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: center;\n      gap: 12px;\n    }\n    #page-nav .nav-link { padding: 8px 20px; font-size: 1rem; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    html { scroll-behavior: auto; }\n  }\n</style>",
    "body": "<div id=\"page\">\n  <nav id=\"page-nav\" aria-label=\"Page sections\">\n    <ul class=\"nav-list\">\n      <li><a class=\"nav-link\" href=\"#shop-name\">Home</a></li>\n      <li><a class=\"nav-link\" href=\"#menu\">Menu</a></li>\n      <li><a class=\"nav-link\" href=\"#opening-hours\">Hours</a></li>\n      <li><a class=\"nav-link\" href=\"#address\">Address</a></li>\n      <li><a class=\"nav-link\" href=\"#pre-order\">Pre-order</a></li>\n      <li><a class=\"nav-link\" href=\"#pickup-note\">Pickup</a></li>\n    </ul>\n  </nav>\n</div>\n<script>\n  (function () {\n    try {\n      var page = document.getElementById('page');\n      if (page && document.body && page.parentNode === document.body && document.body.firstChild !== page) {\n        document.body.insertBefore(page, document.body.firstChild);\n      }\n    } catch (e) { /* leave the navigation where it is */ }\n  })();\n</script>",
    "workflow": "Page layout, navigation and polish"
  }
}