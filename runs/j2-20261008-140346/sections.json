{
  "style": {
    "owner": "W-1",
    "head": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&amp;family=Jost:wght@400;500;600&amp;display=swap\"><style>:root{--j2-primary:#7A3E2B;--j2-secondary:#4F5B3A;--j2-accent:#B7791F;--j2-background:#F6EFE4;--j2-surface:#FFFBF5;--j2-text:#2B2118;--j2-muted:#6B5D4F;--j2-font-heading:'Cormorant Garamond', Georgia, serif;--j2-font-body:'Jost', 'Segoe UI', Arial, sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:12px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;background:#7A3E2B;color:#FFFBF5;border:1.5px solid #7A3E2B;min-height:48px;padding:0 24px;border-radius:999px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer}.j2-btn-secondary{display:inline-block;background:transparent;color:#7A3E2B;border:1.5px solid #7A3E2B;min-height:48px;padding:0 24px;border-radius:999px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer}.j2-card{background:#FFFBF5;border:1px solid #E3D6C3;border-radius:12px;padding:20px;box-shadow:0 1px 3px rgba(43,33,24,0.08)}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-1": {
    "owner": "W-2",
    "head": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
    "body": "<style>\n  #top, #products { font-family: var(--j2-font-body); color: var(--j2-text); }\n  .tl-topbar { background: var(--j2-surface); border-bottom: 1px solid #E3D6C3; }\n  .tl-topbar-inner { max-width: 1200px; margin: 0 auto; padding: 12px 16px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }\n  .tl-brand { font-family: var(--j2-font-heading); font-size: 1.75rem; font-weight: 700; color: var(--j2-primary); letter-spacing: 0.01em; margin: 0; }\n  .tl-products { background: var(--j2-background); padding: 48px 16px; }\n  .tl-wrap { max-width: 1200px; margin: 0 auto; }\n  .tl-products h2 { font-family: var(--j2-font-heading); font-size: 2rem; margin: 0 0 8px; color: var(--j2-text); }\n  .tl-lede { color: var(--j2-muted); margin: 0 0 24px; }\n  .tl-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 8px; }\n  .tl-tab { box-sizing: border-box; padding: 0 16px; font-family: var(--j2-font-body); font-size: 1rem; }\n  .tl-tab[aria-pressed=\"true\"] { background: var(--j2-primary); color: var(--j2-surface); }\n  .tl-tab:focus-visible { outline: 2px solid var(--j2-accent); outline-offset: 2px; }\n  .tl-status { font-size: 0.9rem; color: var(--j2-muted); margin: 0 0 16px; }\n  .tl-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }\n  .tl-product { display: flex; flex-direction: column; gap: 8px; min-width: 0; }\n  .tl-product[hidden] { display: none; }\n  .tl-swatch { height: 8px; border-radius: 999px; background: var(--j2-accent); }\n  .tl-product[data-category=\"Kurtas\"] .tl-swatch { background: #3F4E7A; }\n  .tl-product[data-category=\"Sarees\"] .tl-swatch { background: var(--j2-primary); }\n  .tl-product[data-category=\"Shirts\"] .tl-swatch { background: var(--j2-secondary); }\n  .tl-product[data-category=\"Dupattas\"] .tl-swatch { background: var(--j2-accent); }\n  .tl-cat { font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--j2-muted); margin: 0; }\n  .tl-name { font-family: var(--j2-font-heading); font-size: 1.4rem; line-height: 1.2; margin: 0; overflow-wrap: anywhere; }\n  .tl-price { font-size: 1.2rem; font-weight: 600; color: var(--j2-primary); margin: 0; }\n  .tl-sizes { font-size: 0.9rem; color: var(--j2-muted); margin: 0 0 8px; }\n  .tl-product .j2-btn { margin-top: auto; width: 100%; }\n  @media (min-width: 600px) { .tl-grid { grid-template-columns: repeat(2, 1fr); } }\n  @media (min-width: 960px) { .tl-grid { grid-template-columns: repeat(3, 1fr); gap: 24px; } .tl-products { padding: 64px 24px; } }\n  @media (min-width: 1200px) { .tl-grid { grid-template-columns: repeat(4, 1fr); } }\n</style>\n\n<header id=\"top\" class=\"tl-topbar\">\n  <div class=\"tl-topbar-inner\">\n    <p class=\"tl-brand\">Thread &amp; Loom</p>\n    <a class=\"j2-btn\" id=\"order-top\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20place%20an%20order.\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n  </div>\n</header>\n\n<section id=\"products\" class=\"tl-products\" aria-labelledby=\"products-title\">\n  <div class=\"tl-wrap\">\n    <h2 id=\"products-title\">Our Collection</h2>\n    <p class=\"tl-lede\">Tap Order on WhatsApp on any piece and we will take it from there.</p>\n\n    <div class=\"tl-tabs\" id=\"category-tabs\" role=\"group\" aria-label=\"Browse by category\">\n      <button type=\"button\" class=\"j2-btn-secondary tl-tab\" data-filter=\"All\" aria-pressed=\"true\">All</button>\n      <button type=\"button\" class=\"j2-btn-secondary tl-tab\" data-filter=\"Kurtas\" aria-pressed=\"false\">Kurtas</button>\n      <button type=\"button\" class=\"j2-btn-secondary tl-tab\" data-filter=\"Sarees\" aria-pressed=\"false\">Sarees</button>\n      <button type=\"button\" class=\"j2-btn-secondary tl-tab\" data-filter=\"Shirts\" aria-pressed=\"false\">Shirts</button>\n      <button type=\"button\" class=\"j2-btn-secondary tl-tab\" data-filter=\"Dupattas\" aria-pressed=\"false\">Dupattas</button>\n    </div>\n    <p class=\"tl-status\" id=\"tab-status\" role=\"status\" aria-live=\"polite\">Showing 10 products</p>\n\n    <div class=\"tl-grid\" id=\"product-grid\">\n\n      <article class=\"j2-card tl-product\" data-category=\"Kurtas\" data-price=\"1499\" data-sizes=\"S,M,L,XL,XXL\">\n        <div class=\"tl-swatch\"></div>\n        <p class=\"tl-cat\">Kurtas</p>\n        <h3 class=\"tl-name\">Indigo block-print kurta</h3>\n        <p class=\"tl-price\">₹1,499</p>\n        <p class=\"tl-sizes\">Sizes: S to XXL</p>\n        <a class=\"j2-btn\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20order%3A%20Indigo%20block-print%20kurta\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n      </article>\n\n      <article class=\"j2-card tl-product\" data-category=\"Kurtas\" data-price=\"1699\" data-sizes=\"S,M,L,XL\">\n        <div class=\"tl-swatch\"></div>\n        <p class=\"tl-cat\">Kurtas</p>\n        <h3 class=\"tl-name\">Mustard handloom kurta</h3>\n        <p class=\"tl-price\">₹1,699</p>\n        <p class=\"tl-sizes\">Sizes: S to XL</p>\n        <a class=\"j2-btn\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20order%3A%20Mustard%20handloom%20kurta\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n      </article>\n\n      <article class=\"j2-card tl-product\" data-category=\"Kurtas\" data-price=\"2199\" data-sizes=\"XS,S,M,L,XL\" data-new=\"true\">\n        <div class=\"tl-swatch\"></div>\n        <p class=\"tl-cat\">Kurtas</p>\n        <h3 class=\"tl-name\">White chikankari kurta</h3>\n        <p class=\"tl-price\">₹2,199</p>\n        <p class=\"tl-sizes\">Sizes: XS to XL</p>\n        <a class=\"j2-btn\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20order%3A%20White%20chikankari%20kurta\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n      </article>\n\n      <article class=\"j2-card tl-product\" data-category=\"Sarees\" data-price=\"3499\" data-sizes=\"free\" data-new=\"true\">\n        <div class=\"tl-swatch\"></div>\n        <p class=\"tl-cat\">Sarees</p>\n        <h3 class=\"tl-name\">Ikat handloom saree</h3>\n        <p class=\"tl-price\">₹3,499</p>\n        <p class=\"tl-sizes\">Free size</p>\n        <a class=\"j2-btn\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20order%3A%20Ikat%20handloom%20saree\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n      </article>\n\n      <article class=\"j2-card tl-product\" data-category=\"Sarees\" data-price=\"4999\" data-sizes=\"free\">\n        <div class=\"tl-swatch\"></div>\n        <p class=\"tl-cat\">Sarees</p>\n        <h3 class=\"tl-name\">Khadi silk saree</h3>\n        <p class=\"tl-price\">₹4,999</p>\n        <p class=\"tl-sizes\">Free size</p>\n        <a class=\"j2-btn\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20order%3A%20Khadi%20silk%20saree\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n      </article>\n\n      <article class=\"j2-card tl-product\" data-category=\"Sarees\" data-price=\"3999\" data-sizes=\"free\">\n        <div class=\"tl-swatch\"></div>\n        <p class=\"tl-cat\">Sarees</p>\n        <h3 class=\"tl-name\">Cotton jamdani saree</h3>\n        <p class=\"tl-price\">₹3,999</p>\n        <p class=\"tl-sizes\">Free size</p>\n        <a class=\"j2-btn\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20order%3A%20Cotton%20jamdani%20saree\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n      </article>\n\n      <article class=\"j2-card tl-product\" data-category=\"Shirts\" data-price=\"1299\" data-sizes=\"S,M,L,XL,XXL\">\n        <div class=\"tl-swatch\"></div>\n        <p class=\"tl-cat\">Shirts</p>\n        <h3 class=\"tl-name\">Khadi cotton shirt</h3>\n        <p class=\"tl-price\">₹1,299</p>\n        <p class=\"tl-sizes\">Sizes: S to XXL</p>\n        <a class=\"j2-btn\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20order%3A%20Khadi%20cotton%20shirt\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n      </article>\n\n      <article class=\"j2-card tl-product\" data-category=\"Shirts\" data-price=\"1599\" data-sizes=\"M,L,XL,XXL\" data-new=\"true\">\n        <div class=\"tl-swatch\"></div>\n        <p class=\"tl-cat\">Shirts</p>\n        <h3 class=\"tl-name\">Linen-blend shirt</h3>\n        <p class=\"tl-price\">₹1,599</p>\n        <p class=\"tl-sizes\">Sizes: M to XXL</p>\n        <a class=\"j2-btn\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20order%3A%20Linen-blend%20shirt\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n      </article>\n\n      <article class=\"j2-card tl-product\" data-category=\"Dupattas\" data-price=\"899\" data-sizes=\"free\">\n        <div class=\"tl-swatch\"></div>\n        <p class=\"tl-cat\">Dupattas</p>\n        <h3 class=\"tl-name\">Block-print dupatta</h3>\n        <p class=\"tl-price\">₹899</p>\n        <p class=\"tl-sizes\">Free size</p>\n        <a class=\"j2-btn\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20order%3A%20Block-print%20dupatta\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n      </article>\n\n      <article class=\"j2-card tl-product\" data-category=\"Dupattas\" data-price=\"1099\" data-sizes=\"free\">\n        <div class=\"tl-swatch\"></div>\n        <p class=\"tl-cat\">Dupattas</p>\n        <h3 class=\"tl-name\">Chanderi dupatta</h3>\n        <p class=\"tl-price\">₹1,099</p>\n        <p class=\"tl-sizes\">Free size</p>\n        <a class=\"j2-btn\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20order%3A%20Chanderi%20dupatta\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n      </article>\n\n    </div>\n  </div>\n</section>\n\n<script>\n(function () {\n  var tabs = document.querySelectorAll('#category-tabs .tl-tab');\n  var cards = document.querySelectorAll('#product-grid .tl-product');\n  var status = document.getElementById('tab-status');\n  if (!tabs.length || !cards.length) { return; }\n\n  function showCategory(cat) {\n    var shown = 0;\n    cards.forEach(function (card) {\n      var match = cat === 'All' || card.getAttribute('data-category') === cat;\n      card.hidden = !match;\n      if (match) { shown += 1; }\n    });\n    tabs.forEach(function (tab) {\n      tab.setAttribute('aria-pressed', tab.getAttribute('data-filter') === cat ? 'true' : 'false');\n    });\n    if (status) {\n      status.textContent = 'Showing ' + shown + ' product' + (shown === 1 ? '' : 's');\n    }\n  }\n\n  tabs.forEach(function (tab) {\n    tab.addEventListener('click', function () {\n      showCategory(tab.getAttribute('data-filter'));\n    });\n  });\n\n  showCategory('All');\n})();\n</script>",
    "workflow": "Fix category tabs with view all"
  },
  "W-3": {
    "owner": "W-3",
    "head": "",
    "body": "<style>\n  html { scroll-behavior: smooth; }\n  .tl-nav { box-sizing: border-box; font-family: var(--j2-font-body); background: var(--j2-surface); border-bottom: 1px solid #E3D6C3; padding: 4px 16px; }\n  .tl-nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 16px; }\n  .tl-nav a { box-sizing: border-box; display: inline-flex; align-items: center; min-height: 44px; padding: 0 4px; color: var(--j2-primary); font-weight: 500; text-decoration: none; border-bottom: 2px solid transparent; }\n  .tl-nav a:hover { border-bottom-color: var(--j2-accent); }\n  .tl-nav a:focus-visible { outline: 2px solid var(--j2-accent); outline-offset: 2px; }\n  .tl-topbar-inner > .tl-nav { flex: 1 1 100%; order: 3; background: transparent; border-bottom: 0; padding: 0; }\n  @media (min-width: 900px) {\n    .tl-topbar-inner > .tl-nav { flex: 0 1 auto; order: 0; }\n  }\n</style>\n\n<nav class=\"tl-nav\" id=\"site-nav\" aria-label=\"Main menu\">\n  <ul>\n    <li><a href=\"#products\">Collection</a></li>\n    <li><a href=\"#category-tabs\">Categories</a></li>\n  </ul>\n</nav>\n\n<script>\n(function () {\n  var nav = document.getElementById('site-nav');\n  var inner = document.querySelector('#top .tl-topbar-inner');\n  if (!nav || !inner) { return; }\n  var cta = document.getElementById('order-top');\n  if (cta && cta.parentNode === inner) {\n    inner.insertBefore(nav, cta);\n  } else {\n    inner.appendChild(nav);\n  }\n})();\n</script>",
    "workflow": "Fix navigation menu"
  },
  "W-4": {
    "owner": "W-4",
    "head": "",
    "body": "<style>\n  /* W-4: 360px overflow fix. Buttons with width:100% plus padding and border were wider than their cards. */\n  .j2-btn,\n  .j2-btn-secondary,\n  .j2-card,\n  .tl-topbar-inner,\n  .tl-products,\n  .tl-wrap,\n  .tl-grid,\n  .tl-tabs,\n  .tl-product {\n    box-sizing: border-box;\n  }\n  .tl-product .j2-btn {\n    max-width: 100%;\n    text-align: center;\n  }\n  .tl-topbar-inner > .j2-btn {\n    max-width: 100%;\n  }\n</style>",
    "workflow": "Fix 360px overflow"
  }
}