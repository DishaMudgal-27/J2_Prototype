{
  "style": {
    "owner": "W-1",
    "head": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&amp;family=Nunito+Sans:wght@400;600;700&amp;display=swap\"><style>:root{--j2-primary:#7A3E22;--j2-secondary:#4F5D3A;--j2-accent:#B8863B;--j2-background:#FAF5EC;--j2-surface:#FFFFFF;--j2-text:#2E2418;--j2-muted:#6B5B4B;--j2-font-heading:'Cormorant Garamond', Georgia, 'Times New Roman', serif;--j2-font-body:'Nunito Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:12px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;background:#7A3E22;color:#FFFFFF;border:1.5px solid #7A3E22;min-height:44px;padding:0 22px;font-weight:600;letter-spacing:0.02em;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center}.j2-btn-secondary{display:inline-block;background:transparent;color:#7A3E22;border:1.5px solid #7A3E22;min-height:44px;padding:0 22px;font-weight:600;letter-spacing:0.02em;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center}.j2-card{background:#FFFFFF;border:1px solid #E6DAC6;box-shadow:0 1px 3px rgba(46,36,24,0.08);padding:16px}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-1": {
    "owner": "W-1",
    "head": "",
    "body": "<section id=\"products\" class=\"j2-products\" aria-labelledby=\"products-title\">\n  <style>\n    #products { padding: var(--j2-section, 64px) 16px; max-width: 1200px; margin: 0 auto; box-sizing: border-box; }\n    #products *, #products *::before, #products *::after { box-sizing: border-box; }\n    #products .j2-products-head { text-align: center; margin-bottom: 24px; }\n    #products .j2-products-head h2 { font-family: var(--j2-font-heading, Georgia, serif); font-size: clamp(1.75rem, 5vw, 2.5rem); margin: 0 0 8px; color: var(--j2-text, #2E2418); font-weight: 600; }\n    #products .j2-products-head p { margin: 0; color: var(--j2-muted, #6B5B4B); }\n    #products .j2-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 0 0 16px; padding: 0; }\n    #products .j2-tab { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 44px; padding: 0 20px; border-radius: 999px; cursor: pointer; font-family: inherit; font-size: 1rem; }\n    #products .j2-tab.is-active { background: var(--j2-primary, #7A3E22); color: #fff; border-color: var(--j2-primary, #7A3E22); }\n    #products .j2-tab:focus-visible { outline: 3px solid var(--j2-accent, #B8863B); outline-offset: 2px; }\n    #products .j2-count { text-align: center; color: var(--j2-muted, #6B5B4B); margin: 0 0 24px; font-size: 0.95rem; }\n    #products .j2-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); }\n    #products .j2-product { display: flex; flex-direction: column; gap: 8px; min-width: 0; }\n    #products .j2-product[hidden] { display: none; }\n    #products .j2-photo { width: 100%; aspect-ratio: 4 / 5; border-radius: calc(var(--j2-radius, 12px) - 4px); background: rgba(122, 62, 34, 0.06); border: 1.5px dashed rgba(122, 62, 34, 0.35); }\n    #products .j2-cat { margin: 4px 0 0; font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--j2-secondary, #4F5D3A); font-weight: 700; }\n    #products .j2-name { margin: 0; font-family: var(--j2-font-heading, Georgia, serif); font-size: 1.3rem; line-height: 1.25; color: var(--j2-text, #2E2418); font-weight: 600; overflow-wrap: anywhere; }\n    #products .j2-price { margin: 0; font-size: 1.15rem; font-weight: 700; color: var(--j2-primary, #7A3E22); }\n    #products .j2-sizes { margin: 0; font-size: 0.95rem; color: var(--j2-muted, #6B5B4B); }\n    #products .j2-card-actions { margin-top: auto; padding-top: 8px; }\n  </style>\n\n  <div class=\"j2-products-head\">\n    <h2 id=\"products-title\">Our Collection</h2>\n    <p>Handloom kurtas, sarees, cotton shirts and dupattas.</p>\n  </div>\n\n  <div class=\"j2-tabs\" role=\"group\" aria-label=\"Browse by category\">\n    <button type=\"button\" class=\"j2-tab j2-btn-secondary is-active\" data-category=\"all\" aria-pressed=\"true\">All</button>\n    <button type=\"button\" class=\"j2-tab j2-btn-secondary\" data-category=\"Kurtas\" aria-pressed=\"false\">Kurtas</button>\n    <button type=\"button\" class=\"j2-tab j2-btn-secondary\" data-category=\"Sarees\" aria-pressed=\"false\">Sarees</button>\n    <button type=\"button\" class=\"j2-tab j2-btn-secondary\" data-category=\"Shirts\" aria-pressed=\"false\">Shirts</button>\n    <button type=\"button\" class=\"j2-tab j2-btn-secondary\" data-category=\"Dupattas\" aria-pressed=\"false\">Dupattas</button>\n  </div>\n\n  <p class=\"j2-count\" id=\"products-count\" aria-live=\"polite\">Showing 10 of 10 products</p>\n\n  <ul class=\"j2-grid\" id=\"product-grid\">\n    <li class=\"j2-product j2-card\" data-name=\"Indigo block-print kurta\" data-category=\"Kurtas\" data-price=\"1499\" data-sizes=\"S,M,L,XL,XXL\">\n      <div class=\"j2-photo\" aria-hidden=\"true\"></div>\n      <p class=\"j2-cat\">Kurtas</p>\n      <h3 class=\"j2-name\">Indigo block-print kurta</h3>\n      <p class=\"j2-price\">₹1,499</p>\n      <p class=\"j2-sizes\">Sizes: S-XXL</p>\n      <div class=\"j2-card-actions\"></div>\n    </li>\n    <li class=\"j2-product j2-card\" data-name=\"Mustard handloom kurta\" data-category=\"Kurtas\" data-price=\"1699\" data-sizes=\"S,M,L,XL\">\n      <div class=\"j2-photo\" aria-hidden=\"true\"></div>\n      <p class=\"j2-cat\">Kurtas</p>\n      <h3 class=\"j2-name\">Mustard handloom kurta</h3>\n      <p class=\"j2-price\">₹1,699</p>\n      <p class=\"j2-sizes\">Sizes: S-XL</p>\n      <div class=\"j2-card-actions\"></div>\n    </li>\n    <li class=\"j2-product j2-card\" data-name=\"White chikankari kurta\" data-category=\"Kurtas\" data-price=\"2199\" data-sizes=\"XS,S,M,L,XL\">\n      <div class=\"j2-photo\" aria-hidden=\"true\"></div>\n      <p class=\"j2-cat\">Kurtas</p>\n      <h3 class=\"j2-name\">White chikankari kurta</h3>\n      <p class=\"j2-price\">₹2,199</p>\n      <p class=\"j2-sizes\">Sizes: XS-XL</p>\n      <div class=\"j2-card-actions\"></div>\n    </li>\n    <li class=\"j2-product j2-card\" data-name=\"Maheshwari cotton saree\" data-category=\"Sarees\" data-price=\"3499\" data-sizes=\"FREE\">\n      <div class=\"j2-photo\" aria-hidden=\"true\"></div>\n      <p class=\"j2-cat\">Sarees</p>\n      <h3 class=\"j2-name\">Maheshwari cotton saree</h3>\n      <p class=\"j2-price\">₹3,499</p>\n      <p class=\"j2-sizes\">Free size</p>\n      <div class=\"j2-card-actions\"></div>\n    </li>\n    <li class=\"j2-product j2-card\" data-name=\"Chanderi silk-cotton saree\" data-category=\"Sarees\" data-price=\"4999\" data-sizes=\"FREE\">\n      <div class=\"j2-photo\" aria-hidden=\"true\"></div>\n      <p class=\"j2-cat\">Sarees</p>\n      <h3 class=\"j2-name\">Chanderi silk-cotton saree</h3>\n      <p class=\"j2-price\">₹4,999</p>\n      <p class=\"j2-sizes\">Free size</p>\n      <div class=\"j2-card-actions\"></div>\n    </li>\n    <li class=\"j2-product j2-card\" data-name=\"Ikat handloom saree\" data-category=\"Sarees\" data-price=\"3999\" data-sizes=\"FREE\">\n      <div class=\"j2-photo\" aria-hidden=\"true\"></div>\n      <p class=\"j2-cat\">Sarees</p>\n      <h3 class=\"j2-name\">Ikat handloom saree</h3>\n      <p class=\"j2-price\">₹3,999</p>\n      <p class=\"j2-sizes\">Free size</p>\n      <div class=\"j2-card-actions\"></div>\n    </li>\n    <li class=\"j2-product j2-card\" data-name=\"Khadi cotton shirt\" data-category=\"Shirts\" data-price=\"1299\" data-sizes=\"S,M,L,XL,XXL\">\n      <div class=\"j2-photo\" aria-hidden=\"true\"></div>\n      <p class=\"j2-cat\">Shirts</p>\n      <h3 class=\"j2-name\">Khadi cotton shirt</h3>\n      <p class=\"j2-price\">₹1,299</p>\n      <p class=\"j2-sizes\">Sizes: S-XXL</p>\n      <div class=\"j2-card-actions\"></div>\n    </li>\n    <li class=\"j2-product j2-card\" data-name=\"Linen-blend shirt\" data-category=\"Shirts\" data-price=\"1599\" data-sizes=\"M,L,XL,XXL\">\n      <div class=\"j2-photo\" aria-hidden=\"true\"></div>\n      <p class=\"j2-cat\">Shirts</p>\n      <h3 class=\"j2-name\">Linen-blend shirt</h3>\n      <p class=\"j2-price\">₹1,599</p>\n      <p class=\"j2-sizes\">Sizes: M-XXL</p>\n      <div class=\"j2-card-actions\"></div>\n    </li>\n    <li class=\"j2-product j2-card\" data-name=\"Ajrakh dupatta\" data-category=\"Dupattas\" data-price=\"899\" data-sizes=\"FREE\">\n      <div class=\"j2-photo\" aria-hidden=\"true\"></div>\n      <p class=\"j2-cat\">Dupattas</p>\n      <h3 class=\"j2-name\">Ajrakh dupatta</h3>\n      <p class=\"j2-price\">₹899</p>\n      <p class=\"j2-sizes\">Free size</p>\n      <div class=\"j2-card-actions\"></div>\n    </li>\n    <li class=\"j2-product j2-card\" data-name=\"Bandhani dupatta\" data-category=\"Dupattas\" data-price=\"1099\" data-sizes=\"FREE\">\n      <div class=\"j2-photo\" aria-hidden=\"true\"></div>\n      <p class=\"j2-cat\">Dupattas</p>\n      <h3 class=\"j2-name\">Bandhani dupatta</h3>\n      <p class=\"j2-price\">₹1,099</p>\n      <p class=\"j2-sizes\">Free size</p>\n      <div class=\"j2-card-actions\"></div>\n    </li>\n  </ul>\n\n  <script>\n    (function () {\n      var root = document.getElementById('products');\n      if (!root) return;\n      var tabs = root.querySelectorAll('.j2-tab');\n      var cards = root.querySelectorAll('.j2-product');\n      var count = document.getElementById('products-count');\n\n      function apply(category) {\n        var shown = 0;\n        for (var i = 0; i < cards.length; i++) {\n          var match = category === 'all' || cards[i].getAttribute('data-category') === category;\n          cards[i].hidden = !match;\n          if (match) shown++;\n        }\n        for (var j = 0; j < tabs.length; j++) {\n          var active = tabs[j].getAttribute('data-category') === category;\n          tabs[j].classList.toggle('is-active', active);\n          tabs[j].setAttribute('aria-pressed', active ? 'true' : 'false');\n        }\n        if (count) count.textContent = 'Showing ' + shown + ' of ' + cards.length + ' products';\n      }\n\n      for (var k = 0; k < tabs.length; k++) {\n        tabs[k].addEventListener('click', function () {\n          apply(this.getAttribute('data-category'));\n        });\n      }\n      apply('all');\n    })();\n  </script>\n</section>",
    "workflow": "Product list with category browse"
  },
  "W-2": {
    "owner": "W-2",
    "head": "",
    "body": "<style>\n  .j2-order-btn { width: 100%; gap: 8px; border-radius: var(--j2-radius, 12px); font-family: var(--j2-font-body, system-ui, sans-serif); font-size: 1rem; box-sizing: border-box; transition: background-color 0.15s ease, border-color 0.15s ease; }\n  .j2-order-btn:hover { background: var(--j2-secondary, #4F5D3A); border-color: var(--j2-secondary, #4F5D3A); color: #fff; }\n  .j2-order-btn:focus-visible { outline: 3px solid var(--j2-accent, #B8863B); outline-offset: 2px; }\n  .j2-order-btn svg { width: 20px; height: 20px; flex: 0 0 auto; fill: currentColor; }\n</style>\n<script>\n  (function () {\n    var NUMBER = '910000011111';\n    var ICON = '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.700 6.700 0 0 1-3.300-2.900c-.2-.4.2-.4.700-1.300.1-.2 0-.3 0-.5l-.8-1.900c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.300-.2.300-.9.900-.9 2.200s.9 2.500 1.100 2.700c.1.200 1.800 2.800 4.400 3.900 1.600.7 2.300.7 3.100.6.500-.1 1.500-.6 1.700-1.200.2-.6.2-1.100.2-1.200-.1-.1-.3-.2-.5-.3z\"/></svg>';\n\n    function addButtons() {\n      var cards = document.querySelectorAll('#products .j2-product');\n      for (var i = 0; i < cards.length; i++) {\n        var card = cards[i];\n        var slot = card.querySelector('.j2-card-actions');\n        if (!slot || slot.querySelector('.j2-order-btn')) continue;\n        var name = card.getAttribute('data-name');\n        if (!name) {\n          var h = card.querySelector('.j2-name');\n          name = h ? h.textContent.trim() : '';\n        }\n        if (!name) continue;\n        var message = 'Hi Thread & Loom, I would like to order: ' + name;\n        var a = document.createElement('a');\n        a.className = 'j2-btn j2-order-btn';\n        a.href = 'https://wa.me/' + NUMBER + '?text=' + encodeURIComponent(message);\n        a.target = '_blank';\n        a.rel = 'noopener noreferrer';\n        a.setAttribute('aria-label', 'Order ' + name + ' on WhatsApp');\n        a.innerHTML = ICON + '<span>Order on WhatsApp</span>';\n        slot.appendChild(a);\n      }\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', addButtons);\n    } else {\n      addButtons();\n    }\n  })();\n</script>",
    "workflow": "WhatsApp order buttons"
  },
  "W-3": {
    "owner": "W-3",
    "head": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
    "body": "<style>\n  /* W-3 theme: low-specificity base rules so section styles from W-1 and W-2 still win */\n  *, *::before, *::after { box-sizing: border-box; }\n  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; max-width: 100%; overflow-x: hidden; overflow-x: clip; }\n  body { max-width: 100%; overflow-x: hidden; overflow-x: clip; font-size: 1rem; line-height: 1.6; overflow-wrap: break-word; -webkit-font-smoothing: antialiased; }\n  :where(img, svg, video, canvas, iframe, table) { max-width: 100%; }\n  :where(img, video) { height: auto; }\n  :where(h1, h2, h3, h4) { font-family: var(--j2-font-heading); color: var(--j2-text); line-height: 1.2; font-weight: 600; letter-spacing: 0.01em; text-wrap: balance; }\n  :where(h1) { font-size: clamp(2.25rem, 7vw, 3.5rem); }\n  :where(h2) { font-size: clamp(1.75rem, 5vw, 2.5rem); }\n  :where(p, li) { max-width: 70ch; }\n  :where(a) { color: var(--j2-primary); text-underline-offset: 3px; }\n  :where(a:hover) { color: var(--j2-secondary); }\n  :where(a, button, input, select, textarea):focus-visible { outline: 3px solid var(--j2-accent); outline-offset: 2px; }\n  :where(button, input, select, textarea) { font-family: var(--j2-font-body); font-size: 1rem; }\n  :where(section[id]) { scroll-margin-top: calc(var(--j2-space) * 2); }\n  :where(.j2-btn, .j2-btn-secondary) { border-radius: var(--j2-radius); transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease; }\n  :where(.j2-btn):hover { background: var(--j2-secondary); border-color: var(--j2-secondary); color: var(--j2-surface); }\n  :where(.j2-btn-secondary):hover { background: var(--j2-primary); color: var(--j2-surface); }\n  :where(.j2-card) { border-radius: var(--j2-radius); transition: box-shadow 0.2s ease, transform 0.2s ease; }\n  :where(.j2-card):hover { box-shadow: 0 6px 18px rgba(46, 36, 24, 0.12); transform: translateY(-2px); }\n  ::selection { background: var(--j2-accent); color: var(--j2-text); }\n  @media (max-width: 480px) {\n    html { scroll-padding-top: 8px; }\n    body { font-size: 1rem; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    html { scroll-behavior: auto; }\n    *, *::before, *::after { transition: none !important; animation: none !important; }\n    :where(.j2-card):hover { transform: none; }\n  }\n</style>",
    "workflow": "Earthy elegant theme"
  },
  "W-4": {
    "owner": "W-4",
    "head": "",
    "body": "<header id=\"hero\" class=\"j2-hero\" aria-labelledby=\"hero-title\">\n  <style>\n    #hero { box-sizing: border-box; width: 100%; max-width: 100%; padding: var(--j2-section, 64px) 16px; text-align: center; background: var(--j2-background, #FAF5EC); border-bottom: 1px solid #E6DAC6; }\n    #hero *, #hero *::before, #hero *::after { box-sizing: border-box; }\n    #hero .j2-hero-inner { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 16px; }\n    #hero .j2-hero-eyebrow { margin: 0; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--j2-secondary, #4F5D3A); }\n    #hero .j2-hero-rule { width: 56px; height: 2px; border: 0; margin: 0; background: var(--j2-accent, #B8863B); }\n    #hero h1 { margin: 0; font-family: var(--j2-font-heading, Georgia, serif); font-size: clamp(2.5rem, 9vw, 4.5rem); line-height: 1.1; font-weight: 600; color: var(--j2-primary, #7A3E22); overflow-wrap: anywhere; }\n    #hero .j2-hero-sub { margin: 0; font-family: var(--j2-font-heading, Georgia, serif); font-size: clamp(1.25rem, 4vw, 1.75rem); line-height: 1.3; color: var(--j2-text, #2E2418); }\n    #hero .j2-hero-line { margin: 0; font-size: 1.05rem; color: var(--j2-muted, #6B5B4B); max-width: 52ch; }\n    #hero .j2-hero-cta { margin-top: 8px; border-radius: var(--j2-radius, 12px); }\n    #hero .j2-hero-cta:focus-visible { outline: 3px solid var(--j2-accent, #B8863B); outline-offset: 2px; }\n    @media (max-width: 480px) {\n      #hero { padding: 40px 16px; }\n      #hero .j2-hero-cta { width: 100%; }\n    }\n  </style>\n\n  <div class=\"j2-hero-inner\">\n    <p class=\"j2-hero-eyebrow\">Handloom boutique &middot; Pune</p>\n    <hr class=\"j2-hero-rule\" aria-hidden=\"true\">\n    <h1 id=\"hero-title\">Thread &amp; Loom</h1>\n    <p class=\"j2-hero-sub\">A handloom clothing boutique in Pune</p>\n    <p class=\"j2-hero-line\">Handloom kurtas, sarees, cotton shirts and dupattas.</p>\n    <a class=\"j2-btn j2-hero-cta\" href=\"#products\">Browse the collection</a>\n  </div>\n\n  <script>\n    (function () {\n      var hero = document.getElementById('hero');\n      if (hero && document.body && document.body.firstElementChild !== hero) {\n        document.body.insertBefore(hero, document.body.firstChild);\n      }\n    })();\n  </script>\n</header>",
    "workflow": "Shop name, Pune and single h1"
  },
  "W-5": {
    "owner": "W-5",
    "head": "",
    "body": "<!-- W-5: size and price filters. Moves itself under the category tabs in #products. -->\n<section id=\"filters\" class=\"j2-filters\" aria-labelledby=\"filters-title\">\n  <style>\n    #filters { box-sizing: border-box; width: 100%; max-width: 760px; margin: 0 auto 16px; padding: 16px; transform: none; }\n    #filters *, #filters *::before, #filters *::after { box-sizing: border-box; }\n    #filters.j2-card:hover { transform: none; box-shadow: 0 1px 3px rgba(46, 36, 24, 0.08); }\n    #filters .j2-filters-title { margin: 0 0 12px; font-family: var(--j2-font-heading, Georgia, serif); font-size: 1.35rem; font-weight: 600; color: var(--j2-text, #2E2418); }\n    #filters .j2-filters-form { display: grid; grid-template-columns: 1fr; gap: 12px; align-items: end; margin: 0; }\n    #filters .j2-field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }\n    #filters .j2-field label { font-size: 0.85rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--j2-secondary, #4F5D3A); }\n    #filters .j2-select { width: 100%; min-height: 44px; padding: 0 12px; border: 1.5px solid var(--j2-primary, #7A3E22); border-radius: var(--j2-radius, 12px); background: var(--j2-surface, #FFFFFF); color: var(--j2-text, #2E2418); font-family: var(--j2-font-body, system-ui, sans-serif); font-size: 1rem; }\n    #filters .j2-select:focus-visible { outline: 3px solid var(--j2-accent, #B8863B); outline-offset: 2px; }\n    #filters .j2-filters-reset { width: 100%; border-radius: var(--j2-radius, 12px); font-family: var(--j2-font-body, system-ui, sans-serif); font-size: 1rem; }\n    #filters .j2-filters-note { margin: 12px 0 0; font-size: 0.9rem; color: var(--j2-muted, #6B5B4B); }\n    #filters .j2-filters-empty { margin: 12px 0 0; font-weight: 600; color: var(--j2-primary, #7A3E22); }\n    #filters .j2-filters-empty[hidden] { display: none; }\n    #products .j2-product.j2-filtered-out { display: none; }\n    @media (min-width: 640px) {\n      #filters .j2-filters-form { grid-template-columns: 1fr 1fr auto; }\n      #filters .j2-filters-reset { width: auto; }\n    }\n  </style>\n\n  <h3 id=\"filters-title\" class=\"j2-filters-title\">Filter by size and price</h3>\n\n  <form class=\"j2-filters-form\" id=\"filters-form\" aria-label=\"Filter products by size and price\" novalidate>\n    <div class=\"j2-field\">\n      <label for=\"filter-size\">Size</label>\n      <select id=\"filter-size\" class=\"j2-select\" name=\"size\">\n        <option value=\"all\" selected>All sizes</option>\n        <option value=\"XS\">XS</option>\n        <option value=\"S\">S</option>\n        <option value=\"M\">M</option>\n        <option value=\"L\">L</option>\n        <option value=\"XL\">XL</option>\n        <option value=\"XXL\">XXL</option>\n      </select>\n    </div>\n    <div class=\"j2-field\">\n      <label for=\"filter-price\">Price</label>\n      <select id=\"filter-price\" class=\"j2-select\" name=\"price\">\n        <option value=\"all\" selected>All prices</option>\n        <option value=\"0-1499\">Under ₹1,500</option>\n        <option value=\"1500-2999\">₹1,500 to ₹2,999</option>\n        <option value=\"3000-999999\">₹3,000 and above</option>\n      </select>\n    </div>\n    <button type=\"button\" id=\"filters-reset\" class=\"j2-btn-secondary j2-filters-reset\">Reset filters</button>\n  </form>\n\n  <p class=\"j2-filters-note\">Sarees and dupattas are free size, so they show for every size.</p>\n  <p class=\"j2-filters-empty\" id=\"filters-empty\" role=\"status\" hidden>No products match these filters. Try another size or price range.</p>\n\n  <script>\n    (function () {\n      var panel = document.getElementById('filters');\n      var products = document.getElementById('products');\n      if (!panel || !products) return;\n\n      var count = document.getElementById('products-count');\n      var sizeSel = document.getElementById('filter-size');\n      var priceSel = document.getElementById('filter-price');\n      var resetBtn = document.getElementById('filters-reset');\n      var form = document.getElementById('filters-form');\n      var empty = document.getElementById('filters-empty');\n      var cards = products.querySelectorAll('.j2-product');\n      var tabs = products.querySelectorAll('.j2-tab');\n\n      panel.className = (panel.className + ' j2-card').replace(/^\\s+/, '');\n      if (count && count.parentNode === products) {\n        products.insertBefore(panel, count);\n      }\n\n      function sizeOk(card, size) {\n        if (size === 'all') return true;\n        var list = (card.getAttribute('data-sizes') || '').split(',');\n        for (var i = 0; i < list.length; i++) {\n          var s = list[i].replace(/\\s+/g, '').toUpperCase();\n          if (s === 'FREE' || s === size) return true;\n        }\n        return false;\n      }\n\n      function priceOk(card, range) {\n        if (range === 'all') return true;\n        var parts = range.split('-');\n        var lo = parseInt(parts[0], 10);\n        var hi = parseInt(parts[1], 10);\n        var price = parseInt(card.getAttribute('data-price'), 10);\n        if (isNaN(price)) return true;\n        return price >= lo && price <= hi;\n      }\n\n      function apply() {\n        var size = sizeSel.value;\n        var range = priceSel.value;\n        var visible = 0;\n        for (var i = 0; i < cards.length; i++) {\n          var pass = sizeOk(cards[i], size) && priceOk(cards[i], range);\n          cards[i].classList.toggle('j2-filtered-out', !pass);\n          if (pass && !cards[i].hidden) visible++;\n        }\n        if (count) count.textContent = 'Showing ' + visible + ' of ' + cards.length + ' products';\n        if (empty) empty.hidden = visible !== 0;\n      }\n\n      sizeSel.addEventListener('change', apply);\n      priceSel.addEventListener('change', apply);\n      form.addEventListener('submit', function (e) { e.preventDefault(); });\n      resetBtn.addEventListener('click', function () {\n        sizeSel.value = 'all';\n        priceSel.value = 'all';\n        apply();\n      });\n\n      /* Category tabs (W-1) set card.hidden first; recount afterwards so the filters stack on top. */\n      for (var t = 0; t < tabs.length; t++) {\n        tabs[t].addEventListener('click', apply);\n      }\n\n      apply();\n    })();\n  </script>\n</section>",
    "workflow": "Size and price filters"
  },
  "W-6": {
    "owner": "W-6",
    "head": "",
    "body": "<nav id=\"site-nav\" class=\"j2-sitenav\" aria-label=\"Page sections\">\n  <style>\n    #site-nav { box-sizing: border-box; width: 100%; max-width: 100%; padding: 8px 16px; background: var(--j2-surface, #FFFFFF); border-bottom: 1px solid #E6DAC6; }\n    #site-nav *, #site-nav *::before, #site-nav *::after { box-sizing: border-box; }\n    #site-nav ul { list-style: none; margin: 0 auto; padding: 0; max-width: 1200px; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }\n    #site-nav li { margin: 0; max-width: 100%; }\n    #site-nav li[hidden] { display: none; }\n    #site-nav a { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 44px; padding: 0 16px; border-radius: 999px; font-family: var(--j2-font-body, system-ui, sans-serif); font-size: 1rem; font-weight: 600; letter-spacing: 0.02em; color: var(--j2-primary, #7A3E22); text-decoration: none; }\n    #site-nav a:hover { background: var(--j2-primary, #7A3E22); color: var(--j2-surface, #FFFFFF); }\n    #site-nav a:focus-visible { outline: 3px solid var(--j2-accent, #B8863B); outline-offset: 2px; }\n    @media (max-width: 480px) {\n      #site-nav { padding: 4px 8px; }\n      #site-nav ul { gap: 4px; }\n      #site-nav a { padding: 0 12px; font-size: 0.95rem; }\n    }\n    @media (min-width: 1024px) {\n      #site-nav { padding: 8px 32px; }\n      #site-nav ul { gap: 16px; }\n    }\n  </style>\n\n  <ul>\n    <li><a href=\"#products\">Collection</a></li>\n    <li><a href=\"#filters\">Filters</a></li>\n    <li><a href=\"#hero\">Top</a></li>\n  </ul>\n\n  <script>\n    (function () {\n      var nav = document.getElementById('site-nav');\n      if (!nav) return;\n\n      /* Place the nav directly under the hero header. */\n      var hero = document.getElementById('hero');\n      if (hero && hero.parentNode) {\n        hero.parentNode.insertBefore(nav, hero.nextSibling);\n      }\n\n      /* Hide any in-page link whose target id is missing, so no link is ever broken. */\n      var links = nav.querySelectorAll('a[href^=\"#\"]');\n      for (var i = 0; i < links.length; i++) {\n        var id = links[i].getAttribute('href').slice(1);\n        if (!id || !document.getElementById(id)) {\n          var item = links[i].parentNode;\n          if (item) item.hidden = true;\n        }\n      }\n    })();\n  </script>\n</nav>",
    "workflow": "Responsive and link hygiene"
  }
}