{
  "style": {
    "owner": "W-1",
    "head": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&amp;family=Space+Grotesk:wght@500;700&amp;display=swap\"><style>:root{--j2-primary:#FF4F8B;--j2-secondary:#6C5CE7;--j2-accent:#FFD23F;--j2-background:#0F1020;--j2-surface:#1B1D3A;--j2-text:#F5F6FF;--j2-muted:#B8BCE0;--j2-font-heading:'Space Grotesk', 'Segoe UI', system-ui, sans-serif;--j2-font-body:'Inter', 'Segoe UI', system-ui, sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:16px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;background:#FF4F8B;color:#0F1020;border:2px solid #FF4F8B;min-height:48px;padding:12px 28px;border-radius:999px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;}.j2-btn-secondary{display:inline-block;background:transparent;color:#F5F6FF;border:2px solid #FFD23F;min-height:48px;padding:12px 28px;border-radius:999px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;}.j2-card{background:#1B1D3A;color:#F5F6FF;border:1px solid rgba(255,255,255,0.12);border-radius:16px;padding:24px;}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-1": {
    "owner": "W-1",
    "head": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>",
    "body": "<section id=\"j2-hero\" class=\"j2-hero\" data-section=\"j2-hero\" aria-labelledby=\"j2-hero-title\">\n  <style>\n    #j2-hero {\n      position: relative;\n      overflow: hidden;\n      box-sizing: border-box;\n      max-width: 100%;\n      padding: 48px 20px 64px;\n      background:\n        radial-gradient(circle at 15% 10%, rgba(255, 79, 139, 0.35), transparent 45%),\n        radial-gradient(circle at 90% 85%, rgba(108, 92, 231, 0.45), transparent 50%),\n        var(--j2-background, #0F1020);\n      color: var(--j2-text, #F5F6FF);\n    }\n    #j2-hero *, #j2-hero *::before, #j2-hero *::after { box-sizing: border-box; }\n    #j2-hero j2-hero {\n      display: block;\n      max-width: 100%;\n    }\n    #j2-hero .j2-hero-inner {\n      position: relative;\n      z-index: 1;\n      display: grid;\n      gap: 32px;\n      align-items: center;\n      max-width: 1120px;\n      margin: 0 auto;\n    }\n    #j2-hero .j2-hero-text { min-width: 0; }\n    #j2-hero .j2-hero-tag {\n      display: inline-block;\n      margin: 0 0 16px;\n      padding: 6px 14px;\n      border-radius: 999px;\n      background: var(--j2-accent, #FFD23F);\n      color: #0F1020;\n      font-weight: 700;\n      font-size: 0.875rem;\n      letter-spacing: 0.04em;\n      text-transform: uppercase;\n    }\n    #j2-hero h1 {\n      margin: 0 0 12px;\n      font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif);\n      font-size: clamp(2.75rem, 13vw, 5.5rem);\n      line-height: 1;\n      font-weight: 700;\n      letter-spacing: -0.02em;\n      overflow-wrap: anywhere;\n      background: linear-gradient(90deg, #FF4F8B, #FFD23F);\n      -webkit-background-clip: text;\n      background-clip: text;\n      -webkit-text-fill-color: transparent;\n      color: #FF4F8B;\n    }\n    #j2-hero .j2-hero-college {\n      margin: 0 0 8px;\n      font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif);\n      font-size: clamp(1.125rem, 4.5vw, 1.625rem);\n      font-weight: 500;\n      color: var(--j2-text, #F5F6FF);\n    }\n    #j2-hero .j2-hero-dates {\n      margin: 0 0 28px;\n      font-size: clamp(1.125rem, 4.5vw, 1.375rem);\n      font-weight: 600;\n      color: var(--j2-accent, #FFD23F);\n    }\n    #j2-hero .j2-hero-actions {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 12px;\n    }\n    #j2-hero .j2-hero-actions a {\n      max-width: 100%;\n      min-width: 44px;\n      min-height: 48px;\n      text-align: center;\n    }\n    #j2-hero .j2-photo-placeholder {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      width: 100%;\n      max-width: 100%;\n      aspect-ratio: 4 / 3;\n      border-radius: var(--j2-radius, 16px);\n      border: 2px dashed rgba(255, 210, 63, 0.6);\n      background: linear-gradient(135deg, rgba(108, 92, 231, 0.35), rgba(255, 79, 139, 0.25));\n      color: var(--j2-muted, #B8BCE0);\n      font-size: 0.9375rem;\n      text-align: center;\n      padding: 16px;\n    }\n    @media (min-width: 900px) {\n      #j2-hero { padding: 96px 32px 104px; }\n      #j2-hero .j2-hero-inner { grid-template-columns: 1.1fr 0.9fr; gap: 56px; }\n    }\n  </style>\n  <j2-hero>\n    <div class=\"j2-hero-inner\">\n      <div class=\"j2-hero-text\">\n        <p class=\"j2-hero-tag\">College tech fest</p>\n        <h1 id=\"j2-hero-title\">Spark 2026</h1>\n        <p class=\"j2-hero-college\">Northfield College of Engineering, Pune</p>\n        <p class=\"j2-hero-dates\">14 to 16 February 2027</p>\n        <div class=\"j2-hero-actions\">\n          <a class=\"j2-btn\" href=\"#j2-register\">Register for an event</a>\n          <a class=\"j2-btn j2-btn-secondary\" href=\"#j2-schedule\">See the schedule</a>\n        </div>\n      </div>\n      <div class=\"j2-photo-placeholder\" role=\"img\" aria-label=\"Photo placeholder for Spark 2026\">Photo coming soon</div>\n    </div>\n  </j2-hero>\n</section>",
    "workflow": "Hero and identity"
  },
  "W-2": {
    "owner": "W-2",
    "head": "",
    "body": "<section id=\"j2-schedule\" class=\"j2-schedule\" data-section=\"j2-schedule\" aria-labelledby=\"j2-schedule-title\">\n  <style>\n    #j2-schedule {\n      box-sizing: border-box;\n      max-width: 100%;\n      padding: var(--j2-section, 64px) 20px;\n      background: var(--j2-background, #0F1020);\n      color: var(--j2-text, #F5F6FF);\n    }\n    #j2-schedule *, #j2-schedule *::before, #j2-schedule *::after { box-sizing: border-box; }\n    #j2-schedule .j2-schedule-inner {\n      max-width: 1120px;\n      margin: 0 auto;\n    }\n    #j2-schedule h2 {\n      margin: 0 0 8px;\n      font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif);\n      font-size: clamp(2rem, 8vw, 3rem);\n      line-height: 1.1;\n      font-weight: 700;\n      color: var(--j2-text, #F5F6FF);\n    }\n    #j2-schedule .j2-schedule-intro {\n      margin: 0 0 32px;\n      color: var(--j2-muted, #B8BCE0);\n      font-size: 1.0625rem;\n      line-height: 1.5;\n    }\n    #j2-schedule .j2-days {\n      display: grid;\n      grid-template-columns: minmax(0, 1fr);\n      gap: 24px;\n    }\n    #j2-schedule .j2-day {\n      min-width: 0;\n      background: var(--j2-surface, #1B1D3A);\n      border: 1px solid rgba(255, 255, 255, 0.12);\n      border-top: 4px solid var(--j2-primary, #FF4F8B);\n      border-radius: var(--j2-radius, 16px);\n      padding: 24px;\n    }\n    #j2-schedule .j2-day:nth-child(2) { border-top-color: var(--j2-secondary, #6C5CE7); }\n    #j2-schedule .j2-day:nth-child(3) { border-top-color: var(--j2-accent, #FFD23F); }\n    #j2-schedule .j2-day h3 {\n      margin: 0 0 16px;\n      font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif);\n      font-size: 1.5rem;\n      font-weight: 700;\n      color: var(--j2-accent, #FFD23F);\n    }\n    #j2-schedule .j2-slots {\n      list-style: none;\n      margin: 0;\n      padding: 0;\n      display: grid;\n      gap: 12px;\n    }\n    #j2-schedule .j2-slot {\n      min-width: 0;\n      padding: 14px 16px;\n      border-radius: 12px;\n      background: rgba(255, 255, 255, 0.05);\n      border-left: 3px solid var(--j2-primary, #FF4F8B);\n    }\n    #j2-schedule .j2-slot-name {\n      display: block;\n      margin: 0 0 4px;\n      font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif);\n      font-size: 1.125rem;\n      font-weight: 700;\n      color: var(--j2-text, #F5F6FF);\n      overflow-wrap: anywhere;\n    }\n    #j2-schedule .j2-slot-time {\n      display: block;\n      font-size: 1rem;\n      font-weight: 500;\n      color: var(--j2-muted, #B8BCE0);\n    }\n    @media (min-width: 900px) {\n      #j2-schedule { padding: var(--j2-section, 64px) 32px; }\n      #j2-schedule .j2-days {\n        grid-template-columns: repeat(3, minmax(0, 1fr));\n        gap: 24px;\n      }\n    }\n  </style>\n  <div class=\"j2-schedule-inner\">\n    <h2 id=\"j2-schedule-title\">Schedule</h2>\n    <p class=\"j2-schedule-intro\">Three days, eight events. Plan your Spark 2026 day by day.</p>\n    <div class=\"j2-days\">\n      <article class=\"j2-day\" aria-labelledby=\"j2-day1-title\">\n        <h3 id=\"j2-day1-title\">Day 1</h3>\n        <ul class=\"j2-slots\">\n          <li class=\"j2-slot\">\n            <span class=\"j2-slot-name\">Code Sprint</span>\n            <span class=\"j2-slot-time\">10am to 1pm</span>\n          </li>\n          <li class=\"j2-slot\">\n            <span class=\"j2-slot-name\">Line Follower</span>\n            <span class=\"j2-slot-time\">2pm to 5pm</span>\n          </li>\n          <li class=\"j2-slot\">\n            <span class=\"j2-slot-name\">AI in Daily Life</span>\n            <span class=\"j2-slot-time\">5:30pm to 6:30pm</span>\n          </li>\n        </ul>\n      </article>\n      <article class=\"j2-day\" aria-labelledby=\"j2-day2-title\">\n        <h3 id=\"j2-day2-title\">Day 2</h3>\n        <ul class=\"j2-slots\">\n          <li class=\"j2-slot\">\n            <span class=\"j2-slot-name\">Bug Hunt</span>\n            <span class=\"j2-slot-time\">11am to 1pm</span>\n          </li>\n          <li class=\"j2-slot\">\n            <span class=\"j2-slot-name\">Poster Jam</span>\n            <span class=\"j2-slot-time\">2pm to 4pm</span>\n          </li>\n        </ul>\n      </article>\n      <article class=\"j2-day\" aria-labelledby=\"j2-day3-title\">\n        <h3 id=\"j2-day3-title\">Day 3</h3>\n        <ul class=\"j2-slots\">\n          <li class=\"j2-slot\">\n            <span class=\"j2-slot-name\">Drone Dash</span>\n            <span class=\"j2-slot-time\">10am to 1pm</span>\n          </li>\n          <li class=\"j2-slot\">\n            <span class=\"j2-slot-name\">UI Duel</span>\n            <span class=\"j2-slot-time\">2pm to 5pm</span>\n          </li>\n          <li class=\"j2-slot\">\n            <span class=\"j2-slot-name\">Startup Stories</span>\n            <span class=\"j2-slot-time\">5:30pm to 6:30pm</span>\n          </li>\n        </ul>\n      </article>\n    </div>\n  </div>\n</section>",
    "workflow": "Day-by-day schedule"
  },
  "W-5": {
    "owner": "W-5",
    "head": "",
    "body": "<section id=\"j2-sponsors\" class=\"j2-sponsors\" data-section=\"j2-sponsors\" aria-labelledby=\"j2-sponsors-title\">\n  <style>\n    #j2-sponsors {\n      box-sizing: border-box;\n      max-width: 100%;\n      padding: var(--j2-section, 64px) 20px;\n      background: var(--j2-background, #0F1020);\n      color: var(--j2-text, #F5F6FF);\n    }\n    #j2-sponsors *, #j2-sponsors *::before, #j2-sponsors *::after { box-sizing: border-box; }\n    #j2-sponsors .j2-sponsors-inner {\n      max-width: 1120px;\n      margin: 0 auto;\n    }\n    #j2-sponsors h2 {\n      margin: 0 0 8px;\n      font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif);\n      font-size: clamp(2rem, 8vw, 3rem);\n      line-height: 1.1;\n      font-weight: 700;\n      color: var(--j2-text, #F5F6FF);\n    }\n    #j2-sponsors .j2-sponsors-intro {\n      margin: 0 0 32px;\n      color: var(--j2-muted, #B8BCE0);\n      font-size: 1.0625rem;\n      line-height: 1.5;\n    }\n    #j2-sponsors .j2-sponsor-list {\n      list-style: none;\n      margin: 0;\n      padding: 0;\n      display: grid;\n      grid-template-columns: minmax(0, 1fr);\n      gap: 16px;\n    }\n    #j2-sponsors .j2-sponsor {\n      min-width: 0;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      min-height: 96px;\n      padding: 24px;\n      text-align: center;\n      background: var(--j2-surface, #1B1D3A);\n      border: 1px solid rgba(255, 255, 255, 0.12);\n      border-bottom: 4px solid var(--j2-primary, #FF4F8B);\n      border-radius: var(--j2-radius, 16px);\n      font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif);\n      font-size: 1.375rem;\n      font-weight: 700;\n      color: var(--j2-text, #F5F6FF);\n      overflow-wrap: anywhere;\n    }\n    #j2-sponsors .j2-sponsor:nth-child(2) { border-bottom-color: var(--j2-secondary, #6C5CE7); }\n    #j2-sponsors .j2-sponsor:nth-child(3) { border-bottom-color: var(--j2-accent, #FFD23F); }\n    @media (min-width: 900px) {\n      #j2-sponsors { padding: var(--j2-section, 64px) 32px; }\n      #j2-sponsors .j2-sponsor-list {\n        grid-template-columns: repeat(3, minmax(0, 1fr));\n        gap: 24px;\n      }\n    }\n  </style>\n  <div class=\"j2-sponsors-inner\">\n    <h2 id=\"j2-sponsors-title\">Sponsors</h2>\n    <p class=\"j2-sponsors-intro\">Spark 2026 is supported by these sponsors.</p>\n    <ul class=\"j2-sponsor-list\">\n      <li class=\"j2-sponsor\">Nimbus Cloud</li>\n      <li class=\"j2-sponsor\">Orbit Labs</li>\n      <li class=\"j2-sponsor\">Pixel Press</li>\n    </ul>\n  </div>\n</section>",
    "workflow": "Sponsors"
  },
  "W-9": {
    "owner": "W-9",
    "head": "",
    "body": "<section id=\"j2-events\" class=\"j2-events\" data-section=\"j2-events\" aria-labelledby=\"j2-events-title\">\n  <style>\n    #j2-events {\n      box-sizing: border-box;\n      max-width: 100%;\n      padding: var(--j2-section, 64px) 20px;\n      background: var(--j2-background, #0F1020);\n      color: var(--j2-text, #F5F6FF);\n    }\n    #j2-events *, #j2-events *::before, #j2-events *::after { box-sizing: border-box; }\n    #j2-events .j2-events-inner { max-width: 1120px; margin: 0 auto; }\n    #j2-events h2 {\n      margin: 0 0 8px;\n      font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif);\n      font-size: clamp(2rem, 8vw, 3rem);\n      line-height: 1.1;\n      font-weight: 700;\n      color: var(--j2-text, #F5F6FF);\n    }\n    #j2-events .j2-events-intro {\n      margin: 0 0 24px;\n      color: var(--j2-muted, #B8BCE0);\n      font-size: 1.0625rem;\n      line-height: 1.5;\n    }\n    #j2-events .j2-filter-bar {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 12px;\n      margin: 0 0 16px;\n    }\n    #j2-events .j2-filter-bar button {\n      min-width: 44px;\n      min-height: 48px;\n      padding: 10px 22px;\n      border-radius: 999px;\n      border: 2px solid var(--j2-accent, #FFD23F);\n      background: transparent;\n      color: var(--j2-text, #F5F6FF);\n      font-family: var(--j2-font-body, 'Inter', system-ui, sans-serif);\n      font-size: 1rem;\n      font-weight: 600;\n      cursor: pointer;\n    }\n    #j2-events .j2-filter-bar button[aria-pressed=\"true\"] {\n      background: var(--j2-primary, #FF4F8B);\n      border-color: var(--j2-primary, #FF4F8B);\n      color: #0F1020;\n      font-weight: 700;\n    }\n    #j2-events .j2-filter-bar button:focus-visible {\n      outline: 3px solid var(--j2-text, #F5F6FF);\n      outline-offset: 2px;\n    }\n    #j2-events .j2-events-status {\n      margin: 0 0 24px;\n      color: var(--j2-muted, #B8BCE0);\n      font-size: 0.9375rem;\n    }\n    #j2-events .j2-events-grid {\n      display: grid;\n      grid-template-columns: minmax(0, 1fr);\n      gap: 20px;\n    }\n    #j2-events .j2-card {\n      min-width: 0;\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n      background: var(--j2-surface, #1B1D3A);\n      color: var(--j2-text, #F5F6FF);\n      border: 1px solid rgba(255, 255, 255, 0.12);\n      border-top: 4px solid var(--j2-primary, #FF4F8B);\n      border-radius: var(--j2-radius, 16px);\n      padding: 24px;\n    }\n    #j2-events .j2-card[data-category=\"Robotics\"] { border-top-color: var(--j2-secondary, #6C5CE7); }\n    #j2-events .j2-card[data-category=\"Design\"] { border-top-color: var(--j2-accent, #FFD23F); }\n    #j2-events .j2-card[data-category=\"Talks\"] { border-top-color: var(--j2-muted, #B8BCE0); }\n    #j2-events .j2-card[hidden] { display: none; }\n    #j2-events .j2-card-cat {\n      margin: 0;\n      color: var(--j2-muted, #B8BCE0);\n      font-size: 0.875rem;\n      font-weight: 600;\n      letter-spacing: 0.06em;\n      text-transform: uppercase;\n    }\n    #j2-events .j2-card h3 {\n      margin: 0;\n      font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif);\n      font-size: 1.375rem;\n      font-weight: 700;\n      color: var(--j2-text, #F5F6FF);\n      overflow-wrap: anywhere;\n    }\n    #j2-events .j2-card-when {\n      margin: 0;\n      color: var(--j2-muted, #B8BCE0);\n      font-size: 1rem;\n    }\n    #j2-events .j2-card-price {\n      margin: 8px 0 0;\n      font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif);\n      font-size: 1.5rem;\n      font-weight: 700;\n      color: var(--j2-accent, #FFD23F);\n    }\n    #j2-events .j2-events-cta { margin: 32px 0 0; }\n    #j2-events .j2-events-cta a { max-width: 100%; min-height: 48px; text-align: center; }\n    @media (min-width: 640px) {\n      #j2-events .j2-events-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n    }\n    @media (min-width: 900px) {\n      #j2-events { padding: var(--j2-section, 64px) 32px; }\n      #j2-events .j2-events-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }\n    }\n  </style>\n  <div class=\"j2-events-inner\">\n    <h2 id=\"j2-events-title\">Events</h2>\n    <p class=\"j2-events-intro\">Pick a category to see what is on and what it costs.</p>\n    <div class=\"j2-filter-bar\" role=\"group\" aria-label=\"Filter events by category\">\n      <button type=\"button\" class=\"j2-filter-all\" data-filter=\"all\" aria-pressed=\"true\">All</button>\n      <button type=\"button\" class=\"j2-filter\" data-filter=\"Coding\" aria-pressed=\"false\">Coding</button>\n      <button type=\"button\" class=\"j2-filter\" data-filter=\"Robotics\" aria-pressed=\"false\">Robotics</button>\n      <button type=\"button\" class=\"j2-filter\" data-filter=\"Design\" aria-pressed=\"false\">Design</button>\n      <button type=\"button\" class=\"j2-filter\" data-filter=\"Talks\" aria-pressed=\"false\">Talks</button>\n    </div>\n    <p class=\"j2-events-status\" id=\"j2-events-status\" role=\"status\" aria-live=\"polite\">Showing all 8 events</p>\n    <div class=\"j2-events-grid\">\n      <article class=\"j2-card\" data-category=\"Coding\">\n        <p class=\"j2-card-cat\">Coding</p>\n        <h3>Code Sprint</h3>\n        <p class=\"j2-card-when\">Day 1, 10am to 1pm</p>\n        <p class=\"j2-card-price\">Rs 100</p>\n      </article>\n      <article class=\"j2-card\" data-category=\"Coding\">\n        <p class=\"j2-card-cat\">Coding</p>\n        <h3>Bug Hunt</h3>\n        <p class=\"j2-card-when\">Day 2, 11am to 1pm</p>\n        <p class=\"j2-card-price\">Rs 50</p>\n      </article>\n      <article class=\"j2-card\" data-category=\"Robotics\">\n        <p class=\"j2-card-cat\">Robotics</p>\n        <h3>Line Follower</h3>\n        <p class=\"j2-card-when\">Day 1, 2pm to 5pm</p>\n        <p class=\"j2-card-price\">Rs 150</p>\n      </article>\n      <article class=\"j2-card\" data-category=\"Robotics\">\n        <p class=\"j2-card-cat\">Robotics</p>\n        <h3>Drone Dash</h3>\n        <p class=\"j2-card-when\">Day 3, 10am to 1pm</p>\n        <p class=\"j2-card-price\">Rs 200</p>\n      </article>\n      <article class=\"j2-card\" data-category=\"Design\">\n        <p class=\"j2-card-cat\">Design</p>\n        <h3>Poster Jam</h3>\n        <p class=\"j2-card-when\">Day 2, 2pm to 4pm</p>\n        <p class=\"j2-card-price\">free</p>\n      </article>\n      <article class=\"j2-card\" data-category=\"Design\">\n        <p class=\"j2-card-cat\">Design</p>\n        <h3>UI Duel</h3>\n        <p class=\"j2-card-when\">Day 3, 2pm to 5pm</p>\n        <p class=\"j2-card-price\">Rs 100</p>\n      </article>\n      <article class=\"j2-card\" data-category=\"Talks\">\n        <p class=\"j2-card-cat\">Talks</p>\n        <h3>AI in Daily Life</h3>\n        <p class=\"j2-card-when\">Day 1, 5:30pm to 6:30pm</p>\n        <p class=\"j2-card-price\">free</p>\n      </article>\n      <article class=\"j2-card\" data-category=\"Talks\">\n        <p class=\"j2-card-cat\">Talks</p>\n        <h3>Startup Stories</h3>\n        <p class=\"j2-card-when\">Day 3, 5:30pm to 6:30pm</p>\n        <p class=\"j2-card-price\">free</p>\n      </article>\n    </div>\n    <p class=\"j2-events-cta\">\n      <a class=\"j2-btn\" href=\"#j2-register\">Register for an event</a>\n    </p>\n  </div>\n  <script>\n    (function () {\n      var root = document.getElementById('j2-events');\n      if (!root) return;\n      var buttons = root.querySelectorAll('.j2-filter-bar button');\n      var cards = root.querySelectorAll('.j2-card');\n      var status = document.getElementById('j2-events-status');\n      function apply(filter) {\n        var shown = 0;\n        for (var i = 0; i < cards.length; i++) {\n          var match = filter === 'all' || cards[i].getAttribute('data-category') === filter;\n          if (match) { cards[i].removeAttribute('hidden'); shown++; }\n          else { cards[i].setAttribute('hidden', ''); }\n        }\n        for (var j = 0; j < buttons.length; j++) {\n          buttons[j].setAttribute('aria-pressed', buttons[j].getAttribute('data-filter') === filter ? 'true' : 'false');\n        }\n        if (status) {\n          status.textContent = filter === 'all'\n            ? 'Showing all ' + shown + ' events'\n            : 'Showing ' + shown + ' ' + filter + ' events';\n        }\n      }\n      for (var k = 0; k < buttons.length; k++) {\n        buttons[k].addEventListener('click', function () {\n          apply(this.getAttribute('data-filter'));\n        });\n      }\n      apply('all');\n    })();\n  </script>\n</section>",
    "workflow": "Events by category with prices"
  },
  "W-10": {
    "owner": "W-10",
    "head": "",
    "body": "<section id=\"j2-register\" class=\"j2-register\" data-section=\"j2-register\" aria-labelledby=\"j2-register-title\">\n  <style>\n    #j2-register {\n      box-sizing: border-box;\n      max-width: 100%;\n      padding: var(--j2-section, 64px) 20px;\n      background: var(--j2-background, #0F1020);\n      color: var(--j2-text, #F5F6FF);\n    }\n    #j2-register *, #j2-register *::before, #j2-register *::after { box-sizing: border-box; }\n    #j2-register .j2-register-inner { max-width: 640px; margin: 0 auto; }\n    #j2-register h2 {\n      margin: 0 0 8px;\n      font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif);\n      font-size: clamp(2rem, 8vw, 3rem);\n      line-height: 1.1;\n      font-weight: 700;\n      color: var(--j2-text, #F5F6FF);\n    }\n    #j2-register .j2-register-intro {\n      margin: 0 0 24px;\n      color: var(--j2-muted, #B8BCE0);\n      font-size: 1.0625rem;\n      line-height: 1.5;\n    }\n    #j2-register .j2-form {\n      display: grid;\n      grid-template-columns: minmax(0, 1fr);\n      gap: 20px;\n      padding: 24px;\n      background: var(--j2-surface, #1B1D3A);\n      border: 1px solid rgba(255, 255, 255, 0.12);\n      border-top: 4px solid var(--j2-primary, #FF4F8B);\n      border-radius: var(--j2-radius, 16px);\n    }\n    #j2-register .j2-field { display: grid; gap: 8px; min-width: 0; }\n    #j2-register label {\n      font-weight: 600;\n      font-size: 1rem;\n      color: var(--j2-text, #F5F6FF);\n    }\n    #j2-register input,\n    #j2-register select {\n      display: block;\n      width: 100%;\n      max-width: 100%;\n      min-height: 48px;\n      padding: 10px 14px;\n      border-radius: 12px;\n      border: 2px solid var(--j2-muted, #B8BCE0);\n      background: var(--j2-background, #0F1020);\n      color: var(--j2-text, #F5F6FF);\n      font-family: var(--j2-font-body, 'Inter', system-ui, sans-serif);\n      font-size: 1rem;\n    }\n    #j2-register input:focus-visible,\n    #j2-register select:focus-visible,\n    #j2-register button:focus-visible {\n      outline: 3px solid var(--j2-accent, #FFD23F);\n      outline-offset: 2px;\n    }\n    #j2-register input:focus,\n    #j2-register select:focus { border-color: var(--j2-accent, #FFD23F); }\n    #j2-register button.j2-btn {\n      width: 100%;\n      max-width: 100%;\n      min-height: 48px;\n      cursor: pointer;\n      font-family: var(--j2-font-body, 'Inter', system-ui, sans-serif);\n      font-size: 1.0625rem;\n    }\n    #j2-register .j2-register-note {\n      margin: 0;\n      color: var(--j2-muted, #B8BCE0);\n      font-size: 0.9375rem;\n      line-height: 1.5;\n      overflow-wrap: anywhere;\n    }\n    #j2-register .j2-register-status {\n      margin: 0;\n      padding: 14px 16px;\n      border-radius: 12px;\n      border-left: 4px solid var(--j2-accent, #FFD23F);\n      background: rgba(255, 255, 255, 0.05);\n      color: var(--j2-text, #F5F6FF);\n      font-size: 1rem;\n      line-height: 1.5;\n    }\n    #j2-register .j2-register-status[hidden] { display: none; }\n    @media (min-width: 900px) {\n      #j2-register { padding: var(--j2-section, 64px) 32px; }\n      #j2-register .j2-form { padding: 32px; }\n      #j2-register button.j2-btn { width: auto; justify-self: start; }\n    }\n  </style>\n  <div class=\"j2-register-inner\">\n    <h2 id=\"j2-register-title\">Register for an event</h2>\n    <p class=\"j2-register-intro\">Fill in your details and pick an event. One form per event.</p>\n    <form class=\"j2-form\" id=\"j2-register-form\" action=\"mailto:spark2026@example.com\" method=\"post\" enctype=\"text/plain\">\n      <div class=\"j2-field\">\n        <label for=\"j2-reg-name\">Name</label>\n        <input type=\"text\" id=\"j2-reg-name\" name=\"name\" autocomplete=\"name\" required>\n      </div>\n      <div class=\"j2-field\">\n        <label for=\"j2-reg-email\">Email</label>\n        <input type=\"email\" id=\"j2-reg-email\" name=\"email\" autocomplete=\"email\" required>\n      </div>\n      <div class=\"j2-field\">\n        <label for=\"j2-reg-college\">College</label>\n        <input type=\"text\" id=\"j2-reg-college\" name=\"college\" autocomplete=\"organization\" required>\n      </div>\n      <div class=\"j2-field\">\n        <label for=\"j2-reg-event\">Event</label>\n        <select id=\"j2-reg-event\" name=\"event\" required>\n          <option value=\"\" selected disabled>Choose an event</option>\n          <option class=\"j2-event-option\" value=\"Code Sprint\">Code Sprint</option>\n          <option class=\"j2-event-option\" value=\"Bug Hunt\">Bug Hunt</option>\n          <option class=\"j2-event-option\" value=\"Line Follower\">Line Follower</option>\n          <option class=\"j2-event-option\" value=\"Drone Dash\">Drone Dash</option>\n          <option class=\"j2-event-option\" value=\"Poster Jam\">Poster Jam</option>\n          <option class=\"j2-event-option\" value=\"UI Duel\">UI Duel</option>\n          <option class=\"j2-event-option\" value=\"AI in Daily Life\">AI in Daily Life</option>\n          <option class=\"j2-event-option\" value=\"Startup Stories\">Startup Stories</option>\n        </select>\n      </div>\n      <button type=\"submit\" class=\"j2-btn\">Send registration</button>\n      <p class=\"j2-register-note\">Your details are sent by email to spark2026@example.com.</p>\n      <p class=\"j2-register-status\" id=\"j2-register-status\" role=\"status\" aria-live=\"polite\" hidden></p>\n    </form>\n  </div>\n  <script>\n    (function () {\n      var form = document.getElementById('j2-register-form');\n      var status = document.getElementById('j2-register-status');\n      if (!form) return;\n      form.addEventListener('submit', function (e) {\n        e.preventDefault();\n        var name = form.elements['name'].value.trim();\n        var email = form.elements['email'].value.trim();\n        var college = form.elements['college'].value.trim();\n        var eventName = form.elements['event'].value;\n        var subject = 'Spark 2026 registration: ' + eventName;\n        var body = 'Name: ' + name + '\\r\\n' +\n                   'Email: ' + email + '\\r\\n' +\n                   'College: ' + college + '\\r\\n' +\n                   'Event: ' + eventName + '\\r\\n';\n        var url = 'mailto:spark2026@example.com' +\n                  '?subject=' + encodeURIComponent(subject) +\n                  '&body=' + encodeURIComponent(body);\n        if (status) {\n          status.textContent = 'Thanks ' + name + '. Your email app should open with your details for ' +\n            eventName + '. Press send in that email to finish registering.';\n          status.removeAttribute('hidden');\n        }\n        window.location.href = url;\n      });\n    })();\n  </script>\n</section>",
    "workflow": "Registration form"
  },
  "W-11": {
    "owner": "W-11",
    "head": "",
    "body": "<section id=\"j2-venue\" class=\"j2-venue\" data-section=\"j2-venue\" aria-labelledby=\"j2-venue-title\">\n  <style>\n    #j2-venue {\n      box-sizing: border-box;\n      max-width: 100%;\n      padding: var(--j2-section, 64px) 20px;\n      background: var(--j2-background, #0F1020);\n      color: var(--j2-text, #F5F6FF);\n    }\n    #j2-venue *, #j2-venue *::before, #j2-venue *::after { box-sizing: border-box; }\n    #j2-venue .j2-venue-inner { max-width: 1120px; margin: 0 auto; }\n    #j2-venue h2 {\n      margin: 0 0 8px;\n      font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif);\n      font-size: clamp(2rem, 8vw, 3rem);\n      line-height: 1.1;\n      font-weight: 700;\n      color: var(--j2-text, #F5F6FF);\n    }\n    #j2-venue .j2-venue-intro {\n      margin: 0 0 32px;\n      color: var(--j2-muted, #B8BCE0);\n      font-size: 1.0625rem;\n      line-height: 1.5;\n    }\n    #j2-venue .j2-venue-panel {\n      display: grid;\n      grid-template-columns: minmax(0, 1fr);\n      gap: 20px;\n      padding: 24px;\n      background: var(--j2-surface, #1B1D3A);\n      border: 1px solid rgba(255, 255, 255, 0.12);\n      border-top: 4px solid var(--j2-secondary, #6C5CE7);\n      border-radius: var(--j2-radius, 16px);\n    }\n    #j2-venue .j2-venue-name {\n      margin: 0;\n      font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif);\n      font-size: 1.5rem;\n      font-weight: 700;\n      line-height: 1.2;\n      color: var(--j2-accent, #FFD23F);\n      overflow-wrap: anywhere;\n    }\n    #j2-venue address {\n      margin: 0;\n      font-style: normal;\n      font-size: 1.125rem;\n      line-height: 1.5;\n      color: var(--j2-text, #F5F6FF);\n      overflow-wrap: anywhere;\n    }\n    #j2-venue .j2-venue-actions { margin: 0; }\n    #j2-venue .j2-map-link {\n      max-width: 100%;\n      min-width: 44px;\n      min-height: 48px;\n      text-align: center;\n    }\n    #j2-venue .j2-map-link:focus-visible {\n      outline: 3px solid var(--j2-accent, #FFD23F);\n      outline-offset: 2px;\n    }\n    @media (min-width: 900px) {\n      #j2-venue { padding: var(--j2-section, 64px) 32px; }\n      #j2-venue .j2-venue-panel { padding: 32px; gap: 24px; }\n    }\n  </style>\n  <div class=\"j2-venue-inner\">\n    <h2 id=\"j2-venue-title\">Venue</h2>\n    <p class=\"j2-venue-intro\">Spark 2026 takes place at our campus in Pune.</p>\n    <div class=\"j2-venue-panel\">\n      <p class=\"j2-venue-name\">Northfield College of Engineering</p>\n      <address>22 University Road, Pune 411007</address>\n      <p class=\"j2-venue-actions\">\n        <a class=\"j2-map-link j2-btn\" href=\"https://www.google.com/maps/search/?api=1&amp;query=Northfield+College+of+Engineering%2C+22+University+Road%2C+Pune+411007\" target=\"_blank\" rel=\"noopener noreferrer\">Open in maps</a>\n      </p>\n    </div>\n  </div>\n</section>",
    "workflow": "Venue"
  },
  "W-12": {
    "owner": "W-12",
    "head": "",
    "body": "<section id=\"j2-contact\" class=\"j2-contact\" data-section=\"j2-contact\" aria-labelledby=\"j2-contact-title\">\n  <style>\n    #j2-contact {\n      box-sizing: border-box;\n      max-width: 100%;\n      padding: var(--j2-section, 64px) 20px;\n      background: var(--j2-background, #0F1020);\n      color: var(--j2-text, #F5F6FF);\n    }\n    #j2-contact *, #j2-contact *::before, #j2-contact *::after { box-sizing: border-box; }\n    #j2-contact .j2-contact-inner { max-width: 1120px; margin: 0 auto; }\n    #j2-contact h2 {\n      margin: 0 0 8px;\n      font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif);\n      font-size: clamp(2rem, 8vw, 3rem);\n      line-height: 1.1;\n      font-weight: 700;\n      color: var(--j2-text, #F5F6FF);\n    }\n    #j2-contact .j2-contact-intro {\n      margin: 0 0 32px;\n      color: var(--j2-muted, #B8BCE0);\n      font-size: 1.0625rem;\n      line-height: 1.5;\n    }\n    #j2-contact .j2-contact-panel {\n      display: grid;\n      grid-template-columns: minmax(0, 1fr);\n      gap: 20px;\n      padding: 24px;\n      background: var(--j2-surface, #1B1D3A);\n      border: 1px solid rgba(255, 255, 255, 0.12);\n      border-top: 4px solid var(--j2-accent, #FFD23F);\n      border-radius: var(--j2-radius, 16px);\n    }\n    #j2-contact .j2-contact-number {\n      margin: 0;\n      font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif);\n      font-size: 1.5rem;\n      font-weight: 700;\n      line-height: 1.2;\n      color: var(--j2-accent, #FFD23F);\n      overflow-wrap: anywhere;\n    }\n    #j2-contact .j2-contact-label {\n      display: block;\n      margin: 0 0 4px;\n      color: var(--j2-muted, #B8BCE0);\n      font-family: var(--j2-font-body, 'Inter', system-ui, sans-serif);\n      font-size: 0.875rem;\n      font-weight: 600;\n      letter-spacing: 0.06em;\n      text-transform: uppercase;\n    }\n    #j2-contact .j2-contact-actions {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 12px;\n      margin: 0;\n    }\n    #j2-contact .j2-contact-actions a {\n      max-width: 100%;\n      min-width: 44px;\n      min-height: 48px;\n      text-align: center;\n      overflow-wrap: anywhere;\n    }\n    #j2-contact .j2-contact-actions a:focus-visible {\n      outline: 3px solid var(--j2-text, #F5F6FF);\n      outline-offset: 2px;\n    }\n    @media (min-width: 900px) {\n      #j2-contact { padding: var(--j2-section, 64px) 32px; }\n      #j2-contact .j2-contact-panel { padding: 32px; gap: 24px; }\n    }\n  </style>\n  <div class=\"j2-contact-inner\">\n    <h2 id=\"j2-contact-title\">Contact the organisers</h2>\n    <p class=\"j2-contact-intro\">Questions about Spark 2026? Message the organisers on WhatsApp or send an email.</p>\n    <div class=\"j2-contact-panel\">\n      <p class=\"j2-contact-number\"><span class=\"j2-contact-label\">WhatsApp number</span>+91 00000 33333</p>\n      <p class=\"j2-contact-actions\">\n        <a class=\"j2-whatsapp j2-btn\" href=\"https://wa.me/910000033333\" target=\"_blank\" rel=\"noopener noreferrer\">Chat on WhatsApp</a>\n        <a class=\"j2-btn j2-btn-secondary\" href=\"mailto:spark2026@example.com\">spark2026@example.com</a>\n      </p>\n    </div>\n  </div>\n</section>",
    "workflow": "Contact on WhatsApp"
  },
  "W-13": {
    "owner": "W-13",
    "head": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
    "body": "<section id=\"j2-base\" class=\"j2-base\" data-section=\"j2-base\">\n  <style>\n    :root { --j2-nav-h: 56px; }\n    *, *::before, *::after { box-sizing: border-box; }\n    html {\n      max-width: 100%;\n      overflow-x: hidden;\n      scroll-padding-top: calc(var(--j2-nav-h) + 8px);\n      -webkit-text-size-adjust: 100%;\n    }\n    @media (prefers-reduced-motion: no-preference) {\n      html { scroll-behavior: smooth; }\n    }\n    body {\n      max-width: 100%;\n      overflow-x: hidden;\n      padding-top: var(--j2-nav-h);\n      line-height: 1.5;\n    }\n    img, svg, video, iframe { max-width: 100%; height: auto; }\n    h1, h2, h3, h4, p, li, address, a { overflow-wrap: anywhere; }\n    a { color: var(--j2-accent); }\n    .j2-btn, .j2-btn-secondary { max-width: 100%; cursor: pointer; text-align: center; }\n    .j2-btn { transition: transform 0.15s ease, box-shadow 0.15s ease; }\n    .j2-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(108, 92, 231, 0.45); }\n    .j2-btn-secondary:hover { background: var(--j2-surface); }\n    .j2-btn:focus-visible, .j2-btn-secondary:focus-visible {\n      outline: 3px solid var(--j2-text);\n      outline-offset: 2px;\n    }\n    .j2-card { min-width: 0; max-width: 100%; }\n    @media (prefers-reduced-motion: reduce) {\n      .j2-btn { transition: none; }\n      .j2-btn:hover { transform: none; }\n    }\n\n    #j2-nav {\n      position: fixed;\n      top: 0;\n      left: 0;\n      right: 0;\n      z-index: 1000;\n      height: var(--j2-nav-h);\n      max-width: 100%;\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      padding: 0 8px 0 12px;\n      background: var(--j2-background);\n      color: var(--j2-text);\n    }\n    #j2-nav::after {\n      content: \"\";\n      position: absolute;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      height: 3px;\n      background: linear-gradient(90deg, var(--j2-primary), var(--j2-secondary), var(--j2-accent));\n    }\n    #j2-nav .j2-nav-brand {\n      flex: 0 0 auto;\n      display: inline-flex;\n      align-items: center;\n      min-height: 48px;\n      min-width: 44px;\n      padding: 0 8px;\n      font-family: var(--j2-font-heading);\n      font-size: 1.125rem;\n      font-weight: 700;\n      color: var(--j2-primary);\n      text-decoration: none;\n      white-space: nowrap;\n    }\n    #j2-nav .j2-nav-list {\n      flex: 1 1 auto;\n      min-width: 0;\n      display: flex;\n      flex-wrap: nowrap;\n      align-items: center;\n      gap: 4px;\n      margin: 0;\n      padding: 0;\n      list-style: none;\n      overflow-x: auto;\n      overflow-y: hidden;\n      -webkit-overflow-scrolling: touch;\n      scrollbar-width: none;\n    }\n    #j2-nav .j2-nav-list::-webkit-scrollbar { display: none; }\n    #j2-nav .j2-nav-list li { flex: 0 0 auto; }\n    #j2-nav .j2-nav-list a {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      min-height: 48px;\n      min-width: 44px;\n      padding: 0 14px;\n      border-radius: 999px;\n      font-family: var(--j2-font-body);\n      font-size: 0.9375rem;\n      font-weight: 600;\n      color: var(--j2-text);\n      text-decoration: none;\n      white-space: nowrap;\n    }\n    #j2-nav .j2-nav-list a:hover { background: var(--j2-surface); color: var(--j2-accent); }\n    #j2-nav a:focus-visible {\n      outline: 3px solid var(--j2-accent);\n      outline-offset: -3px;\n    }\n    @media (min-width: 900px) {\n      #j2-nav { padding: 0 32px; gap: 24px; }\n      #j2-nav .j2-nav-brand { font-size: 1.375rem; }\n      #j2-nav .j2-nav-list { justify-content: flex-end; gap: 8px; }\n      #j2-nav .j2-nav-list a { font-size: 1rem; padding: 0 16px; }\n    }\n  </style>\n  <nav id=\"j2-nav\" aria-label=\"Main\">\n    <a class=\"j2-nav-brand\" href=\"#j2-hero\">Spark 2026</a>\n    <ul class=\"j2-nav-list\">\n      <li><a href=\"#j2-schedule\">Schedule</a></li>\n      <li><a href=\"#j2-events\">Events</a></li>\n      <li><a href=\"#j2-register\">Register</a></li>\n      <li><a href=\"#j2-sponsors\">Sponsors</a></li>\n      <li><a href=\"#j2-venue\">Venue</a></li>\n      <li><a href=\"#j2-contact\">Contact</a></li>\n    </ul>\n  </nav>\n</section>",
    "workflow": "Base style, nav and responsiveness"
  }
}