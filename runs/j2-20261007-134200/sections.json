    "body": "<section id=\"loyalty\" class=\"bl-section bl-loyalty\" aria-labelledby=\"loyalty-title\">\n  <div class=\"wrap\">\n    <h2 id=\"loyalty-title\">Loyalty card</h2>\n    <p class=\"bl-loyalty-intro\">Your 10th stamp gives one free drink of any size.</p>\n\n    <ol class=\"bl-stamps\" aria-label=\"Loyalty card with 10 stamps, the 10th stamp is a free drink\">\n      <li class=\"bl-stamp\"><span>1</span></li>\n      <li class=\"bl-stamp\"><span>2</span></li>\n      <li class=\"bl-stamp\"><span>3</span></li>\n      <li class=\"bl-stamp\"><span>4</span></li>\n      <li class=\"bl-stamp\"><span>5</span></li>\n      <li class=\"bl-stamp\"><span>6</span></li>\n      <li class=\"bl-stamp\"><span>7</span></li>\n      <li class=\"bl-stamp\"><span>8</span></li>\n      <li class=\"bl-stamp\"><span>9</span></li>\n      <li class=\"bl-stamp bl-stamp-free\" aria-label=\"Stamp 10: FREE drink\"><span>FREE</span></li>\n    </ol>\n\n    <p class=\"bl-loyalty-note\">Stamp 10 is FREE: one drink of any size.</p>\n  </div>\n\n  <style>\n    .bl-loyalty-intro { color: var(--bl-muted); }\n    .bl-loyalty .bl-stamps {\n      list-style: none;\n      margin: 0 0 1rem;\n      padding: 1rem;\n      display: grid;\n      grid-template-columns: repeat(5, minmax(0, 1fr));\n      gap: .5rem;\n      max-width: 36rem;\n      background: var(--bl-surface);\n      border: 1px solid var(--bl-line);\n      border-radius: var(--bl-radius);\n    }\n    .bl-loyalty .bl-stamp {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      aspect-ratio: 1 / 1;\n      min-width: 0;\n      border: 2px dashed var(--bl-accent);\n      border-radius: 50%;\n      color: var(--bl-muted);\n      font-weight: 600;\n      font-size: .95rem;\n      font-variant-numeric: tabular-nums;\n      background: var(--bl-bg);\n    }\n    .bl-loyalty .bl-stamp-free {\n      border-style: solid;\n      background: var(--bl-accent);\n      color: #fff;\n      font-size: .75rem;\n      font-weight: 700;\n      letter-spacing: .04em;\n    }\n    .bl-loyalty-note { margin: 0; font-weight: 600; }\n    @media (min-width: 768px) {\n      .bl-loyalty .bl-stamps {\n        grid-template-columns: repeat(10, minmax(0, 1fr));\n        max-width: 100%;\n        gap: .6rem;\n        padding: 1.25rem;\n      }\n      .bl-loyalty .bl-stamp-free { font-size: .8rem; }\n    }\n  </style>\n</section>",
