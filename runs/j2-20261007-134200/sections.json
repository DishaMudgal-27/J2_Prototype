{
  "W-1": {
    "owner": "W-1",
    "head": "<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"description\" content=\"Brew Lab, a cafe on 100 Feet Road, Indiranagar, Bengaluru. Menu, hours, loyalty and pickup pre-orders.\">\n<style>\n  :root {\n    --bl-bg: #faf6f0;\n    --bl-surface: #ffffff;\n    --bl-ink: #2b1d14;\n    --bl-muted: #6b5a4e;\n    --bl-accent: #8a4b22;\n    --bl-line: #e6dccf;\n    --bl-radius: 12px;\n  }\n  *, *::before, *::after { box-sizing: border-box; }\n  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }\n  body {\n    margin: 0;\n    background: var(--bl-bg);\n    color: var(--bl-ink);\n    font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n    font-size: 1rem;\n    line-height: 1.5;\n    overflow-wrap: anywhere;\n  }\n  img, svg, video { max-width: 100%; height: auto; }\n  h1, h2, h3, p, ul { margin-top: 0; }\n  a { color: var(--bl-accent); }\n  .wrap { width: 100%; max-width: 960px; margin: 0 auto; padding: 0 1rem; }\n  .bl-section { padding: 2rem 0; }\n  .bl-section h2 { font-size: 1.5rem; margin-bottom: 1rem; }\n  @media (min-width: 768px) {\n    .wrap { padding: 0 1.5rem; }\n    .bl-section { padding: 3rem 0; }\n    .bl-section h2 { font-size: 1.875rem; }\n  }\n</style>",
    "body": "<header class=\"bl-hero\">\n  <div class=\"wrap\">\n    <h1>Brew Lab</h1>\n    <p>Coffee on 100 Feet Road, Indiranagar, Bengaluru.</p>\n  </div>\n</header>\n\n<main>\n<section id=\"menu\" class=\"bl-section bl-menu\" aria-labelledby=\"menu-title\">\n  <div class=\"wrap\">\n    <h2 id=\"menu-title\">Menu</h2>\n    <div class=\"bl-menu-grid\">\n      <div class=\"bl-menu-group\">\n        <h3>Coffee</h3>\n        <ul class=\"bl-menu-list\">\n          <li><span class=\"bl-item\">Espresso</span><span class=\"bl-price\">₹120</span></li>\n          <li><span class=\"bl-item\">Cappuccino</span><span class=\"bl-price\">₹180</span></li>\n          <li><span class=\"bl-item\">Pour-over</span><span class=\"bl-price\">₹220</span></li>\n        </ul>\n      </div>\n      <div class=\"bl-menu-group\">\n        <h3>Cold</h3>\n        <ul class=\"bl-menu-list\">\n          <li><span class=\"bl-item\">Cold brew</span><span class=\"bl-price\">₹200</span></li>\n        </ul>\n      </div>\n      <div class=\"bl-menu-group\">\n        <h3>Food</h3>\n        <ul class=\"bl-menu-list\">\n          <li><span class=\"bl-item\">Croissant</span><span class=\"bl-price\">₹150</span></li>\n          <li><span class=\"bl-item\">Banana bread</span><span class=\"bl-price\">₹130</span></li>\n        </ul>\n      </div>\n    </div>\n  </div>\n</section>\n<!-- Other sections attach below this line, inside main. -->\n</main>\n\n<style>\n  .bl-hero {\n    background: var(--bl-ink);\n    color: #fff;\n    padding: 2rem 0 1.75rem;\n  }\n  .bl-hero h1 { font-size: 2rem; margin-bottom: .25rem; letter-spacing: .02em; }\n  .bl-hero p { margin-bottom: 0; color: #e9dccd; }\n  .bl-menu-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }\n  .bl-menu-group {\n    background: var(--bl-surface);\n    border: 1px solid var(--bl-line);\n    border-radius: var(--bl-radius);\n    padding: 1rem;\n    min-width: 0;\n  }\n  .bl-menu-group h3 {\n    margin-bottom: .5rem;\n    font-size: 1.125rem;\n    color: var(--bl-accent);\n    text-transform: uppercase;\n    letter-spacing: .06em;\n  }\n  .bl-menu-list { list-style: none; padding: 0; margin: 0; }\n  .bl-menu-list li {\n    display: flex;\n    justify-content: space-between;\n    align-items: baseline;\n    gap: 1rem;\n    padding: .6rem 0;\n    border-top: 1px solid var(--bl-line);\n  }\n  .bl-menu-list li:first-child { border-top: 0; }\n  .bl-item { min-width: 0; }\n  .bl-price { font-weight: 700; white-space: nowrap; font-variant-numeric: tabular-nums; }\n  @media (min-width: 768px) {\n    .bl-hero { padding: 3rem 0 2.5rem; }\n    .bl-hero h1 { font-size: 2.75rem; }\n    .bl-menu-grid { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }\n  }\n</style>",
    "workflow": "Menu section"
  },
  "W-2": {
    "owner": "W-2",
    "head": "",
    "body": "<section id=\"visit\" class=\"bl-section bl-visit\" aria-labelledby=\"visit-title\">\n  <div class=\"wrap\">\n    <h2 id=\"visit-title\">Hours and location</h2>\n    <div class=\"bl-visit-grid\">\n      <div class=\"bl-visit-card\">\n        <h3>Opening hours</h3>\n        <table class=\"bl-hours\">\n          <caption class=\"bl-sr\">Opening hours by day</caption>\n          <tbody>\n            <tr data-day=\"1\"><th scope=\"row\">Monday</th><td>8am to 10pm</td></tr>\n            <tr data-day=\"2\"><th scope=\"row\">Tuesday</th><td>8am to 10pm</td></tr>\n            <tr data-day=\"3\"><th scope=\"row\">Wednesday</th><td>8am to 10pm</td></tr>\n            <tr data-day=\"4\"><th scope=\"row\">Thursday</th><td>8am to 10pm</td></tr>\n            <tr data-day=\"5\"><th scope=\"row\">Friday</th><td>8am to 10pm</td></tr>\n            <tr data-day=\"6\"><th scope=\"row\">Saturday</th><td>9am to 11pm</td></tr>\n            <tr data-day=\"0\"><th scope=\"row\">Sunday</th><td>9am to 11pm</td></tr>\n          </tbody>\n        </table>\n        <p class=\"bl-hours-note\">Open every day. Today's hours are highlighted.</p>\n      </div>\n      <div class=\"bl-visit-card\">\n        <h3>Find us</h3>\n        <address class=\"bl-address\">100 Feet Road, Indiranagar, Bengaluru 560038</address>\n        <p><a class=\"bl-directions\" href=\"https://maps.google.com/?q=100+Feet+Road+Indiranagar+Bengaluru+560038\" target=\"_blank\" rel=\"noopener\">Get directions</a></p>\n      </div>\n    </div>\n  </div>\n\n  <style>\n    .bl-visit-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }\n    .bl-visit-card {\n      background: var(--bl-surface);\n      border: 1px solid var(--bl-line);\n      border-radius: var(--bl-radius);\n      padding: 1rem;\n      min-width: 0;\n    }\n    .bl-visit-card h3 {\n      margin-bottom: .5rem;\n      font-size: 1.125rem;\n      color: var(--bl-accent);\n      text-transform: uppercase;\n      letter-spacing: .06em;\n    }\n    .bl-visit .bl-sr {\n      position: absolute;\n      width: 1px;\n      height: 1px;\n      overflow: hidden;\n      clip: rect(0 0 0 0);\n      white-space: nowrap;\n    }\n    .bl-hours { width: 100%; border-collapse: collapse; table-layout: fixed; }\n    .bl-hours th, .bl-hours td {\n      text-align: left;\n      padding: .6rem .5rem;\n      border-top: 1px solid var(--bl-line);\n      font-weight: 400;\n      vertical-align: baseline;\n    }\n    .bl-hours tr:first-child th, .bl-hours tr:first-child td { border-top: 0; }\n    .bl-hours td { text-align: right; font-variant-numeric: tabular-nums; }\n    .bl-hours tr.bl-today th, .bl-hours tr.bl-today td {\n      background: #f6e6d3;\n      font-weight: 700;\n      color: var(--bl-ink);\n    }\n    .bl-hours tr.bl-today th { box-shadow: inset 4px 0 0 var(--bl-accent); }\n    .bl-today-tag {\n      display: inline-block;\n      margin-left: .4rem;\n      padding: .05rem .45rem;\n      border-radius: 999px;\n      background: var(--bl-accent);\n      color: #fff;\n      font-size: .75rem;\n      font-weight: 600;\n      vertical-align: middle;\n    }\n    .bl-hours-note { margin: .75rem 0 0; color: var(--bl-muted); font-size: .9rem; }\n    .bl-address { font-style: normal; margin-bottom: 1rem; }\n    .bl-directions {\n      display: inline-block;\n      padding: .7rem 1.25rem;\n      background: var(--bl-accent);\n      color: #fff;\n      border-radius: var(--bl-radius);\n      text-decoration: none;\n      font-weight: 600;\n    }\n    .bl-directions:hover, .bl-directions:focus { background: #6f3b19; }\n    @media (min-width: 768px) {\n      .bl-visit-grid { grid-template-columns: 1fr 1fr; gap: 1.25rem; }\n    }\n  </style>\n\n  <script>\n    (function () {\n      var today = String(new Date().getDay());\n      var rows = document.querySelectorAll('.bl-hours tr[data-day]');\n      for (var i = 0; i < rows.length; i++) {\n        if (rows[i].getAttribute('data-day') === today) {\n          rows[i].classList.add('bl-today');\n          rows[i].setAttribute('aria-current', 'date');\n          var th = rows[i].querySelector('th');\n          if (th) {\n            var tag = document.createElement('span');\n            tag.className = 'bl-today-tag';\n            tag.textContent = 'Today';\n            th.appendChild(tag);\n          }\n        }\n      }\n    })();\n  </script>\n</section>",
    "workflow": "Hours and location section"
  },
  "W-3": {
    "owner": "W-3",
    "head": "",
    "body": "<section id=\"order\" class=\"bl-section bl-order\" aria-labelledby=\"order-title\">\n  <div class=\"wrap\">\n    <h2 id=\"order-title\">Pre-order for pickup</h2>\n    <p class=\"bl-order-intro\">Pick your items and a pickup time. The order goes to us on WhatsApp. Payment is at pickup.</p>\n\n    <form id=\"bl-order-form\" class=\"bl-order-form\" novalidate>\n      <div class=\"bl-order-field\">\n        <label for=\"bl-order-name\">Name</label>\n        <input id=\"bl-order-name\" name=\"name\" type=\"text\" autocomplete=\"name\" maxlength=\"60\" required>\n        <p class=\"bl-order-error\" id=\"bl-order-name-err\" role=\"alert\"></p>\n      </div>\n\n      <div class=\"bl-order-field\">\n        <label for=\"bl-order-phone\">Phone</label>\n        <input id=\"bl-order-phone\" name=\"phone\" type=\"tel\" inputmode=\"tel\" autocomplete=\"tel\" maxlength=\"20\" placeholder=\"98450 00000\" required>\n        <p class=\"bl-order-error\" id=\"bl-order-phone-err\" role=\"alert\"></p>\n      </div>\n\n      <fieldset class=\"bl-order-items\">\n        <legend>Items</legend>\n        <div class=\"bl-order-row\">\n          <label for=\"bl-qty-espresso\"><span class=\"bl-order-name\">Espresso</span><span class=\"bl-order-price\">₹120</span></label>\n          <input id=\"bl-qty-espresso\" class=\"bl-order-qty\" type=\"number\" inputmode=\"numeric\" min=\"0\" max=\"20\" step=\"1\" value=\"0\" data-name=\"Espresso\" data-price=\"120\">\n        </div>\n        <div class=\"bl-order-row\">\n          <label for=\"bl-qty-cappuccino\"><span class=\"bl-order-name\">Cappuccino</span><span class=\"bl-order-price\">₹180</span></label>\n          <input id=\"bl-qty-cappuccino\" class=\"bl-order-qty\" type=\"number\" inputmode=\"numeric\" min=\"0\" max=\"20\" step=\"1\" value=\"0\" data-name=\"Cappuccino\" data-price=\"180\">\n        </div>\n        <div class=\"bl-order-row\">\n          <label for=\"bl-qty-pourover\"><span class=\"bl-order-name\">Pour-over</span><span class=\"bl-order-price\">₹220</span></label>\n          <input id=\"bl-qty-pourover\" class=\"bl-order-qty\" type=\"number\" inputmode=\"numeric\" min=\"0\" max=\"20\" step=\"1\" value=\"0\" data-name=\"Pour-over\" data-price=\"220\">\n        </div>\n        <div class=\"bl-order-row\">\n          <label for=\"bl-qty-coldbrew\"><span class=\"bl-order-name\">Cold brew</span><span class=\"bl-order-price\">₹200</span></label>\n          <input id=\"bl-qty-coldbrew\" class=\"bl-order-qty\" type=\"number\" inputmode=\"numeric\" min=\"0\" max=\"20\" step=\"1\" value=\"0\" data-name=\"Cold brew\" data-price=\"200\">\n        </div>\n        <div class=\"bl-order-row\">\n          <label for=\"bl-qty-croissant\"><span class=\"bl-order-name\">Croissant</span><span class=\"bl-order-price\">₹150</span></label>\n          <input id=\"bl-qty-croissant\" class=\"bl-order-qty\" type=\"number\" inputmode=\"numeric\" min=\"0\" max=\"20\" step=\"1\" value=\"0\" data-name=\"Croissant\" data-price=\"150\">\n        </div>\n        <div class=\"bl-order-row\">\n          <label for=\"bl-qty-bananabread\"><span class=\"bl-order-name\">Banana bread</span><span class=\"bl-order-price\">₹130</span></label>\n          <input id=\"bl-qty-bananabread\" class=\"bl-order-qty\" type=\"number\" inputmode=\"numeric\" min=\"0\" max=\"20\" step=\"1\" value=\"0\" data-name=\"Banana bread\" data-price=\"130\">\n        </div>\n        <p class=\"bl-order-error\" id=\"bl-order-items-err\" role=\"alert\"></p>\n      </fieldset>\n\n      <p class=\"bl-order-total\">Total: <strong id=\"bl-order-total\" aria-live=\"polite\">₹0</strong></p>\n\n      <div class=\"bl-order-field\">\n        <label for=\"bl-order-time\">Pickup time</label>\n        <input id=\"bl-order-time\" name=\"time\" type=\"time\" required>\n        <p class=\"bl-order-hint\" id=\"bl-order-hint\"></p>\n        <p class=\"bl-order-error\" id=\"bl-order-time-err\" role=\"alert\"></p>\n      </div>\n\n      <button type=\"submit\" class=\"bl-order-submit\">Send order on WhatsApp</button>\n    </form>\n\n    <div id=\"bl-order-confirm\" class=\"bl-order-confirm\" role=\"status\" tabindex=\"-1\" hidden>\n      <p id=\"bl-order-confirm-text\"></p>\n      <p><a id=\"bl-order-wa-link\" href=\"https://wa.me/919845000000\" target=\"_blank\" rel=\"noopener\">Open WhatsApp again</a></p>\n    </div>\n  </div>\n\n  <style>\n    .bl-order-intro { color: var(--bl-muted); }\n    .bl-order-form {\n      background: var(--bl-surface);\n      border: 1px solid var(--bl-line);\n      border-radius: var(--bl-radius);\n      padding: 1rem;\n      max-width: 36rem;\n      min-width: 0;\n    }\n    .bl-order-field { margin-bottom: 1rem; min-width: 0; }\n    .bl-order label { display: block; font-weight: 600; }\n    .bl-order input[type=\"text\"],\n    .bl-order input[type=\"tel\"],\n    .bl-order input[type=\"time\"] {\n      display: block;\n      width: 100%;\n      min-width: 0;\n      margin-top: .35rem;\n      padding: .7rem .75rem;\n      font: inherit;\n      font-size: 1rem;\n      color: var(--bl-ink);\n      background: #fff;\n      border: 1px solid var(--bl-line);\n      border-radius: 8px;\n    }\n    .bl-order input[aria-invalid=\"true\"] { border-color: #b3261e; }\n    .bl-order-items { border: 0; padding: 0; margin: 0 0 1rem; min-width: 0; }\n    .bl-order-items legend { font-weight: 600; padding: 0; margin-bottom: .25rem; }\n    .bl-order-row {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: .75rem;\n      padding: .5rem 0;\n      border-top: 1px solid var(--bl-line);\n    }\n    .bl-order-row:first-of-type { border-top: 0; }\n    .bl-order-row label { flex: 1 1 auto; min-width: 0; font-weight: 400; display: flex; justify-content: space-between; gap: .75rem; }\n    .bl-order-price { font-weight: 700; white-space: nowrap; font-variant-numeric: tabular-nums; }\n    .bl-order-qty {\n      flex: 0 0 4.5rem;\n      width: 4.5rem;\n      padding: .5rem;\n      font: inherit;\n      font-size: 1rem;\n      text-align: center;\n      border: 1px solid var(--bl-line);\n      border-radius: 8px;\n      background: #fff;\n      color: var(--bl-ink);\n    }\n    .bl-order-total {\n      font-size: 1.25rem;\n      margin: 0 0 1rem;\n      padding: .75rem 0;\n      border-top: 2px solid var(--bl-line);\n      border-bottom: 1px solid var(--bl-line);\n    }\n    .bl-order-total strong { font-variant-numeric: tabular-nums; color: var(--bl-accent); }\n    .bl-order-hint { margin: .35rem 0 0; font-size: .9rem; color: var(--bl-muted); }\n    .bl-order-error { margin: .35rem 0 0; font-size: .9rem; color: #b3261e; min-height: 0; }\n    .bl-order-error:empty { display: none; }\n    .bl-order-submit {\n      display: block;\n      width: 100%;\n      padding: .85rem 1.25rem;\n      font: inherit;\n      font-weight: 600;\n      color: #fff;\n      background: var(--bl-accent);\n      border: 0;\n      border-radius: var(--bl-radius);\n      cursor: pointer;\n    }\n    .bl-order-submit:hover, .bl-order-submit:focus { background: #6f3b19; }\n    .bl-order-confirm {\n      max-width: 36rem;\n      margin-top: 1rem;\n      padding: 1rem;\n      background: #eaf5ea;\n      border: 1px solid #b7d9b7;\n      border-radius: var(--bl-radius);\n    }\n    .bl-order-confirm[hidden] { display: none; }\n    .bl-order-confirm p { margin-bottom: .5rem; }\n    .bl-order-confirm p:last-child { margin-bottom: 0; }\n    @media (min-width: 768px) {\n      .bl-order-form { padding: 1.5rem; }\n      .bl-order-submit { width: auto; }\n    }\n  </style>\n\n  <script>\n    (function () {\n      var form = document.getElementById('bl-order-form');\n      if (!form) { return; }\n\n      var nameEl = document.getElementById('bl-order-name');\n      var phoneEl = document.getElementById('bl-order-phone');\n      var timeEl = document.getElementById('bl-order-time');\n      var totalEl = document.getElementById('bl-order-total');\n      var hintEl = document.getElementById('bl-order-hint');\n      var confirmBox = document.getElementById('bl-order-confirm');\n      var confirmText = document.getElementById('bl-order-confirm-text');\n      var waLink = document.getElementById('bl-order-wa-link');\n      var qtyEls = form.querySelectorAll('.bl-order-qty');\n      var errs = {\n        name: document.getElementById('bl-order-name-err'),\n        phone: document.getElementById('bl-order-phone-err'),\n        items: document.getElementById('bl-order-items-err'),\n        time: document.getElementById('bl-order-time-err')\n      };\n\n      var WA_NUMBER = '919845000000';\n      var DAY_NAMES = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];\n\n      // Opening hours in minutes from midnight. Mon-Fri 8am-10pm, Sat-Sun 9am-11pm.\n      function hoursFor(day) {\n        if (day === 0 || day === 6) { return { open: 9 * 60, close: 23 * 60 }; }\n        return { open: 8 * 60, close: 22 * 60 };\n      }\n\n      function fmtTime(mins) {\n        var h = Math.floor(mins / 60);\n        var m = mins % 60;\n        var suffix = h >= 12 ? 'pm' : 'am';\n        var h12 = h % 12;\n        if (h12 === 0) { h12 = 12; }\n        return h12 + (m ? ':' + (m < 10 ? '0' : '') + m : '') + suffix;\n      }\n\n      function fmtRupees(n) {\n        return '₹' + n.toLocaleString('en-IN');\n      }\n\n      function readQty(el) {\n        var n = parseInt(el.value, 10);\n        if (isNaN(n) || n < 0) { return 0; }\n        if (n > 20) { return 20; }\n        return n;\n      }\n\n      function computeTotal() {\n        var total = 0;\n        for (var i = 0; i < qtyEls.length; i++) {\n          total += readQty(qtyEls[i]) * parseInt(qtyEls[i].getAttribute('data-price'), 10);\n        }\n        return total;\n      }\n\n      function updateTotal() {\n        totalEl.textContent = fmtRupees(computeTotal());\n      }\n\n      var todayIdx = new Date().getDay();\n      var todayHours = hoursFor(todayIdx);\n      hintEl.textContent = 'Today (' + DAY_NAMES[todayIdx] + ') we are open ' + fmtTime(todayHours.open) + ' to ' + fmtTime(todayHours.close) + '. Pick a time in that window.';\n      timeEl.setAttribute('min', pad(Math.floor(todayHours.open / 60)) + ':' + pad(todayHours.open % 60));\n      timeEl.setAttribute('max', pad(Math.floor(todayHours.close / 60)) + ':' + pad(todayHours.close % 60));\n\n      function pad(n) { return (n < 10 ? '0' : '') + n; }\n\n      function setError(key, input, msg) {\n        errs[key].textContent = msg || '';\n        if (input) {\n          if (msg) { input.setAttribute('aria-invalid', 'true'); }\n          else { input.removeAttribute('aria-invalid'); }\n        }\n      }\n\n      function parseTime(value) {\n        var m = /^(\\d{1,2}):(\\d{2})/.exec(value || '');\n        if (!m) { return null; }\n        var h = parseInt(m[1], 10);\n        var mi = parseInt(m[2], 10);\n        if (h > 23 || mi > 59) { return null; }\n        return h * 60 + mi;\n      }\n\n      function validate() {\n        var ok = true;\n        var firstBad = null;\n\n        var name = nameEl.value.trim();\n        if (!name) {\n          setError('name', nameEl, 'Please enter your name.');\n          ok = false; firstBad = firstBad || nameEl;\n        } else { setError('name', nameEl, ''); }\n\n        var digits = phoneEl.value.replace(/[\\s\\-+()]/g, '');\n        if (!/^(91)?[6-9]\\d{9}$/.test(digits)) {\n          setError('phone', phoneEl, 'Enter a valid 10 digit mobile number.');\n          ok = false; firstBad = firstBad || phoneEl;\n        } else { setError('phone', phoneEl, ''); }\n\n        if (computeTotal() <= 0) {\n          setError('items', null, 'Choose at least one item.');\n          ok = false; firstBad = firstBad || qtyEls[0];\n        } else { setError('items', null, ''); }\n\n        var mins = parseTime(timeEl.value);\n        var hours = hoursFor(new Date().getDay());\n        if (mins === null) {\n          setError('time', timeEl, 'Please choose a pickup time.');\n          ok = false; firstBad = firstBad || timeEl;\n        } else if (mins < hours.open || mins > hours.close) {\n          setError('time', timeEl, 'Pickup must be between ' + fmtTime(hours.open) + ' and ' + fmtTime(hours.close) + ' today.');\n          ok = false; firstBad = firstBad || timeEl;\n        } else { setError('time', timeEl, ''); }\n\n        if (firstBad && typeof firstBad.focus === 'function') { firstBad.focus(); }\n        return ok;\n      }\n\n      function buildMessage(name, phone, mins, total) {\n        var lines = [];\n        lines.push('New Brew Lab pickup order');\n        lines.push('Name: ' + name);\n        lines.push('Phone: ' + phone);\n        lines.push('Items:');\n        for (var i = 0; i < qtyEls.length; i++) {\n          var q = readQty(qtyEls[i]);\n          if (q > 0) {\n            var price = parseInt(qtyEls[i].getAttribute('data-price'), 10);\n            lines.push('- ' + qtyEls[i].getAttribute('data-name') + ' x ' + q + ' (' + fmtRupees(q * price) + ')');\n          }\n        }\n        lines.push('Pickup time: ' + fmtTime(mins) + ' today (' + DAY_NAMES[new Date().getDay()] + ')');\n        lines.push('Total: ' + fmtRupees(total));\n        lines.push('Payment at pickup.');\n        return lines.join('\\n');\n      }\n\n      for (var i = 0; i < qtyEls.length; i++) {\n        qtyEls[i].addEventListener('input', updateTotal);\n        qtyEls[i].addEventListener('change', function () {\n          // Normalise odd values (blank, negative, over 20) after editing.\n          this.value = String(readQty(this));\n          updateTotal();\n        });\n      }\n\n      form.addEventListener('submit', function (ev) {\n        ev.preventDefault();\n        if (!validate()) {\n          confirmBox.hidden = true;\n          return;\n        }\n        var name = nameEl.value.trim();\n        var phone = phoneEl.value.trim();\n        var mins = parseTime(timeEl.value);\n        var total = computeTotal();\n        var url = 'https://wa.me/' + WA_NUMBER + '?text=' + encodeURIComponent(buildMessage(name, phone, mins, total));\n\n        waLink.setAttribute('href', url);\n        confirmText.textContent = 'Thanks, ' + name + '. Your order for ' + fmtRupees(total) + ' is ready to send on WhatsApp for pickup at ' + fmtTime(mins) + '. Payment is at pickup.';\n        confirmBox.hidden = false;\n\n        var w = null;\n        try { w = window.open(url, '_blank'); } catch (e) { w = null; }\n        if (w) { try { w.opener = null; } catch (e2) { /* ignore */ } }\n\n        if (typeof confirmBox.focus === 'function') { confirmBox.focus(); }\n      });\n\n      updateTotal();\n    })();\n  </script>\n</section>",
    "workflow": "Pre-order form"
  },
  "W-4": {
