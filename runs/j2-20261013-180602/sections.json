{
  "style": {
    "owner": "W-1",
    "head": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&amp;family=Inter:wght@400;500;600&amp;display=swap\"><style>:root{--j2-primary:#FFC83D;--j2-secondary:#7C5CFF;--j2-accent:#22D3EE;--j2-background:#0F0A2A;--j2-surface:#1B1445;--j2-text:#F5F3FF;--j2-muted:#B8B3D9;--j2-font-heading:'Space Grotesk', 'Segoe UI', system-ui, sans-serif;--j2-font-body:'Inter', 'Segoe UI', system-ui, sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:12px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;background:#FFC83D;color:#0F0A2A;border:2px solid #FFC83D;min-height:48px;padding:12px 20px;font-weight:700;border-radius:12px;cursor:pointer}.j2-btn-secondary{display:inline-block;background:transparent;color:#F5F3FF;border:2px solid #22D3EE;min-height:48px;padding:12px 20px;font-weight:600;border-radius:12px;cursor:pointer}.j2-card{background:#1B1445;color:#F5F3FF;border:1px solid #3A2F7A;border-radius:12px;padding:16px}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-1": {
    "owner": "W-7",
    "head": "",
    "body": "<section id=\"schedule\" class=\"j2-schedule\" aria-labelledby=\"schedule-title\">\n  <style>\n    #schedule { padding: 64px 16px; background: var(--j2-background, #0F0A2A); color: var(--j2-text, #F5F3FF); box-sizing: border-box; overflow-x: hidden; }\n    #schedule *, #schedule *::before, #schedule *::after { box-sizing: border-box; }\n    #schedule .j2-sch-wrap { max-width: 880px; margin: 0 auto; }\n    #schedule .j2-sch-title { font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif); font-size: clamp(1.75rem, 6vw, 2.5rem); line-height: 1.15; margin: 0 0 8px; }\n    #schedule .j2-sch-intro { color: var(--j2-muted, #B8B3D9); margin: 0 0 24px; font-size: 1rem; line-height: 1.5; }\n    #schedule .j2-sch-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-bottom: 24px; }\n    #schedule .j2-daytab { min-height: 56px; min-width: 44px; padding: 8px 4px; display: flex; align-items: center; justify-content: center; line-height: 1.2; font-family: var(--j2-font-body, 'Inter', system-ui, sans-serif); font-size: 1rem; background: transparent; color: var(--j2-text, #F5F3FF); border: 2px solid var(--j2-accent, #22D3EE); }\n    #schedule .j2-daytab[aria-selected=\"true\"] { background: var(--j2-primary, #FFC83D); color: #0F0A2A; border-color: var(--j2-primary, #FFC83D); }\n    #schedule .j2-daytab:focus-visible { outline: 3px solid var(--j2-text, #F5F3FF); outline-offset: 2px; }\n    #schedule .j2-day[hidden] { display: none; }\n    #schedule .j2-slots { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }\n    #schedule .j2-slot { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; background: var(--j2-surface, #1B1445); border: 1px solid #3A2F7A; border-left: 6px solid var(--j2-accent, #22D3EE); border-radius: var(--j2-radius, 12px); padding: 16px; min-width: 0; }\n    #schedule .j2-slot-time { font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif); font-weight: 700; color: var(--j2-primary, #FFC83D); font-size: 1.05rem; flex: 0 0 auto; }\n    #schedule .j2-slot-name { font-weight: 600; font-size: 1.05rem; flex: 1 1 160px; min-width: 0; overflow-wrap: anywhere; }\n    @media (min-width: 768px) {\n      #schedule { padding: 80px 24px; }\n      #schedule .j2-slot { padding: 20px 24px; }\n      #schedule .j2-slot-time { flex-basis: 150px; }\n    }\n  </style>\n\n  <div class=\"j2-sch-wrap\">\n    <h2 id=\"schedule-title\" class=\"j2-sch-title\">Schedule</h2>\n    <p class=\"j2-sch-intro\">Pick a day to see what is on and when.</p>\n\n    <div class=\"j2-sch-tabs\" role=\"tablist\" aria-label=\"Festival days\">\n      <button type=\"button\" class=\"j2-btn j2-daytab\" role=\"tab\" id=\"tab-day1\" aria-controls=\"panel-day1\" aria-selected=\"true\" data-day=\"1\">Day 1</button>\n      <button type=\"button\" class=\"j2-btn j2-daytab\" role=\"tab\" id=\"tab-day2\" aria-controls=\"panel-day2\" aria-selected=\"false\" tabindex=\"-1\" data-day=\"2\">Day 2</button>\n      <button type=\"button\" class=\"j2-btn j2-daytab\" role=\"tab\" id=\"tab-day3\" aria-controls=\"panel-day3\" aria-selected=\"false\" tabindex=\"-1\" data-day=\"3\">Day 3</button>\n    </div>\n\n    <div class=\"j2-day\" id=\"panel-day1\" role=\"tabpanel\" aria-labelledby=\"tab-day1\">\n      <ul class=\"j2-slots\">\n        <li class=\"j2-slot\"><span class=\"j2-slot-time\">10am-1pm</span><span class=\"j2-slot-name\">Code Sprint</span></li>\n        <li class=\"j2-slot\"><span class=\"j2-slot-time\">2pm-5pm</span><span class=\"j2-slot-name\">Line Follower</span></li>\n        <li class=\"j2-slot\"><span class=\"j2-slot-time\">5:30pm-6:30pm</span><span class=\"j2-slot-name\">AI in Daily Life</span></li>\n      </ul>\n    </div>\n\n    <div class=\"j2-day\" id=\"panel-day2\" role=\"tabpanel\" aria-labelledby=\"tab-day2\" hidden>\n      <ul class=\"j2-slots\">\n        <li class=\"j2-slot\"><span class=\"j2-slot-time\">11am-1pm</span><span class=\"j2-slot-name\">Bug Hunt</span></li>\n        <li class=\"j2-slot\"><span class=\"j2-slot-time\">2pm-4pm</span><span class=\"j2-slot-name\">Poster Jam</span></li>\n      </ul>\n    </div>\n\n    <div class=\"j2-day\" id=\"panel-day3\" role=\"tabpanel\" aria-labelledby=\"tab-day3\" hidden>\n      <ul class=\"j2-slots\">\n        <li class=\"j2-slot\"><span class=\"j2-slot-time\">10am-1pm</span><span class=\"j2-slot-name\">Drone Dash</span></li>\n        <li class=\"j2-slot\"><span class=\"j2-slot-time\">2pm-5pm</span><span class=\"j2-slot-name\">UI Duel</span></li>\n        <li class=\"j2-slot\"><span class=\"j2-slot-time\">5:30pm-6:30pm</span><span class=\"j2-slot-name\">Startup Stories</span></li>\n      </ul>\n    </div>\n  </div>\n\n  <script>\n    (function () {\n      var root = document.getElementById('schedule');\n      if (!root) { return; }\n      var tabs = Array.prototype.slice.call(root.querySelectorAll('.j2-daytab'));\n      var panels = Array.prototype.slice.call(root.querySelectorAll('.j2-day'));\n      if (!tabs.length || tabs.length !== panels.length) { return; }\n\n      function show(index, focusTab) {\n        tabs.forEach(function (tab, i) {\n          var on = i === index;\n          tab.setAttribute('aria-selected', on ? 'true' : 'false');\n          tab.setAttribute('tabindex', on ? '0' : '-1');\n          if (on && focusTab) { tab.focus(); }\n        });\n        panels.forEach(function (panel, i) {\n          if (i === index) { panel.removeAttribute('hidden'); }\n          else { panel.setAttribute('hidden', ''); }\n        });\n      }\n\n      tabs.forEach(function (tab, i) {\n        tab.addEventListener('click', function () { show(i, false); });\n        tab.addEventListener('keydown', function (e) {\n          var next = null;\n          if (e.key === 'ArrowRight') { next = (i + 1) % tabs.length; }\n          else if (e.key === 'ArrowLeft') { next = (i - 1 + tabs.length) % tabs.length; }\n          if (next !== null) { e.preventDefault(); show(next, true); }\n        });\n      });\n\n      show(0, false);\n    })();\n  </script>\n</section>",
    "workflow": "Schedule day labels fix"
  },
  "W-2": {
    "owner": "W-2",
    "head": "",
    "body": "<section id=\"events\" class=\"j2-events\" aria-labelledby=\"events-title\">\n  <style>\n    #events { padding: 64px 16px; background: var(--j2-background, #0F0A2A); color: var(--j2-text, #F5F3FF); box-sizing: border-box; overflow-x: hidden; }\n    #events *, #events *::before, #events *::after { box-sizing: border-box; }\n    #events .j2-ev-wrap { max-width: 1120px; margin: 0 auto; }\n    #events .j2-ev-title { font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif); font-size: clamp(1.75rem, 6vw, 2.5rem); line-height: 1.15; margin: 0 0 8px; }\n    #events .j2-ev-intro { color: var(--j2-muted, #B8B3D9); margin: 0 0 24px; font-size: 1rem; line-height: 1.5; }\n    #events .j2-ev-filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 16px; }\n    #events .j2-filter { min-height: 48px; min-width: 48px; padding: 8px 18px; font-family: var(--j2-font-body, 'Inter', system-ui, sans-serif); font-size: 1rem; background: transparent; color: var(--j2-text, #F5F3FF); border: 2px solid var(--j2-accent, #22D3EE); font-weight: 600; }\n    #events .j2-filter[aria-pressed=\"true\"] { background: var(--j2-primary, #FFC83D); color: #0F0A2A; border-color: var(--j2-primary, #FFC83D); font-weight: 700; }\n    #events .j2-filter:focus-visible { outline: 3px solid var(--j2-text, #F5F3FF); outline-offset: 2px; }\n    #events .j2-ev-count { color: var(--j2-muted, #B8B3D9); margin: 0 0 24px; font-size: 0.95rem; }\n    #events .j2-ev-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 16px; margin: 0; padding: 0; list-style: none; }\n    #events .j2-card { display: flex; flex-direction: column; gap: 12px; min-width: 0; background: var(--j2-surface, #1B1445); color: var(--j2-text, #F5F3FF); border: 1px solid #3A2F7A; border-radius: var(--j2-radius, 12px); padding: 16px; }\n    #events .j2-card[hidden] { display: none; }\n    #events .j2-photo { display: flex; align-items: center; justify-content: center; text-align: center; min-height: 120px; padding: 8px; border: 2px dashed var(--j2-secondary, #7C5CFF); border-radius: var(--j2-radius, 12px); background: linear-gradient(135deg, rgba(124, 92, 255, 0.25), rgba(34, 211, 238, 0.12)); color: var(--j2-muted, #B8B3D9); font-size: 0.85rem; font-weight: 500; letter-spacing: 0.02em; }\n    #events .j2-ev-cat { align-self: flex-start; color: var(--j2-accent, #22D3EE); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin: 0; }\n    #events .j2-ev-name { font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif); font-size: 1.3rem; line-height: 1.2; margin: 0; overflow-wrap: anywhere; }\n    #events .j2-ev-meta { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: auto; padding-top: 12px; border-top: 1px solid #3A2F7A; }\n    #events .j2-ev-day { color: var(--j2-muted, #B8B3D9); font-size: 0.95rem; margin: 0; }\n    #events .j2-ev-fee { font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif); font-weight: 700; font-size: 1.15rem; color: var(--j2-primary, #FFC83D); margin: 0; }\n    @media (min-width: 768px) {\n      #events { padding: 80px 24px; }\n    }\n  </style>\n\n  <div class=\"j2-ev-wrap\">\n    <h2 id=\"events-title\" class=\"j2-ev-title\">Events</h2>\n    <p class=\"j2-ev-intro\">Eight events across four categories. Pick a category to narrow the list.</p>\n\n    <div class=\"j2-ev-filters\" role=\"group\" aria-label=\"Filter events by category\">\n      <button type=\"button\" class=\"j2-btn j2-filter\" data-filter=\"all\" aria-pressed=\"true\">All</button>\n      <button type=\"button\" class=\"j2-btn j2-filter\" data-filter=\"Coding\" aria-pressed=\"false\">Coding</button>\n      <button type=\"button\" class=\"j2-btn j2-filter\" data-filter=\"Robotics\" aria-pressed=\"false\">Robotics</button>\n      <button type=\"button\" class=\"j2-btn j2-filter\" data-filter=\"Design\" aria-pressed=\"false\">Design</button>\n      <button type=\"button\" class=\"j2-btn j2-filter\" data-filter=\"Talks\" aria-pressed=\"false\">Talks</button>\n    </div>\n    <p class=\"j2-ev-count\" id=\"events-count\" aria-live=\"polite\">Showing 8 events</p>\n\n    <ul class=\"j2-ev-grid\">\n      <li class=\"j2-card\" data-cat=\"Coding\">\n        <div class=\"j2-photo\" role=\"img\" aria-label=\"Photo placeholder for Code Sprint\">Photo placeholder</div>\n        <p class=\"j2-ev-cat\">Coding</p>\n        <h3 class=\"j2-ev-name\">Code Sprint</h3>\n        <div class=\"j2-ev-meta\"><p class=\"j2-ev-day\">Day 1</p><p class=\"j2-ev-fee\">Rs 100</p></div>\n      </li>\n      <li class=\"j2-card\" data-cat=\"Coding\">\n        <div class=\"j2-photo\" role=\"img\" aria-label=\"Photo placeholder for Bug Hunt\">Photo placeholder</div>\n        <p class=\"j2-ev-cat\">Coding</p>\n        <h3 class=\"j2-ev-name\">Bug Hunt</h3>\n        <div class=\"j2-ev-meta\"><p class=\"j2-ev-day\">Day 2</p><p class=\"j2-ev-fee\">Rs 50</p></div>\n      </li>\n      <li class=\"j2-card\" data-cat=\"Robotics\">\n        <div class=\"j2-photo\" role=\"img\" aria-label=\"Photo placeholder for Line Follower\">Photo placeholder</div>\n        <p class=\"j2-ev-cat\">Robotics</p>\n        <h3 class=\"j2-ev-name\">Line Follower</h3>\n        <div class=\"j2-ev-meta\"><p class=\"j2-ev-day\">Day 1</p><p class=\"j2-ev-fee\">Rs 150</p></div>\n      </li>\n      <li class=\"j2-card\" data-cat=\"Robotics\">\n        <div class=\"j2-photo\" role=\"img\" aria-label=\"Photo placeholder for Drone Dash\">Photo placeholder</div>\n        <p class=\"j2-ev-cat\">Robotics</p>\n        <h3 class=\"j2-ev-name\">Drone Dash</h3>\n        <div class=\"j2-ev-meta\"><p class=\"j2-ev-day\">Day 3</p><p class=\"j2-ev-fee\">Rs 200</p></div>\n      </li>\n      <li class=\"j2-card\" data-cat=\"Design\">\n        <div class=\"j2-photo\" role=\"img\" aria-label=\"Photo placeholder for Poster Jam\">Photo placeholder</div>\n        <p class=\"j2-ev-cat\">Design</p>\n        <h3 class=\"j2-ev-name\">Poster Jam</h3>\n        <div class=\"j2-ev-meta\"><p class=\"j2-ev-day\">Day 2</p><p class=\"j2-ev-fee\">Free</p></div>\n      </li>\n      <li class=\"j2-card\" data-cat=\"Design\">\n        <div class=\"j2-photo\" role=\"img\" aria-label=\"Photo placeholder for UI Duel\">Photo placeholder</div>\n        <p class=\"j2-ev-cat\">Design</p>\n        <h3 class=\"j2-ev-name\">UI Duel</h3>\n        <div class=\"j2-ev-meta\"><p class=\"j2-ev-day\">Day 3</p><p class=\"j2-ev-fee\">Rs 100</p></div>\n      </li>\n      <li class=\"j2-card\" data-cat=\"Talks\">\n        <div class=\"j2-photo\" role=\"img\" aria-label=\"Photo placeholder for AI in Daily Life\">Photo placeholder</div>\n        <p class=\"j2-ev-cat\">Talks</p>\n        <h3 class=\"j2-ev-name\">AI in Daily Life</h3>\n        <div class=\"j2-ev-meta\"><p class=\"j2-ev-day\">Day 1</p><p class=\"j2-ev-fee\">Free</p></div>\n      </li>\n      <li class=\"j2-card\" data-cat=\"Talks\">\n        <div class=\"j2-photo\" role=\"img\" aria-label=\"Photo placeholder for Startup Stories\">Photo placeholder</div>\n        <p class=\"j2-ev-cat\">Talks</p>\n        <h3 class=\"j2-ev-name\">Startup Stories</h3>\n        <div class=\"j2-ev-meta\"><p class=\"j2-ev-day\">Day 3</p><p class=\"j2-ev-fee\">Free</p></div>\n      </li>\n    </ul>\n  </div>\n\n  <script>\n    (function () {\n      var root = document.getElementById('events');\n      if (!root) { return; }\n      var buttons = Array.prototype.slice.call(root.querySelectorAll('.j2-filter'));\n      var cards = Array.prototype.slice.call(root.querySelectorAll('.j2-card'));\n      var count = document.getElementById('events-count');\n      if (!buttons.length || !cards.length) { return; }\n\n      function apply(filter) {\n        var shown = 0;\n        buttons.forEach(function (btn) {\n          btn.setAttribute('aria-pressed', btn.getAttribute('data-filter') === filter ? 'true' : 'false');\n        });\n        cards.forEach(function (card) {\n          var match = filter === 'all' || card.getAttribute('data-cat') === filter;\n          if (match) { card.removeAttribute('hidden'); shown += 1; }\n          else { card.setAttribute('hidden', ''); }\n        });\n        if (count) {\n          count.textContent = 'Showing ' + shown + (shown === 1 ? ' event' : ' events');\n        }\n      }\n\n      buttons.forEach(function (btn) {\n        btn.addEventListener('click', function () { apply(btn.getAttribute('data-filter')); });\n      });\n\n      apply('all');\n    })();\n  </script>\n</section>",
    "workflow": "Events by category with fees"
  },
  "W-3": {
    "owner": "W-3",
    "head": "",
    "body": "<section id=\"register\" class=\"j2-register\" aria-labelledby=\"register-title\">\n  <style>\n    #register { padding: 64px 16px; background: var(--j2-surface, #1B1445); color: var(--j2-text, #F5F3FF); box-sizing: border-box; overflow-x: hidden; }\n    #register *, #register *::before, #register *::after { box-sizing: border-box; }\n    #register .j2-reg-wrap { max-width: 560px; margin: 0 auto; }\n    #register .j2-reg-title { font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif); font-size: clamp(1.75rem, 6vw, 2.5rem); line-height: 1.15; margin: 0 0 8px; }\n    #register .j2-reg-intro { color: var(--j2-muted, #B8B3D9); margin: 0 0 24px; font-size: 1rem; line-height: 1.5; }\n    #register .j2-form { display: grid; gap: 16px; margin: 0; padding: 0; min-width: 0; }\n    #register .j2-field { display: grid; gap: 8px; min-width: 0; }\n    #register .j2-label { font-weight: 600; font-size: 1rem; color: var(--j2-text, #F5F3FF); }\n    #register .j2-input { width: 100%; min-width: 0; min-height: 48px; padding: 12px 16px; font-family: var(--j2-font-body, 'Inter', system-ui, sans-serif); font-size: 1rem; line-height: 1.3; color: var(--j2-text, #F5F3FF); background: var(--j2-background, #0F0A2A); border: 2px solid var(--j2-accent, #22D3EE); border-radius: var(--j2-radius, 12px); color-scheme: dark; }\n    #register select.j2-input { appearance: auto; cursor: pointer; }\n    #register .j2-input:focus-visible { outline: 3px solid var(--j2-primary, #FFC83D); outline-offset: 2px; }\n    #register .j2-submit { width: 100%; min-height: 52px; margin-top: 8px; font-family: var(--j2-font-body, 'Inter', system-ui, sans-serif); font-size: 1.05rem; text-align: center; }\n    #register .j2-submit:focus-visible { outline: 3px solid var(--j2-text, #F5F3FF); outline-offset: 2px; }\n    #register .j2-reg-note { color: var(--j2-muted, #B8B3D9); margin: 16px 0 0; font-size: 0.95rem; line-height: 1.5; overflow-wrap: anywhere; }\n    #register .j2-reg-note strong { color: var(--j2-text, #F5F3FF); font-weight: 600; }\n    @media (min-width: 768px) {\n      #register { padding: 80px 24px; }\n      #register .j2-submit { width: auto; min-width: 220px; }\n    }\n  </style>\n\n  <div class=\"j2-reg-wrap\">\n    <h2 id=\"register-title\" class=\"j2-reg-title\">Register</h2>\n    <p class=\"j2-reg-intro\">Pick an event and fill in your details. Fees are shown on each event card.</p>\n\n    <form class=\"j2-form\" action=\"mailto:spark2026@example.com\" method=\"post\" enctype=\"text/plain\">\n      <div class=\"j2-field\">\n        <label class=\"j2-label\" for=\"reg-name\">Name</label>\n        <input class=\"j2-input\" type=\"text\" id=\"reg-name\" name=\"name\" autocomplete=\"name\" required>\n      </div>\n\n      <div class=\"j2-field\">\n        <label class=\"j2-label\" for=\"reg-email\">Email</label>\n        <input class=\"j2-input\" type=\"email\" id=\"reg-email\" name=\"email\" autocomplete=\"email\" inputmode=\"email\" required>\n      </div>\n\n      <div class=\"j2-field\">\n        <label class=\"j2-label\" for=\"reg-college\">College</label>\n        <input class=\"j2-input\" type=\"text\" id=\"reg-college\" name=\"college\" autocomplete=\"organization\" required>\n      </div>\n\n      <div class=\"j2-field\">\n        <label class=\"j2-label\" for=\"reg-event\">Event</label>\n        <select class=\"j2-input\" id=\"reg-event\" name=\"event\" required>\n          <option value=\"\" selected disabled>Choose an event</option>\n          <option class=\"j2-event-option\" value=\"Code Sprint\">Code Sprint</option>\n          <option class=\"j2-event-option\" value=\"Bug Hunt\">Bug Hunt</option>\n          <option class=\"j2-event-option\" value=\"Line Follower\">Line Follower</option>\n          <option class=\"j2-event-option\" value=\"Drone Dash\">Drone Dash</option>\n          <option class=\"j2-event-option\" value=\"Poster Jam\">Poster Jam</option>\n          <option class=\"j2-event-option\" value=\"UI Duel\">UI Duel</option>\n          <option class=\"j2-event-option\" value=\"AI in Daily Life\">AI in Daily Life</option>\n          <option class=\"j2-event-option\" value=\"Startup Stories\">Startup Stories</option>\n        </select>\n      </div>\n\n      <button type=\"submit\" class=\"j2-btn j2-submit\">Register</button>\n    </form>\n\n    <p class=\"j2-reg-note\">Submitting opens your email app with your details ready to send to <strong>spark2026@example.com</strong>. Press send in that app to finish.</p>\n  </div>\n</section>",
    "workflow": "Registration form"
  },
  "W-4": {
    "owner": "W-4",
    "head": "",
    "body": "<section id=\"sponsors\" class=\"j2-sponsors\" aria-labelledby=\"sponsors-title\">\n  <style>\n    #sponsors { padding: 64px 16px; background: var(--j2-background, #0F0A2A); color: var(--j2-text, #F5F3FF); box-sizing: border-box; overflow-x: hidden; }\n    #sponsors *, #sponsors *::before, #sponsors *::after { box-sizing: border-box; }\n    #sponsors .j2-sp-wrap { max-width: 1120px; margin: 0 auto; }\n    #sponsors .j2-sp-title { font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif); font-size: clamp(1.75rem, 6vw, 2.5rem); line-height: 1.15; margin: 0 0 8px; }\n    #sponsors .j2-sp-intro { color: var(--j2-muted, #B8B3D9); margin: 0 0 24px; font-size: 1rem; line-height: 1.5; }\n    #sponsors .j2-sp-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 16px; margin: 0; padding: 0; list-style: none; }\n    #sponsors .j2-sponsor { display: flex; align-items: center; justify-content: center; text-align: center; min-width: 0; min-height: 96px; padding: 16px; background: var(--j2-surface, #1B1445); color: var(--j2-text, #F5F3FF); border: 1px solid #3A2F7A; border-top: 4px solid var(--j2-primary, #FFC83D); border-radius: var(--j2-radius, 12px); font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif); font-weight: 700; font-size: 1.35rem; line-height: 1.2; overflow-wrap: anywhere; }\n    @media (min-width: 768px) {\n      #sponsors { padding: 80px 24px; }\n      #sponsors .j2-sponsor { min-height: 120px; font-size: 1.5rem; }\n    }\n  </style>\n\n  <div class=\"j2-sp-wrap\">\n    <h2 id=\"sponsors-title\" class=\"j2-sp-title\">Sponsors</h2>\n    <p class=\"j2-sp-intro\">Thank you to the sponsors behind Spark 2026.</p>\n\n    <ul class=\"j2-sp-grid\">\n      <li class=\"j2-sponsor\">Nimbus Cloud</li>\n      <li class=\"j2-sponsor\">Orbit Labs</li>\n      <li class=\"j2-sponsor\">Pixel Press</li>\n    </ul>\n  </div>\n</section>",
    "workflow": "Sponsors"
  },
  "W-5": {
    "owner": "W-5",
    "head": "",
    "body": "<section id=\"venue\" class=\"j2-venue\" aria-labelledby=\"venue-title\">\n  <style>\n    #venue, #contact { padding: 64px 16px; color: var(--j2-text, #F5F3FF); box-sizing: border-box; overflow-x: hidden; }\n    #venue { background: var(--j2-surface, #1B1445); }\n    #contact { background: var(--j2-background, #0F0A2A); }\n    #venue *, #venue *::before, #venue *::after, #contact *, #contact *::before, #contact *::after { box-sizing: border-box; }\n    #venue .j2-ve-wrap, #contact .j2-ct-wrap { max-width: 720px; margin: 0 auto; }\n    #venue .j2-ve-title, #contact .j2-ct-title { font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif); font-size: clamp(1.75rem, 6vw, 2.5rem); line-height: 1.15; margin: 0 0 8px; }\n    #venue .j2-ve-intro, #contact .j2-ct-intro { color: var(--j2-muted, #B8B3D9); margin: 0 0 24px; font-size: 1rem; line-height: 1.5; }\n    #venue .j2-ve-card, #contact .j2-ct-card { display: grid; gap: 16px; min-width: 0; background: var(--j2-background, #0F0A2A); border: 1px solid #3A2F7A; border-left: 6px solid var(--j2-accent, #22D3EE); border-radius: var(--j2-radius, 12px); padding: 20px 16px; }\n    #contact .j2-ct-card { background: var(--j2-surface, #1B1445); }\n    #venue .j2-ve-name { font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif); font-size: 1.3rem; line-height: 1.2; font-weight: 700; margin: 0; overflow-wrap: anywhere; }\n    #venue .j2-ve-address { font-style: normal; color: var(--j2-text, #F5F3FF); font-size: 1.05rem; line-height: 1.6; margin: 0; overflow-wrap: anywhere; }\n    #venue .j2-maplink, #contact .j2-whatsapp, #contact .j2-email { display: inline-flex; align-items: center; justify-content: center; text-align: center; text-decoration: none; min-height: 48px; min-width: 48px; width: 100%; max-width: 100%; font-family: var(--j2-font-body, 'Inter', system-ui, sans-serif); font-size: 1.05rem; line-height: 1.3; overflow-wrap: anywhere; }\n    #venue .j2-maplink:focus-visible, #contact .j2-whatsapp:focus-visible, #contact .j2-email:focus-visible { outline: 3px solid var(--j2-text, #F5F3FF); outline-offset: 2px; }\n    #contact .j2-ct-row { display: grid; gap: 8px; min-width: 0; }\n    #contact .j2-ct-label { color: var(--j2-muted, #B8B3D9); font-size: 0.95rem; font-weight: 500; margin: 0; }\n    #contact .j2-ct-number { font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif); font-weight: 700; font-size: 1.2rem; color: var(--j2-primary, #FFC83D); margin: 0; }\n    @media (min-width: 768px) {\n      #venue, #contact { padding: 80px 24px; }\n      #venue .j2-ve-card, #contact .j2-ct-card { padding: 24px; }\n      #venue .j2-maplink, #contact .j2-whatsapp, #contact .j2-email { width: auto; min-width: 240px; justify-self: start; }\n    }\n  </style>\n\n  <div class=\"j2-ve-wrap\">\n    <h2 id=\"venue-title\" class=\"j2-ve-title\">Venue</h2>\n    <p class=\"j2-ve-intro\">Spark 2026 takes place at our college campus in Pune.</p>\n\n    <div class=\"j2-ve-card\">\n      <p class=\"j2-ve-name\">Northfield College of Engineering</p>\n      <address class=\"j2-ve-address\">22 University Road<br>Pune 411007</address>\n      <a class=\"j2-btn j2-maplink\" href=\"https://www.google.com/maps/search/?api=1&amp;query=Northfield+College+of+Engineering%2C+22+University+Road%2C+Pune+411007\" target=\"_blank\" rel=\"noopener noreferrer\">Open in Google Maps</a>\n    </div>\n  </div>\n</section>\n\n<section id=\"contact\" class=\"j2-contact\" aria-labelledby=\"contact-title\">\n  <div class=\"j2-ct-wrap\">\n    <h2 id=\"contact-title\" class=\"j2-ct-title\">Contact the organisers</h2>\n    <p class=\"j2-ct-intro\">Questions about events, fees or registration? Message us.</p>\n\n    <div class=\"j2-ct-card\">\n      <div class=\"j2-ct-row\">\n        <p class=\"j2-ct-label\">WhatsApp</p>\n        <p class=\"j2-ct-number\">+91 00000 33333</p>\n        <a class=\"j2-btn j2-whatsapp\" href=\"https://wa.me/910000033333\" target=\"_blank\" rel=\"noopener noreferrer\">Chat on WhatsApp</a>\n      </div>\n      <div class=\"j2-ct-row\">\n        <p class=\"j2-ct-label\">Email</p>\n        <a class=\"j2-btn-secondary j2-email\" href=\"mailto:spark2026@example.com\">spark2026@example.com</a>\n      </div>\n    </div>\n  </div>\n</section>",
    "workflow": "Venue, map and contact"
  },
  "W-6": {
    "owner": "W-6",
    "head": "",
    "body": "<header class=\"j2-top\" id=\"top\">\n  <style>\n    html { scroll-behavior: smooth; }\n    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }\n    body { display: flex; flex-direction: column; }\n    #schedule, #events, #register, #sponsors, #venue, #contact, #hero { scroll-margin-top: 72px; }\n\n    .j2-top { order: -1; position: sticky; top: 0; z-index: 50; width: 100%; box-sizing: border-box; background: var(--j2-background, #0F0A2A); border-bottom: 1px solid #3A2F7A; }\n    .j2-top *, .j2-top *::before, .j2-top *::after { box-sizing: border-box; }\n    .j2-top .j2-top-inner { max-width: 1120px; margin: 0 auto; padding: 0 16px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; }\n    .j2-top .j2-top-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; min-height: 64px; }\n    .j2-top .j2-brand { display: inline-flex; align-items: center; min-height: 48px; font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif); font-weight: 700; font-size: 1.35rem; color: var(--j2-primary, #FFC83D); text-decoration: none; }\n    .j2-top .j2-brand:focus-visible, .j2-top .j2-navlink:focus-visible, .j2-top .j2-menu-btn:focus-visible { outline: 3px solid var(--j2-text, #F5F3FF); outline-offset: 2px; }\n    .j2-top .j2-menu-btn { display: none; align-items: center; justify-content: center; min-height: 48px; min-width: 48px; padding: 8px 16px; font-family: var(--j2-font-body, 'Inter', system-ui, sans-serif); font-size: 1rem; }\n    .j2-js .j2-top .j2-menu-btn { display: inline-flex; }\n    .j2-top .j2-nav { width: 100%; }\n    .j2-js .j2-top .j2-nav { display: none; }\n    .j2-js .j2-top.j2-open .j2-nav { display: block; }\n    .j2-top .j2-navlist { list-style: none; margin: 0; padding: 0 0 12px; display: grid; gap: 4px; }\n    .j2-top .j2-navlink { display: flex; align-items: center; min-height: 48px; padding: 0 12px; color: var(--j2-text, #F5F3FF); text-decoration: none; font-weight: 600; font-size: 1.05rem; border-radius: var(--j2-radius, 12px); }\n    .j2-top .j2-navlink:hover { color: var(--j2-primary, #FFC83D); background: var(--j2-surface, #1B1445); }\n\n    @media (min-width: 900px) {\n      .j2-top .j2-top-inner { padding: 0 24px; flex-wrap: nowrap; }\n      .j2-top .j2-top-bar { width: auto; }\n      .j2-js .j2-top .j2-menu-btn { display: none; }\n      .j2-top .j2-nav, .j2-js .j2-top .j2-nav, .j2-js .j2-top.j2-open .j2-nav { display: block; width: auto; }\n      .j2-top .j2-navlist { display: flex; gap: 4px; padding: 0; }\n      .j2-top .j2-navlink { padding: 0 14px; }\n    }\n\n    #hero { order: -1; position: relative; width: 100%; box-sizing: border-box; overflow-x: hidden; padding: 64px 16px 72px; color: var(--j2-text, #F5F3FF); background: radial-gradient(circle at 85% 0%, rgba(124, 92, 255, 0.4), transparent 55%), radial-gradient(circle at 0% 100%, rgba(34, 211, 238, 0.18), transparent 50%), var(--j2-background, #0F0A2A); }\n    #hero *, #hero *::before, #hero *::after { box-sizing: border-box; }\n    #hero .j2-hero-wrap { max-width: 1120px; margin: 0 auto; }\n    #hero .j2-kicker { display: inline-block; margin: 0 0 16px; padding: 6px 14px; border: 2px solid var(--j2-accent, #22D3EE); border-radius: 999px; color: var(--j2-accent, #22D3EE); font-size: 0.85rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }\n    #hero .j2-title { font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif); font-weight: 700; font-size: clamp(3rem, 15vw, 6.5rem); line-height: 1; letter-spacing: -0.02em; margin: 0 0 16px; color: var(--j2-text, #F5F3FF); overflow-wrap: anywhere; }\n    #hero .j2-title::after { content: \"\"; display: block; width: 96px; height: 8px; margin-top: 16px; border-radius: 4px; background: linear-gradient(90deg, var(--j2-primary, #FFC83D), var(--j2-secondary, #7C5CFF)); }\n    #hero .j2-hero-college { font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif); font-weight: 600; font-size: clamp(1.2rem, 4.5vw, 1.75rem); line-height: 1.25; margin: 0 0 8px; overflow-wrap: anywhere; }\n    #hero .j2-hero-dates { font-size: clamp(1.1rem, 4vw, 1.4rem); font-weight: 600; color: var(--j2-primary, #FFC83D); margin: 0 0 32px; }\n    #hero .j2-herocta { display: inline-flex; align-items: center; justify-content: center; text-align: center; text-decoration: none; min-height: 56px; min-width: 48px; width: 100%; max-width: 320px; padding: 14px 32px; font-family: var(--j2-font-body, 'Inter', system-ui, sans-serif); font-size: 1.15rem; }\n    #hero .j2-herocta:focus-visible { outline: 3px solid var(--j2-text, #F5F3FF); outline-offset: 3px; }\n    @media (min-width: 768px) {\n      #hero { padding: 112px 24px 120px; }\n      #hero .j2-herocta { width: auto; min-width: 240px; }\n    }\n  </style>\n\n  <div class=\"j2-top-inner\">\n    <div class=\"j2-top-bar\">\n      <a class=\"j2-brand\" href=\"#hero\">Spark 2026</a>\n      <button type=\"button\" class=\"j2-btn-secondary j2-menu-btn\" aria-expanded=\"false\" aria-controls=\"j2-navlist\">Menu</button>\n    </div>\n    <nav class=\"j2-nav\" aria-label=\"Main\">\n      <ul class=\"j2-navlist\" id=\"j2-navlist\">\n        <li><a class=\"j2-navlink\" href=\"#schedule\">Schedule</a></li>\n        <li><a class=\"j2-navlink\" href=\"#events\">Events</a></li>\n        <li><a class=\"j2-navlink\" href=\"#register\">Register</a></li>\n        <li><a class=\"j2-navlink\" href=\"#sponsors\">Sponsors</a></li>\n        <li><a class=\"j2-navlink\" href=\"#venue\">Venue</a></li>\n        <li><a class=\"j2-navlink\" href=\"#contact\">Contact</a></li>\n      </ul>\n    </nav>\n  </div>\n\n  <script>\n    (function () {\n      var top = document.getElementById('top');\n      if (!top) { return; }\n      var btn = top.querySelector('.j2-menu-btn');\n      var links = Array.prototype.slice.call(top.querySelectorAll('.j2-navlink'));\n      if (!btn) { return; }\n      document.documentElement.classList.add('j2-js');\n\n      function setOpen(open) {\n        if (open) { top.classList.add('j2-open'); }\n        else { top.classList.remove('j2-open'); }\n        btn.setAttribute('aria-expanded', open ? 'true' : 'false');\n        btn.textContent = open ? 'Close' : 'Menu';\n      }\n\n      btn.addEventListener('click', function () {\n        setOpen(!top.classList.contains('j2-open'));\n      });\n      links.forEach(function (link) {\n        link.addEventListener('click', function () { setOpen(false); });\n      });\n      document.addEventListener('keydown', function (e) {\n        if (e.key === 'Escape' && top.classList.contains('j2-open')) {\n          setOpen(false);\n          btn.focus();\n        }\n      });\n    })();\n  </script>\n</header>\n\n<section id=\"hero\" class=\"j2-hero\" aria-labelledby=\"hero-title\">\n  <div class=\"j2-hero-wrap\">\n    <p class=\"j2-kicker\">College tech fest</p>\n    <h1 id=\"hero-title\" class=\"j2-title\">Spark 2026</h1>\n    <p class=\"j2-hero-college\">Northfield College of Engineering, Pune</p>\n    <p class=\"j2-hero-dates\">14 to 16 February 2027</p>\n    <a class=\"j2-btn j2-herocta\" href=\"#register\">Register</a>\n  </div>\n</section>",
    "workflow": "Hero, nav and base style"
  }
}