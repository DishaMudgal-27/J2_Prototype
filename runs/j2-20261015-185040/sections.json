{
  "style": {
    "owner": "W-1",
    "head": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&amp;family=Inter:wght@400;500;600&amp;display=swap\"><style>:root{--j2-primary:#4A2E1F;--j2-secondary:#F1E4D3;--j2-accent:#B4531F;--j2-background:#FBF6EF;--j2-surface:#FFFFFF;--j2-text:#2B1B12;--j2-muted:#6B5547;--j2-font-heading:'Fraunces', Georgia, serif;--j2-font-body:'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:12px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;background:#4A2E1F;color:#FFFFFF;border:2px solid #4A2E1F;min-height:48px;padding:12px 24px;border-radius:12px;font-weight:600;font-size:1rem;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer}.j2-btn-secondary{display:inline-block;background:transparent;color:#4A2E1F;border:2px solid #4A2E1F;min-height:48px;padding:12px 24px;border-radius:12px;font-weight:600;font-size:1rem;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer}.j2-card{background:#FFFFFF;border:1px solid #E6D5C0;border-radius:12px;padding:16px;box-shadow:0 1px 3px rgba(43,27,18,0.08)}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-1": {
    "owner": "W-1",
    "head": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Inter:wght@400;500;600&display=swap\">",
    "body": "<style>\n  #top, #location { box-sizing: border-box; font-family: var(--j2-font-body); color: var(--j2-text); }\n  #top *, #location * { box-sizing: border-box; }\n  #top { background: var(--j2-secondary); border-bottom: 1px solid #E6D5C0; padding: 16px 16px 32px; }\n  #top .w1-inner, #location .w1-inner { max-width: 960px; margin: 0 auto; }\n  #top h1 { font-family: var(--j2-font-heading); color: var(--j2-primary); font-size: clamp(2.25rem, 8vw, 3.5rem); line-height: 1.1; margin: 24px 0 8px; overflow-wrap: anywhere; }\n  #top .w1-tagline { color: var(--j2-muted); font-size: 1.125rem; margin: 0 0 24px; }\n  #site-nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }\n  #site-nav a { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 44px; padding: 8px 14px; color: var(--j2-primary); font-weight: 600; text-decoration: none; border-radius: var(--j2-radius); border: 1px solid transparent; }\n  #site-nav a:hover, #site-nav a:focus-visible { background: var(--j2-surface); border-color: var(--j2-primary); outline: none; }\n  #top .j2-btn { margin-top: 8px; }\n  #location { padding: var(--j2-section, 64px) 16px; background: var(--j2-background); scroll-margin-top: 16px; }\n  #location h2 { font-family: var(--j2-font-heading); color: var(--j2-primary); font-size: clamp(1.75rem, 5vw, 2.25rem); margin: 0 0 16px; }\n  #location .w1-panel { background: var(--j2-surface); border: 1px solid #E6D5C0; border-radius: var(--j2-radius); padding: 24px; max-width: 520px; }\n  #location address { font-style: normal; font-size: 1.125rem; line-height: 1.5; margin: 0 0 16px; overflow-wrap: anywhere; }\n  #location #map-link { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; min-width: 44px; padding: 12px 24px; background: transparent; color: var(--j2-primary); border: 2px solid var(--j2-primary); border-radius: var(--j2-radius); font-weight: 600; text-decoration: none; text-align: center; }\n  #location #map-link:hover, #location #map-link:focus-visible { background: var(--j2-secondary); }\n  @media (max-width: 480px) {\n    #site-nav a { flex: 1 1 calc(50% - 8px); }\n    #top .j2-btn, #location #map-link { width: 100%; }\n  }\n</style>\n\n<header id=\"top\">\n  <div class=\"w1-inner\">\n    <nav id=\"site-nav\" aria-label=\"Main\">\n      <ul>\n        <li><a href=\"#menu\">Menu</a></li>\n        <li><a href=\"#hours\">Hours</a></li>\n        <li><a href=\"#location\">Find us</a></li>\n        <li><a href=\"#contact\">Contact</a></li>\n        <li><a href=\"#preorder\">Pre-order</a></li>\n      </ul>\n    </nav>\n    <h1>Brew Lab</h1>\n    <p class=\"w1-tagline\">Specialty coffee shop in Indiranagar, Bengaluru</p>\n    <a class=\"j2-btn\" href=\"#preorder\">Pre-order for pickup</a>\n  </div>\n</header>\n\n<section id=\"location\" aria-labelledby=\"location-heading\">\n  <div class=\"w1-inner\">\n    <h2 id=\"location-heading\">Find us</h2>\n    <div class=\"w1-panel\">\n      <address>12, 100 Feet Road, Indiranagar, Bengaluru 560038</address>\n      <a id=\"map-link\" href=\"https://www.google.com/maps/search/?api=1&amp;query=12%2C+100+Feet+Road%2C+Indiranagar%2C+Bengaluru+560038\" target=\"_blank\" rel=\"noopener noreferrer\">Open in Google Maps</a>\n    </div>\n  </div>\n</section>",
    "workflow": "Header, nav and location with map link"
  },
  "W-2": {
    "owner": "W-2",
    "head": "",
    "body": "<section id=\"menu\" aria-labelledby=\"menu-heading\">\n  <style>\n    #menu { padding: var(--j2-section, 64px) 16px; background: var(--j2-background, #FBF6EF); scroll-margin-top: 72px; }\n    #menu .w2-inner { max-width: 1040px; margin: 0 auto; }\n    #menu .w2-title { font-family: var(--j2-font-heading); color: var(--j2-primary); margin: 0 0 8px; font-size: clamp(1.5rem, 4vw, 2rem); line-height: 1.2; }\n    #menu .w2-note { color: var(--j2-muted, #6B5547); margin: 0 0 24px; font-size: 1rem; }\n    #menu .w2-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 16px; }\n    #menu .j2-card { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; min-width: 0; }\n    #menu .w2-name { font-family: var(--j2-font-body); color: var(--j2-text, #2B1B12); font-weight: 500; font-size: 1.0625rem; overflow-wrap: anywhere; }\n    #menu .w2-price { font-family: var(--j2-font-heading); color: var(--j2-primary); font-weight: 700; font-size: 1.25rem; white-space: nowrap; }\n    #menu .w2-price::before { content: \"\\20B9\"; }\n  </style>\n  <div class=\"w2-inner\">\n    <h2 id=\"menu-heading\" class=\"w2-title\">Menu</h2>\n    <p class=\"w2-note\">All prices are in rupees.</p>\n    <ul class=\"w2-grid\">\n      <li class=\"j2-card\"><span class=\"w2-name\">Filter coffee</span> <span class=\"w2-price\">90</span></li>\n      <li class=\"j2-card\"><span class=\"w2-name\">Cappuccino</span> <span class=\"w2-price\">160</span></li>\n      <li class=\"j2-card\"><span class=\"w2-name\">Latte</span> <span class=\"w2-price\">180</span></li>\n      <li class=\"j2-card\"><span class=\"w2-name\">Cold brew</span> <span class=\"w2-price\">200</span></li>\n      <li class=\"j2-card\"><span class=\"w2-name\">Masala chai</span> <span class=\"w2-price\">80</span></li>\n      <li class=\"j2-card\"><span class=\"w2-name\">Almond croissant</span> <span class=\"w2-price\">140</span></li>\n      <li class=\"j2-card\"><span class=\"w2-name\">Banana bread slice</span> <span class=\"w2-price\">120</span></li>\n    </ul>\n  </div>\n</section>",
    "workflow": "Menu with prices"
  },
  "W-3": {
    "owner": "W-3",
    "head": "",
    "body": "<style>\n  .w3-inner { max-width: 1100px; margin: 0 auto; padding: 0 16px; box-sizing: border-box; }\n  .w3-band { padding: var(--j2-section, 64px) 0; font-family: var(--j2-font-body); color: var(--j2-text); }\n  .w3-band-alt { background: var(--j2-secondary); }\n  .w3-title { font-family: var(--j2-font-heading); color: var(--j2-primary); font-size: 1.75rem; line-height: 1.2; margin: 0 0 8px; }\n  .w3-lead { color: var(--j2-muted); margin: 0 0 24px; overflow-wrap: anywhere; }\n  .w3-card { max-width: 560px; box-sizing: border-box; }\n  .w3-list { list-style: none; margin: 0; padding: 0; }\n  .w3-list li { font-size: 1.125rem; font-weight: 500; padding: 12px 0; border-bottom: 1px solid var(--j2-secondary); overflow-wrap: anywhere; }\n  .w3-list li:last-child { border-bottom: 0; }\n  .w3-actions { display: flex; flex-wrap: wrap; gap: 16px; }\n  .w3-actions .j2-btn { box-sizing: border-box; min-height: 48px; min-width: 48px; max-width: 100%; overflow-wrap: anywhere; text-align: center; }\n  .w3-actions .j2-btn-secondary { background: transparent; color: var(--j2-primary); border: 2px solid var(--j2-primary); }\n  @media (max-width: 480px) {\n    .w3-actions { flex-direction: column; }\n    .w3-actions .j2-btn { width: 100%; }\n    .w3-title { font-size: 1.5rem; }\n  }\n</style>\n\n<section id=\"hours\" class=\"w3-band\" aria-label=\"Opening hours\">\n  <div class=\"w3-inner\">\n    <h2 class=\"w3-title\">Opening hours</h2>\n    <p class=\"w3-lead\">Walk in, or pre-order and pick up when you arrive.</p>\n    <div class=\"j2-card w3-card\">\n      <ul class=\"w3-list\">\n        <li>Monday to Saturday 7:30 am to 9:00 pm</li>\n        <li>Sunday 8:30 am to 6:00 pm</li>\n      </ul>\n    </div>\n  </div>\n</section>\n\n<section id=\"contact\" class=\"w3-band w3-band-alt\" aria-label=\"Contact details\">\n  <div class=\"w3-inner\">\n    <h2 class=\"w3-title\">Contact us</h2>\n    <p class=\"w3-lead\">Questions about your order? Call or write to us.</p>\n    <div class=\"w3-actions\">\n      <a id=\"phone-link\" class=\"j2-btn\" href=\"tel:+919845012345\">+91 98450 12345</a>\n      <a id=\"email-link\" class=\"j2-btn j2-btn-secondary\" href=\"mailto:hello@brewlab.example\">hello@brewlab.example</a>\n    </div>\n  </div>\n</section>",
    "workflow": "Opening hours and contact details"
  },
  "W-4": {
    "owner": "W-4",
    "head": "",
    "body": "<section id=\"preorder\" aria-labelledby=\"po-heading\">\n<style>\n#preorder{background:var(--j2-background);color:var(--j2-text);font-family:var(--j2-font-body);padding:64px 16px;box-sizing:border-box}\n#preorder *,#preorder *::before,#preorder *::after{box-sizing:border-box}\n#preorder .po-wrap{max-width:640px;margin:0 auto}\n#preorder h2{font-family:var(--j2-font-heading);color:var(--j2-primary);font-size:2rem;line-height:1.2;margin:0 0 8px}\n#preorder .po-lead{color:var(--j2-muted);margin:0 0 24px;line-height:1.5;overflow-wrap:anywhere}\n#preorder #po-form{display:block;width:100%}\n#preorder .po-field{display:block;margin:0 0 16px}\n#preorder .po-field label{display:block;font-weight:600;color:var(--j2-text);margin:0 0 8px}\n#preorder .po-field input,#preorder .po-field textarea{display:block;width:100%;min-height:48px;padding:12px 16px;font-family:var(--j2-font-body);font-size:1rem;color:var(--j2-text);background:var(--j2-surface);border:2px solid var(--j2-primary);border-radius:12px}\n#preorder .po-field textarea{min-height:120px;resize:vertical}\n#preorder .po-field input:focus,#preorder .po-field textarea:focus,#preorder #po-submit:focus{outline:3px solid var(--j2-accent);outline-offset:2px}\n#preorder #po-submit{width:100%;margin-top:8px}\n#preorder .po-note{margin:16px 0 0;color:var(--j2-text);font-weight:500;line-height:1.5;overflow-wrap:anywhere}\n#preorder #po-status{margin:16px 0 0;padding:12px 16px;background:var(--j2-secondary);color:var(--j2-primary);border-left:4px solid var(--j2-accent);border-radius:12px;font-weight:500;line-height:1.5;overflow-wrap:anywhere}\n#preorder #po-status[hidden]{display:none}\n@media (min-width:768px){#preorder #po-submit{width:auto;min-width:200px}}\n</style>\n<div class=\"po-wrap\">\n<h2 id=\"po-heading\">Pre-order for pickup</h2>\n<p class=\"po-lead\">Tell us what you would like and when you will collect it. Your order is emailed to hello@brewlab.example.</p>\n<form id=\"po-form\" class=\"j2-card\" action=\"mailto:hello@brewlab.example\" method=\"post\" enctype=\"text/plain\" novalidate>\n<div class=\"po-field\">\n<label for=\"po-name\">Name</label>\n<input type=\"text\" id=\"po-name\" name=\"Name\" autocomplete=\"name\">\n</div>\n<div class=\"po-field\">\n<label for=\"po-phone\">Phone</label>\n<input type=\"tel\" id=\"po-phone\" name=\"Phone\" autocomplete=\"tel\" inputmode=\"tel\">\n</div>\n<div class=\"po-field\">\n<label for=\"po-items\">Items</label>\n<textarea id=\"po-items\" name=\"Items\" rows=\"4\" placeholder=\"For example: 1 Cappuccino, 1 Almond croissant\"></textarea>\n</div>\n<div class=\"po-field\">\n<label for=\"po-time\">Pickup time</label>\n<input type=\"time\" id=\"po-time\" name=\"Pickup time\">\n</div>\n<button type=\"submit\" id=\"po-submit\" class=\"j2-btn\">Send pre-order</button>\n<p class=\"po-note\">Payment is at pickup. No online payment.</p>\n<p id=\"po-status\" role=\"status\" aria-live=\"polite\" hidden></p>\n</form>\n</div>\n<script>\n(function () {\n  var form = document.getElementById('po-form');\n  var status = document.getElementById('po-status');\n  if (!form || !status) { return; }\n  var ids = ['po-name', 'po-phone', 'po-items', 'po-time'];\n  form.addEventListener('submit', function (event) {\n    var firstEmpty = null;\n    for (var i = 0; i < ids.length; i++) {\n      var el = document.getElementById(ids[i]);\n      if (!el || String(el.value).replace(/\\s+/g, '') === '') {\n        if (!firstEmpty && el) { firstEmpty = el; }\n        if (!el) { firstEmpty = firstEmpty || form; }\n      }\n    }\n    if (firstEmpty) {\n      event.preventDefault();\n      status.textContent = 'Please fill every field: name, phone, items and pickup time.';\n      status.hidden = false;\n      if (firstEmpty.focus) { firstEmpty.focus(); }\n      return;\n    }\n    status.textContent = 'Thank you. Your email app should open with the order ready to send to hello@brewlab.example. Press send there to finish. You pay at pickup.';\n    status.hidden = false;\n  });\n})();\n</script>\n</section>",
    "workflow": "Pre-order form"
  },
  "W-5": {
    "owner": "W-5",
    "head": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<style>\n*, *::before, *::after { box-sizing: border-box; }\nimg, svg, video, iframe, canvas, table { max-width: 100%; }\nimg, svg, video { height: auto; }\n.j2-card { max-width: 100%; }\nh1, h2, h3, p, li, a, dt, dd, label, span { overflow-wrap: anywhere; }\n.j2-wrap { width: 100%; max-width: 1120px; margin-left: auto; margin-right: auto; padding-left: 16px; padding-right: 16px; }\n</style>",
    "body": "<footer id=\"site-footer\" aria-label=\"Site footer\">\n  <div class=\"j2-wrap w5-inner\">\n    <p class=\"w5-name\">Brew Lab</p>\n    <a class=\"w5-top\" href=\"#top\">Back to top</a>\n  </div>\n  <style>\n    #site-footer { background: var(--j2-primary); color: var(--j2-secondary); padding: 32px 0; font-family: var(--j2-font-body); }\n    #site-footer .w5-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }\n    #site-footer .w5-name { margin: 0; font-family: var(--j2-font-heading); font-weight: 700; font-size: 1.25rem; color: var(--j2-secondary); }\n    #site-footer .w5-top { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; min-width: 48px; padding: 12px 16px; color: var(--j2-secondary); font-weight: 600; text-decoration: underline; border: 2px solid var(--j2-secondary); border-radius: 12px; }\n    #site-footer .w5-top:focus-visible { outline: 3px solid var(--j2-secondary); outline-offset: 3px; }\n  </style>\n</footer>",
    "workflow": "Mobile setup, overflow guard and footer"
  }
}