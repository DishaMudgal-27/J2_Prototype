{
  "W-1": {
    "owner": "W-1",
    "head": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"dark\">\n<title>Frontend Developer Portfolio</title>\n<style>\n  :root {\n    --bg: #0b0d12;\n    --surface: #141824;\n    --border: #262c3d;\n    --text: #e8eaf0;\n    --muted: #a3a9b8;\n    --accent: #7c9cff;\n    --accent-ink: #0b0d12;\n    --radius: 12px;\n  }\n  *, *::before, *::after { box-sizing: border-box; }\n  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }\n  body {\n    margin: 0;\n    background: var(--bg);\n    color: var(--text);\n    font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n    line-height: 1.6;\n  }\n  img, svg, video { max-width: 100%; height: auto; }\n  a { color: var(--accent); }\n  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }\n  .container { width: min(100% - 2rem, 1100px); margin-inline: auto; }\n</style>",
    "body": "<style>\n  #hero { padding: clamp(3rem, 10vw, 7rem) 0; border-bottom: 1px solid var(--border); }\n  #hero .hero-inner { max-width: 760px; }\n  #hero .hero-badge {\n    display: inline-block;\n    margin: 0 0 1.25rem;\n    padding: .3rem .8rem;\n    font-size: .8rem;\n    color: var(--muted);\n    border: 1px solid var(--border);\n    border-radius: 999px;\n    background: var(--surface);\n  }\n  #hero h1 {\n    margin: 0 0 1rem;\n    font-size: clamp(2rem, 8vw, 3.75rem);\n    line-height: 1.1;\n    letter-spacing: -0.02em;\n    overflow-wrap: anywhere;\n  }\n  #hero .hero-tagline {\n    margin: 0 0 2rem;\n    font-size: clamp(1.05rem, 3.5vw, 1.35rem);\n    color: var(--muted);\n  }\n  #hero .hero-cta {\n    display: inline-block;\n    padding: .85rem 1.6rem;\n    background: var(--accent);\n    color: var(--accent-ink);\n    font-weight: 600;\n    text-decoration: none;\n    border-radius: var(--radius);\n    transition: transform .15s ease, filter .15s ease;\n  }\n  #hero .hero-cta:hover { filter: brightness(1.1); transform: translateY(-1px); }\n  #hero .hero-note { margin: 1.5rem 0 0; font-size: .85rem; color: var(--muted); }\n</style>\n<header id=\"hero\">\n  <div class=\"container hero-inner\">\n    <p class=\"hero-badge\">Dummy content: replace before launch</p>\n    <h1>[Placeholder Name]</h1>\n    <p class=\"hero-tagline\">I'm a frontend developer available for freelance work, building fast, accessible and polished interfaces.</p>\n    <a class=\"hero-cta\" href=\"#contact\">Hire me for your project</a>\n    <p class=\"hero-note\">The name above is a placeholder until the real one is supplied.</p>\n  </div>\n</header>",
    "workflow": "Dark base page, styling and hero"
  },
  "W-3": {
    "owner": "W-3",
    "head": "",
    "body": "<style>\n  #contact { padding: clamp(3rem, 8vw, 5.5rem) 0; border-top: 1px solid var(--border); scroll-margin-top: 1rem; }\n  #contact .contact-inner { max-width: 760px; }\n  #contact h2 {\n    margin: 0 0 .75rem;\n    font-size: clamp(1.6rem, 6vw, 2.5rem);\n    line-height: 1.15;\n    letter-spacing: -0.02em;\n  }\n  #contact .contact-intro { margin: 0 0 2rem; color: var(--muted); font-size: clamp(1rem, 3vw, 1.15rem); }\n  #contact .contact-email {\n    display: inline-block;\n    max-width: 100%;\n    margin: 0 0 1.5rem;\n    padding: .85rem 1.6rem;\n    background: var(--accent);\n    color: var(--accent-ink);\n    font-weight: 600;\n    text-decoration: none;\n    border-radius: var(--radius);\n    overflow-wrap: anywhere;\n    transition: transform .15s ease, filter .15s ease;\n  }\n  #contact .contact-email:hover { filter: brightness(1.1); transform: translateY(-1px); }\n  #contact .contact-links {\n    display: flex;\n    flex-wrap: wrap;\n    gap: .75rem;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n  #contact .contact-links a {\n    display: inline-block;\n    padding: .7rem 1.25rem;\n    color: var(--text);\n    background: var(--surface);\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n    text-decoration: none;\n    font-weight: 500;\n    transition: border-color .15s ease, color .15s ease;\n  }\n  #contact .contact-links a:hover { border-color: var(--accent); color: var(--accent); }\n  #contact .contact-note { margin: 1.75rem 0 0; font-size: .85rem; color: var(--muted); overflow-wrap: anywhere; }\n</style>\n<section id=\"contact\" aria-labelledby=\"contact-heading\">\n  <div class=\"container contact-inner\">\n    <h2 id=\"contact-heading\">Let's work together</h2>\n    <p class=\"contact-intro\">I'm open to freelance frontend projects. Send an email and I'll reply with next steps.</p>\n    <a class=\"contact-email\" href=\"mailto:hello@example.com\">hello@example.com</a>\n    <ul class=\"contact-links\">\n      <li><a href=\"https://github.com/your-username\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub</a></li>\n      <li><a href=\"https://www.linkedin.com/in/your-username\" target=\"_blank\" rel=\"noopener noreferrer\">LinkedIn</a></li>\n    </ul>\n    <p class=\"contact-note\">Dummy content: the email address and the GitHub and LinkedIn links are placeholders until the real ones are supplied.</p>\n  </div>\n</section>",
    "workflow": "Contact section with email and profile links"
  },
  "W-2": {
    "owner": "W-2",
    "head": "",
    "body": "<style>\n  #projects { padding: clamp(3rem, 8vw, 5.5rem) 0; border-top: 1px solid var(--border); scroll-margin-top: 1rem; }\n  #projects .projects-intro { margin: 0 0 2rem; max-width: 760px; color: var(--muted); font-size: clamp(1rem, 3vw, 1.15rem); }\n  #projects h2 {\n    margin: 0 0 .75rem;\n    font-size: clamp(1.6rem, 6vw, 2.5rem);\n    line-height: 1.15;\n    letter-spacing: -0.02em;\n  }\n  #projects .projects-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));\n    gap: 1.25rem;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n  #projects .project-card {\n    min-width: 0;\n    padding: 1.5rem;\n    background: var(--surface);\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n    transition: border-color .15s ease, transform .15s ease;\n  }\n  #projects .project-card:hover { border-color: var(--accent); transform: translateY(-2px); }\n  #projects .project-card h3 {\n    margin: 0 0 .5rem;\n    font-size: 1.2rem;\n    line-height: 1.3;\n    overflow-wrap: anywhere;\n  }\n  #projects .project-card p { margin: 0; color: var(--muted); overflow-wrap: anywhere; }\n  #projects .projects-note { margin: 1.75rem 0 0; font-size: .85rem; color: var(--muted); overflow-wrap: anywhere; }\n</style>\n<section id=\"projects\" aria-labelledby=\"projects-heading\">\n  <div class=\"container\">\n    <h2 id=\"projects-heading\">Selected projects</h2>\n    <p class=\"projects-intro\">A few examples of the interfaces I build for freelance clients.</p>\n    <div class=\"projects-grid\">\n      <article class=\"project-card\">\n        <h3>[Project One]</h3>\n        <p>A responsive marketing site built for speed and accessibility.</p>\n      </article>\n      <article class=\"project-card\">\n        <h3>[Project Two]</h3>\n        <p>A dashboard interface that turns complex data into clear charts.</p>\n      </article>\n      <article class=\"project-card\">\n        <h3>[Project Three]</h3>\n        <p>An online store front end with a fast, simple checkout flow.</p>\n      </article>\n    </div>\n    <p class=\"projects-note\">Dummy content: these project titles and descriptions are placeholders until the real projects are supplied.</p>\n  </div>\n</section>",
    "workflow": "Projects section with 3 placeholder cards"
  }
}