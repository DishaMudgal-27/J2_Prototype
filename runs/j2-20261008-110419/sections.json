{
  "style": {
    "owner": "W-1",
    "head": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&amp;family=Nunito+Sans:wght@400;600;700&amp;display=swap\"><style>:root{--j2-primary:#8A3B1E;--j2-secondary:#4F5D3A;--j2-accent:#B8863B;--j2-background:#FAF5EC;--j2-surface:#F1E7D6;--j2-text:#2E2418;--j2-muted:#6B5B4B;--j2-font-heading:'Cormorant Garamond', Georgia, 'Times New Roman', serif;--j2-font-body:'Nunito Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:12px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;background:#8A3B1E;color:#FFFFFF;border:2px solid #8A3B1E;min-height:48px;padding:12px 24px;font-weight:700;letter-spacing:.02em;border-radius:12px}.j2-btn-secondary{display:inline-block;background:transparent;color:#4F5D3A;border:2px solid #4F5D3A;min-height:48px;padding:12px 24px;font-weight:700;letter-spacing:.02em;border-radius:12px}.j2-card{background:#FFFFFF;border:1px solid #E3D5BD;border-radius:12px;padding:16px;box-shadow:0 1px 3px rgba(46,36,24,.08)}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-1": {
    "owner": "W-1",
    "head": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"theme-color\" content=\"#8A3B1E\">",
    "body": "<!-- W-1: earthy theme and mobile base (no visible content; shared base styles for all sections) -->\n<style>\n*,*::before,*::after{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%;scroll-behavior:smooth;scroll-padding-top:72px;overflow-x:hidden}\nbody{margin:0;width:100%;max-width:100%;overflow-x:clip;font-family:var(--j2-font-body,'Nunito Sans',system-ui,sans-serif);font-size:16px;line-height:1.6;background:var(--j2-background,#FAF5EC);color:var(--j2-text,#2E2418);-webkit-font-smoothing:antialiased}\nh1,h2,h3,h4{font-family:var(--j2-font-heading,'Cormorant Garamond',Georgia,serif);line-height:1.2;margin:0 0 .5em;color:var(--j2-text,#2E2418);overflow-wrap:anywhere}\nh1{font-size:clamp(2rem,7vw,3.25rem)}\nh2{font-size:clamp(1.6rem,5vw,2.4rem)}\nh3{font-size:clamp(1.2rem,3.5vw,1.5rem)}\np{margin:0 0 1em;overflow-wrap:anywhere}\na{color:var(--j2-primary,#8A3B1E)}\nimg,svg,video,iframe{max-width:100%;height:auto}\ntable{max-width:100%}\n.j2-container{width:100%;max-width:1120px;margin-inline:auto;padding-inline:16px}\n.j2-section{padding-block:clamp(40px,8vw,64px)}\n.j2-grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fill,minmax(min(100%,220px),1fr))}\n.j2-grid>*,.j2-container>*{min-width:0}\n.j2-table-wrap{width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}\n.j2-btn,.j2-btn-secondary{display:inline-flex;align-items:center;justify-content:center;text-align:center;text-decoration:none;cursor:pointer;min-height:44px;font-family:inherit;font-size:1rem;max-width:100%}\n.j2-photo{display:grid;place-items:center;width:100%;aspect-ratio:4/5;background:repeating-linear-gradient(45deg,#F1E7D6,#F1E7D6 10px,#EADCC4 10px,#EADCC4 20px);border:1px dashed #B8863B;border-radius:var(--j2-radius,12px);color:var(--j2-muted,#6B5B4B);font-size:.85rem;text-align:center;padding:8px}\n.j2-photo::after{content:\"Photo coming soon\"}\nselect,input,button,textarea{font-family:inherit;font-size:16px;max-width:100%}\nselect,input[type=\"text\"],input[type=\"number\"],input[type=\"range\"]{min-height:44px}\na:focus-visible,button:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid var(--j2-accent,#B8863B);outline-offset:2px}\n@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}\n</style>",
    "workflow": "Earthy theme and mobile base"
  },
  "W-2": {
    "owner": "W-4",
    "head": "<meta name=\"description\" content=\"Thread & Loom, a handloom clothing boutique in Pune. Kurtas, sarees, cotton shirts and dupattas.\">\n<script>document.title = \"Thread & Loom | Handloom boutique in Pune\";</script>",
    "body": "<!-- W-2: header, navigation, product catalogue and filters.\n     Nav targets other sections should use as ids: new-arrivals, size-guide, lookbook, visit, returns, reviews, delivery.\n     Nav links whose target id is missing are hidden by script, and appear once the section exists. -->\n<style>\nhtml{scroll-padding-top:112px}\n.tl-header{position:sticky;top:0;z-index:50;background:var(--j2-background);border-bottom:1px solid #E3D5BD}\n.tl-bar{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px;padding-top:8px}\n.tl-brand{font-family:var(--j2-font-heading);font-size:1.6rem;font-weight:700;line-height:1.2;color:var(--j2-primary);text-decoration:none}\n.tl-city{font-size:.85rem;letter-spacing:.1em;text-transform:uppercase;color:var(--j2-muted)}\n.tl-nav{overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:thin}\n.tl-nav ul{display:flex;gap:4px;list-style:none;margin:0;padding:0;white-space:nowrap}\n.tl-nav a{display:inline-flex;align-items:center;min-height:44px;padding:0 12px;font-weight:600;text-decoration:none;color:var(--j2-text);border-radius:var(--j2-radius)}\n.tl-nav a:hover{color:var(--j2-primary)}\n.tl-hero{background:var(--j2-surface);padding-block:clamp(32px,8vw,64px)}\n.tl-eyebrow{margin:0 0 8px;font-size:.85rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--j2-secondary)}\n.tl-hero p.tl-lead{max-width:60ch;color:var(--j2-muted);margin-bottom:24px}\n.tl-filters{display:grid;gap:16px;margin-bottom:24px}\n.tl-chips{display:flex;flex-wrap:wrap;gap:8px}\n.tl-chips .j2-btn-secondary{min-height:44px;padding:8px 16px;background:transparent}\n.tl-chips .j2-btn-secondary.tl-on{background:var(--j2-primary);border-color:var(--j2-primary);color:#FFFFFF}\n.tl-selects{display:flex;flex-wrap:wrap;gap:16px;align-items:flex-end}\n.tl-field{display:grid;gap:4px;font-weight:600;flex:1 1 160px;min-width:0}\n.tl-field select{width:100%;padding:8px 12px;border:2px solid var(--j2-secondary);border-radius:var(--j2-radius);background:#FFFFFF;color:var(--j2-text)}\n.tl-selects .j2-btn-secondary{flex:0 0 auto;padding:8px 16px}\n.tl-count{margin:0 0 16px;color:var(--j2-muted);font-weight:600}\n.tl-card[hidden]{display:none}\n.tl-card{display:flex;flex-direction:column;gap:4px}\n.tl-card .j2-photo{margin-bottom:8px}\n.tl-cat{margin:0;font-size:.8rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--j2-secondary)}\n.tl-card h3{margin:0}\n.tl-sizes{margin:0;color:var(--j2-muted);font-size:.95rem}\n.tl-price{margin:4px 0 0;font-family:var(--j2-font-heading);font-size:1.5rem;font-weight:700;color:var(--j2-primary)}\n.tl-card .tl-order{margin-top:auto;width:100%;min-height:48px;padding:12px 16px}\n.tl-card .tl-price{margin-bottom:12px}\n.tl-empty{padding:24px;text-align:center}\n.tl-empty[hidden]{display:none}\n</style>\n\n<header class=\"tl-header\" id=\"top\">\n  <div class=\"j2-container\">\n    <div class=\"tl-bar\">\n      <a class=\"tl-brand\" href=\"#top\">Thread &amp; Loom</a>\n      <span class=\"tl-city\">Handloom boutique, Pune</span>\n    </div>\n    <nav class=\"tl-nav\" aria-label=\"Main\">\n      <ul id=\"tl-navlist\">\n        <li><a href=\"#products\">Shop</a></li>\n        <li><a href=\"#new-arrivals\">New Arrivals</a></li>\n        <li><a href=\"#size-guide\">Size Guide</a></li>\n        <li><a href=\"#lookbook\">Lookbook</a></li>\n        <li><a href=\"#visit\">Visit</a></li>\n        <li><a href=\"#returns\">Returns</a></li>\n        <li><a href=\"#reviews\">Reviews</a></li>\n        <li><a href=\"#delivery\">Delivery</a></li>\n      </ul>\n    </nav>\n  </div>\n</header>\n\n<section class=\"tl-hero\" aria-labelledby=\"tl-h1\">\n  <div class=\"j2-container\">\n    <p class=\"tl-eyebrow\">Thread &amp; Loom, Pune</p>\n    <h1 id=\"tl-h1\">Handloom kurtas, sarees, shirts and dupattas</h1>\n    <p class=\"tl-lead\">A handloom clothing boutique on FC Road, Pune. Browse the collection and filter by size and price.</p>\n    <a class=\"j2-btn\" href=\"#products\">Shop the collection</a>\n  </div>\n</section>\n\n<section class=\"j2-section\" id=\"products\" aria-labelledby=\"tl-products-h\">\n  <div class=\"j2-container\">\n    <h2 id=\"tl-products-h\">Our collection</h2>\n\n    <div class=\"tl-filters j2-card\">\n      <div class=\"tl-chips\" role=\"group\" aria-label=\"Category\">\n        <button type=\"button\" class=\"j2-btn-secondary tl-chip tl-on\" data-cat=\"All\" aria-pressed=\"true\">All</button>\n        <button type=\"button\" class=\"j2-btn-secondary tl-chip\" data-cat=\"Kurtas\" aria-pressed=\"false\">Kurtas</button>\n        <button type=\"button\" class=\"j2-btn-secondary tl-chip\" data-cat=\"Sarees\" aria-pressed=\"false\">Sarees</button>\n        <button type=\"button\" class=\"j2-btn-secondary tl-chip\" data-cat=\"Shirts\" aria-pressed=\"false\">Shirts</button>\n        <button type=\"button\" class=\"j2-btn-secondary tl-chip\" data-cat=\"Dupattas\" aria-pressed=\"false\">Dupattas</button>\n      </div>\n      <div class=\"tl-selects\">\n        <label class=\"tl-field\" for=\"tl-size\">Size\n          <select id=\"tl-size\">\n            <option value=\"all\">All sizes</option>\n            <option value=\"XS\">XS</option>\n            <option value=\"S\">S</option>\n            <option value=\"M\">M</option>\n            <option value=\"L\">L</option>\n            <option value=\"XL\">XL</option>\n            <option value=\"XXL\">XXL</option>\n            <option value=\"Free\">Free size</option>\n          </select>\n        </label>\n        <label class=\"tl-field\" for=\"tl-price\">Price\n          <select id=\"tl-price\">\n            <option value=\"all\">Any price</option>\n            <option value=\"0-1500\">Under ₹1,500</option>\n            <option value=\"1500-3000\">₹1,500 to ₹2,999</option>\n            <option value=\"3000-\">₹3,000 and above</option>\n          </select>\n        </label>\n        <button type=\"button\" id=\"tl-reset\" class=\"j2-btn-secondary\">Reset</button>\n      </div>\n    </div>\n\n    <p class=\"tl-count\" id=\"tl-count\" role=\"status\" aria-live=\"polite\"></p>\n\n    <div class=\"j2-grid\" id=\"tl-grid\">\n      <article class=\"j2-card tl-card\" data-category=\"Kurtas\" data-sizes=\"S M L XL XXL\" data-price=\"1499\">\n        <div class=\"j2-photo\" role=\"img\" aria-label=\"Photo of Indigo block-print kurta coming soon\"></div>\n        <p class=\"tl-cat\">Kurta</p>\n        <h3>Indigo block-print kurta</h3>\n        <p class=\"tl-sizes\">Sizes: S-XXL</p>\n        <p class=\"tl-price\">₹1,499</p>\n        <a class=\"j2-btn tl-order\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20order%20the%20Indigo%20block-print%20kurta.\" target=\"_blank\" rel=\"noopener\" aria-label=\"Order on WhatsApp: Indigo block-print kurta\">Order on WhatsApp</a>\n      </article>\n      <article class=\"j2-card tl-card\" data-category=\"Kurtas\" data-sizes=\"S M L XL\" data-price=\"1699\">\n        <div class=\"j2-photo\" role=\"img\" aria-label=\"Photo of Mustard handloom kurta coming soon\"></div>\n        <p class=\"tl-cat\">Kurta</p>\n        <h3>Mustard handloom kurta</h3>\n        <p class=\"tl-sizes\">Sizes: S-XL</p>\n        <p class=\"tl-price\">₹1,699</p>\n        <a class=\"j2-btn tl-order\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20order%20the%20Mustard%20handloom%20kurta.\" target=\"_blank\" rel=\"noopener\" aria-label=\"Order on WhatsApp: Mustard handloom kurta\">Order on WhatsApp</a>\n      </article>\n      <article class=\"j2-card tl-card\" data-category=\"Kurtas\" data-sizes=\"XS S M L XL\" data-price=\"2199\">\n        <div class=\"j2-photo\" role=\"img\" aria-label=\"Photo of White chikankari kurta coming soon\"></div>\n        <p class=\"tl-cat\">Kurta</p>\n        <h3>White chikankari kurta</h3>\n        <p class=\"tl-sizes\">Sizes: XS-XL</p>\n        <p class=\"tl-price\">₹2,199</p>\n        <a class=\"j2-btn tl-order\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20order%20the%20White%20chikankari%20kurta.\" target=\"_blank\" rel=\"noopener\" aria-label=\"Order on WhatsApp: White chikankari kurta\">Order on WhatsApp</a>\n      </article>\n      <article class=\"j2-card tl-card\" data-category=\"Sarees\" data-sizes=\"Free\" data-price=\"3499\">\n        <div class=\"j2-photo\" role=\"img\" aria-label=\"Photo of Maheshwari cotton saree coming soon\"></div>\n        <p class=\"tl-cat\">Saree</p>\n        <h3>Maheshwari cotton saree</h3>\n        <p class=\"tl-sizes\">Free size</p>\n        <p class=\"tl-price\">₹3,499</p>\n        <a class=\"j2-btn tl-order\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20order%20the%20Maheshwari%20cotton%20saree.\" target=\"_blank\" rel=\"noopener\" aria-label=\"Order on WhatsApp: Maheshwari cotton saree\">Order on WhatsApp</a>\n      </article>\n      <article class=\"j2-card tl-card\" data-category=\"Sarees\" data-sizes=\"Free\" data-price=\"4999\">\n        <div class=\"j2-photo\" role=\"img\" aria-label=\"Photo of Chanderi silk-cotton saree coming soon\"></div>\n        <p class=\"tl-cat\">Saree</p>\n        <h3>Chanderi silk-cotton saree</h3>\n        <p class=\"tl-sizes\">Free size</p>\n        <p class=\"tl-price\">₹4,999</p>\n        <a class=\"j2-btn tl-order\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20order%20the%20Chanderi%20silk-cotton%20saree.\" target=\"_blank\" rel=\"noopener\" aria-label=\"Order on WhatsApp: Chanderi silk-cotton saree\">Order on WhatsApp</a>\n      </article>\n      <article class=\"j2-card tl-card\" data-category=\"Sarees\" data-sizes=\"Free\" data-price=\"3999\">\n        <div class=\"j2-photo\" role=\"img\" aria-label=\"Photo of Ikat handloom saree coming soon\"></div>\n        <p class=\"tl-cat\">Saree</p>\n        <h3>Ikat handloom saree</h3>\n        <p class=\"tl-sizes\">Free size</p>\n        <p class=\"tl-price\">₹3,999</p>\n        <a class=\"j2-btn tl-order\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20order%20the%20Ikat%20handloom%20saree.\" target=\"_blank\" rel=\"noopener\" aria-label=\"Order on WhatsApp: Ikat handloom saree\">Order on WhatsApp</a>\n      </article>\n      <article class=\"j2-card tl-card\" data-category=\"Shirts\" data-sizes=\"S M L XL XXL\" data-price=\"1299\">\n        <div class=\"j2-photo\" role=\"img\" aria-label=\"Photo of Khadi cotton shirt coming soon\"></div>\n        <p class=\"tl-cat\">Shirt</p>\n        <h3>Khadi cotton shirt</h3>\n        <p class=\"tl-sizes\">Sizes: S-XXL</p>\n        <p class=\"tl-price\">₹1,299</p>\n        <a class=\"j2-btn tl-order\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20order%20the%20Khadi%20cotton%20shirt.\" target=\"_blank\" rel=\"noopener\" aria-label=\"Order on WhatsApp: Khadi cotton shirt\">Order on WhatsApp</a>\n      </article>\n      <article class=\"j2-card tl-card\" data-category=\"Shirts\" data-sizes=\"M L XL XXL\" data-price=\"1599\">\n        <div class=\"j2-photo\" role=\"img\" aria-label=\"Photo of Linen-blend shirt coming soon\"></div>\n        <p class=\"tl-cat\">Shirt</p>\n        <h3>Linen-blend shirt</h3>\n        <p class=\"tl-sizes\">Sizes: M-XXL</p>\n        <p class=\"tl-price\">₹1,599</p>\n        <a class=\"j2-btn tl-order\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20order%20the%20Linen-blend%20shirt.\" target=\"_blank\" rel=\"noopener\" aria-label=\"Order on WhatsApp: Linen-blend shirt\">Order on WhatsApp</a>\n      </article>\n      <article class=\"j2-card tl-card\" data-category=\"Dupattas\" data-sizes=\"Free\" data-price=\"899\">\n        <div class=\"j2-photo\" role=\"img\" aria-label=\"Photo of Ajrakh dupatta coming soon\"></div>\n        <p class=\"tl-cat\">Dupatta</p>\n        <h3>Ajrakh dupatta</h3>\n        <p class=\"tl-sizes\">Free size</p>\n        <p class=\"tl-price\">₹899</p>\n        <a class=\"j2-btn tl-order\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20order%20the%20Ajrakh%20dupatta.\" target=\"_blank\" rel=\"noopener\" aria-label=\"Order on WhatsApp: Ajrakh dupatta\">Order on WhatsApp</a>\n      </article>\n      <article class=\"j2-card tl-card\" data-category=\"Dupattas\" data-sizes=\"Free\" data-price=\"1099\">\n        <div class=\"j2-photo\" role=\"img\" aria-label=\"Photo of Bandhani dupatta coming soon\"></div>\n        <p class=\"tl-cat\">Dupatta</p>\n        <h3>Bandhani dupatta</h3>\n        <p class=\"tl-sizes\">Free size</p>\n        <p class=\"tl-price\">₹1,099</p>\n        <a class=\"j2-btn tl-order\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20order%20the%20Bandhani%20dupatta.\" target=\"_blank\" rel=\"noopener\" aria-label=\"Order on WhatsApp: Bandhani dupatta\">Order on WhatsApp</a>\n      </article>\n    </div>\n\n    <div class=\"j2-card tl-empty\" id=\"tl-empty\" hidden>\n      <p>No products match these filters.</p>\n      <button type=\"button\" class=\"j2-btn\" id=\"tl-empty-reset\">Clear filters</button>\n    </div>\n  </div>\n</section>\n\n<script>\n(function () {\n  \"use strict\";\n  function init() {\n    var cards = Array.prototype.slice.call(document.querySelectorAll(\"#tl-grid .tl-card\"));\n    var chips = Array.prototype.slice.call(document.querySelectorAll(\".tl-chip\"));\n    var sizeSel = document.getElementById(\"tl-size\");\n    var priceSel = document.getElementById(\"tl-price\");\n    var countEl = document.getElementById(\"tl-count\");\n    var emptyEl = document.getElementById(\"tl-empty\");\n    var state = { cat: \"All\", size: \"all\", price: \"all\" };\n\n    function priceOk(price, range) {\n      if (range === \"all\") return true;\n      var parts = range.split(\"-\");\n      var min = Number(parts[0]);\n      var max = parts[1] === \"\" ? Infinity : Number(parts[1]);\n      return price >= min && price < max;\n    }\n\n    function apply() {\n      var shown = 0;\n      cards.forEach(function (card) {\n        var sizes = (card.getAttribute(\"data-sizes\") || \"\").split(\" \");\n        var price = Number(card.getAttribute(\"data-price\"));\n        var ok =\n          (state.cat === \"All\" || card.getAttribute(\"data-category\") === state.cat) &&\n          (state.size === \"all\" || sizes.indexOf(state.size) !== -1) &&\n          priceOk(price, state.price);\n        card.hidden = !ok;\n        if (ok) shown++;\n      });\n      if (countEl) countEl.textContent = \"Showing \" + shown + \" of \" + cards.length + \" products\";\n      if (emptyEl) emptyEl.hidden = shown !== 0;\n    }\n\n    function setCat(cat) {\n      state.cat = cat;\n      chips.forEach(function (chip) {\n        var on = chip.getAttribute(\"data-cat\") === cat;\n        chip.classList.toggle(\"tl-on\", on);\n        chip.setAttribute(\"aria-pressed\", on ? \"true\" : \"false\");\n      });\n    }\n\n    function reset() {\n      setCat(\"All\");\n      state.size = \"all\";\n      state.price = \"all\";\n      if (sizeSel) sizeSel.value = \"all\";\n      if (priceSel) priceSel.value = \"all\";\n      apply();\n    }\n\n    chips.forEach(function (chip) {\n      chip.addEventListener(\"click\", function () {\n        setCat(chip.getAttribute(\"data-cat\"));\n        apply();\n      });\n    });\n    if (sizeSel) sizeSel.addEventListener(\"change\", function () { state.size = sizeSel.value; apply(); });\n    if (priceSel) priceSel.addEventListener(\"change\", function () { state.price = priceSel.value; apply(); });\n    var resetBtn = document.getElementById(\"tl-reset\");\n    var emptyReset = document.getElementById(\"tl-empty-reset\");\n    if (resetBtn) resetBtn.addEventListener(\"click\", reset);\n    if (emptyReset) emptyReset.addEventListener(\"click\", reset);\n\n    // Hide nav links whose target section does not exist (yet), so no in-page link is broken.\n    var links = document.querySelectorAll(\"#tl-navlist a\");\n    Array.prototype.forEach.call(links, function (a) {\n      var id = (a.getAttribute(\"href\") || \"\").slice(1);\n      if (id && !document.getElementById(id)) {\n        var li = a.parentNode;\n        if (li) li.hidden = true;\n      }\n    });\n\n    apply();\n  }\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", init);\n  } else {\n    init();\n  }\n})();\n</script>",
    "workflow": "WhatsApp order links"
  },
  "W-3": {
    "owner": "W-3",
    "head": "",
    "body": "<!-- W-3: visit section (address, timings, tap-to-call phone) -->\n<style>\n.tl-visit{background:var(--j2-surface)}\n.tl-visit-grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr))}\n.tl-visit-grid>*{min-width:0}\n.tl-visit h3{margin:0 0 8px;color:var(--j2-secondary)}\n.tl-visit address{font-style:normal;margin:0 0 8px}\n.tl-visit-hours{list-style:none;margin:0;padding:0}\n.tl-visit-hours li{display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 16px;padding:8px 0}\n.tl-visit-hours li+li{border-top:1px dashed var(--j2-accent)}\n.tl-visit-hours .tl-day{font-weight:700}\n.tl-visit-hours .tl-closed{color:var(--j2-primary);font-weight:700}\n.tl-visit-phone{margin:0 0 16px;color:var(--j2-muted)}\n.tl-visit .j2-btn{width:100%}\n@media (min-width:480px){.tl-visit .j2-btn{width:auto}}\n</style>\n\n<section class=\"j2-section tl-visit\" id=\"visit\" aria-labelledby=\"tl-visit-h\">\n  <div class=\"j2-container\">\n    <h2 id=\"tl-visit-h\">Visit Thread &amp; Loom in Pune</h2>\n    <div class=\"tl-visit-grid\">\n      <div class=\"j2-card\">\n        <h3>Find us</h3>\n        <address>\n          Thread &amp; Loom<br>\n          18 FC Road, Shivajinagar<br>\n          Pune 411005\n        </address>\n      </div>\n      <div class=\"j2-card\">\n        <h3>Store timings</h3>\n        <ul class=\"tl-visit-hours\">\n          <li><span class=\"tl-day\">Tuesday to Sunday</span><span>11am to 9pm</span></li>\n          <li><span class=\"tl-day\">Monday</span><span class=\"tl-closed\">Closed</span></li>\n        </ul>\n      </div>\n      <div class=\"j2-card\">\n        <h3>Call the shop</h3>\n        <p class=\"tl-visit-phone\">+91 00000 22222</p>\n        <a class=\"j2-btn\" href=\"tel:+910000022222\">Call +91 00000 22222</a>\n      </div>\n    </div>\n  </div>\n</section>",
    "workflow": "Visit block"
  },
  "W-5": {
    "owner": "W-5",
    "head": "",
    "body": "<!-- W-5: size guide (chest in inches) -->\n<style>\n.tl-sg-wrap{max-width:560px}\n.tl-sg-lead{color:var(--j2-muted);margin:0 0 16px}\n.tl-sg-table{width:100%;border-collapse:collapse;background:#FFFFFF;border-radius:var(--j2-radius);overflow:hidden}\n.tl-sg-table caption{text-align:left;padding:0 0 8px;font-weight:700;color:var(--j2-secondary)}\n.tl-sg-table th,.tl-sg-table td{padding:12px 16px;text-align:left;border-bottom:1px dashed var(--j2-accent)}\n.tl-sg-table thead th{background:var(--j2-surface);color:var(--j2-secondary);font-weight:700;border-bottom:2px solid var(--j2-secondary)}\n.tl-sg-table tbody th{font-weight:700;color:var(--j2-text)}\n.tl-sg-table tbody tr:last-child th,.tl-sg-table tbody tr:last-child td{border-bottom:0}\n.tl-sg-note{margin:16px 0 0;color:var(--j2-muted);font-size:.95rem}\n</style>\n\n<section class=\"j2-section\" id=\"size-guide\" aria-labelledby=\"tl-sg-h\">\n  <div class=\"j2-container\">\n    <div class=\"tl-sg-wrap\">\n      <h2 id=\"tl-sg-h\">Size guide</h2>\n      <p class=\"tl-sg-lead\">Chest measurements in inches for kurtas and shirts.</p>\n      <div class=\"j2-card\">\n        <div class=\"j2-table-wrap\">\n          <table class=\"tl-sg-table\">\n            <caption>Chest by size (inches)</caption>\n            <thead>\n              <tr>\n                <th scope=\"col\">Size</th>\n                <th scope=\"col\">Chest (inches)</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr><th scope=\"row\">XS</th><td>32</td></tr>\n              <tr><th scope=\"row\">S</th><td>34</td></tr>\n              <tr><th scope=\"row\">M</th><td>36</td></tr>\n              <tr><th scope=\"row\">L</th><td>38</td></tr>\n              <tr><th scope=\"row\">XL</th><td>40</td></tr>\n              <tr><th scope=\"row\">XXL</th><td>42</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n      <p class=\"tl-sg-note\">Sarees and dupattas are free size.</p>\n    </div>\n  </div>\n</section>",
    "workflow": "Size guide"
  }
