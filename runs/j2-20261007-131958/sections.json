{
  "W-1": {
    "owner": "W-1",
    "head": "<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Brew Lab | Cafe on 100 Feet Road, Indiranagar, Bengaluru</title>\n<meta name=\"description\" content=\"Brew Lab, a cafe on 100 Feet Road, Indiranagar, Bengaluru. See today's hours, the menu, pre-order by WhatsApp and get directions.\">\n<style>\n  :root {\n    --bl-bg: #faf6f0;\n    --bl-card: #ffffff;\n    --bl-ink: #2b1d14;\n    --bl-muted: #6f5f53;\n    --bl-accent: #8a4b22;\n    --bl-accent-dark: #6b3716;\n    --bl-line: #e6dccf;\n    --bl-radius: 12px;\n  }\n  *, *::before, *::after { box-sizing: border-box; }\n  html { -webkit-text-size-adjust: 100%; }\n  body {\n    margin: 0;\n    font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif;\n    font-size: 16px;\n    line-height: 1.5;\n    color: var(--bl-ink);\n    background: var(--bl-bg);\n    overflow-wrap: break-word;\n  }\n  img, svg, video { max-width: 100%; height: auto; }\n  h1, h2, h3, p { margin-top: 0; }\n  a { color: var(--bl-accent-dark); }\n  /* Shared helpers other sections may reuse */\n  .bl-wrap { width: 100%; max-width: 1100px; margin: 0 auto; padding: 0 16px; }\n  .bl-section { padding: 32px 0; }\n  .bl-section h2 { font-size: 1.5rem; margin-bottom: 8px; }\n  .bl-lead { color: var(--bl-muted); margin-bottom: 20px; }\n  .bl-card {\n    background: var(--bl-card);\n    border: 1px solid var(--bl-line);\n    border-radius: var(--bl-radius);\n    padding: 16px;\n    min-width: 0;\n  }\n  @media (min-width: 768px) {\n    .bl-wrap { padding: 0 24px; }\n    .bl-section { padding: 48px 0; }\n    .bl-section h2 { font-size: 1.875rem; }\n  }\n</style>",
    "body": "<style>\n  .bl-hero { background: var(--bl-accent-dark); color: #fff; padding: 28px 0; }\n  .bl-hero h1 { font-size: 2rem; margin-bottom: 4px; letter-spacing: 0.02em; }\n  .bl-hero p { margin: 0; color: #f1e3d6; }\n  .bl-menu-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }\n  .bl-menu-group h3 {\n    margin-bottom: 8px;\n    padding-bottom: 8px;\n    font-size: 1.125rem;\n    color: var(--bl-accent);\n    border-bottom: 2px solid var(--bl-line);\n  }\n  .bl-menu-list { list-style: none; margin: 0; padding: 0; }\n  .bl-menu-item {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 12px;\n    padding: 8px 0;\n    min-width: 0;\n  }\n  .bl-menu-item + .bl-menu-item { border-top: 1px dashed var(--bl-line); }\n  .bl-menu-name { min-width: 0; overflow-wrap: anywhere; }\n  .bl-menu-price { font-weight: 700; white-space: nowrap; color: var(--bl-accent-dark); }\n  @media (min-width: 768px) {\n    .bl-hero { padding: 44px 0; }\n    .bl-hero h1 { font-size: 2.75rem; }\n    .bl-menu-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }\n  }\n</style>\n\n<header class=\"bl-hero\" id=\"top\">\n  <div class=\"bl-wrap\">\n    <h1>Brew Lab</h1>\n    <p>Cafe on 100 Feet Road, Indiranagar, Bengaluru</p>\n  </div>\n</header>\n\n<section class=\"bl-section\" id=\"menu\" aria-labelledby=\"menu-title\">\n  <div class=\"bl-wrap\">\n    <h2 id=\"menu-title\">Menu</h2>\n    <p class=\"bl-lead\">All prices in rupees (₹).</p>\n    <div class=\"bl-menu-grid\">\n      <div class=\"bl-card bl-menu-group\">\n        <h3>Coffee</h3>\n        <ul class=\"bl-menu-list\">\n          <li class=\"bl-menu-item\"><span class=\"bl-menu-name\">Espresso</span><span class=\"bl-menu-price\">₹120</span></li>\n          <li class=\"bl-menu-item\"><span class=\"bl-menu-name\">Cappuccino</span><span class=\"bl-menu-price\">₹180</span></li>\n          <li class=\"bl-menu-item\"><span class=\"bl-menu-name\">Pour-over</span><span class=\"bl-menu-price\">₹220</span></li>\n        </ul>\n      </div>\n      <div class=\"bl-card bl-menu-group\">\n        <h3>Cold</h3>\n        <ul class=\"bl-menu-list\">\n          <li class=\"bl-menu-item\"><span class=\"bl-menu-name\">Cold brew</span><span class=\"bl-menu-price\">₹200</span></li>\n        </ul>\n      </div>\n      <div class=\"bl-card bl-menu-group\">\n        <h3>Food</h3>\n        <ul class=\"bl-menu-list\">\n          <li class=\"bl-menu-item\"><span class=\"bl-menu-name\">Croissant</span><span class=\"bl-menu-price\">₹150</span></li>\n          <li class=\"bl-menu-item\"><span class=\"bl-menu-name\">Banana bread</span><span class=\"bl-menu-price\">₹130</span></li>\n        </ul>\n      </div>\n    </div>\n  </div>\n</section>",
    "workflow": "Menu section"
  },
  "W-2": {
    "owner": "W-2",
    "head": "",
    "body": "<style>\n  .bl-hours-card { max-width: 560px; }\n  .bl-hours-list { list-style: none; margin: 0; padding: 0; }\n  .bl-hours-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    flex-wrap: wrap;\n    gap: 4px 12px;\n    padding: 10px 12px;\n    min-width: 0;\n    border-left: 4px solid transparent;\n    border-radius: 6px;\n  }\n  .bl-hours-row + .bl-hours-row { border-top: 1px dashed var(--bl-line); }\n  .bl-hours-day { min-width: 0; font-weight: 600; }\n  .bl-hours-time { color: var(--bl-muted); white-space: nowrap; }\n  .bl-hours-row.bl-today {\n    background: #f6e6d4;\n    border-left-color: var(--bl-accent);\n    border-top-color: transparent;\n  }\n  .bl-hours-row.bl-today + .bl-hours-row { border-top-color: transparent; }\n  .bl-hours-row.bl-today .bl-hours-day,\n  .bl-hours-row.bl-today .bl-hours-time { color: var(--bl-accent-dark); font-weight: 700; }\n  .bl-hours-badge {\n    display: inline-block;\n    margin-left: 8px;\n    padding: 1px 8px;\n    border-radius: 999px;\n    background: var(--bl-accent);\n    color: #fff;\n    font-size: 0.75rem;\n    font-weight: 700;\n    vertical-align: middle;\n  }\n</style>\n\n<section class=\"bl-section\" id=\"hours\" aria-labelledby=\"hours-title\">\n  <div class=\"bl-wrap\">\n    <h2 id=\"hours-title\">Opening hours</h2>\n    <p class=\"bl-lead\">Open every day. Today's hours are highlighted.</p>\n    <div class=\"bl-card bl-hours-card\">\n      <ul class=\"bl-hours-list\" id=\"bl-hours-list\">\n        <li class=\"bl-hours-row\" data-day=\"1\"><span class=\"bl-hours-day\">Monday</span><span class=\"bl-hours-time\">8am to 10pm</span></li>\n        <li class=\"bl-hours-row\" data-day=\"2\"><span class=\"bl-hours-day\">Tuesday</span><span class=\"bl-hours-time\">8am to 10pm</span></li>\n        <li class=\"bl-hours-row\" data-day=\"3\"><span class=\"bl-hours-day\">Wednesday</span><span class=\"bl-hours-time\">8am to 10pm</span></li>\n        <li class=\"bl-hours-row\" data-day=\"4\"><span class=\"bl-hours-day\">Thursday</span><span class=\"bl-hours-time\">8am to 10pm</span></li>\n        <li class=\"bl-hours-row\" data-day=\"5\"><span class=\"bl-hours-day\">Friday</span><span class=\"bl-hours-time\">8am to 10pm</span></li>\n        <li class=\"bl-hours-row\" data-day=\"6\"><span class=\"bl-hours-day\">Saturday</span><span class=\"bl-hours-time\">9am to 11pm</span></li>\n        <li class=\"bl-hours-row\" data-day=\"0\"><span class=\"bl-hours-day\">Sunday</span><span class=\"bl-hours-time\">9am to 11pm</span></li>\n      </ul>\n    </div>\n  </div>\n</section>\n\n<script>\n  (function () {\n    try {\n      var list = document.getElementById('bl-hours-list');\n      if (!list) { return; }\n      var today = String(new Date().getDay()); // 0 = Sunday ... 6 = Saturday\n      var rows = list.querySelectorAll('.bl-hours-row');\n      for (var i = 0; i < rows.length; i++) {\n        if (rows[i].getAttribute('data-day') === today) {\n          rows[i].classList.add('bl-today');\n          rows[i].setAttribute('aria-current', 'date');\n          var dayEl = rows[i].querySelector('.bl-hours-day');\n          if (dayEl) {\n            var badge = document.createElement('span');\n            badge.className = 'bl-hours-badge';\n            badge.textContent = 'Today';\n            dayEl.appendChild(badge);\n          }\n          break;\n        }\n      }\n    } catch (e) {\n      /* highlight is cosmetic; never break the page */\n    }\n  })();\n</script>",
    "workflow": "Opening hours with today highlight"
  },
  "W-3": {
    "owner": "W-3",
    "head": "",
    "body": "<style>\n  .bl-order-card { max-width: 560px; }\n  .bl-order-list { list-style: none; margin: 0 0 12px; padding: 0; }\n  .bl-order-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    padding: 10px 0;\n    min-width: 0;\n  }\n  .bl-order-row + .bl-order-row { border-top: 1px dashed var(--bl-line); }\n  .bl-order-info { min-width: 0; flex: 1 1 auto; }\n  .bl-order-name { display: block; font-weight: 600; overflow-wrap: anywhere; }\n  .bl-order-price { display: block; color: var(--bl-muted); font-size: 0.9rem; }\n  .bl-order-qty {\n    flex: 0 0 auto;\n    width: 76px;\n    padding: 10px 8px;\n    font: inherit;\n    text-align: center;\n    color: var(--bl-ink);\n    background: #fff;\n    border: 1px solid var(--bl-line);\n    border-radius: 8px;\n  }\n  .bl-order-field { margin: 4px 0 16px; }\n  .bl-order-field label { display: block; font-weight: 600; margin-bottom: 4px; }\n  .bl-order-name-input {\n    display: block;\n    width: 100%;\n    padding: 10px 12px;\n    font: inherit;\n    color: var(--bl-ink);\n    background: #fff;\n    border: 1px solid var(--bl-line);\n    border-radius: 8px;\n  }\n  .bl-order-total {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 12px;\n    padding: 12px;\n    margin-bottom: 12px;\n    background: #f6e6d4;\n    border-radius: 8px;\n    font-weight: 700;\n    color: var(--bl-accent-dark);\n  }\n  .bl-order-total output { font-size: 1.5rem; white-space: nowrap; }\n  .bl-order-submit {\n    display: block;\n    width: 100%;\n    padding: 14px 16px;\n    font: inherit;\n    font-weight: 700;\n    color: #fff;\n    background: var(--bl-accent-dark);\n    border: 0;\n    border-radius: 10px;\n    cursor: pointer;\n  }\n  .bl-order-submit:hover, .bl-order-submit:focus-visible { background: var(--bl-accent); }\n  .bl-order-msg { min-height: 1.5em; margin: 8px 0 0; color: #a12b1c; font-weight: 600; }\n  .bl-order-note { margin: 12px 0 0; padding: 0; list-style: none; color: var(--bl-muted); font-size: 0.95rem; }\n  .bl-order-note li + li { margin-top: 4px; }\n</style>\n\n<section class=\"bl-section\" id=\"preorder\" aria-labelledby=\"preorder-title\">\n  <div class=\"bl-wrap\">\n    <h2 id=\"preorder-title\">Pre-order for pickup</h2>\n    <p class=\"bl-lead\">Choose your items and send the order on WhatsApp. Prices in rupees (₹).</p>\n    <div class=\"bl-card bl-order-card\">\n      <form id=\"bl-order-form\" novalidate>\n        <ul class=\"bl-order-list\">\n          <li class=\"bl-order-row\">\n            <div class=\"bl-order-info\"><span class=\"bl-order-name\">Espresso</span><span class=\"bl-order-price\">₹120</span></div>\n            <input class=\"bl-order-qty\" type=\"number\" inputmode=\"numeric\" min=\"0\" max=\"20\" step=\"1\" value=\"0\" data-name=\"Espresso\" data-price=\"120\" aria-label=\"Quantity of Espresso, ₹120 each\">\n          </li>\n          <li class=\"bl-order-row\">\n            <div class=\"bl-order-info\"><span class=\"bl-order-name\">Cappuccino</span><span class=\"bl-order-price\">₹180</span></div>\n            <input class=\"bl-order-qty\" type=\"number\" inputmode=\"numeric\" min=\"0\" max=\"20\" step=\"1\" value=\"0\" data-name=\"Cappuccino\" data-price=\"180\" aria-label=\"Quantity of Cappuccino, ₹180 each\">\n          </li>\n          <li class=\"bl-order-row\">\n            <div class=\"bl-order-info\"><span class=\"bl-order-name\">Pour-over</span><span class=\"bl-order-price\">₹220</span></div>\n            <input class=\"bl-order-qty\" type=\"number\" inputmode=\"numeric\" min=\"0\" max=\"20\" step=\"1\" value=\"0\" data-name=\"Pour-over\" data-price=\"220\" aria-label=\"Quantity of Pour-over, ₹220 each\">\n          </li>\n          <li class=\"bl-order-row\">\n            <div class=\"bl-order-info\"><span class=\"bl-order-name\">Cold brew</span><span class=\"bl-order-price\">₹200</span></div>\n            <input class=\"bl-order-qty\" type=\"number\" inputmode=\"numeric\" min=\"0\" max=\"20\" step=\"1\" value=\"0\" data-name=\"Cold brew\" data-price=\"200\" aria-label=\"Quantity of Cold brew, ₹200 each\">\n          </li>\n          <li class=\"bl-order-row\">\n            <div class=\"bl-order-info\"><span class=\"bl-order-name\">Croissant</span><span class=\"bl-order-price\">₹150</span></div>\n            <input class=\"bl-order-qty\" type=\"number\" inputmode=\"numeric\" min=\"0\" max=\"20\" step=\"1\" value=\"0\" data-name=\"Croissant\" data-price=\"150\" aria-label=\"Quantity of Croissant, ₹150 each\">\n          </li>\n          <li class=\"bl-order-row\">\n            <div class=\"bl-order-info\"><span class=\"bl-order-name\">Banana bread</span><span class=\"bl-order-price\">₹130</span></div>\n            <input class=\"bl-order-qty\" type=\"number\" inputmode=\"numeric\" min=\"0\" max=\"20\" step=\"1\" value=\"0\" data-name=\"Banana bread\" data-price=\"130\" aria-label=\"Quantity of Banana bread, ₹130 each\">\n          </li>\n        </ul>\n\n        <div class=\"bl-order-field\">\n          <label for=\"bl-order-customer\">Your name (optional)</label>\n          <input class=\"bl-order-name-input\" id=\"bl-order-customer\" type=\"text\" maxlength=\"60\" autocomplete=\"name\">\n        </div>\n\n        <div class=\"bl-order-total\">\n          <span>Total</span>\n          <output id=\"bl-order-total\" for=\"bl-order-form\" aria-live=\"polite\">₹0</output>\n        </div>\n\n        <button class=\"bl-order-submit\" type=\"submit\">Send order on WhatsApp</button>\n        <p class=\"bl-order-msg\" id=\"bl-order-msg\" role=\"status\" aria-live=\"polite\"></p>\n      </form>\n\n      <ul class=\"bl-order-note\">\n        <li>Pay at pickup.</li>\n        <li>Pickup within 15 minutes of ordering.</li>\n      </ul>\n    </div>\n  </div>\n</section>\n\n<script>\n  (function () {\n    try {\n      var form = document.getElementById('bl-order-form');\n      var totalEl = document.getElementById('bl-order-total');\n      var msgEl = document.getElementById('bl-order-msg');\n      var nameEl = document.getElementById('bl-order-customer');\n      if (!form || !totalEl) { return; }\n      var inputs = form.querySelectorAll('.bl-order-qty');\n      var PHONE = '919845000000';\n\n      function qtyOf(input) {\n        var n = parseInt(input.value, 10);\n        if (isNaN(n) || n < 0) { n = 0; }\n        if (n > 20) { n = 20; }\n        return n;\n      }\n\n      function lines() {\n        var out = [];\n        for (var i = 0; i < inputs.length; i++) {\n          var q = qtyOf(inputs[i]);\n          if (q > 0) {\n            var price = parseInt(inputs[i].getAttribute('data-price'), 10);\n            out.push({ name: inputs[i].getAttribute('data-name'), qty: q, price: price, sub: q * price });\n          }\n        }\n        return out;\n      }\n\n      function total(items) {\n        var t = 0;\n        for (var i = 0; i < items.length; i++) { t += items[i].sub; }\n        return t;\n      }\n\n      function update() {\n        totalEl.textContent = '\\u20B9' + total(lines());\n        if (msgEl) { msgEl.textContent = ''; }\n      }\n\n      for (var i = 0; i < inputs.length; i++) {\n        inputs[i].addEventListener('input', update);\n        inputs[i].addEventListener('change', function () {\n          // normalise out-of-range or blank values after editing\n          this.value = String(qtyOf(this));\n          update();\n        });\n      }\n\n      form.addEventListener('submit', function (e) {\n        e.preventDefault();\n        var items = lines();\n        if (items.length === 0) {\n          if (msgEl) { msgEl.textContent = 'Please choose at least one item.'; }\n          return;\n        }\n        var text = 'Hi Brew Lab, I would like to pre-order for pickup:\\n';\n        for (var j = 0; j < items.length; j++) {\n          text += '- ' + items[j].qty + ' x ' + items[j].name + ' (\\u20B9' + items[j].sub + ')\\n';\n        }\n        text += 'Total: \\u20B9' + total(items) + '\\n';\n        var who = nameEl ? nameEl.value.replace(/^\\s+|\\s+$/g, '') : '';\n        if (who) { text += 'Name: ' + who + '\\n'; }\n        text += 'Pay at pickup.';\n        var url = 'https://wa.me/' + PHONE + '?text=' + encodeURIComponent(text);\n        var w = null;\n        try { w = window.open(url, '_blank'); } catch (err) { w = null; }\n        if (!w) { window.location.href = url; }\n      });\n\n      update();\n    } catch (err) {\n      /* never break the rest of the page */\n    }\n  })();\n</script>",
    "workflow": "Pre-order form with running total and WhatsApp"
  },
  "W-4": {
    "owner": "W-4",
    "head": "",
    "body": "<style>\n  .bl-loyalty-card { max-width: 560px; }\n  .bl-loyalty-grid {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n    display: grid;\n    grid-template-columns: repeat(5, minmax(0, 1fr));\n    gap: 10px;\n    justify-items: center;\n  }\n  .bl-stamp {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 100%;\n    max-width: 64px;\n    aspect-ratio: 1 / 1;\n    min-width: 0;\n    border: 2px dashed var(--bl-accent);\n    border-radius: 50%;\n    background: #fff;\n    color: var(--bl-muted);\n    font-weight: 700;\n    font-size: 1rem;\n    line-height: 1;\n  }\n  .bl-stamp.bl-stamp-free {\n    border-style: solid;\n    border-color: var(--bl-accent-dark);\n    background: var(--bl-accent-dark);\n    color: #fff;\n    font-size: 0.8rem;\n    letter-spacing: 0.04em;\n  }\n  .bl-loyalty-note { margin: 16px 0 0; color: var(--bl-muted); font-size: 0.95rem; }\n  @media (min-width: 768px) {\n    .bl-loyalty-grid { gap: 14px; }\n    .bl-stamp.bl-stamp-free { font-size: 0.95rem; }\n  }\n</style>\n\n<section class=\"bl-section\" id=\"loyalty\" aria-labelledby=\"loyalty-title\">\n  <div class=\"bl-wrap\">\n    <h2 id=\"loyalty-title\">Loyalty card</h2>\n    <p class=\"bl-lead\">Collect stamps on your Brew Lab card. The 10th circle is FREE.</p>\n    <div class=\"bl-card bl-loyalty-card\">\n      <ol class=\"bl-loyalty-grid\" aria-label=\"Loyalty stamp card, 10 stamps\">\n        <li class=\"bl-stamp\" aria-label=\"Stamp 1\">1</li>\n        <li class=\"bl-stamp\" aria-label=\"Stamp 2\">2</li>\n        <li class=\"bl-stamp\" aria-label=\"Stamp 3\">3</li>\n        <li class=\"bl-stamp\" aria-label=\"Stamp 4\">4</li>\n        <li class=\"bl-stamp\" aria-label=\"Stamp 5\">5</li>\n        <li class=\"bl-stamp\" aria-label=\"Stamp 6\">6</li>\n        <li class=\"bl-stamp\" aria-label=\"Stamp 7\">7</li>\n        <li class=\"bl-stamp\" aria-label=\"Stamp 8\">8</li>\n        <li class=\"bl-stamp\" aria-label=\"Stamp 9\">9</li>\n        <li class=\"bl-stamp bl-stamp-free\" aria-label=\"Stamp 10, FREE\">FREE</li>\n      </ol>\n      <p class=\"bl-loyalty-note\">Ask at the counter to get your card stamped.</p>\n    </div>\n  </div>\n</section>",
    "workflow": "Loyalty stamp card"
  },
  "W-5": {
    "owner": "W-5",
    "head": "",
    "body": "<style>\n  .bl-location-card { max-width: 560px; }\n  .bl-location-address {\n    margin: 0 0 16px;\n    font-style: normal;\n    font-size: 1.125rem;\n    font-weight: 600;\n    overflow-wrap: anywhere;\n  }\n  .bl-location-link {\n    display: inline-block;\n    max-width: 100%;\n    padding: 12px 20px;\n    font-weight: 700;\n    text-align: center;\n    text-decoration: none;\n    color: #fff;\n    background: var(--bl-accent-dark);\n    border-radius: 10px;\n  }\n  .bl-location-link:hover, .bl-location-link:focus-visible { background: var(--bl-accent); color: #fff; }\n  .bl-location-note { margin: 12px 0 0; color: var(--bl-muted); font-size: 0.95rem; }\n  @media (max-width: 479px) {\n    .bl-location-link { display: block; width: 100%; }\n  }\n</style>\n\n<section class=\"bl-section\" id=\"location\" aria-labelledby=\"location-title\">\n  <div class=\"bl-wrap\">\n    <h2 id=\"location-title\">Find us</h2>\n    <p class=\"bl-lead\">Brew Lab is on 100 Feet Road in Indiranagar.</p>\n    <div class=\"bl-card bl-location-card\">\n      <address class=\"bl-location-address\">100 Feet Road, Indiranagar, Bengaluru 560038</address>\n      <a class=\"bl-location-link\" href=\"https://maps.google.com/?q=100+Feet+Road+Indiranagar+Bengaluru+560038\" target=\"_blank\" rel=\"noopener noreferrer\">Get directions</a>\n      <p class=\"bl-location-note\">Opens in Google Maps.</p>\n    </div>\n  </div>\n</section>",
    "workflow": "Location and directions"
  }
}