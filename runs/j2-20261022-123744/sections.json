{
  "style": {
    "owner": "W-32",
    "head": "<style>:root{--j2-primary:#5a3825;--j2-secondary:#2f4a3a;--j2-accent:#9a4a14;--j2-background:#faf5ee;--j2-surface:#ffffff;--j2-text:#2b1d14;--j2-muted:#6b5646;--j2-font-heading:Georgia, 'Times New Roman', serif;--j2-font-body:system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:12px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;background:#5a3825;color:#ffffff;border:2px solid #5a3825;min-height:48px;padding:12px 24px;font-weight:600;font-size:1rem;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;text-decoration:none}.j2-btn-secondary{display:inline-block;background:transparent;color:#5a3825;border:2px solid #5a3825;min-height:48px;padding:12px 24px;font-weight:600;font-size:1rem;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;text-decoration:none}.j2-card{background:#ffffff;border:1px solid #e6d9c8;border-radius:12px;padding:24px;box-shadow:0 2px 8px rgba(43,29,20,0.08)}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-32": {
    "owner": "W-37",
    "head": "",
    "body": "<section id=\"shop-identity\" aria-labelledby=\"shop-name\">\n  <style>\n    #shop-identity {\n      box-sizing: border-box;\n      width: 100%;\n      max-width: 100%;\n      padding: 48px 16px;\n      background: var(--j2-background, #faf5ee);\n      color: var(--j2-text, #2b1d14);\n      font-family: var(--j2-font-body, system-ui, sans-serif);\n      text-align: center;\n    }\n    #shop-identity .shop-identity-inner {\n      box-sizing: border-box;\n      max-width: 720px;\n      margin: 0 auto;\n      padding: 32px 20px;\n      background: var(--j2-surface, #ffffff);\n      border: 1px solid #e6d9c8;\n      border-radius: var(--j2-radius, 12px);\n      box-shadow: 0 2px 8px rgba(43, 29, 20, 0.08);\n    }\n    #shop-identity .shop-kicker {\n      margin: 0 0 8px;\n      font-size: 0.875rem;\n      font-weight: 600;\n      letter-spacing: 0.08em;\n      text-transform: uppercase;\n      color: var(--j2-accent, #9a4a14);\n    }\n    #shop-identity #shop-name {\n      margin: 0 0 16px;\n      font-family: var(--j2-font-heading, Georgia, serif);\n      font-size: clamp(2.25rem, 8vw, 3.5rem);\n      line-height: 1.1;\n      color: var(--j2-primary, #5a3825);\n      overflow-wrap: anywhere;\n    }\n    #shop-identity #shop-address {\n      margin: 0 0 24px;\n      font-size: 1.125rem;\n      line-height: 1.5;\n      color: var(--j2-text, #2b1d14);\n      overflow-wrap: anywhere;\n    }\n    #shop-identity #hero-preorder {\n      box-sizing: border-box;\n      max-width: 100%;\n      min-width: 44px;\n      min-height: 48px;\n    }\n    @media (min-width: 768px) {\n      #shop-identity { padding: 64px 24px; }\n      #shop-identity .shop-identity-inner { padding: 48px 32px; }\n    }\n  </style>\n  <div class=\"shop-identity-inner\">\n    <p class=\"shop-kicker\">Specialty coffee shop</p>\n    <h1 id=\"shop-name\">Brew Lab</h1>\n    <p id=\"shop-address\">12, 100 Feet Road, Indiranagar, Bengaluru 560038</p>\n    <a id=\"hero-preorder\" class=\"j2-btn\" href=\"#pre-order\">Pre-order</a>\n  </div>\n</section>",
    "workflow": "Hero Pre-order button"
  },
  "W-33": {
    "owner": "W-33",
    "head": "",
    "body": "<section id=\"menu\" aria-labelledby=\"menu-heading\">\n  <style>\n    #menu {\n      padding: var(--j2-section, 64px) 16px;\n      color: var(--j2-text);\n    }\n    #menu .menu-inner {\n      max-width: 720px;\n      margin: 0 auto;\n      min-width: 0;\n    }\n    #menu h2 {\n      font-family: var(--j2-font-heading);\n      color: var(--j2-primary);\n      font-size: 1.75rem;\n      line-height: 1.2;\n      margin: 0 0 16px;\n    }\n    #menu .menu-list {\n      list-style: none;\n      margin: 0;\n      padding: 0;\n    }\n    #menu .menu-item {\n      display: flex;\n      align-items: baseline;\n      justify-content: space-between;\n      gap: 16px;\n      padding: 16px 0;\n      border-bottom: 1px solid #e6d9c8;\n      min-width: 0;\n    }\n    #menu .menu-item:first-child {\n      padding-top: 0;\n    }\n    #menu .menu-item:last-child {\n      border-bottom: 0;\n      padding-bottom: 0;\n    }\n    #menu .menu-name {\n      font-size: 1.0625rem;\n      font-weight: 600;\n      min-width: 0;\n      overflow-wrap: anywhere;\n    }\n    #menu .menu-price {\n      font-weight: 700;\n      color: var(--j2-accent);\n      white-space: nowrap;\n      flex-shrink: 0;\n    }\n    @media (min-width: 768px) {\n      #menu h2 { font-size: 2.125rem; }\n      #menu .menu-name { font-size: 1.125rem; }\n    }\n  </style>\n  <div class=\"menu-inner\">\n    <h2 id=\"menu-heading\">Menu</h2>\n    <div class=\"j2-card\">\n      <ul class=\"menu-list\">\n        <li class=\"menu-item\"><span class=\"menu-name\">Filter coffee</span> <span class=\"menu-price\">90 rupees</span></li>\n        <li class=\"menu-item\"><span class=\"menu-name\">Cappuccino</span> <span class=\"menu-price\">160 rupees</span></li>\n        <li class=\"menu-item\"><span class=\"menu-name\">Latte</span> <span class=\"menu-price\">180 rupees</span></li>\n        <li class=\"menu-item\"><span class=\"menu-name\">Cold brew</span> <span class=\"menu-price\">200 rupees</span></li>\n        <li class=\"menu-item\"><span class=\"menu-name\">Masala chai</span> <span class=\"menu-price\">80 rupees</span></li>\n        <li class=\"menu-item\"><span class=\"menu-name\">Almond croissant</span> <span class=\"menu-price\">140 rupees</span></li>\n        <li class=\"menu-item\"><span class=\"menu-name\">Banana bread slice</span> <span class=\"menu-price\">120 rupees</span></li>\n      </ul>\n    </div>\n  </div>\n</section>",
    "workflow": "Menu section"
  },
  "W-34": {
    "owner": "W-41",
    "head": "",
    "body": "<section id=\"pre-order\" aria-label=\"Pre-order for pickup\">\n  <style>\n    #pre-order {\n      background: var(--j2-background, #faf5ee);\n      color: var(--j2-text, #2b1d14);\n      font-family: var(--j2-font-body, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif);\n      padding: 64px 16px;\n      box-sizing: border-box;\n      max-width: 100%;\n    }\n    #pre-order *, #pre-order *::before, #pre-order *::after { box-sizing: border-box; }\n    #pre-order .pre-order-inner { max-width: 640px; width: 100%; margin: 0 auto; }\n    #pre-order h2 {\n      font-family: var(--j2-font-heading, Georgia, 'Times New Roman', serif);\n      color: var(--j2-primary, #5a3825);\n      font-size: 1.75rem;\n      line-height: 1.2;\n      margin: 0 0 8px;\n    }\n    #pre-order .pre-order-intro { margin: 0 0 24px; line-height: 1.5; overflow-wrap: anywhere; }\n    #pre-order .pre-order-field { display: block; margin: 0 0 16px; }\n    #pre-order label {\n      display: block;\n      font-weight: 600;\n      margin: 0 0 8px;\n      color: var(--j2-text, #2b1d14);\n    }\n    #pre-order .pre-order-hint {\n      display: block;\n      font-weight: 400;\n      font-size: 0.9rem;\n      color: var(--j2-muted, #6b5646);\n      margin-top: 2px;\n    }\n    #pre-order input[type=\"text\"],\n    #pre-order input[type=\"tel\"],\n    #pre-order textarea {\n      display: block;\n      width: 100%;\n      max-width: 100%;\n      min-height: 48px;\n      padding: 12px 16px;\n      font: inherit;\n      font-size: 1rem;\n      color: var(--j2-text, #2b1d14);\n      background: var(--j2-surface, #ffffff);\n      border: 2px solid var(--j2-muted, #6b5646);\n      border-radius: 12px;\n    }\n    #pre-order input[type=\"text\"],\n    #pre-order input[type=\"tel\"] {\n      -webkit-appearance: none;\n      appearance: none;\n    }\n    #pre-order textarea { min-height: 96px; resize: vertical; }\n    #pre-order input:focus-visible,\n    #pre-order textarea:focus-visible,\n    #pre-order button:focus-visible {\n      outline: 3px solid var(--j2-accent, #9a4a14);\n      outline-offset: 2px;\n    }\n    #pre-order [aria-invalid=\"true\"] { border-color: var(--j2-accent, #9a4a14); }\n    #pre-order #order-submit { width: 100%; max-width: 100%; }\n    #pre-order #order-status {\n      min-height: 24px;\n      margin: 16px 0 0;\n      line-height: 1.5;\n      font-weight: 600;\n      color: var(--j2-text, #2b1d14);\n      overflow-wrap: anywhere;\n    }\n    #pre-order #order-status.has-error { color: var(--j2-accent, #9a4a14); }\n    @media (min-width: 600px) {\n      #pre-order h2 { font-size: 2rem; }\n      #pre-order #order-submit { width: auto; min-width: 200px; }\n    }\n  </style>\n  <div class=\"pre-order-inner\">\n    <h2>Pre-order for pickup</h2>\n    <p class=\"pre-order-intro\">Fill in the form and send your order to hello@brewlab.example. You collect it at the shop.</p>\n    <form id=\"pre-order-form\" class=\"j2-card\" action=\"mailto:hello@brewlab.example\" method=\"post\" enctype=\"text/plain\" novalidate>\n      <div class=\"pre-order-field\" id=\"order-name\">\n        <label for=\"order-name-input\">Name</label>\n        <input type=\"text\" id=\"order-name-input\" name=\"name\" autocomplete=\"name\" aria-required=\"true\" required>\n      </div>\n      <div class=\"pre-order-field\" id=\"order-phone\">\n        <label for=\"order-phone-input\">Phone</label>\n        <input type=\"tel\" id=\"order-phone-input\" name=\"phone\" autocomplete=\"tel\" inputmode=\"tel\" aria-required=\"true\" required>\n      </div>\n      <div class=\"pre-order-field\" id=\"order-items\">\n        <label for=\"order-items-input\">Items <span class=\"pre-order-hint\">Write the menu items you want, one per line.</span></label>\n        <textarea id=\"order-items-input\" name=\"items\" rows=\"4\" aria-required=\"true\" required></textarea>\n      </div>\n      <div class=\"pre-order-field\" id=\"order-pickup\">\n        <label for=\"order-pickup-input\">Pickup time <span class=\"pre-order-hint\">Write the time you want to collect your order.</span></label>\n        <input type=\"text\" id=\"order-pickup-input\" name=\"pickup time\" aria-required=\"true\" required>\n      </div>\n      <button type=\"submit\" id=\"order-submit\" class=\"j2-btn\">Send pre-order</button>\n      <p id=\"order-status\" role=\"status\" aria-live=\"polite\"></p>\n    </form>\n  </div>\n  <script>\n    (function () {\n      var form = document.getElementById('pre-order-form');\n      var status = document.getElementById('order-status');\n      if (!form || !status) { return; }\n      var fields = [\n        { id: 'order-name-input', label: 'Name' },\n        { id: 'order-phone-input', label: 'Phone' },\n        { id: 'order-items-input', label: 'Items' },\n        { id: 'order-pickup-input', label: 'Pickup time' }\n      ];\n      function valueOf(id) {\n        var el = document.getElementById(id);\n        if (!el) { return ''; }\n        return String(el.value || '').trim();\n      }\n      form.addEventListener('submit', function (event) {\n        event.preventDefault();\n        var bad = [];\n        var i, el;\n        for (i = 0; i < fields.length; i++) {\n          el = document.getElementById(fields[i].id);\n          if (!el) { continue; }\n          if (valueOf(fields[i].id) === '') {\n            bad.push(fields[i]);\n            el.setAttribute('aria-invalid', 'true');\n          } else {\n            el.removeAttribute('aria-invalid');\n          }\n        }\n        if (bad.length > 0) {\n          var names = [];\n          for (i = 0; i < bad.length; i++) { names.push(bad[i].label); }\n          status.className = 'has-error';\n          status.textContent = 'Please fill in: ' + names.join(', ') + '.';\n          var first = document.getElementById(bad[0].id);\n          if (first && first.focus) { first.focus(); }\n          return;\n        }\n        var lines = [\n          'Pre-order for Brew Lab',\n          '',\n          'Name: ' + valueOf('order-name-input'),\n          'Phone: ' + valueOf('order-phone-input'),\n          'Items: ' + valueOf('order-items-input').replace(/\\s*\\r?\\n\\s*/g, ', '),\n          'Pickup time: ' + valueOf('order-pickup-input'),\n          '',\n          'The order is collected at the shop. No online payment is taken.'\n        ];\n        var href = 'mailto:hello@brewlab.example'\n          + '?subject=' + encodeURIComponent('Brew Lab pre-order')\n          + '&body=' + encodeURIComponent(lines.join('\\r\\n'));\n        status.className = '';\n        status.textContent = 'Your order is ready to send to hello@brewlab.example for pickup at the shop. Please press send in your email app.';\n        window.location.href = href;\n      });\n    })();\n  </script>\n</section>",
    "workflow": "Pre-order form pickup field matches LLD S3"
  },
  "W-35": {
    "owner": "W-35",
    "head": "",
    "body": "<section id=\"pickup-payment-notice\" aria-labelledby=\"pickup-payment-heading\">\n  <style>\n    #pickup-payment-notice {\n      padding: var(--j2-section, 64px) 16px;\n      background: var(--j2-background);\n      color: var(--j2-text);\n      font-family: var(--j2-font-body);\n    }\n    #pickup-payment-notice .pickup-inner {\n      max-width: 720px;\n      margin: 0 auto;\n      box-sizing: border-box;\n    }\n    #pickup-payment-notice .j2-card {\n      box-sizing: border-box;\n      max-width: 100%;\n      overflow-wrap: anywhere;\n    }\n    #pickup-payment-notice h2 {\n      font-family: var(--j2-font-heading);\n      color: var(--j2-primary);\n      margin: 0 0 16px;\n      font-size: 1.5rem;\n      line-height: 1.3;\n    }\n    #pickup-payment-notice p {\n      margin: 0 0 8px;\n      font-size: 1.0625rem;\n      line-height: 1.6;\n      color: var(--j2-text);\n    }\n    #pickup-payment-notice p:last-child {\n      margin-bottom: 0;\n    }\n  </style>\n  <div class=\"pickup-inner\">\n    <div class=\"j2-card\">\n      <h2 id=\"pickup-payment-heading\">Pickup and payment</h2>\n      <p>Customers collect the order at the shop.</p>\n      <p>No online payment is taken.</p>\n    </div>\n  </div>\n</section>",
    "workflow": "Pickup and payment notice"
  },
  "W-36": {
    "owner": "W-40",
    "head": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<style>\n*, *::before, *::after { box-sizing: border-box; }\nhtml { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }\nbody { margin: 0; max-width: 100%; display: flex; flex-direction: column; background: var(--j2-background); color: var(--j2-text); font-family: var(--j2-font-body); line-height: 1.5; overflow-wrap: anywhere; }\nbody > * { width: 100%; min-width: 0; }\nimg, svg, video, iframe, table { max-width: 100%; }\nsection[id] { scroll-margin-top: 16px; }\n#page-header { order: -1; background: var(--j2-surface); border-bottom: 2px solid var(--j2-primary); padding: 8px 16px; width: 100%; }\n#page-header .header-inner { max-width: 1100px; margin: 0 auto; display: flex; flex-direction: column; gap: 8px; align-items: stretch; }\n#page-header .header-brand { font-family: var(--j2-font-heading); font-size: 1.25rem; font-weight: 700; color: var(--j2-primary); }\n#site-nav { width: 100%; }\n#site-nav ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }\n#site-nav li { margin: 0; min-width: 0; }\n#site-nav .nav-link { display: inline-flex; align-items: center; justify-content: center; text-align: center; width: 100%; min-height: 44px; min-width: 44px; padding: 8px 12px; border: 2px solid var(--j2-primary); border-radius: var(--j2-radius, 12px); background: transparent; color: var(--j2-primary); font-family: var(--j2-font-body); font-size: 1rem; font-weight: 600; text-decoration: none; }\n#site-nav .nav-link:hover { background: var(--j2-primary); color: var(--j2-surface); }\n#site-nav .nav-link:focus-visible { outline: 3px solid var(--j2-accent); outline-offset: 2px; }\n#site-nav .nav-link-main { background: var(--j2-primary); color: var(--j2-surface); }\n#site-nav .nav-link-main:hover { background: var(--j2-secondary); border-color: var(--j2-secondary); }\n@media (min-width: 700px) {\n  #page-header { position: sticky; top: 0; z-index: 10; padding: 8px 24px; }\n  #page-header .header-inner { flex-direction: row; align-items: center; justify-content: space-between; gap: 24px; }\n  #site-nav { width: auto; }\n  #site-nav ul { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }\n  #site-nav .nav-link { width: auto; padding: 8px 16px; }\n  section[id] { scroll-margin-top: 80px; }\n}\n@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }\n</style>",
    "body": "<header id=\"page-header\">\n  <div id=\"page\" class=\"header-inner\">\n    <span class=\"header-brand\">Brew Lab</span>\n    <nav id=\"site-nav\" aria-label=\"Page sections\">\n      <ul>\n        <li><a class=\"nav-link\" href=\"#shop-identity\">Address</a></li>\n        <li><a class=\"nav-link\" href=\"#menu\">Menu</a></li>\n        <li><a class=\"nav-link nav-link-main\" href=\"#pre-order\">Pre-order</a></li>\n        <li><a class=\"nav-link\" href=\"#pickup-payment-notice\">Pickup &amp; payment</a></li>\n      </ul>\n    </nav>\n  </div>\n</header>",
    "workflow": "Header and nav first in HTML source"
  }
}