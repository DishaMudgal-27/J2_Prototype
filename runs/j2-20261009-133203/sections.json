{
  "style": {
    "owner": "W-1",
    "head": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&amp;family=Nunito+Sans:wght@400;600;700&amp;display=swap\"><style>:root{--j2-primary:#7A3B1E;--j2-secondary:#4F5D2F;--j2-accent:#B5763A;--j2-background:#F7F1E8;--j2-surface:#FFFDF9;--j2-text:#2B2118;--j2-muted:#6B5B4D;--j2-font-heading:'Cormorant Garamond', Georgia, serif;--j2-font-body:'Nunito Sans', 'Segoe UI', Arial, sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:12px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;background:#7A3B1E;color:#FFFDF9;border:2px solid #7A3B1E;min-height:48px;padding:12px 24px;font-weight:700;letter-spacing:0.02em;}.j2-btn-secondary{display:inline-block;background:transparent;color:#4F5D2F;border:2px solid #4F5D2F;min-height:48px;padding:12px 24px;font-weight:700;letter-spacing:0.02em;}.j2-card{background:#FFFDF9;border:1px solid #E6DAC8;border-radius:12px;padding:16px;box-shadow:0 2px 10px rgba(43,33,24,0.06);}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-1": {
    "owner": "W-1",
    "head": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"theme-color\" content=\"#7A3B1E\">",
    "body": "<style>\n  *, *::before, *::after { box-sizing: border-box; }\n  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }\n  body {\n    margin: 0;\n    background: var(--j2-background);\n    color: var(--j2-text);\n    font-family: var(--j2-font-body);\n    font-size: 16px;\n    line-height: 1.6;\n    overflow-x: clip;\n  }\n  img, svg, video, iframe, table { max-width: 100%; }\n  img, svg, video { height: auto; }\n  h1, h2, h3, h4 {\n    font-family: var(--j2-font-heading);\n    color: var(--j2-primary);\n    line-height: 1.2;\n    margin: 0 0 12px;\n    overflow-wrap: anywhere;\n  }\n  h1 { font-size: clamp(2rem, 7vw, 3.25rem); }\n  h2 { font-size: clamp(1.6rem, 5vw, 2.25rem); }\n  h3 { font-size: 1.25rem; }\n  p { margin: 0 0 12px; overflow-wrap: anywhere; }\n  a { color: var(--j2-primary); text-underline-offset: 3px; }\n  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible {\n    outline: 3px solid var(--j2-accent);\n    outline-offset: 2px;\n  }\n  .j2-container {\n    width: 100%;\n    max-width: 1120px;\n    margin: 0 auto;\n    padding-left: 16px;\n    padding-right: 16px;\n  }\n  .j2-section { padding-top: 40px; padding-bottom: 40px; }\n  .j2-section-title { text-align: center; margin-bottom: 24px; }\n  .j2-grid {\n    display: grid;\n    gap: 16px;\n    grid-template-columns: minmax(0, 1fr);\n  }\n  .j2-grid > * { min-width: 0; }\n  .j2-btn, .j2-btn-secondary {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    text-decoration: none;\n    cursor: pointer;\n    font-family: var(--j2-font-body);\n    font-size: 1rem;\n    max-width: 100%;\n  }\n  .j2-weave-band {\n    height: 10px;\n    width: 100%;\n    background: repeating-linear-gradient(90deg, #7A3B1E 0 24px, #B5763A 24px 48px, #4F5D2F 48px 72px, #F7F1E8 72px 80px);\n  }\n  .j2-visually-hidden {\n    position: absolute !important;\n    width: 1px; height: 1px;\n    overflow: hidden;\n    clip: rect(0 0 0 0);\n    white-space: nowrap;\n  }\n  @media (min-width: 640px) {\n    .j2-container { padding-left: 24px; padding-right: 24px; }\n    .j2-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }\n  }\n  @media (min-width: 1024px) {\n    .j2-section { padding-top: 64px; padding-bottom: 64px; }\n    .j2-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    html { scroll-behavior: auto; }\n  }\n</style>\n<div class=\"j2-weave-band\" aria-hidden=\"true\"></div>",
    "workflow": "Foundation and earthy styling"
  },
  "W-2": {
    "owner": "W-2",
    "head": "",
    "body": "<section id=\"products\" class=\"j2-section\" aria-labelledby=\"products-title\">\n  <style>\n    #products .w2-card { display: flex; flex-direction: column; gap: 12px; }\n    #products .w2-pic {\n      aspect-ratio: 4 / 5;\n      width: 100%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      text-align: center;\n      padding: 16px;\n      background: var(--j2-background);\n      border: 2px dashed var(--j2-accent);\n      border-radius: var(--j2-radius);\n      color: var(--j2-muted);\n      font-size: 0.875rem;\n      font-weight: 600;\n      letter-spacing: 0.02em;\n    }\n    #products .w2-cat {\n      margin: 0;\n      color: var(--j2-secondary);\n      font-size: 0.8125rem;\n      font-weight: 700;\n      letter-spacing: 0.08em;\n      text-transform: uppercase;\n    }\n    #products .w2-name { margin: 0; font-size: 1.35rem; }\n    #products .w2-price {\n      margin: 0;\n      color: var(--j2-text);\n      font-size: 1.125rem;\n      font-weight: 700;\n    }\n    #products .w2-order-slot { margin-top: auto; }\n    #products .w2-intro {\n      text-align: center;\n      color: var(--j2-muted);\n      max-width: 36rem;\n      margin: -8px auto 24px;\n    }\n  </style>\n\n  <div class=\"j2-container\">\n    <h2 id=\"products-title\" class=\"j2-section-title\">Our handloom collection</h2>\n    <p class=\"w2-intro\">Kurtas, sarees, shirts and dupattas. Pictures are placeholders until real photos arrive.</p>\n\n    <div class=\"j2-grid\" id=\"product-grid\">\n\n      <article class=\"j2-card w2-card\" data-product-id=\"indigo-block-print-kurta\" data-product-name=\"Indigo block-print kurta\" data-category=\"Kurtas\" data-price=\"1499\">\n        <div class=\"w2-pic\" role=\"img\" aria-label=\"Placeholder picture for Indigo block-print kurta\">Placeholder picture<br>Photo coming soon</div>\n        <p class=\"w2-cat\">Kurtas</p>\n        <h3 class=\"w2-name\">Indigo block-print kurta</h3>\n        <p class=\"w2-price\">₹1,499</p>\n        <div class=\"w2-order-slot\" data-product-id=\"indigo-block-print-kurta\"></div>\n      </article>\n\n      <article class=\"j2-card w2-card\" data-product-id=\"mustard-handloom-kurta\" data-product-name=\"Mustard handloom kurta\" data-category=\"Kurtas\" data-price=\"1699\">\n        <div class=\"w2-pic\" role=\"img\" aria-label=\"Placeholder picture for Mustard handloom kurta\">Placeholder picture<br>Photo coming soon</div>\n        <p class=\"w2-cat\">Kurtas</p>\n        <h3 class=\"w2-name\">Mustard handloom kurta</h3>\n        <p class=\"w2-price\">₹1,699</p>\n        <div class=\"w2-order-slot\" data-product-id=\"mustard-handloom-kurta\"></div>\n      </article>\n\n      <article class=\"j2-card w2-card\" data-product-id=\"white-chikankari-kurta\" data-product-name=\"White chikankari kurta\" data-category=\"Kurtas\" data-price=\"2199\">\n        <div class=\"w2-pic\" role=\"img\" aria-label=\"Placeholder picture for White chikankari kurta\">Placeholder picture<br>Photo coming soon</div>\n        <p class=\"w2-cat\">Kurtas</p>\n        <h3 class=\"w2-name\">White chikankari kurta</h3>\n        <p class=\"w2-price\">₹2,199</p>\n        <div class=\"w2-order-slot\" data-product-id=\"white-chikankari-kurta\"></div>\n      </article>\n\n      <article class=\"j2-card w2-card\" data-product-id=\"ikat-handloom-saree\" data-product-name=\"Ikat handloom saree\" data-category=\"Sarees\" data-price=\"3499\">\n        <div class=\"w2-pic\" role=\"img\" aria-label=\"Placeholder picture for Ikat handloom saree\">Placeholder picture<br>Photo coming soon</div>\n        <p class=\"w2-cat\">Sarees</p>\n        <h3 class=\"w2-name\">Ikat handloom saree</h3>\n        <p class=\"w2-price\">₹3,499</p>\n        <div class=\"w2-order-slot\" data-product-id=\"ikat-handloom-saree\"></div>\n      </article>\n\n      <article class=\"j2-card w2-card\" data-product-id=\"khadi-silk-saree\" data-product-name=\"Khadi silk saree\" data-category=\"Sarees\" data-price=\"4999\">\n        <div class=\"w2-pic\" role=\"img\" aria-label=\"Placeholder picture for Khadi silk saree\">Placeholder picture<br>Photo coming soon</div>\n        <p class=\"w2-cat\">Sarees</p>\n        <h3 class=\"w2-name\">Khadi silk saree</h3>\n        <p class=\"w2-price\">₹4,999</p>\n        <div class=\"w2-order-slot\" data-product-id=\"khadi-silk-saree\"></div>\n      </article>\n\n      <article class=\"j2-card w2-card\" data-product-id=\"cotton-jamdani-saree\" data-product-name=\"Cotton jamdani saree\" data-category=\"Sarees\" data-price=\"3999\">\n        <div class=\"w2-pic\" role=\"img\" aria-label=\"Placeholder picture for Cotton jamdani saree\">Placeholder picture<br>Photo coming soon</div>\n        <p class=\"w2-cat\">Sarees</p>\n        <h3 class=\"w2-name\">Cotton jamdani saree</h3>\n        <p class=\"w2-price\">₹3,999</p>\n        <div class=\"w2-order-slot\" data-product-id=\"cotton-jamdani-saree\"></div>\n      </article>\n\n      <article class=\"j2-card w2-card\" data-product-id=\"khadi-cotton-shirt\" data-product-name=\"Khadi cotton shirt\" data-category=\"Shirts\" data-price=\"1299\">\n        <div class=\"w2-pic\" role=\"img\" aria-label=\"Placeholder picture for Khadi cotton shirt\">Placeholder picture<br>Photo coming soon</div>\n        <p class=\"w2-cat\">Shirts</p>\n        <h3 class=\"w2-name\">Khadi cotton shirt</h3>\n        <p class=\"w2-price\">₹1,299</p>\n        <div class=\"w2-order-slot\" data-product-id=\"khadi-cotton-shirt\"></div>\n      </article>\n\n      <article class=\"j2-card w2-card\" data-product-id=\"linen-blend-shirt\" data-product-name=\"Linen-blend shirt\" data-category=\"Shirts\" data-price=\"1599\">\n        <div class=\"w2-pic\" role=\"img\" aria-label=\"Placeholder picture for Linen-blend shirt\">Placeholder picture<br>Photo coming soon</div>\n        <p class=\"w2-cat\">Shirts</p>\n        <h3 class=\"w2-name\">Linen-blend shirt</h3>\n        <p class=\"w2-price\">₹1,599</p>\n        <div class=\"w2-order-slot\" data-product-id=\"linen-blend-shirt\"></div>\n      </article>\n\n      <article class=\"j2-card w2-card\" data-product-id=\"block-print-dupatta\" data-product-name=\"Block-print dupatta\" data-category=\"Dupattas\" data-price=\"899\">\n        <div class=\"w2-pic\" role=\"img\" aria-label=\"Placeholder picture for Block-print dupatta\">Placeholder picture<br>Photo coming soon</div>\n        <p class=\"w2-cat\">Dupattas</p>\n        <h3 class=\"w2-name\">Block-print dupatta</h3>\n        <p class=\"w2-price\">₹899</p>\n        <div class=\"w2-order-slot\" data-product-id=\"block-print-dupatta\"></div>\n      </article>\n\n      <article class=\"j2-card w2-card\" data-product-id=\"chanderi-dupatta\" data-product-name=\"Chanderi dupatta\" data-category=\"Dupattas\" data-price=\"1099\">\n        <div class=\"w2-pic\" role=\"img\" aria-label=\"Placeholder picture for Chanderi dupatta\">Placeholder picture<br>Photo coming soon</div>\n        <p class=\"w2-cat\">Dupattas</p>\n        <h3 class=\"w2-name\">Chanderi dupatta</h3>\n        <p class=\"w2-price\">₹1,099</p>\n        <div class=\"w2-order-slot\" data-product-id=\"chanderi-dupatta\"></div>\n      </article>\n\n    </div>\n  </div>\n\n  <script>\n    window.J2_PRODUCTS = [\n      { id: \"indigo-block-print-kurta\", name: \"Indigo block-print kurta\", category: \"Kurtas\", price: 1499 },\n      { id: \"mustard-handloom-kurta\", name: \"Mustard handloom kurta\", category: \"Kurtas\", price: 1699 },\n      { id: \"white-chikankari-kurta\", name: \"White chikankari kurta\", category: \"Kurtas\", price: 2199 },\n      { id: \"ikat-handloom-saree\", name: \"Ikat handloom saree\", category: \"Sarees\", price: 3499 },\n      { id: \"khadi-silk-saree\", name: \"Khadi silk saree\", category: \"Sarees\", price: 4999 },\n      { id: \"cotton-jamdani-saree\", name: \"Cotton jamdani saree\", category: \"Sarees\", price: 3999 },\n      { id: \"khadi-cotton-shirt\", name: \"Khadi cotton shirt\", category: \"Shirts\", price: 1299 },\n      { id: \"linen-blend-shirt\", name: \"Linen-blend shirt\", category: \"Shirts\", price: 1599 },\n      { id: \"block-print-dupatta\", name: \"Block-print dupatta\", category: \"Dupattas\", price: 899 },\n      { id: \"chanderi-dupatta\", name: \"Chanderi dupatta\", category: \"Dupattas\", price: 1099 }\n    ];\n  </script>\n</section>",
    "workflow": "Product catalogue"
  },
  "W-3": {
    "owner": "W-3",
    "head": "",
    "body": "<style>\n  #products .w3-order {\n    display: flex;\n    width: 100%;\n  }\n</style>\n<script>\n  (function () {\n    var WA_NUMBER = \"910000011111\";\n\n    function buildMessage(name) {\n      return \"Hello Thread & Loom, I would like to order: \" + name;\n    }\n\n    function buildLink(name) {\n      return \"https://wa.me/\" + WA_NUMBER + \"?text=\" + encodeURIComponent(buildMessage(name));\n    }\n\n    function nameFor(slot) {\n      var card = slot.closest(\"[data-product-name]\");\n      if (card && card.getAttribute(\"data-product-name\")) {\n        return card.getAttribute(\"data-product-name\");\n      }\n      var id = slot.getAttribute(\"data-product-id\");\n      var list = window.J2_PRODUCTS || [];\n      for (var i = 0; i < list.length; i++) {\n        if (list[i].id === id) return list[i].name;\n      }\n      return \"\";\n    }\n\n    function addButtons() {\n      var slots = document.querySelectorAll(\".w2-order-slot[data-product-id]\");\n      for (var i = 0; i < slots.length; i++) {\n        var slot = slots[i];\n        if (slot.querySelector(\".w3-order\")) continue;\n        var name = nameFor(slot);\n        if (!name) continue;\n        var a = document.createElement(\"a\");\n        a.className = \"j2-btn w3-order\";\n        a.href = buildLink(name);\n        a.target = \"_blank\";\n        a.rel = \"noopener noreferrer\";\n        a.setAttribute(\"aria-label\", \"Order \" + name + \" on WhatsApp\");\n        a.textContent = \"Order on WhatsApp\";\n        slot.appendChild(a);\n      }\n    }\n\n    window.J2_buildWhatsAppLink = buildLink;\n\n    if (document.readyState === \"loading\") {\n      document.addEventListener(\"DOMContentLoaded\", addButtons);\n    } else {\n      addButtons();\n    }\n  })();\n</script>",
    "workflow": "Per-product WhatsApp order buttons"
  },
  "W-4": {
    "owner": "W-4",
    "head": "",
    "body": "<header id=\"top\" class=\"w4-header\" aria-labelledby=\"w4-name\">\n  <style>\n    .w4-header {\n      background: var(--j2-surface);\n      border-bottom: 1px solid #E6DAC8;\n      padding: 32px 0;\n      text-align: center;\n    }\n    .w4-header .w4-name {\n      margin: 0 0 8px;\n      font-size: clamp(2.25rem, 9vw, 3.5rem);\n      letter-spacing: 0.02em;\n    }\n    .w4-header .w4-tagline {\n      margin: 0 auto 8px;\n      max-width: 34rem;\n      color: var(--j2-muted);\n    }\n    .w4-header .w4-place {\n      margin: 0 0 20px;\n      color: var(--j2-secondary);\n      font-size: 0.8125rem;\n      font-weight: 700;\n      letter-spacing: 0.08em;\n      text-transform: uppercase;\n    }\n    .w4-header .w4-actions {\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: center;\n      gap: 12px;\n    }\n    #visit .w4-visit-card {\n      max-width: 32rem;\n      margin: 0 auto;\n      text-align: center;\n    }\n    #visit .w4-label {\n      margin: 0 0 8px;\n      color: var(--j2-secondary);\n      font-size: 0.8125rem;\n      font-weight: 700;\n      letter-spacing: 0.08em;\n      text-transform: uppercase;\n    }\n    #visit .w4-shop {\n      margin: 0 0 8px;\n      font-family: var(--j2-font-heading);\n      font-size: 1.5rem;\n      font-weight: 700;\n      color: var(--j2-primary);\n    }\n    #visit address {\n      font-style: normal;\n      font-size: 1.125rem;\n      line-height: 1.6;\n      color: var(--j2-text);\n      overflow-wrap: anywhere;\n    }\n  </style>\n  <div class=\"j2-container\">\n    <h1 id=\"w4-name\" class=\"w4-name\">Thread &amp; Loom</h1>\n    <p class=\"w4-tagline\">Handloom kurtas, sarees, cotton shirts and dupattas.</p>\n    <p class=\"w4-place\">Boutique in Pune</p>\n    <div class=\"w4-actions\">\n      <a class=\"j2-btn\" href=\"#products\">Browse the collection</a>\n      <a class=\"j2-btn j2-btn-secondary\" href=\"#visit\">Visit us</a>\n    </div>\n  </div>\n</header>\n\n<section id=\"visit\" class=\"j2-section\" aria-labelledby=\"visit-title\">\n  <div class=\"j2-container\">\n    <h2 id=\"visit-title\" class=\"j2-section-title\">Visit us</h2>\n    <div class=\"j2-card w4-visit-card\">\n      <p class=\"w4-label\">Our shop</p>\n      <p class=\"w4-shop\">Thread &amp; Loom</p>\n      <address>18 FC Road, Shivajinagar, Pune 411005</address>\n    </div>\n  </div>\n  <script>\n    (function () {\n      function placeHeader() {\n        var header = document.getElementById(\"top\");\n        var products = document.getElementById(\"products\");\n        if (header && products && products.parentNode && header.nextElementSibling !== products) {\n          products.parentNode.insertBefore(header, products);\n        }\n      }\n      if (document.readyState === \"loading\") {\n        document.addEventListener(\"DOMContentLoaded\", placeHeader);\n      } else {\n        placeHeader();\n      }\n    })();\n  </script>\n</section>",
    "workflow": "Shop name and address"
  },
  "W-5": {
    "owner": "W-5",
    "head": "",
    "body": "<section id=\"contact\" class=\"j2-section\" aria-labelledby=\"contact-title\">\n  <style>\n    #contact .w5-wrap {\n      max-width: 40rem;\n      margin: 0 auto;\n    }\n    #contact .w5-intro {\n      text-align: center;\n      color: var(--j2-muted);\n      margin: -8px auto 24px;\n      max-width: 32rem;\n    }\n    #contact .w5-list {\n      display: grid;\n      gap: 16px;\n      grid-template-columns: minmax(0, 1fr);\n    }\n    #contact .w5-card {\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n      text-align: center;\n      align-items: stretch;\n    }\n    #contact .w5-label {\n      margin: 0;\n      color: var(--j2-secondary);\n      font-size: 0.8125rem;\n      font-weight: 700;\n      letter-spacing: 0.08em;\n      text-transform: uppercase;\n    }\n    #contact .w5-note {\n      margin: 0 0 4px;\n      color: var(--j2-muted);\n      font-size: 0.9375rem;\n    }\n    #contact .w5-card .j2-btn,\n    #contact .w5-card .j2-btn-secondary {\n      width: 100%;\n      white-space: normal;\n    }\n    @media (min-width: 640px) {\n      #contact .w5-list {\n        grid-template-columns: repeat(2, minmax(0, 1fr));\n        gap: 24px;\n      }\n    }\n  </style>\n\n  <div class=\"j2-container\">\n    <h2 id=\"contact-title\" class=\"j2-section-title\">Order or call us</h2>\n    <p class=\"w5-intro\">Tap a number to message us on WhatsApp or to call the shop.</p>\n\n    <div class=\"w5-wrap\">\n      <div class=\"w5-list\">\n\n        <div class=\"j2-card w5-card\">\n          <p class=\"w5-label\">WhatsApp orders</p>\n          <p class=\"w5-note\">Message us to place an order.</p>\n          <a class=\"j2-btn w5-whatsapp\" href=\"https://wa.me/910000011111\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Order on WhatsApp: +91 00000 11111\">+91 00000 11111</a>\n        </div>\n\n        <div class=\"j2-card w5-card\">\n          <p class=\"w5-label\">Shop phone</p>\n          <p class=\"w5-note\">Call the shop directly.</p>\n          <a class=\"j2-btn j2-btn-secondary w5-phone\" href=\"tel:+910000022222\" aria-label=\"Call the shop: +91 00000 22222\">+91 00000 22222</a>\n        </div>\n\n      </div>\n    </div>\n  </div>\n</section>",
    "workflow": "Tappable WhatsApp and phone links"
  },
  "W-6": {
    "owner": "W-6",
    "head": "",
    "body": "<section id=\"timings\" class=\"j2-section\" aria-labelledby=\"timings-title\">\n  <style>\n    #timings .w6-card {\n      max-width: 32rem;\n      margin: 0 auto;\n      text-align: center;\n    }\n    #timings .w6-label {\n      margin: 0 0 8px;\n      color: var(--j2-secondary);\n      font-size: 0.8125rem;\n      font-weight: 700;\n      letter-spacing: 0.08em;\n      text-transform: uppercase;\n    }\n    #timings .w6-hours {\n      margin: 0 0 4px;\n      font-family: var(--j2-font-heading);\n      font-size: clamp(1.5rem, 6vw, 2rem);\n      font-weight: 700;\n      color: var(--j2-primary);\n    }\n    #timings .w6-days {\n      margin: 0 0 12px;\n      font-size: 1.125rem;\n      color: var(--j2-text);\n    }\n    #timings .w6-closed {\n      margin: 0;\n      padding-top: 12px;\n      border-top: 1px solid #E6DAC8;\n      color: var(--j2-muted);\n      font-weight: 600;\n    }\n  </style>\n\n  <div class=\"j2-container\">\n    <h2 id=\"timings-title\" class=\"j2-section-title\">Store timings</h2>\n    <div class=\"j2-card w6-card\">\n      <p class=\"w6-label\">Opening hours</p>\n      <p class=\"w6-hours\">11am to 9pm</p>\n      <p class=\"w6-days\">Tuesday to Sunday</p>\n      <p class=\"w6-closed\">Closed on Monday</p>\n    </div>\n  </div>\n</section>",
    "workflow": "Store timings"
  },
  "W-7": {
    "owner": "W-7",
    "head": "",
    "body": "<nav id=\"w7-nav\" class=\"w7-nav\" aria-label=\"Page sections\">\n  <style>\n    .w7-nav {\n      position: sticky;\n      top: 0;\n      z-index: 20;\n      width: 100%;\n      background: var(--j2-surface);\n      border-bottom: 1px solid var(--j2-accent);\n      box-shadow: 0 2px 10px rgba(43, 33, 24, 0.06);\n    }\n    .w7-nav .w7-list {\n      display: grid;\n      grid-template-columns: repeat(4, minmax(0, 1fr));\n      gap: 0;\n      list-style: none;\n      margin: 0 auto;\n      padding: 0 8px;\n      max-width: 1120px;\n    }\n    .w7-nav .w7-list li { min-width: 0; margin: 0; }\n    .w7-nav .w7-link {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      min-height: 48px;\n      padding: 0 4px;\n      color: var(--j2-primary);\n      font-family: var(--j2-font-body);\n      font-size: 0.875rem;\n      font-weight: 700;\n      letter-spacing: 0.02em;\n      text-align: center;\n      text-decoration: none;\n      overflow-wrap: anywhere;\n    }\n    .w7-nav .w7-link:hover { background: var(--j2-background); }\n    .w7-nav .w7-link[hidden] { display: none; }\n    #products, #visit, #contact, #timings { scroll-margin-top: 64px; }\n    @media (min-width: 640px) {\n      .w7-nav .w7-list { padding: 0 24px; }\n      .w7-nav .w7-link { font-size: 1rem; }\n    }\n  </style>\n  <ul class=\"w7-list\">\n    <li><a class=\"w7-link\" href=\"#products\">Products</a></li>\n    <li><a class=\"w7-link\" href=\"#visit\">Visit</a></li>\n    <li><a class=\"w7-link\" href=\"#contact\">Contact</a></li>\n    <li><a class=\"w7-link\" href=\"#timings\">Timings</a></li>\n  </ul>\n  <script>\n    (function () {\n      function init() {\n        try {\n          var nav = document.getElementById(\"w7-nav\");\n          if (nav && document.body && document.body.firstChild !== nav) {\n            document.body.insertBefore(nav, document.body.firstChild);\n          }\n          var links = document.querySelectorAll('a[href^=\"#\"]');\n          var broken = [];\n          for (var i = 0; i < links.length; i++) {\n            var href = links[i].getAttribute(\"href\") || \"\";\n            if (href.length < 2) continue;\n            var id = decodeURIComponent(href.slice(1));\n            if (!document.getElementById(id)) {\n              broken.push(href);\n              if (nav && nav.contains(links[i])) links[i].setAttribute(\"hidden\", \"\");\n            }\n          }\n          window.J2_BROKEN_LINKS = broken;\n          if (broken.length && window.console && console.warn) {\n            console.warn(\"Thread & Loom: in-page links with no target: \" + broken.join(\", \"));\n          }\n        } catch (e) {\n          if (window.console && console.warn) console.warn(\"Thread & Loom nav check skipped\");\n        }\n      }\n      if (document.readyState === \"loading\") {\n        document.addEventListener(\"DOMContentLoaded\", init);\n      } else {\n        init();\n      }\n    })();\n  </script>\n</nav>",
    "workflow": "Section nav and link integrity"
  }
}