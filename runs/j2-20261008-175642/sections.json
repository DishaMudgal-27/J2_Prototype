{
  "style": {
    "owner": "W-1",
    "head": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&amp;family=Nunito+Sans:wght@400;600;700&amp;display=swap\"><style>:root{--j2-primary:#7A3E2B;--j2-secondary:#55663A;--j2-accent:#B8862B;--j2-background:#FAF4EA;--j2-surface:#FFFFFF;--j2-text:#2E2420;--j2-muted:#6B5A4E;--j2-font-heading:'Cormorant Garamond', Georgia, 'Times New Roman', serif;--j2-font-body:'Nunito Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:12px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:12px 24px;background:#7A3E2B;color:#FFFFFF;border:2px solid #7A3E2B;border-radius:12px;font-weight:700;text-decoration:none;cursor:pointer}.j2-btn-secondary{display:inline-block;display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:12px 24px;background:transparent;color:#7A3E2B;border:2px solid #7A3E2B;border-radius:12px;font-weight:700;text-decoration:none;cursor:pointer}.j2-card{background:#FFFFFF;border:1px solid #E6D8C3;border-radius:12px;padding:16px;box-shadow:0 2px 8px rgba(46,36,32,0.06)}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-1": {
    "owner": "W-1",
    "head": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Thread &amp; Loom | Handloom clothing boutique, Pune</title>\n<meta name=\"description\" content=\"Thread &amp; Loom, a handloom clothing boutique in Pune: kurtas, sarees, cotton shirts and dupattas.\">",
    "body": "<style>\n  *, *::before, *::after { box-sizing: border-box; }\n  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }\n  body {\n    margin: 0;\n    background: var(--j2-background, #FAF4EA);\n    color: var(--j2-text, #2E2420);\n    font-family: var(--j2-font-body, system-ui, sans-serif);\n    font-size: 1rem;\n    line-height: 1.6;\n    overflow-x: hidden;\n  }\n  img, svg, video { max-width: 100%; height: auto; }\n  h1, h2, h3 {\n    font-family: var(--j2-font-heading, Georgia, serif);\n    color: var(--j2-primary, #7A3E2B);\n    line-height: 1.2;\n    margin: 0 0 0.5em;\n    overflow-wrap: anywhere;\n  }\n  p { overflow-wrap: anywhere; }\n  a { color: var(--j2-primary, #7A3E2B); }\n  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible {\n    outline: 3px solid var(--j2-accent, #B8862B);\n    outline-offset: 2px;\n  }\n\n  .w1-header {\n    background: var(--j2-surface, #FFFFFF);\n    border-bottom: 4px solid var(--j2-accent, #B8862B);\n    text-align: center;\n    padding: 32px 16px 24px;\n  }\n  .w1-header__inner { max-width: 1100px; margin: 0 auto; }\n  .w1-header__name {\n    font-size: clamp(2.25rem, 9vw, 3.75rem);\n    font-weight: 700;\n    letter-spacing: 0.02em;\n    margin: 0;\n  }\n  .w1-header__rule {\n    display: block;\n    width: 72px;\n    height: 3px;\n    margin: 12px auto;\n    background: var(--j2-secondary, #55663A);\n    border-radius: 3px;\n  }\n  .w1-header__tag {\n    margin: 0;\n    color: var(--j2-muted, #6B5A4E);\n    font-size: clamp(0.95rem, 3.6vw, 1.125rem);\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n  }\n  .w1-header__tag strong { color: var(--j2-secondary, #55663A); font-weight: 700; }\n</style>\n\n<header class=\"w1-header\" id=\"top\">\n  <div class=\"w1-header__inner\">\n    <h1 class=\"w1-header__name\">Thread &amp; Loom</h1>\n    <span class=\"w1-header__rule\" aria-hidden=\"true\"></span>\n    <p class=\"w1-header__tag\">Handloom clothing boutique &middot; <strong>Pune</strong></p>\n  </div>\n</header>",
    "workflow": "Earthy theme, header and viewport base"
  },
  "W-2": {
    "owner": "W-2",
    "head": "",
    "body": "<style>\n  .w2-catalogue { max-width: 1100px; margin: 0 auto; padding: var(--j2-section, 64px) 16px; }\n  .w2-catalogue__intro { text-align: center; margin-bottom: 24px; }\n  .w2-catalogue__intro h2 { font-size: clamp(1.75rem, 6vw, 2.5rem); margin-bottom: 8px; }\n  .w2-catalogue__intro p { margin: 0; color: var(--j2-muted, #6B5A4E); }\n\n  .w2-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 0 0 32px; padding: 0; }\n  .w2-tabs .w2-tab { padding: 8px 16px; font-family: var(--j2-font-body, system-ui, sans-serif); font-size: 1rem; line-height: 1.2; }\n\n  .w2-group { margin-bottom: 40px; }\n  .w2-group[hidden], .w2-card[hidden], .w2-empty[hidden] { display: none; }\n  .w2-group__title { font-size: clamp(1.5rem, 5vw, 2rem); padding-bottom: 8px; border-bottom: 2px solid var(--j2-accent, #B8862B); margin-bottom: 16px; }\n\n  .w2-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }\n  @media (min-width: 560px) { .w2-grid { grid-template-columns: repeat(2, 1fr); } }\n  @media (min-width: 900px) { .w2-grid { grid-template-columns: repeat(3, 1fr); } }\n\n  .w2-card { display: flex; flex-direction: column; min-width: 0; }\n  .w2-card__swatch { height: 96px; border-radius: 8px; margin-bottom: 12px; }\n  .w2-swatch--kurtas { background: repeating-linear-gradient(90deg, var(--j2-primary, #7A3E2B) 0 14px, var(--j2-accent, #B8862B) 14px 18px, var(--j2-surface, #FFFFFF) 18px 22px); }\n  .w2-swatch--sarees { background: repeating-linear-gradient(90deg, var(--j2-secondary, #55663A) 0 14px, var(--j2-accent, #B8862B) 14px 18px, var(--j2-surface, #FFFFFF) 18px 22px); }\n  .w2-swatch--shirts { background: repeating-linear-gradient(0deg, var(--j2-secondary, #55663A) 0 10px, var(--j2-surface, #FFFFFF) 10px 14px, var(--j2-primary, #7A3E2B) 14px 24px, var(--j2-surface, #FFFFFF) 24px 28px); }\n  .w2-swatch--dupattas { background: repeating-linear-gradient(45deg, var(--j2-accent, #B8862B) 0 10px, var(--j2-surface, #FFFFFF) 10px 14px, var(--j2-primary, #7A3E2B) 14px 24px, var(--j2-surface, #FFFFFF) 24px 28px); }\n  .w2-card__cat { margin: 0 0 4px; font-size: 0.8125rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--j2-secondary, #55663A); font-weight: 700; }\n  .w2-card__name { font-size: 1.375rem; margin: 0 0 8px; color: var(--j2-text, #2E2420); }\n  .w2-card__price { margin: 0; font-size: 1.25rem; font-weight: 700; color: var(--j2-primary, #7A3E2B); }\n  .w2-card__actions { margin-top: auto; padding-top: 12px; }\n  .w2-empty { text-align: center; color: var(--j2-muted, #6B5A4E); padding: 24px 0; }\n</style>\n\n<section class=\"w2-catalogue\" id=\"catalogue\" aria-labelledby=\"w2-title\">\n  <div class=\"w2-catalogue__intro\">\n    <h2 id=\"w2-title\">Our Collection</h2>\n    <p>Handloom kurtas, sarees, cotton shirts and dupattas. Prices in rupees.</p>\n  </div>\n\n  <div class=\"w2-tabs\" role=\"group\" aria-label=\"Browse by category\">\n    <button type=\"button\" class=\"w2-tab j2-btn\" data-w2-cat=\"all\" aria-pressed=\"true\">All</button>\n    <button type=\"button\" class=\"w2-tab j2-btn-secondary\" data-w2-cat=\"kurtas\" aria-pressed=\"false\">Kurtas</button>\n    <button type=\"button\" class=\"w2-tab j2-btn-secondary\" data-w2-cat=\"sarees\" aria-pressed=\"false\">Sarees</button>\n    <button type=\"button\" class=\"w2-tab j2-btn-secondary\" data-w2-cat=\"shirts\" aria-pressed=\"false\">Shirts</button>\n    <button type=\"button\" class=\"w2-tab j2-btn-secondary\" data-w2-cat=\"dupattas\" aria-pressed=\"false\">Dupattas</button>\n  </div>\n\n  <div class=\"w2-group\" data-w2-group=\"kurtas\">\n    <h3 class=\"w2-group__title\">Kurtas</h3>\n    <div class=\"w2-grid\">\n      <article class=\"w2-card j2-card\" data-category=\"kurtas\" data-price=\"1499\" data-sizes=\"S,M,L,XL,XXL\" data-name=\"Indigo block-print kurta\">\n        <div class=\"w2-card__swatch w2-swatch--kurtas\" aria-hidden=\"true\"></div>\n        <p class=\"w2-card__cat\">Kurtas</p>\n        <h4 class=\"w2-card__name\">Indigo block-print kurta</h4>\n        <p class=\"w2-card__price\">&#8377;1,499</p>\n        <div class=\"w2-card__actions\" data-w2-actions></div>\n      </article>\n      <article class=\"w2-card j2-card\" data-category=\"kurtas\" data-price=\"1699\" data-sizes=\"S,M,L,XL\" data-name=\"Mustard handloom kurta\">\n        <div class=\"w2-card__swatch w2-swatch--kurtas\" aria-hidden=\"true\"></div>\n        <p class=\"w2-card__cat\">Kurtas</p>\n        <h4 class=\"w2-card__name\">Mustard handloom kurta</h4>\n        <p class=\"w2-card__price\">&#8377;1,699</p>\n        <div class=\"w2-card__actions\" data-w2-actions></div>\n      </article>\n      <article class=\"w2-card j2-card\" data-category=\"kurtas\" data-price=\"2199\" data-sizes=\"XS,S,M,L,XL\" data-name=\"White chikankari kurta\">\n        <div class=\"w2-card__swatch w2-swatch--kurtas\" aria-hidden=\"true\"></div>\n        <p class=\"w2-card__cat\">Kurtas</p>\n        <h4 class=\"w2-card__name\">White chikankari kurta</h4>\n        <p class=\"w2-card__price\">&#8377;2,199</p>\n        <div class=\"w2-card__actions\" data-w2-actions></div>\n      </article>\n    </div>\n  </div>\n\n  <div class=\"w2-group\" data-w2-group=\"sarees\">\n    <h3 class=\"w2-group__title\">Sarees</h3>\n    <div class=\"w2-grid\">\n      <article class=\"w2-card j2-card\" data-category=\"sarees\" data-price=\"3499\" data-sizes=\"free\" data-name=\"Ikat handloom saree\">\n        <div class=\"w2-card__swatch w2-swatch--sarees\" aria-hidden=\"true\"></div>\n        <p class=\"w2-card__cat\">Sarees</p>\n        <h4 class=\"w2-card__name\">Ikat handloom saree</h4>\n        <p class=\"w2-card__price\">&#8377;3,499</p>\n        <div class=\"w2-card__actions\" data-w2-actions></div>\n      </article>\n      <article class=\"w2-card j2-card\" data-category=\"sarees\" data-price=\"4999\" data-sizes=\"free\" data-name=\"Khadi silk saree\">\n        <div class=\"w2-card__swatch w2-swatch--sarees\" aria-hidden=\"true\"></div>\n        <p class=\"w2-card__cat\">Sarees</p>\n        <h4 class=\"w2-card__name\">Khadi silk saree</h4>\n        <p class=\"w2-card__price\">&#8377;4,999</p>\n        <div class=\"w2-card__actions\" data-w2-actions></div>\n      </article>\n      <article class=\"w2-card j2-card\" data-category=\"sarees\" data-price=\"3999\" data-sizes=\"free\" data-name=\"Cotton jamdani saree\">\n        <div class=\"w2-card__swatch w2-swatch--sarees\" aria-hidden=\"true\"></div>\n        <p class=\"w2-card__cat\">Sarees</p>\n        <h4 class=\"w2-card__name\">Cotton jamdani saree</h4>\n        <p class=\"w2-card__price\">&#8377;3,999</p>\n        <div class=\"w2-card__actions\" data-w2-actions></div>\n      </article>\n    </div>\n  </div>\n\n  <div class=\"w2-group\" data-w2-group=\"shirts\">\n    <h3 class=\"w2-group__title\">Shirts</h3>\n    <div class=\"w2-grid\">\n      <article class=\"w2-card j2-card\" data-category=\"shirts\" data-price=\"1299\" data-sizes=\"S,M,L,XL,XXL\" data-name=\"Khadi cotton shirt\">\n        <div class=\"w2-card__swatch w2-swatch--shirts\" aria-hidden=\"true\"></div>\n        <p class=\"w2-card__cat\">Shirts</p>\n        <h4 class=\"w2-card__name\">Khadi cotton shirt</h4>\n        <p class=\"w2-card__price\">&#8377;1,299</p>\n        <div class=\"w2-card__actions\" data-w2-actions></div>\n      </article>\n      <article class=\"w2-card j2-card\" data-category=\"shirts\" data-price=\"1599\" data-sizes=\"M,L,XL,XXL\" data-name=\"Linen-blend shirt\">\n        <div class=\"w2-card__swatch w2-swatch--shirts\" aria-hidden=\"true\"></div>\n        <p class=\"w2-card__cat\">Shirts</p>\n        <h4 class=\"w2-card__name\">Linen-blend shirt</h4>\n        <p class=\"w2-card__price\">&#8377;1,599</p>\n        <div class=\"w2-card__actions\" data-w2-actions></div>\n      </article>\n    </div>\n  </div>\n\n  <div class=\"w2-group\" data-w2-group=\"dupattas\">\n    <h3 class=\"w2-group__title\">Dupattas</h3>\n    <div class=\"w2-grid\">\n      <article class=\"w2-card j2-card\" data-category=\"dupattas\" data-price=\"899\" data-sizes=\"free\" data-name=\"Block-print dupatta\">\n        <div class=\"w2-card__swatch w2-swatch--dupattas\" aria-hidden=\"true\"></div>\n        <p class=\"w2-card__cat\">Dupattas</p>\n        <h4 class=\"w2-card__name\">Block-print dupatta</h4>\n        <p class=\"w2-card__price\">&#8377;899</p>\n        <div class=\"w2-card__actions\" data-w2-actions></div>\n      </article>\n      <article class=\"w2-card j2-card\" data-category=\"dupattas\" data-price=\"1099\" data-sizes=\"free\" data-name=\"Chanderi dupatta\">\n        <div class=\"w2-card__swatch w2-swatch--dupattas\" aria-hidden=\"true\"></div>\n        <p class=\"w2-card__cat\">Dupattas</p>\n        <h4 class=\"w2-card__name\">Chanderi dupatta</h4>\n        <p class=\"w2-card__price\">&#8377;1,099</p>\n        <div class=\"w2-card__actions\" data-w2-actions></div>\n      </article>\n    </div>\n  </div>\n\n  <p class=\"w2-empty\" id=\"w2-empty\" role=\"status\" hidden>No products match your choices. Try a different category or clear the filters.</p>\n</section>\n\n<script>\n(function () {\n  var root = document.getElementById('catalogue');\n  if (!root) { return; }\n  var tabs = root.querySelectorAll('.w2-tab');\n  var groups = root.querySelectorAll('.w2-group');\n  var empty = document.getElementById('w2-empty');\n  var current = 'all';\n\n  // Visible = matches the selected category AND not hidden by another filter\n  // (other sections may set data-filter-hidden=\"true\" on a .w2-card, then call window.W2Catalog.apply()).\n  function apply() {\n    var anyVisible = false;\n    Array.prototype.forEach.call(groups, function (group) {\n      var groupCat = group.getAttribute('data-w2-group');\n      var catOk = current === 'all' || current === groupCat;\n      var groupVisible = false;\n      Array.prototype.forEach.call(group.querySelectorAll('.w2-card'), function (card) {\n        var filtered = card.getAttribute('data-filter-hidden') === 'true';\n        var show = catOk && !filtered;\n        card.hidden = !show;\n        if (show) { groupVisible = true; }\n      });\n      group.hidden = !groupVisible;\n      if (groupVisible) { anyVisible = true; }\n    });\n    if (empty) { empty.hidden = anyVisible; }\n  }\n\n  function setCategory(cat) {\n    current = cat;\n    Array.prototype.forEach.call(tabs, function (tab) {\n      var active = tab.getAttribute('data-w2-cat') === cat;\n      tab.setAttribute('aria-pressed', active ? 'true' : 'false');\n      tab.className = 'w2-tab ' + (active ? 'j2-btn' : 'j2-btn-secondary');\n    });\n    apply();\n    try {\n      document.dispatchEvent(new CustomEvent('w2:category', { detail: { category: cat } }));\n    } catch (e) { /* older browsers: ignore */ }\n  }\n\n  Array.prototype.forEach.call(tabs, function (tab) {\n    tab.addEventListener('click', function () {\n      setCategory(tab.getAttribute('data-w2-cat'));\n    });\n  });\n\n  window.W2Catalog = {\n    apply: apply,\n    setCategory: setCategory,\n    getCategory: function () { return current; }\n  };\n  apply();\n})();\n</script>",
    "workflow": "Product catalogue by category"
  },
  "W-3": {
    "owner": "W-3",
    "head": "",
    "body": "<style>\n  .w3-filters { max-width: 1100px; margin: 0 auto 24px; padding: 0 16px; }\n  .w3-filters.w3-in-catalogue { padding: 0; }\n  .w3-bar { display: grid; grid-template-columns: 1fr; gap: 16px; align-items: end; min-width: 0; }\n  .w3-title { font-size: 1.375rem; margin: 0 0 12px; }\n  .w3-field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }\n  .w3-label { font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--j2-secondary, #55663A); }\n  .w3-select {\n    width: 100%;\n    min-width: 0;\n    min-height: 44px;\n    padding: 8px 12px;\n    font-family: var(--j2-font-body, system-ui, sans-serif);\n    font-size: 1rem;\n    color: var(--j2-text, #2E2420);\n    background: var(--j2-surface, #FFFFFF);\n    border: 2px solid var(--j2-primary, #7A3E2B);\n    border-radius: var(--j2-radius, 12px);\n  }\n  .w3-clear { width: 100%; font-family: var(--j2-font-body, system-ui, sans-serif); font-size: 1rem; }\n  .w3-count { margin: 12px 0 0; color: var(--j2-muted, #6B5A4E); font-size: 0.9375rem; }\n  @media (min-width: 560px) {\n    .w3-bar { grid-template-columns: repeat(2, 1fr) auto; }\n    .w3-clear { width: auto; }\n  }\n</style>\n\n<div class=\"w3-filters j2-card\" id=\"w3-filters\">\n  <h3 class=\"w3-title\">Filter products</h3>\n  <div class=\"w3-bar\" role=\"group\" aria-label=\"Filter products by size and price\">\n    <div class=\"w3-field\">\n      <label class=\"w3-label\" for=\"w3-size\">Size</label>\n      <select class=\"w3-select\" id=\"w3-size\">\n        <option value=\"\">All sizes</option>\n        <option value=\"XS\">XS</option>\n        <option value=\"S\">S</option>\n        <option value=\"M\">M</option>\n        <option value=\"L\">L</option>\n        <option value=\"XL\">XL</option>\n        <option value=\"XXL\">XXL</option>\n        <option value=\"free\">Free size</option>\n      </select>\n    </div>\n    <div class=\"w3-field\">\n      <label class=\"w3-label\" for=\"w3-price\">Price (in rupees)</label>\n      <select class=\"w3-select\" id=\"w3-price\">\n        <option value=\"\">Any price</option>\n        <option value=\"1000\">Up to &#8377;1,000</option>\n        <option value=\"1500\">Up to &#8377;1,500</option>\n        <option value=\"2000\">Up to &#8377;2,000</option>\n        <option value=\"3000\">Up to &#8377;3,000</option>\n        <option value=\"4000\">Up to &#8377;4,000</option>\n      </select>\n    </div>\n    <button type=\"button\" class=\"w3-clear j2-btn-secondary\" id=\"w3-clear\">Clear filters</button>\n  </div>\n  <p class=\"w3-count\" id=\"w3-count\" role=\"status\" aria-live=\"polite\"></p>\n</div>\n\n<script>\n(function () {\n  var bar = document.getElementById('w3-filters');\n  var sizeSel = document.getElementById('w3-size');\n  var priceSel = document.getElementById('w3-price');\n  var clearBtn = document.getElementById('w3-clear');\n  var countEl = document.getElementById('w3-count');\n  if (!bar || !sizeSel || !priceSel || !clearBtn || !countEl) { return; }\n\n  // Show the bar right under the category tabs, above the product groups.\n  var catalogue = document.getElementById('catalogue');\n  var firstGroup = catalogue ? catalogue.querySelector('.w2-group') : null;\n  if (catalogue && firstGroup) {\n    bar.classList.add('w3-in-catalogue');\n    catalogue.insertBefore(bar, firstGroup);\n  }\n\n  var cards = document.querySelectorAll('.w2-card');\n\n  function sizesOf(card) {\n    var raw = card.getAttribute('data-sizes') || '';\n    var list = raw.split(',');\n    var out = [];\n    for (var i = 0; i < list.length; i++) {\n      var s = list[i].replace(/^\\s+|\\s+$/g, '');\n      if (s) { out.push(s); }\n    }\n    return out;\n  }\n\n  function updateCount() {\n    var shown = 0;\n    for (var i = 0; i < cards.length; i++) {\n      if (!cards[i].hidden) { shown++; }\n    }\n    countEl.textContent = 'Showing ' + shown + ' of ' + cards.length + ' products';\n  }\n\n  function run() {\n    var size = sizeSel.value;\n    var cap = parseInt(priceSel.value, 10);\n    for (var i = 0; i < cards.length; i++) {\n      var card = cards[i];\n      var ok = true;\n      if (size && sizesOf(card).indexOf(size) === -1) { ok = false; }\n      if (cap && Number(card.getAttribute('data-price')) > cap) { ok = false; }\n      if (ok) {\n        card.removeAttribute('data-filter-hidden');\n      } else {\n        card.setAttribute('data-filter-hidden', 'true');\n      }\n    }\n    if (window.W2Catalog && typeof window.W2Catalog.apply === 'function') {\n      window.W2Catalog.apply();\n    } else {\n      for (var j = 0; j < cards.length; j++) {\n        cards[j].hidden = cards[j].getAttribute('data-filter-hidden') === 'true';\n      }\n    }\n    updateCount();\n  }\n\n  sizeSel.addEventListener('change', run);\n  priceSel.addEventListener('change', run);\n  clearBtn.addEventListener('click', function () {\n    sizeSel.value = '';\n    priceSel.value = '';\n    run();\n  });\n  document.addEventListener('w2:category', updateCount);\n\n  run();\n})();\n</script>",
    "workflow": "Size and price filters"
  },
  "W-4": {
    "owner": "W-4",
    "head": "",
    "body": "<style>\n  .w4-guide { max-width: 1100px; margin: 0 auto; padding: var(--j2-section, 64px) 16px; }\n  .w4-guide__intro { text-align: center; margin-bottom: 24px; }\n  .w4-guide__intro h2 { font-size: clamp(1.75rem, 6vw, 2.5rem); margin-bottom: 8px; }\n  .w4-guide__intro p { margin: 0; color: var(--j2-muted, #6B5A4E); }\n  .w4-guide__card { max-width: 520px; margin: 0 auto; min-width: 0; }\n  .w4-table { width: 100%; border-collapse: collapse; font-family: var(--j2-font-body, system-ui, sans-serif); font-size: 1rem; }\n  .w4-table caption { text-align: left; font-family: var(--j2-font-heading, Georgia, serif); font-size: 1.375rem; font-weight: 600; color: var(--j2-primary, #7A3E2B); padding-bottom: 12px; }\n  .w4-table th, .w4-table td { padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--j2-accent, #B8862B); }\n  .w4-table thead th { background: var(--j2-primary, #7A3E2B); color: var(--j2-surface, #FFFFFF); font-size: 0.875rem; letter-spacing: 0.08em; text-transform: uppercase; border-bottom: 0; }\n  .w4-table tbody th { font-weight: 700; color: var(--j2-text, #2E2420); }\n  .w4-table tbody td { color: var(--j2-text, #2E2420); }\n  .w4-table tbody tr:last-child th, .w4-table tbody tr:last-child td { border-bottom: 0; }\n  .w4-note { margin: 16px 0 0; color: var(--j2-muted, #6B5A4E); font-size: 0.9375rem; }\n</style>\n\n<section class=\"w4-guide\" id=\"size-guide\" aria-labelledby=\"w4-title\">\n  <div class=\"w4-guide__intro\">\n    <h2 id=\"w4-title\">Size Guide</h2>\n    <p>Find your size by chest measurement, in inches.</p>\n  </div>\n  <div class=\"w4-guide__card j2-card\">\n    <table class=\"w4-table\">\n      <caption>Chest measurement by size</caption>\n      <thead>\n        <tr>\n          <th scope=\"col\">Size</th>\n          <th scope=\"col\">Chest (inches)</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr><th scope=\"row\">XS</th><td>32</td></tr>\n        <tr><th scope=\"row\">S</th><td>34</td></tr>\n        <tr><th scope=\"row\">M</th><td>36</td></tr>\n        <tr><th scope=\"row\">L</th><td>38</td></tr>\n        <tr><th scope=\"row\">XL</th><td>40</td></tr>\n        <tr><th scope=\"row\">XXL</th><td>42</td></tr>\n      </tbody>\n    </table>\n    <p class=\"w4-note\">All sarees and dupattas are free size (one size).</p>\n  </div>\n</section>",
    "workflow": "Size guide table"
  },
  "W-5": {
