    "body": "<style>\n  .w5-visit { max-width: 1100px; margin: 0 auto; padding: var(--j2-section, 64px) 16px; }\n  .w5-visit__intro { text-align: center; margin-bottom: 24px; }\n  .w5-visit__intro h2 { font-size: clamp(1.75rem, 6vw, 2.5rem); margin-bottom: 8px; }\n  .w5-visit__intro p { margin: 0; color: var(--j2-muted, #6B5A4E); }\n  .w5-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }\n  @media (min-width: 700px) { .w5-grid { grid-template-columns: repeat(3, 1fr); } }\n  .w5-card { min-width: 0; }\n  .w5-card h3 { font-size: 1.375rem; margin: 0 0 8px; }\n  .w5-card p { margin: 0 0 8px; overflow-wrap: anywhere; }\n  .w5-card p:last-child { margin-bottom: 0; }\n  .w5-address { font-style: normal; line-height: 1.6; overflow-wrap: anywhere; }\n  .w5-hours { list-style: none; margin: 0; padding: 0; }\n  .w5-hours li { padding: 4px 0; }\n  .w5-closed { color: var(--j2-secondary, #55663A); font-weight: 700; }\n  .w5-actions { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 8px; }\n</style>\n\n<section class=\"w5-visit\" id=\"visit\" aria-labelledby=\"w5-title\">\n  <div class=\"w5-visit__intro\">\n    <h2 id=\"w5-title\">Visit the Store</h2>\n    <p>Thread &amp; Loom, Pune</p>\n  </div>\n  <div class=\"w5-grid\">\n    <div class=\"w5-card j2-card\">\n      <h3>Address</h3>\n      <address class=\"w5-address\">18 FC Road, Shivajinagar, Pune 411005</address>\n      <div class=\"w5-actions\">\n        <a class=\"j2-btn-secondary\" href=\"https://www.google.com/maps/search/?api=1&amp;query=18+FC+Road+Shivajinagar+Pune+411005\" target=\"_blank\" rel=\"noopener\">Get directions</a>\n      </div>\n    </div>\n    <div class=\"w5-card j2-card\">\n      <h3>Timings</h3>\n      <ul class=\"w5-hours\">\n        <li>11am to 9pm</li>\n        <li>Tuesday to Sunday</li>\n        <li class=\"w5-closed\">Closed Monday</li>\n      </ul>\n    </div>\n    <div class=\"w5-card j2-card\">\n      <h3>Shop phone</h3>\n      <p>+91 00000 22222</p>\n      <div class=\"w5-actions\">\n        <a class=\"j2-btn-secondary\" href=\"tel:+910000022222\">Call the shop</a>\n      </div>\n    </div>\n  </div>\n</section>",
    "workflow": "Address, phone and timings"
  },
  "W-6": {
    "owner": "W-6",
    "head": "",
    "body": "<style>\n  .w6-policy { max-width: 1100px; margin: 0 auto; padding: var(--j2-section, 64px) 16px; }\n  .w6-policy__intro { text-align: center; margin-bottom: 24px; }\n  .w6-policy__intro h2 { font-size: clamp(1.75rem, 6vw, 2.5rem); margin-bottom: 8px; }\n  .w6-policy__intro p { margin: 0; color: var(--j2-muted, #6B5A4E); }\n  .w6-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }\n  @media (min-width: 700px) { .w6-grid { grid-template-columns: repeat(3, 1fr); } }\n  .w6-card { min-width: 0; border-top: 4px solid var(--j2-accent, #B8862B); }\n  .w6-card h3 { font-size: 1.375rem; margin: 0 0 8px; }\n  .w6-card p { margin: 0; overflow-wrap: anywhere; }\n  .w6-card strong { color: var(--j2-secondary, #55663A); }\n  .w6-more { text-align: center; margin: 24px 0 0; color: var(--j2-muted, #6B5A4E); }\n</style>\n\n<section class=\"w6-policy\" id=\"returns\" aria-labelledby=\"w6-title\">\n  <div class=\"w6-policy__intro\">\n    <h2 id=\"w6-title\">Return and Exchange Policy</h2>\n    <p>Exchange only. Please read before you order.</p>\n  </div>\n  <div class=\"w6-grid\">\n    <div class=\"w6-card j2-card\">\n      <h3>Exchange window</h3>\n      <p>We offer an <strong>exchange within 7 days</strong>.</p>\n    </div>\n    <div class=\"w6-card j2-card\">\n      <h3>Condition</h3>\n      <p>The item must be <strong>unworn with tags</strong> to be exchanged.</p>\n    </div>\n    <div class=\"w6-card j2-card\">\n      <h3>Sale items</h3>\n      <p><strong>No returns on sale items.</strong></p>\n    </div>\n  </div>\n  <p class=\"w6-more\">Questions about an exchange? See the <a href=\"#visit\">store address, timings and phone</a>.</p>\n</section>",
    "workflow": "Return and exchange policy"
  }
}