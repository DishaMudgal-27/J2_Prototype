  "W-1": {
    "owner": "W-10",
    "head": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"description\" content=\"Thread &amp; Loom, a handloom clothing boutique at 18 FC Road, Shivajinagar, Pune. Handloom kurtas, sarees, cotton shirts and dupattas.\">\n<meta name=\"theme-color\" content=\"#7A3E22\">\n<style>\n*,*::before,*::after{box-sizing:border-box}\nhtml{scroll-behavior:smooth;-webkit-text-size-adjust:100%;max-width:100%;overflow-x:clip}\nbody{margin:0;max-width:100%;overflow-x:clip;background:var(--j2-background,#FAF5EC);color:var(--j2-text,#2E2A25);font-family:var(--j2-font-body,'Nunito Sans',system-ui,sans-serif);line-height:1.6;font-size:16px}\nimg,svg,video,iframe,table{max-width:100%}\nh1,h2,h3,h4{font-family:var(--j2-font-heading,'Cormorant Garamond',Georgia,serif);line-height:1.15;overflow-wrap:break-word}\np,li,a,td,th{overflow-wrap:break-word}\nsection[id]{scroll-margin-top:76px}\na{color:var(--j2-primary,#7A3E22)}\na:focus-visible,button:focus-visible{outline:3px solid var(--j2-accent,#C58B2B);outline-offset:2px}\n</style>",
    "body": "<style>\n.tl-header{position:sticky;top:0;z-index:50;background:var(--j2-background,#FAF5EC);border-bottom:1px solid #E3D6BF}\n.tl-header-inner{display:flex;align-items:center;justify-content:space-between;gap:12px;max-width:1200px;margin:0 auto;padding:6px 16px;min-height:60px;position:relative}\n.tl-brand{font-family:var(--j2-font-heading,'Cormorant Garamond',Georgia,serif);font-size:1.6rem;font-weight:700;color:var(--j2-primary,#7A3E22);text-decoration:none;min-height:44px;display:inline-flex;align-items:center}\n.tl-toggle{min-height:44px;min-width:44px;padding:0 14px;background:transparent;border:2px solid var(--j2-primary,#7A3E22);color:var(--j2-primary,#7A3E22);border-radius:var(--j2-radius,12px);font:inherit;font-weight:700;cursor:pointer}\n.tl-nav{display:none;position:absolute;left:0;right:0;top:100%;background:var(--j2-background,#FAF5EC);border-bottom:1px solid #E3D6BF;box-shadow:0 8px 16px rgba(46,42,37,0.08)}\n.tl-nav.tl-open{display:block}\n.tl-nav ul{list-style:none;margin:0;padding:8px 16px 16px}\n.tl-nav a{display:flex;align-items:center;min-height:44px;padding:0 4px;color:var(--j2-text,#2E2A25);text-decoration:none;font-weight:600;border-bottom:1px solid #EADFCB}\n.tl-nav a:hover{color:var(--j2-primary,#7A3E22)}\n.tl-hero{background-color:var(--j2-surface,#F1E6D3);background-image:repeating-linear-gradient(90deg,rgba(122,62,34,0.06) 0 2px,transparent 2px 14px),repeating-linear-gradient(0deg,rgba(79,91,58,0.05) 0 2px,transparent 2px 14px);border-bottom:1px solid #E3D6BF}\n.tl-hero-inner{max-width:1200px;margin:0 auto;padding:56px 20px 64px}\n.tl-eyebrow{margin:0 0 8px;color:var(--j2-secondary,#4F5B3A);font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:.85rem}\n.tl-hero h1{margin:0 0 16px;font-size:clamp(2.4rem,9vw,4.2rem);color:var(--j2-primary,#7A3E22)}\n.tl-lead{margin:0 0 24px;max-width:36rem;font-size:1.1rem}\n.tl-actions{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:28px}\n.tl-facts{list-style:none;margin:0;padding:0;display:grid;gap:6px;color:var(--j2-text,#2E2A25);font-size:.98rem}\n.tl-facts strong{color:var(--j2-secondary,#4F5B3A)}\n.tl-footer{background:var(--j2-secondary,#4F5B3A);color:#FFFFFF;padding:32px 20px}\n.tl-footer-inner{max-width:1200px;margin:0 auto;display:grid;gap:8px}\n.tl-footer p{margin:0}\n.tl-footer .tl-fname{font-family:var(--j2-font-heading,'Cormorant Garamond',Georgia,serif);font-size:1.5rem;font-weight:700}\n.tl-footer a{color:#FFFFFF}\n@media (min-width:900px){\n.tl-toggle{display:none}\n.tl-nav{display:block;position:static;background:transparent;border:0;box-shadow:none}\n.tl-nav ul{display:flex;gap:18px;padding:0}\n.tl-nav a{border:0;font-size:.93rem;padding:0 2px}\n.tl-hero-inner{padding:88px 24px 96px}\n}\n</style>\n\n<header class=\"tl-header\" id=\"top\">\n  <div class=\"tl-header-inner\">\n    <a class=\"tl-brand\" href=\"#home\">Thread &amp; Loom</a>\n    <button class=\"tl-toggle\" id=\"tl-toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"tl-nav\">Menu</button>\n    <nav class=\"tl-nav\" id=\"tl-nav\" aria-label=\"Main\">\n      <ul>\n        <li><a href=\"#shop\">Shop</a></li>\n        <li><a href=\"#new-arrivals\">New arrivals</a></li>\n        <li><a href=\"#lookbook\">Lookbook</a></li>\n        <li><a href=\"#size-guide\">Size guide</a></li>\n        <li><a href=\"#store\">Visit us</a></li>\n        <li><a href=\"#orders-returns\">Orders &amp; returns</a></li>\n        <li><a href=\"#reviews\">Reviews</a></li>\n      </ul>\n    </nav>\n  </div>\n</header>\n\n<section class=\"tl-hero\" id=\"home\" aria-label=\"Welcome\">\n  <div class=\"tl-hero-inner\">\n    <p class=\"tl-eyebrow\">Handloom boutique, Pune</p>\n    <h1>Thread &amp; Loom</h1>\n    <p class=\"tl-lead\">Handloom kurtas, sarees, cotton shirts and dupattas. Browse the collection and order on WhatsApp.</p>\n    <div class=\"tl-actions\">\n      <a class=\"j2-btn\" href=\"#shop\">Shop the collection</a>\n      <a class=\"j2-btn j2-btn-secondary\" href=\"https://wa.me/918822033445\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n    </div>\n    <ul class=\"tl-facts\">\n      <li><strong>Visit:</strong> 18 FC Road, Shivajinagar, Pune 411005</li>\n      <li><strong>Open:</strong> Tuesday to Sunday, 11am to 9pm. Closed on Monday.</li>\n    </ul>\n  </div>\n</section>\n\n<footer class=\"tl-footer\" id=\"site-footer\">\n  <div class=\"tl-footer-inner\">\n    <p class=\"tl-fname\">Thread &amp; Loom</p>\n    <p>18 FC Road, Shivajinagar, Pune 411005</p>\n    <p>Tuesday to Sunday, 11am to 9pm. Closed on Monday.</p>\n    <p>Instagram: <a href=\"https://www.instagram.com/threadandloom.pune\" target=\"_blank\" rel=\"noopener\">@threadandloom.pune</a></p>\n  </div>\n</footer>\n\n<script>\n(function () {\n  var toggle = document.getElementById('tl-toggle');\n  var nav = document.getElementById('tl-nav');\n  if (toggle && nav) {\n    toggle.addEventListener('click', function () {\n      var open = nav.classList.toggle('tl-open');\n      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');\n    });\n    nav.addEventListener('click', function (e) {\n      if (e.target && e.target.tagName === 'A') {\n        nav.classList.remove('tl-open');\n        toggle.setAttribute('aria-expanded', 'false');\n      }\n    });\n  }\n  var footer = document.getElementById('site-footer');\n  function moveFooter() {\n    if (footer && document.body && footer.parentNode) { document.body.appendChild(footer); }\n  }\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', moveFooter);\n  } else {\n    moveFooter();\n  }\n  window.addEventListener('load', moveFooter);\n})();\n</script>",
    "workflow": "Head cleanup"
  },
  "W-2": {
    "owner": "W-2",
    "head": "",
    "body": "<section id=\"shop\" class=\"w2-shop\" aria-labelledby=\"w2-title\">\n<style>\n.w2-shop{max-width:1200px;margin:0 auto;padding:var(--j2-section,64px) 16px}\n.w2-shop h2{margin:0 0 8px;font-size:clamp(2rem,6vw,2.8rem);color:var(--j2-primary)}\n.w2-intro{margin:0 0 24px;max-width:38rem;color:var(--j2-muted)}\n.w2-controls{display:grid;gap:16px;margin-bottom:16px}\n.w2-cats{display:flex;flex-wrap:wrap;gap:8px}\n.w2-cat-btn{font:inherit;font-weight:700;padding:8px 16px;border-radius:var(--j2-radius)}\n.w2-cat-btn[aria-pressed=\"true\"]{background:var(--j2-primary);color:#FFFFFF}\n.w2-filters{display:grid;grid-template-columns:1fr;gap:12px;align-items:end}\n.w2-field{display:flex;flex-direction:column;gap:4px;min-width:0}\n.w2-label{font-size:.85rem;font-weight:700;color:var(--j2-secondary)}\n.w2-shop select,.w2-shop input[type=\"number\"]{width:100%;min-width:0;min-height:44px;padding:8px 10px;font:inherit;color:var(--j2-text);background:#FFFFFF;border:1px solid var(--j2-muted);border-radius:var(--j2-radius)}\n.w2-reset{font:inherit;font-weight:700;border-radius:var(--j2-radius)}\n.w2-count{margin:0 0 16px;font-weight:600;color:var(--j2-muted)}\n.w2-grid{display:grid;grid-template-columns:1fr;gap:20px}\n.w2-card{display:flex;flex-direction:column;gap:8px;min-width:0}\n.w2-card[hidden]{display:none}\n.w2-photo{width:100%;aspect-ratio:4/5;background:var(--j2-surface);border:2px dashed var(--j2-muted);border-radius:var(--j2-radius)}\n.w2-cat{margin:4px 0 0;font-size:.8rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--j2-secondary)}\n.w2-card h3{margin:0;font-size:1.5rem;color:var(--j2-text)}\n.w2-price{margin:0;font-family:var(--j2-font-heading);font-size:1.6rem;font-weight:700;color:var(--j2-primary)}\n.w2-sizes{margin:0;color:var(--j2-muted);font-size:.95rem}\n.w2-order{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:4px}\n.w2-order.w2-single{grid-template-columns:1fr}\n.w2-order-btn{margin-top:auto;border-radius:var(--j2-radius);text-align:center}\n.w2-empty{padding:32px 16px;text-align:center;background:var(--j2-surface);border-radius:var(--j2-radius)}\n.w2-empty p{margin:0 0 16px}\n@media (min-width:600px){\n.w2-filters{grid-template-columns:1fr 1fr auto}\n.w2-grid{grid-template-columns:repeat(2,minmax(0,1fr))}\n}\n@media (min-width:960px){\n.w2-grid{grid-template-columns:repeat(3,minmax(0,1fr))}\n}\n</style>\n\n<h2 id=\"w2-title\">Shop the collection</h2>\n<p class=\"w2-intro\">Handloom kurtas, sarees, cotton shirts and dupattas. Pick a size and quantity, then order on WhatsApp.</p>\n\n<div class=\"w2-controls\">\n  <div class=\"w2-cats\" role=\"group\" aria-label=\"Category\">\n    <button type=\"button\" class=\"j2-btn j2-btn-secondary w2-cat-btn\" data-cat=\"all\" aria-pressed=\"true\">All</button>\n    <button type=\"button\" class=\"j2-btn j2-btn-secondary w2-cat-btn\" data-cat=\"kurtas\" aria-pressed=\"false\">Kurtas</button>\n    <button type=\"button\" class=\"j2-btn j2-btn-secondary w2-cat-btn\" data-cat=\"sarees\" aria-pressed=\"false\">Sarees</button>\n    <button type=\"button\" class=\"j2-btn j2-btn-secondary w2-cat-btn\" data-cat=\"shirts\" aria-pressed=\"false\">Shirts</button>\n    <button type=\"button\" class=\"j2-btn j2-btn-secondary w2-cat-btn\" data-cat=\"dupattas\" aria-pressed=\"false\">Dupattas</button>\n  </div>\n  <div class=\"w2-filters\">\n    <label class=\"w2-field\"><span class=\"w2-label\">Filter by size</span>\n      <select id=\"w2-size-filter\">\n        <option value=\"all\">All sizes</option>\n        <option value=\"XS\">XS</option>\n        <option value=\"S\">S</option>\n        <option value=\"M\">M</option>\n        <option value=\"L\">L</option>\n        <option value=\"XL\">XL</option>\n        <option value=\"XXL\">XXL</option>\n        <option value=\"Free size\">Free size (sarees, dupattas)</option>\n      </select>\n    </label>\n    <label class=\"w2-field\"><span class=\"w2-label\">Filter by price</span>\n      <select id=\"w2-price-filter\">\n        <option value=\"all\">All prices</option>\n        <option value=\"under1500\">Under ₹1,500</option>\n        <option value=\"1500-2999\">₹1,500 to ₹2,999</option>\n        <option value=\"3000up\">₹3,000 and above</option>\n      </select>\n    </label>\n    <button type=\"button\" class=\"j2-btn j2-btn-secondary w2-reset\" id=\"w2-reset\">Clear filters</button>\n  </div>\n</div>\n\n<p class=\"w2-count\" id=\"w2-count\" aria-live=\"polite\">Showing 10 of 10 products</p>\n\n<div class=\"w2-grid\" id=\"w2-grid\">\n\n  <article class=\"j2-card w2-card\" data-name=\"Indigo block-print kurta\" data-cat=\"kurtas\" data-price=\"1499\" data-sizes=\"S,M,L,XL,XXL\">\n    <div class=\"w2-photo\" role=\"img\" aria-label=\"Photo spot for Indigo block-print kurta, photo not added yet\"></div>\n    <p class=\"w2-cat\">Kurta</p>\n    <h3>Indigo block-print kurta</h3>\n    <p class=\"w2-price\">₹1,499</p>\n    <p class=\"w2-sizes\">Sizes: S-XXL</p>\n    <div class=\"w2-order\">\n      <label class=\"w2-field\"><span class=\"w2-label\">Size</span>\n        <select class=\"w2-size\"><option>S</option><option>M</option><option>L</option><option>XL</option><option>XXL</option></select>\n      </label>\n      <label class=\"w2-field\"><span class=\"w2-label\">Quantity</span><input class=\"w2-qty\" type=\"number\" min=\"1\" max=\"99\" value=\"1\" inputmode=\"numeric\"></label>\n    </div>\n    <a class=\"j2-btn w2-order-btn\" href=\"https://wa.me/918822033445\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n  </article>\n\n  <article class=\"j2-card w2-card\" data-name=\"Mustard handloom kurta\" data-cat=\"kurtas\" data-price=\"1699\" data-sizes=\"S,M,L,XL\">\n    <div class=\"w2-photo\" role=\"img\" aria-label=\"Photo spot for Mustard handloom kurta, photo not added yet\"></div>\n    <p class=\"w2-cat\">Kurta</p>\n    <h3>Mustard handloom kurta</h3>\n    <p class=\"w2-price\">₹1,699</p>\n    <p class=\"w2-sizes\">Sizes: S-XL</p>\n    <div class=\"w2-order\">\n      <label class=\"w2-field\"><span class=\"w2-label\">Size</span>\n        <select class=\"w2-size\"><option>S</option><option>M</option><option>L</option><option>XL</option></select>\n      </label>\n      <label class=\"w2-field\"><span class=\"w2-label\">Quantity</span><input class=\"w2-qty\" type=\"number\" min=\"1\" max=\"99\" value=\"1\" inputmode=\"numeric\"></label>\n    </div>\n    <a class=\"j2-btn w2-order-btn\" href=\"https://wa.me/918822033445\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n  </article>\n\n  <article class=\"j2-card w2-card\" data-name=\"White chikankari kurta\" data-cat=\"kurtas\" data-price=\"2199\" data-sizes=\"XS,S,M,L,XL\">\n    <div class=\"w2-photo\" role=\"img\" aria-label=\"Photo spot for White chikankari kurta, photo not added yet\"></div>\n    <p class=\"w2-cat\">Kurta</p>\n    <h3>White chikankari kurta</h3>\n    <p class=\"w2-price\">₹2,199</p>\n    <p class=\"w2-sizes\">Sizes: XS-XL</p>\n    <div class=\"w2-order\">\n      <label class=\"w2-field\"><span class=\"w2-label\">Size</span>\n        <select class=\"w2-size\"><option>XS</option><option>S</option><option>M</option><option>L</option><option>XL</option></select>\n      </label>\n      <label class=\"w2-field\"><span class=\"w2-label\">Quantity</span><input class=\"w2-qty\" type=\"number\" min=\"1\" max=\"99\" value=\"1\" inputmode=\"numeric\"></label>\n    </div>\n    <a class=\"j2-btn w2-order-btn\" href=\"https://wa.me/918822033445\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n  </article>\n\n  <article class=\"j2-card w2-card\" data-name=\"Maheshwari cotton saree\" data-cat=\"sarees\" data-price=\"3499\" data-sizes=\"Free size\">\n    <div class=\"w2-photo\" role=\"img\" aria-label=\"Photo spot for Maheshwari cotton saree, photo not added yet\"></div>\n    <p class=\"w2-cat\">Saree</p>\n    <h3>Maheshwari cotton saree</h3>\n    <p class=\"w2-price\">₹3,499</p>\n    <p class=\"w2-sizes\">Free size</p>\n    <div class=\"w2-order w2-single\">\n      <label class=\"w2-field\"><span class=\"w2-label\">Quantity</span><input class=\"w2-qty\" type=\"number\" min=\"1\" max=\"99\" value=\"1\" inputmode=\"numeric\"></label>\n    </div>\n    <a class=\"j2-btn w2-order-btn\" href=\"https://wa.me/918822033445\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n  </article>\n\n  <article class=\"j2-card w2-card\" data-name=\"Chanderi silk-cotton saree\" data-cat=\"sarees\" data-price=\"4999\" data-sizes=\"Free size\">\n    <div class=\"w2-photo\" role=\"img\" aria-label=\"Photo spot for Chanderi silk-cotton saree, photo not added yet\"></div>\n    <p class=\"w2-cat\">Saree</p>\n    <h3>Chanderi silk-cotton saree</h3>\n    <p class=\"w2-price\">₹4,999</p>\n    <p class=\"w2-sizes\">Free size</p>\n    <div class=\"w2-order w2-single\">\n      <label class=\"w2-field\"><span class=\"w2-label\">Quantity</span><input class=\"w2-qty\" type=\"number\" min=\"1\" max=\"99\" value=\"1\" inputmode=\"numeric\"></label>\n    </div>\n    <a class=\"j2-btn w2-order-btn\" href=\"https://wa.me/918822033445\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n  </article>\n\n  <article class=\"j2-card w2-card\" data-name=\"Ikat handloom saree\" data-cat=\"sarees\" data-price=\"3999\" data-sizes=\"Free size\">\n    <div class=\"w2-photo\" role=\"img\" aria-label=\"Photo spot for Ikat handloom saree, photo not added yet\"></div>\n    <p class=\"w2-cat\">Saree</p>\n    <h3>Ikat handloom saree</h3>\n    <p class=\"w2-price\">₹3,999</p>\n    <p class=\"w2-sizes\">Free size</p>\n    <div class=\"w2-order w2-single\">\n      <label class=\"w2-field\"><span class=\"w2-label\">Quantity</span><input class=\"w2-qty\" type=\"number\" min=\"1\" max=\"99\" value=\"1\" inputmode=\"numeric\"></label>\n    </div>\n    <a class=\"j2-btn w2-order-btn\" href=\"https://wa.me/918822033445\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n  </article>\n\n  <article class=\"j2-card w2-card\" data-name=\"Khadi cotton shirt\" data-cat=\"shirts\" data-price=\"1299\" data-sizes=\"S,M,L,XL,XXL\">\n    <div class=\"w2-photo\" role=\"img\" aria-label=\"Photo spot for Khadi cotton shirt, photo not added yet\"></div>\n    <p class=\"w2-cat\">Shirt</p>\n    <h3>Khadi cotton shirt</h3>\n    <p class=\"w2-price\">₹1,299</p>\n    <p class=\"w2-sizes\">Sizes: S-XXL</p>\n    <div class=\"w2-order\">\n      <label class=\"w2-field\"><span class=\"w2-label\">Size</span>\n        <select class=\"w2-size\"><option>S</option><option>M</option><option>L</option><option>XL</option><option>XXL</option></select>\n      </label>\n      <label class=\"w2-field\"><span class=\"w2-label\">Quantity</span><input class=\"w2-qty\" type=\"number\" min=\"1\" max=\"99\" value=\"1\" inputmode=\"numeric\"></label>\n    </div>\n    <a class=\"j2-btn w2-order-btn\" href=\"https://wa.me/918822033445\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n  </article>\n\n  <article class=\"j2-card w2-card\" data-name=\"Linen-blend shirt\" data-cat=\"shirts\" data-price=\"1599\" data-sizes=\"M,L,XL,XXL\">\n    <div class=\"w2-photo\" role=\"img\" aria-label=\"Photo spot for Linen-blend shirt, photo not added yet\"></div>\n    <p class=\"w2-cat\">Shirt</p>\n    <h3>Linen-blend shirt</h3>\n    <p class=\"w2-price\">₹1,599</p>\n    <p class=\"w2-sizes\">Sizes: M-XXL</p>\n    <div class=\"w2-order\">\n      <label class=\"w2-field\"><span class=\"w2-label\">Size</span>\n        <select class=\"w2-size\"><option>M</option><option>L</option><option>XL</option><option>XXL</option></select>\n      </label>\n      <label class=\"w2-field\"><span class=\"w2-label\">Quantity</span><input class=\"w2-qty\" type=\"number\" min=\"1\" max=\"99\" value=\"1\" inputmode=\"numeric\"></label>\n    </div>\n    <a class=\"j2-btn w2-order-btn\" href=\"https://wa.me/918822033445\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n  </article>\n\n  <article class=\"j2-card w2-card\" data-name=\"Ajrakh dupatta\" data-cat=\"dupattas\" data-price=\"899\" data-sizes=\"Free size\">\n    <div class=\"w2-photo\" role=\"img\" aria-label=\"Photo spot for Ajrakh dupatta, photo not added yet\"></div>\n    <p class=\"w2-cat\">Dupatta</p>\n    <h3>Ajrakh dupatta</h3>\n    <p class=\"w2-price\">₹899</p>\n    <p class=\"w2-sizes\">Free size</p>\n    <div class=\"w2-order w2-single\">\n      <label class=\"w2-field\"><span class=\"w2-label\">Quantity</span><input class=\"w2-qty\" type=\"number\" min=\"1\" max=\"99\" value=\"1\" inputmode=\"numeric\"></label>\n    </div>\n    <a class=\"j2-btn w2-order-btn\" href=\"https://wa.me/918822033445\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n  </article>\n\n  <article class=\"j2-card w2-card\" data-name=\"Bandhani dupatta\" data-cat=\"dupattas\" data-price=\"1099\" data-sizes=\"Free size\">\n    <div class=\"w2-photo\" role=\"img\" aria-label=\"Photo spot for Bandhani dupatta, photo not added yet\"></div>\n    <p class=\"w2-cat\">Dupatta</p>\n    <h3>Bandhani dupatta</h3>\n    <p class=\"w2-price\">₹1,099</p>\n    <p class=\"w2-sizes\">Free size</p>\n    <div class=\"w2-order w2-single\">\n      <label class=\"w2-field\"><span class=\"w2-label\">Quantity</span><input class=\"w2-qty\" type=\"number\" min=\"1\" max=\"99\" value=\"1\" inputmode=\"numeric\"></label>\n    </div>\n    <a class=\"j2-btn w2-order-btn\" href=\"https://wa.me/918822033445\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n  </article>\n\n</div>\n\n<div class=\"w2-empty\" id=\"w2-empty\" hidden>\n  <p>No products match these filters.</p>\n  <button type=\"button\" class=\"j2-btn w2-reset\" id=\"w2-reset-empty\" style=\"border-radius:var(--j2-radius);font:inherit;font-weight:700\">Clear filters</button>\n</div>\n\n<script>\n(function () {\n  var root = document.getElementById('shop');\n  if (!root) { return; }\n  var PHONE = '918822033445';\n  var cards = [].slice.call(root.querySelectorAll('.w2-card'));\n  var catBtns = [].slice.call(root.querySelectorAll('.w2-cat-btn'));\n  var sizeSel = document.getElementById('w2-size-filter');\n  var priceSel = document.getElementById('w2-price-filter');\n  var count = document.getElementById('w2-count');\n  var empty = document.getElementById('w2-empty');\n  var grid = document.getElementById('w2-grid');\n  var cat = 'all';\n\n  function buildLink(card) {\n    var name = card.getAttribute('data-name');\n    var sel = card.querySelector('.w2-size');\n    var size = sel ? sel.value : 'Free size';\n    var q = parseInt(card.querySelector('.w2-qty').value, 10);\n    if (!q || q < 1) { q = 1; }\n    if (q > 99) { q = 99; }\n    var msg = 'Hi Thread & Loom, I would like to order: ' + name + ', Size: ' + size + ', Quantity: ' + q;\n    card.querySelector('.w2-order-btn').href = 'https://wa.me/' + PHONE + '?text=' + encodeURIComponent(msg);\n  }\n\n  function inPrice(p, range) {\n    if (range === 'under1500') { return p < 1500; }\n    if (range === '1500-2999') { return p >= 1500 && p <= 2999; }\n    if (range === '3000up') { return p >= 3000; }\n    return true;\n  }\n\n  function apply() {\n    var size = sizeSel.value;\n    var range = priceSel.value;\n    var shown = 0;\n    cards.forEach(function (c) {\n      var sizes = c.getAttribute('data-sizes').split(',');\n      var ok = (cat === 'all' || c.getAttribute('data-cat') === cat) &&\n               (size === 'all' || sizes.indexOf(size) > -1) &&\n               inPrice(Number(c.getAttribute('data-price')), range);\n      c.hidden = !ok;\n      if (ok) {\n        shown++;\n        var sel = c.querySelector('.w2-size');\n        if (sel && size !== 'all' && sizes.indexOf(size) > -1) { sel.value = size; }\n        buildLink(c);\n      }\n    });\n    count.textContent = 'Showing ' + shown + ' of ' + cards.length + ' products';\n    empty.hidden = shown !== 0;\n  }\n\n  function setCat(value) {\n    cat = value;\n    catBtns.forEach(function (b) {\n      b.setAttribute('aria-pressed', b.getAttribute('data-cat') === value ? 'true' : 'false');\n    });\n  }\n\n  function reset() {\n    setCat('all');\n    sizeSel.value = 'all';\n    priceSel.value = 'all';\n    apply();\n  }\n\n  catBtns.forEach(function (b) {\n    b.addEventListener('click', function () {\n      setCat(b.getAttribute('data-cat'));\n      apply();\n    });\n  });\n  sizeSel.addEventListener('change', apply);\n  priceSel.addEventListener('change', apply);\n  document.getElementById('w2-reset').addEventListener('click', reset);\n  document.getElementById('w2-reset-empty').addEventListener('click', reset);\n\n  function onCardChange(e) {\n    var t = e.target;\n    while (t && t !== grid) {\n      if (t.classList && t.classList.contains('w2-card')) { buildLink(t); return; }\n      t = t.parentNode;\n    }\n  }\n  grid.addEventListener('change', onCardChange);\n  grid.addEventListener('input', onCardChange);\n\n  apply();\n})();\n</script>\n</section>",
    "workflow": "Product catalogue with filters and WhatsApp ordering"
  },
