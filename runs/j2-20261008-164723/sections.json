{
  "style": {
    "owner": "W-1",
    "head": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&amp;family=Nunito+Sans:wght@400;600;700&amp;display=swap\"><style>:root{--j2-primary:#6B3F2A;--j2-secondary:#4F5D3A;--j2-accent:#B5532F;--j2-background:#FAF5EC;--j2-surface:#FFFFFF;--j2-text:#2E2118;--j2-muted:#6F5E50;--j2-font-heading:'Cormorant Garamond', Georgia, serif;--j2-font-body:'Nunito Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:12px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;background:#6B3F2A;color:#FFFFFF;border:1.5px solid #6B3F2A;min-height:44px;padding:0 20px;border-radius:999px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;text-decoration:none}.j2-btn-secondary{display:inline-block;background:transparent;color:#6B3F2A;border:1.5px solid #6B3F2A;min-height:44px;padding:0 20px;border-radius:999px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;text-decoration:none}.j2-card{background:#FFFFFF;border:1px solid #E3D6C0;border-radius:12px;padding:12px;box-shadow:0 1px 2px rgba(46,33,24,0.06)}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-1": {
    "owner": "W-1",
    "head": "",
    "body": "<section id=\"shop\" class=\"cat-section\" aria-labelledby=\"shop-title\">\n<style>\n#shop.cat-section{padding:var(--j2-section, 64px) 16px;max-width:1120px;margin:0 auto;box-sizing:border-box}\n#shop *,#shop *::before,#shop *::after{box-sizing:border-box}\n#shop [hidden]{display:none !important}\n#shop .cat-title{font-family:var(--j2-font-heading);font-size:clamp(1.9rem,6vw,2.6rem);line-height:1.15;color:var(--j2-primary);margin:0 0 8px}\n#shop .cat-intro{color:var(--j2-muted);margin:0 0 24px;max-width:60ch}\n#shop .cat-tabs{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 32px;padding:0;list-style:none}\n#shop .cat-tab{min-height:44px;padding:0 18px;border-radius:999px;border:1.5px solid var(--j2-primary);background:transparent;color:var(--j2-primary);font:700 1rem var(--j2-font-body);cursor:pointer}\n#shop .cat-tab[aria-pressed=\"true\"]{background:var(--j2-primary);color:#fff}\n#shop .cat-tab:focus-visible{outline:3px solid var(--j2-accent);outline-offset:2px}\n#shop .cat-group{margin:0 0 40px}\n#shop .cat-group-title{font-family:var(--j2-font-heading);font-size:1.6rem;color:var(--j2-secondary);margin:0 0 16px;padding-bottom:8px;border-bottom:1px solid #E3D6C0}\n#shop .cat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px;margin:0;padding:0;list-style:none}\n@media (min-width:700px){#shop .cat-grid{grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px}}\n#shop .cat-card{display:flex;flex-direction:column;gap:8px;min-width:0}\n#shop .cat-photo{width:100%;aspect-ratio:4/5;background:#EFE4D0;border-radius:8px}\n#shop .cat-name{font-family:var(--j2-font-heading);font-size:1.2rem;font-weight:700;line-height:1.2;margin:4px 0 0;color:var(--j2-text);overflow-wrap:anywhere}\n#shop .cat-price{font-weight:700;color:var(--j2-accent);margin:0;font-size:1.05rem}\n#shop .cat-sizes{margin:0;color:var(--j2-muted);font-size:.9rem}\n#shop .cat-actions{margin-top:auto;padding-top:4px}\n#shop .cat-empty{padding:24px;border:1px dashed #C9B79B;border-radius:12px;color:var(--j2-muted);text-align:center}\n</style>\n\n<h2 id=\"shop-title\" class=\"cat-title\">Shop the collection</h2>\n<p class=\"cat-intro\">Handloom kurtas, sarees, cotton shirts and dupattas from Thread &amp; Loom, Pune.</p>\n\n<ul class=\"cat-tabs\" aria-label=\"Product categories\">\n  <li><button type=\"button\" class=\"cat-tab\" data-cat=\"all\" aria-pressed=\"true\">All</button></li>\n  <li><button type=\"button\" class=\"cat-tab\" data-cat=\"Kurtas\" aria-pressed=\"false\">Kurtas</button></li>\n  <li><button type=\"button\" class=\"cat-tab\" data-cat=\"Sarees\" aria-pressed=\"false\">Sarees</button></li>\n  <li><button type=\"button\" class=\"cat-tab\" data-cat=\"Shirts\" aria-pressed=\"false\">Shirts</button></li>\n  <li><button type=\"button\" class=\"cat-tab\" data-cat=\"Dupattas\" aria-pressed=\"false\">Dupattas</button></li>\n</ul>\n\n<div class=\"cat-group\" data-group=\"Kurtas\">\n  <h3 class=\"cat-group-title\">Kurtas</h3>\n  <ul class=\"cat-grid\">\n    <li class=\"cat-card j2-card\" data-category=\"Kurtas\" data-name=\"Indigo block-print kurta\" data-price=\"1499\" data-sizes=\"S,M,L,XL,XXL\" data-new=\"false\">\n      <div class=\"cat-photo\" aria-hidden=\"true\"></div>\n      <h4 class=\"cat-name\">Indigo block-print kurta</h4>\n      <p class=\"cat-price\">₹1,499</p>\n      <p class=\"cat-sizes\">Sizes: S to XXL</p>\n      <div class=\"cat-actions\"></div>\n    </li>\n    <li class=\"cat-card j2-card\" data-category=\"Kurtas\" data-name=\"Mustard handloom kurta\" data-price=\"1699\" data-sizes=\"S,M,L,XL\" data-new=\"false\">\n      <div class=\"cat-photo\" aria-hidden=\"true\"></div>\n      <h4 class=\"cat-name\">Mustard handloom kurta</h4>\n      <p class=\"cat-price\">₹1,699</p>\n      <p class=\"cat-sizes\">Sizes: S to XL</p>\n      <div class=\"cat-actions\"></div>\n    </li>\n    <li class=\"cat-card j2-card\" data-category=\"Kurtas\" data-name=\"White chikankari kurta\" data-price=\"2199\" data-sizes=\"XS,S,M,L,XL\" data-new=\"true\">\n      <div class=\"cat-photo\" aria-hidden=\"true\"></div>\n      <h4 class=\"cat-name\">White chikankari kurta</h4>\n      <p class=\"cat-price\">₹2,199</p>\n      <p class=\"cat-sizes\">Sizes: XS to XL</p>\n      <div class=\"cat-actions\"></div>\n    </li>\n  </ul>\n</div>\n\n<div class=\"cat-group\" data-group=\"Sarees\">\n  <h3 class=\"cat-group-title\">Sarees</h3>\n  <ul class=\"cat-grid\">\n    <li class=\"cat-card j2-card\" data-category=\"Sarees\" data-name=\"Ikat handloom saree\" data-price=\"3499\" data-sizes=\"Free size\" data-new=\"true\">\n      <div class=\"cat-photo\" aria-hidden=\"true\"></div>\n      <h4 class=\"cat-name\">Ikat handloom saree</h4>\n      <p class=\"cat-price\">₹3,499</p>\n      <p class=\"cat-sizes\">Size: Free size</p>\n      <div class=\"cat-actions\"></div>\n    </li>\n    <li class=\"cat-card j2-card\" data-category=\"Sarees\" data-name=\"Khadi silk saree\" data-price=\"4999\" data-sizes=\"Free size\" data-new=\"false\">\n      <div class=\"cat-photo\" aria-hidden=\"true\"></div>\n      <h4 class=\"cat-name\">Khadi silk saree</h4>\n      <p class=\"cat-price\">₹4,999</p>\n      <p class=\"cat-sizes\">Size: Free size</p>\n      <div class=\"cat-actions\"></div>\n    </li>\n    <li class=\"cat-card j2-card\" data-category=\"Sarees\" data-name=\"Cotton jamdani saree\" data-price=\"3999\" data-sizes=\"Free size\" data-new=\"false\">\n      <div class=\"cat-photo\" aria-hidden=\"true\"></div>\n      <h4 class=\"cat-name\">Cotton jamdani saree</h4>\n      <p class=\"cat-price\">₹3,999</p>\n      <p class=\"cat-sizes\">Size: Free size</p>\n      <div class=\"cat-actions\"></div>\n    </li>\n  </ul>\n</div>\n\n<div class=\"cat-group\" data-group=\"Shirts\">\n  <h3 class=\"cat-group-title\">Shirts</h3>\n  <ul class=\"cat-grid\">\n    <li class=\"cat-card j2-card\" data-category=\"Shirts\" data-name=\"Khadi cotton shirt\" data-price=\"1299\" data-sizes=\"S,M,L,XL,XXL\" data-new=\"false\">\n      <div class=\"cat-photo\" aria-hidden=\"true\"></div>\n      <h4 class=\"cat-name\">Khadi cotton shirt</h4>\n      <p class=\"cat-price\">₹1,299</p>\n      <p class=\"cat-sizes\">Sizes: S to XXL</p>\n      <div class=\"cat-actions\"></div>\n    </li>\n    <li class=\"cat-card j2-card\" data-category=\"Shirts\" data-name=\"Linen-blend shirt\" data-price=\"1599\" data-sizes=\"M,L,XL,XXL\" data-new=\"true\">\n      <div class=\"cat-photo\" aria-hidden=\"true\"></div>\n      <h4 class=\"cat-name\">Linen-blend shirt</h4>\n      <p class=\"cat-price\">₹1,599</p>\n      <p class=\"cat-sizes\">Sizes: M to XXL</p>\n      <div class=\"cat-actions\"></div>\n    </li>\n  </ul>\n</div>\n\n<div class=\"cat-group\" data-group=\"Dupattas\">\n  <h3 class=\"cat-group-title\">Dupattas</h3>\n  <ul class=\"cat-grid\">\n    <li class=\"cat-card j2-card\" data-category=\"Dupattas\" data-name=\"Block-print dupatta\" data-price=\"899\" data-sizes=\"Free size\" data-new=\"false\">\n      <div class=\"cat-photo\" aria-hidden=\"true\"></div>\n      <h4 class=\"cat-name\">Block-print dupatta</h4>\n      <p class=\"cat-price\">₹899</p>\n      <p class=\"cat-sizes\">Size: Free size</p>\n      <div class=\"cat-actions\"></div>\n    </li>\n    <li class=\"cat-card j2-card\" data-category=\"Dupattas\" data-name=\"Chanderi dupatta\" data-price=\"1099\" data-sizes=\"Free size\" data-new=\"false\">\n      <div class=\"cat-photo\" aria-hidden=\"true\"></div>\n      <h4 class=\"cat-name\">Chanderi dupatta</h4>\n      <p class=\"cat-price\">₹1,099</p>\n      <p class=\"cat-sizes\">Size: Free size</p>\n      <div class=\"cat-actions\"></div>\n    </li>\n  </ul>\n</div>\n\n<p class=\"cat-empty\" id=\"cat-empty\" role=\"status\" hidden>No products match your choices. Try a different size or price.</p>\n\n<script>\n(function () {\n  var root = document.getElementById('shop');\n  if (!root) return;\n  var cards = Array.prototype.slice.call(root.querySelectorAll('.cat-card'));\n  var groups = Array.prototype.slice.call(root.querySelectorAll('.cat-group'));\n  var tabs = Array.prototype.slice.call(root.querySelectorAll('.cat-tab'));\n  var empty = root.querySelector('#cat-empty');\n  var state = { category: 'all' };\n\n  function toProduct(el) {\n    return {\n      el: el,\n      name: el.getAttribute('data-name'),\n      category: el.getAttribute('data-category'),\n      price: Number(el.getAttribute('data-price')),\n      sizes: el.getAttribute('data-sizes').split(','),\n      isNew: el.getAttribute('data-new') === 'true'\n    };\n  }\n\n  var api = window.J2Catalogue = window.J2Catalogue || {};\n  api.products = cards.map(toProduct);\n  api.filter = api.filter || null; // other sections may set: function (product) { return true|false }\n  api.getCategory = function () { return state.category; };\n\n  function render() {\n    var shown = 0;\n    api.products.forEach(function (p) {\n      var ok = state.category === 'all' || p.category === state.category;\n      if (ok && typeof api.filter === 'function') {\n        try { ok = api.filter(p) !== false; } catch (e) { ok = true; }\n      }\n      p.el.hidden = !ok;\n      if (ok) shown++;\n    });\n    groups.forEach(function (g) {\n      g.hidden = !g.querySelector('.cat-card:not([hidden])');\n    });\n    if (empty) empty.hidden = shown > 0;\n    document.dispatchEvent(new CustomEvent('j2:catalogue-rendered', { detail: { shown: shown } }));\n  }\n  api.render = render;\n\n  tabs.forEach(function (tab) {\n    tab.addEventListener('click', function () {\n      state.category = tab.getAttribute('data-cat');\n      tabs.forEach(function (t) {\n        t.setAttribute('aria-pressed', t === tab ? 'true' : 'false');\n      });\n      render();\n    });\n  });\n\n  render();\n})();\n</script>\n</section>",
    "workflow": "Product catalogue by category"
  }
}