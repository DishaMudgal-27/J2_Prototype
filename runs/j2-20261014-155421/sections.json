{
  "style": {
    "owner": "W-9",
    "head": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&amp;family=Inter:wght@400;500;600;700&amp;display=swap\"><style>:root{--j2-primary:#0A3D8F;--j2-secondary:#0B1F3A;--j2-accent:#F25C05;--j2-background:#F5F7FA;--j2-surface:#FFFFFF;--j2-text:#0B1220;--j2-muted:#4A5568;--j2-font-heading:'Barlow Condensed', 'Arial Narrow', Impact, sans-serif;--j2-font-body:'Inter', system-ui, -apple-system, 'Segoe UI', Arial, sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:12px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;background:#F25C05;color:#0B1220;border:2px solid #F25C05;font-weight:700;text-transform:uppercase;letter-spacing:.04em;min-height:44px;padding:12px 24px}.j2-btn-secondary{display:inline-block;background:transparent;color:#0A3D8F;border:2px solid #0A3D8F;font-weight:700;text-transform:uppercase;letter-spacing:.04em;min-height:44px;padding:12px 24px}.j2-card{background:#FFFFFF;border:1px solid #D5DCE6;border-top:4px solid #F25C05;border-radius:12px;padding:24px;box-shadow:0 2px 8px rgba(11,31,58,.08)}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-9": {
    "owner": "W-9",
    "head": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
    "body": "<style id=\"j2-base-style\">\n:root{\n  --j2-on-primary:#FFFFFF;\n  --j2-on-accent:#0B1220;\n  --j2-border:#D5DCE6;\n  --j2-field-border:#5B6577;\n}\n*,*::before,*::after{box-sizing:border-box}\nhtml{scroll-behavior:smooth;scroll-padding-top:80px;-webkit-text-size-adjust:100%;overflow-x:clip}\nbody{\n  margin:0;max-width:100%;overflow-x:clip;\n  font-family:var(--j2-font-body,system-ui,-apple-system,'Segoe UI',Arial,sans-serif);\n  font-size:1rem;line-height:1.6;\n  background:var(--j2-background,#F5F7FA);color:var(--j2-text,#0B1220);\n}\nimg,svg,video,canvas,iframe,picture{max-width:100%;height:auto}\np,li,dd,dt,td,th,a,span,label,summary,h1,h2,h3,h4{overflow-wrap:anywhere}\nsection{padding-block:clamp(40px,8vw,64px);padding-inline:16px;max-width:100%}\nsection>*{max-width:1120px;margin-inline:auto}\nh1,h2,h3,h4{\n  font-family:var(--j2-font-heading,'Arial Narrow',Impact,sans-serif);\n  font-weight:800;line-height:1.1;text-transform:uppercase;letter-spacing:.01em;\n  color:var(--j2-text,#0B1220);margin:0 0 .5em;\n}\nh1{font-size:clamp(2.25rem,9vw,4.25rem)}\nh2{font-size:clamp(1.75rem,6vw,2.75rem)}\nh3{font-size:clamp(1.25rem,4vw,1.5rem)}\nh2::after{content:\"\";display:block;width:56px;height:6px;margin-top:8px;background:var(--j2-accent,#F25C05);border-radius:3px}\np{margin:0 0 1em}\na{color:var(--j2-primary,#0A3D8F);text-underline-offset:3px}\n:focus-visible{outline:3px solid var(--j2-accent,#F25C05);outline-offset:2px}\n\n/* Buttons */\n.j2-btn{\n  display:inline-flex;align-items:center;justify-content:center;gap:8px;\n  min-height:44px;min-width:44px;padding:12px 24px;max-width:100%;\n  font-family:inherit;font-size:1rem;font-weight:700;line-height:1.2;text-align:center;\n  text-transform:uppercase;letter-spacing:.04em;text-decoration:none;cursor:pointer;\n  border:2px solid var(--j2-primary,#0A3D8F);border-radius:var(--j2-radius,12px);\n  background:var(--j2-primary,#0A3D8F);color:var(--j2-on-primary,#FFFFFF);\n}\n.j2-btn-primary{background:var(--j2-accent,#F25C05);border-color:var(--j2-accent,#F25C05);color:var(--j2-on-accent,#0B1220)}\n.j2-btn-secondary{background:transparent;border-color:var(--j2-primary,#0A3D8F);color:var(--j2-primary,#0A3D8F)}\n.j2-btn:hover{filter:brightness(1.08)}\n.j2-btn:active{transform:translateY(1px)}\n.j2-btn[disabled]{opacity:.6;cursor:not-allowed}\n\n/* Cards and grids */\n.j2-card{\n  background:var(--j2-surface,#FFFFFF);color:var(--j2-text,#0B1220);\n  border:1px solid var(--j2-border,#D5DCE6);border-top:4px solid var(--j2-accent,#F25C05);\n  border-radius:var(--j2-radius,12px);padding:24px;min-width:0;\n  box-shadow:0 2px 8px rgba(11,31,58,.08);\n}\n.j2-grid{display:grid;gap:24px;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))}\n.j2-grid>*{min-width:0}\n\n/* Forms */\nform{max-width:100%}\nfieldset{border:0;margin:0;padding:0;min-width:0}\nlabel{display:block;font-weight:600;margin-bottom:4px}\nlabel:has(input[type=radio]),label:has(input[type=checkbox]){display:inline-flex;align-items:center;gap:8px;min-height:44px;margin-right:16px}\ninput,select,textarea{\n  display:block;width:100%;max-width:100%;min-height:44px;padding:10px 12px;margin-bottom:16px;\n  font:inherit;color:var(--j2-text,#0B1220);background:var(--j2-surface,#FFFFFF);\n  border:2px solid var(--j2-field-border,#5B6577);border-radius:8px;\n}\ninput[type=radio],input[type=checkbox]{display:inline-block;width:24px;height:24px;min-height:0;margin:0;padding:0;accent-color:var(--j2-primary,#0A3D8F)}\n\n/* Tables, lists, details */\ntable{display:block;max-width:100%;overflow-x:auto;border-collapse:collapse}\nth,td{padding:8px 12px;text-align:left;border-bottom:1px solid var(--j2-border,#D5DCE6)}\nsummary{display:flex;align-items:center;min-height:44px;cursor:pointer;font-weight:600}\n.j2-nav-link{display:inline-flex;align-items:center;min-height:44px;padding:0 12px}\n\n/* Placeholders */\n.j2-route-map,.j2-logo-ph{\n  display:grid;place-items:center;text-align:center;padding:16px;max-width:100%;\n  border:2px dashed var(--j2-field-border,#5B6577);border-radius:var(--j2-radius,12px);\n  background:var(--j2-background,#F5F7FA);color:var(--j2-muted,#4A5568);font-weight:600;\n}\n.j2-route-map{min-height:180px}\n.j2-logo-ph{min-height:88px}\n\n@media (max-width:480px){\n  section{padding-inline:12px}\n  .j2-card{padding:16px}\n  .j2-btn{width:100%}\n}\n@media (prefers-reduced-motion:reduce){\n  html{scroll-behavior:auto}\n  *{transition:none!important;animation:none!important}\n}\n</style>",
    "workflow": "Sporty base styling and responsive layout"
  },
  "W-1": {
    "owner": "W-10",
    "head": "",
    "body": "<section id=\"hero\" class=\"j2-top\" aria-labelledby=\"top-title\">\n<style>\n.j2-top{background:var(--j2-secondary);color:var(--j2-surface);padding-block:clamp(48px,10vw,96px)}\n.j2-top .j2-top-inner{display:grid;gap:24px}\n.j2-top h1{color:var(--j2-surface);margin:0}\n.j2-top .j2-top-kicker{font-family:var(--j2-font-heading);font-weight:700;font-size:clamp(1.125rem,4vw,1.5rem);text-transform:uppercase;letter-spacing:.08em;color:var(--j2-accent);margin:0}\n.j2-top .j2-top-facts{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));margin:0}\n.j2-top .j2-top-fact{border-left:6px solid var(--j2-accent);padding-left:16px;min-width:0}\n.j2-top .j2-top-fact dt{font-family:var(--j2-font-heading);font-weight:700;font-size:1.125rem;text-transform:uppercase;letter-spacing:.06em;color:var(--j2-accent)}\n.j2-top .j2-top-fact dd{margin:4px 0 0;font-size:1.125rem;font-weight:500;color:var(--j2-surface)}\n.j2-top #j2-countdown{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;max-width:560px;margin-inline:0}\n.j2-top .j2-cd-unit{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0;padding:12px 4px;text-align:center;border:2px solid var(--j2-accent);border-radius:var(--j2-radius)}\n.j2-top .j2-cd-num{font-family:var(--j2-font-heading);font-weight:800;font-size:clamp(1.75rem,8vw,3rem);line-height:1;color:var(--j2-surface);font-variant-numeric:tabular-nums}\n.j2-top .j2-cd-label{margin-top:4px;font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--j2-surface)}\n.j2-top .j2-cd-note{margin:0;font-weight:600;color:var(--j2-accent)}\n.j2-top .j2-top-cta{margin:0}\n@media (max-width:480px){.j2-top .j2-cd-label{font-size:.6875rem;letter-spacing:.02em}}\n</style>\n<div class=\"j2-top-inner\">\n  <p class=\"j2-top-kicker\">Pune city running event</p>\n  <h1 id=\"top-title\">Riverside Run 2027</h1>\n  <dl class=\"j2-top-facts\">\n    <div class=\"j2-top-fact\">\n      <dt>Race day</dt>\n      <dd>Sunday 14 February 2027</dd>\n    </div>\n    <div class=\"j2-top-fact\">\n      <dt>Expo day</dt>\n      <dd>Saturday 13 February 2027, 10am to 6pm</dd>\n    </div>\n    <div class=\"j2-top-fact\">\n      <dt>Venue</dt>\n      <dd>Riverside Grounds, 5 River Road, Pune 411001</dd>\n    </div>\n  </dl>\n  <div id=\"j2-countdown\" role=\"timer\" aria-label=\"Time until race day, Sunday 14 February 2027\">\n    <div class=\"j2-cd-unit\"><span class=\"j2-cd-num\" data-unit=\"days\">--</span><span class=\"j2-cd-label\">Days</span></div>\n    <div class=\"j2-cd-unit\"><span class=\"j2-cd-num\" data-unit=\"hours\">--</span><span class=\"j2-cd-label\">Hours</span></div>\n    <div class=\"j2-cd-unit\"><span class=\"j2-cd-num\" data-unit=\"minutes\">--</span><span class=\"j2-cd-label\">Minutes</span></div>\n    <div class=\"j2-cd-unit\"><span class=\"j2-cd-num\" data-unit=\"seconds\">--</span><span class=\"j2-cd-label\">Seconds</span></div>\n  </div>\n  <p class=\"j2-cd-note\" id=\"j2-cd-note\" hidden>Race day is here. See you at the start line.</p>\n  <p class=\"j2-top-cta\"><a class=\"j2-btn j2-btn-primary j2-main-cta\" href=\"#register\">Register now</a></p>\n</div>\n<script>\n(function () {\n  var box = document.getElementById('j2-countdown');\n  if (!box) { return; }\n  var target = new Date('2027-02-14T06:00:00+05:30').getTime();\n  var els = {\n    days: box.querySelector('[data-unit=\"days\"]'),\n    hours: box.querySelector('[data-unit=\"hours\"]'),\n    minutes: box.querySelector('[data-unit=\"minutes\"]'),\n    seconds: box.querySelector('[data-unit=\"seconds\"]')\n  };\n  var note = document.getElementById('j2-cd-note');\n  var timer = null;\n  function pad(n) { return n < 10 ? '0' + n : String(n); }\n  function set(el, text) { if (el) { el.textContent = text; } }\n  function tick() {\n    var diff = target - Date.now();\n    if (isNaN(diff) || diff <= 0) {\n      set(els.days, '--'); set(els.hours, '--'); set(els.minutes, '--'); set(els.seconds, '--');\n      if (note) { note.hidden = false; }\n      if (timer) { clearInterval(timer); timer = null; }\n      return;\n    }\n    var s = Math.floor(diff / 1000);\n    set(els.days, String(Math.floor(s / 86400)));\n    set(els.hours, pad(Math.floor((s % 86400) / 3600)));\n    set(els.minutes, pad(Math.floor((s % 3600) / 60)));\n    set(els.seconds, pad(s % 60));\n  }\n  tick();\n  timer = setInterval(tick, 1000);\n})();\n</script>\n</section>",
    "workflow": "Hero countdown placeholders without bare zeros"
  },
  "W-3": {
    "owner": "W-11",
    "head": "",
    "body": "<section id=\"races\" aria-labelledby=\"races-title\">\n<style>\n.j2-rc-lead{color:var(--j2-muted)}\n.j2-rc-card h3{margin:0 0 8px}\n.j2-rc-fee{font-family:var(--j2-font-heading);font-weight:800;font-size:clamp(2.25rem,8vw,3rem);line-height:1;color:var(--j2-primary);margin:0}\n.j2-rc-fee-label{font-size:.875rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--j2-muted);margin:4px 0 16px}\n.j2-rc-facts{list-style:none;margin:0;padding:0}\n.j2-rc-facts li{padding:8px 0;border-top:1px solid var(--j2-border);font-weight:500}\n.j2-rc-facts li::first-letter{text-transform:uppercase}\n.j2-rc-shirt{margin-top:24px;padding:16px 20px;border-left:6px solid var(--j2-accent);background:var(--j2-surface);border-radius:var(--j2-radius)}\n.j2-rc-shirt p{margin:0}\n.j2-rc-shirt p+p{margin-top:8px}\n.j2-rc-calc{background:var(--j2-surface)}\n.j2-rc-layout{display:grid;gap:24px;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));align-items:start}\n.j2-rc-layout>*{min-width:0}\n.j2-rc-panel,.j2-rc-result{background:var(--j2-background);border:1px solid var(--j2-border);border-radius:var(--j2-radius);padding:24px;color:var(--j2-text)}\n.j2-rc-result{border:2px solid var(--j2-primary)}\n.j2-rc-panel label.j2-rc-early{display:flex;align-items:center;gap:12px;margin:0 0 8px}\n.j2-rc-panel label.j2-rc-early input[type=checkbox]{width:44px;height:44px;flex:none}\n.j2-rc-note{font-size:.9375rem;color:var(--j2-muted);margin:0 0 16px}\n.j2-rc-msg{margin:0;font-weight:600}\n.j2-rc-msg:not(:empty){padding:8px 12px;border-left:6px solid var(--j2-accent);background:var(--j2-surface)}\n.j2-rc-result h3{margin:0 0 8px}\n.j2-rc-rows{margin:0}\n.j2-rc-row{display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 16px;padding:8px 0;border-bottom:1px solid var(--j2-border)}\n.j2-rc-row[hidden]{display:none}\n.j2-rc-row dt{margin:0;font-weight:500}\n.j2-rc-row dd{margin:0;font-weight:700}\n.j2-rc-total-label{margin:16px 0 0;font-weight:700;text-transform:uppercase;letter-spacing:.06em}\n.j2-rc-total{display:block;font-family:var(--j2-font-heading);font-weight:800;font-size:clamp(2.25rem,10vw,3.5rem);line-height:1.1;color:var(--j2-primary);margin:4px 0 16px;overflow-wrap:anywhere}\n@media (max-width:480px){.j2-rc-panel,.j2-rc-result{padding:16px}}\n</style>\n<h2 id=\"races-title\">Compare the races</h2>\n<p class=\"j2-rc-lead\">Pick the distance that suits you. Start time, fee, minimum age and cutoff for each race are below.</p>\n<div class=\"j2-grid\">\n  <article class=\"j2-card j2-rc-card\">\n    <h3>5K</h3>\n    <p class=\"j2-rc-fee\">Rs 300</p>\n    <p class=\"j2-rc-fee-label\">Race fee per runner</p>\n    <ul class=\"j2-rc-facts\">\n      <li>start 7:30am</li>\n      <li>minimum age 12</li>\n      <li>cutoff 1 hour</li>\n    </ul>\n  </article>\n  <article class=\"j2-card j2-rc-card\">\n    <h3>10K</h3>\n    <p class=\"j2-rc-fee\">Rs 500</p>\n    <p class=\"j2-rc-fee-label\">Race fee per runner</p>\n    <ul class=\"j2-rc-facts\">\n      <li>start 6:45am</li>\n      <li>minimum age 16</li>\n      <li>cutoff 2 hours</li>\n    </ul>\n  </article>\n  <article class=\"j2-card j2-rc-card\">\n    <h3>Half Marathon</h3>\n    <p class=\"j2-rc-fee\">Rs 800</p>\n    <p class=\"j2-rc-fee-label\">Race fee per runner</p>\n    <ul class=\"j2-rc-facts\">\n      <li>start 6:00am</li>\n      <li>minimum age 18</li>\n      <li>cutoff 3 hours 30 minutes</li>\n    </ul>\n  </article>\n</div>\n<div class=\"j2-rc-shirt\">\n  <p><strong>Event T-shirt: Rs 250 each (optional).</strong></p>\n  <p>Early-bird: 10% off race fees only, not T-shirts, for registrations up to 31 December 2026. <a href=\"#calculator\">Work out your total</a>.</p>\n</div>\n</section>\n\n<section id=\"calculator\" class=\"j2-rc-calc\" aria-labelledby=\"calc-title\">\n<h2 id=\"calc-title\">Fee calculator</h2>\n<p class=\"j2-rc-lead\">Choose a race, the number of runners and the number of T-shirts. Leave the T-shirt box empty if you do not want one. The total updates as you go.</p>\n<div class=\"j2-rc-layout\">\n  <div class=\"j2-rc-panel\" role=\"group\" aria-labelledby=\"calc-title\">\n    <label for=\"calc-race\">Race</label>\n    <select id=\"calc-race\">\n      <option value=\"\" selected>Choose a race</option>\n      <option value=\"5k\" data-name=\"5K\">5K (Rs 300)</option>\n      <option value=\"10k\" data-name=\"10K\">10K (Rs 500)</option>\n      <option value=\"half\" data-name=\"Half Marathon\">Half Marathon (Rs 800)</option>\n    </select>\n    <label for=\"calc-runners\">Number of runners (1 to 10)</label>\n    <input id=\"calc-runners\" type=\"number\" inputmode=\"numeric\" min=\"1\" max=\"10\" step=\"1\" value=\"1\">\n    <label for=\"calc-shirts\">Number of T-shirts (Rs 250 each, optional)</label>\n    <input id=\"calc-shirts\" type=\"number\" inputmode=\"numeric\" step=\"1\">\n    <label class=\"j2-rc-early\" for=\"calc-early\">\n      <input id=\"calc-early\" type=\"checkbox\">\n      <span>Early-bird: registering on or before 31 December 2026</span>\n    </label>\n    <p class=\"j2-rc-note\" id=\"calc-early-note\">Early-bird applies up to 31 December 2026: 10% off race fees only, never on T-shirts.</p>\n    <p class=\"j2-rc-msg\" id=\"calc-msg\" role=\"alert\"></p>\n  </div>\n  <div class=\"j2-rc-result\" aria-live=\"polite\">\n    <h3>Your cost</h3>\n    <dl class=\"j2-rc-rows\">\n      <div class=\"j2-rc-row\"><dt id=\"calc-race-label\">Race fees</dt><dd id=\"calc-race-amt\">--</dd></div>\n      <div class=\"j2-rc-row\" id=\"calc-disc-row\" hidden><dt>Early-bird 10% off race fees</dt><dd id=\"calc-disc-amt\">--</dd></div>\n      <div class=\"j2-rc-row\"><dt id=\"calc-shirt-label\">T-shirts (no discount)</dt><dd id=\"calc-shirt-amt\">--</dd></div>\n    </dl>\n    <p class=\"j2-rc-total-label\">Total</p>\n    <output id=\"calc-total\" class=\"j2-rc-total\" for=\"calc-race calc-runners calc-shirts calc-early\">--</output>\n    <a class=\"j2-btn j2-btn-secondary\" href=\"#register\">Continue to registration</a>\n  </div>\n</div>\n<script>\n(function () {\n  var FEES = { '5k': 300, '10k': 500, 'half': 800 };\n  var SHIRT = 250;\n  var MAX_RUNNERS = 10;\n  var $ = function (id) { return document.getElementById(id); };\n  var race = $('calc-race'), runners = $('calc-runners'), shirts = $('calc-shirts');\n  var early = $('calc-early'), total = $('calc-total'), msg = $('calc-msg'), note = $('calc-early-note');\n  var raceLabel = $('calc-race-label'), raceAmt = $('calc-race-amt');\n  var discRow = $('calc-disc-row'), discAmt = $('calc-disc-amt');\n  var shirtLabel = $('calc-shirt-label'), shirtAmt = $('calc-shirt-amt');\n  if (!race || !runners || !shirts || !early || !total) { return; }\n\n  function money(n) { return 'Rs ' + n.toLocaleString('en-IN'); }\n  function toInt(v) {\n    var s = String(v).replace(/^\\s+|\\s+$/g, '');\n    return /^\\d+$/.test(s) ? parseInt(s, 10) : NaN;\n  }\n  /* Empty, negative or unreadable T-shirt entry counts as no T-shirts */\n  function shirtCount(v) {\n    var s = String(v).replace(/^\\s+|\\s+$/g, '');\n    if (!s) { return NaN; }\n    var n = Number(s);\n    if (!isFinite(n) || n < 1) { return NaN; }\n    return Math.floor(n);\n  }\n  function setText(el, t) { if (el) { el.textContent = t; } }\n\n  var deadline = new Date('2026-12-31T23:59:59+05:30').getTime();\n  if (Date.now() <= deadline) {\n    early.checked = true;\n  } else {\n    early.checked = false;\n    early.disabled = true;\n    setText(note, 'The early-bird period ended on 31 December 2026. Standard race fees apply.');\n  }\n\n  function clearRows() {\n    setText(total, '--');\n    setText(raceLabel, 'Race fees');\n    setText(raceAmt, '--');\n    setText(shirtLabel, 'T-shirts (no discount)');\n    setText(shirtAmt, '--');\n    if (discRow) { discRow.hidden = true; }\n  }\n\n  function update() {\n    var fee = FEES[race.value];\n    var r = toInt(runners.value);\n    var n = shirtCount(shirts.value);\n    var hasShirts = !isNaN(n);\n    var runnersOk = r >= 1 && r <= MAX_RUNNERS;\n    setText(msg, runnersOk ? '' : 'Enter a whole number of runners from 1 to 10.');\n    if (fee === undefined || !runnersOk) {\n      clearRows();\n      return;\n    }\n    var name = race.options[race.selectedIndex].getAttribute('data-name') || 'Race';\n    var raceFees = fee * r;\n    var discount = (early.checked && !early.disabled) ? Math.round(raceFees / 10) : 0;\n    var shirtCost = hasShirts ? n * SHIRT : 0;\n    var sum = raceFees - discount + shirtCost;\n    setText(raceLabel, name + ': ' + r + ' x ' + money(fee));\n    setText(raceAmt, money(raceFees));\n    if (discRow) { discRow.hidden = !discount; }\n    setText(discAmt, discount ? '- ' + money(discount) : '--');\n    if (hasShirts) {\n      setText(shirtLabel, 'T-shirts (no discount): ' + n + ' x ' + money(SHIRT));\n      setText(shirtAmt, money(shirtCost));\n    } else {\n      setText(shirtLabel, 'T-shirts (no discount)');\n      setText(shirtAmt, 'None');\n    }\n    setText(total, money(sum));\n  }\n\n  ['input', 'change'].forEach(function (evt) {\n    race.addEventListener(evt, update);\n    runners.addEventListener(evt, update);\n    shirts.addEventListener(evt, update);\n    early.addEventListener(evt, update);\n  });\n  update();\n})();\n</script>\n</section>",
    "workflow": "Calculator T-shirt box without preset number"
  },
  "W-4": {
    "owner": "W-4",
    "head": "",
    "body": "<section id=\"register\" aria-labelledby=\"register-title\">\n<style>\n.j2-reg-lead{color:var(--j2-muted)}\n.j2-reg-panel{background:var(--j2-surface);color:var(--j2-text);border:1px solid var(--j2-border);border-top:4px solid var(--j2-accent);border-radius:var(--j2-radius);padding:24px;box-shadow:0 2px 8px rgba(11,31,58,.08);min-width:0}\n.j2-reg-panel fieldset+fieldset{margin-top:24px}\n.j2-reg-panel legend{font-family:var(--j2-font-heading);font-weight:800;font-size:clamp(1.25rem,4vw,1.5rem);text-transform:uppercase;letter-spacing:.01em;color:var(--j2-text);padding:0;margin:0 0 12px}\n.j2-reg-grid{display:grid;gap:0 24px;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))}\n.j2-reg-grid>*{min-width:0}\n.j2-reg-panel .j2-reg-radios{display:flex;flex-wrap:wrap;gap:0 8px;margin-bottom:16px}\n.j2-reg-panel .j2-reg-radios label{margin-right:16px}\n.j2-reg-panel .j2-reg-radios input[type=radio]{width:44px;height:44px;flex:none}\n.j2-reg-size[hidden]{display:none}\n.j2-reg-hint{font-size:.9375rem;color:var(--j2-muted);margin:-8px 0 16px}\n.j2-reg-msg{margin:0 0 16px;font-weight:600}\n.j2-reg-msg:not(:empty){padding:8px 12px;border-left:6px solid var(--j2-accent);background:var(--j2-background)}\n.j2-reg-actions{margin-top:24px}\n.j2-reg-actions p{margin:12px 0 0;color:var(--j2-muted);font-size:.9375rem}\n@media (max-width:480px){.j2-reg-panel{padding:16px}}\n</style>\n<h2 id=\"register-title\">Register</h2>\n<p class=\"j2-reg-lead\">Fill in the form and send it. Your registration goes by email to run@example.com. Not sure what you will pay? <a href=\"#calculator\">Use the fee calculator</a>.</p>\n<div class=\"j2-reg-panel\">\n<form id=\"reg-form\" action=\"mailto:run@example.com\" method=\"post\" enctype=\"text/plain\" aria-describedby=\"reg-status\">\n  <fieldset>\n    <legend>Runner details</legend>\n    <div class=\"j2-reg-grid\">\n      <div>\n        <label for=\"reg-name\">Full name</label>\n        <input id=\"reg-name\" name=\"name\" type=\"text\" autocomplete=\"name\" required>\n      </div>\n      <div>\n        <label for=\"reg-email\">Email</label>\n        <input id=\"reg-email\" name=\"email\" type=\"email\" autocomplete=\"email\" inputmode=\"email\" required>\n      </div>\n      <div>\n        <label for=\"reg-phone\">Phone</label>\n        <input id=\"reg-phone\" name=\"phone\" type=\"tel\" autocomplete=\"tel\" inputmode=\"tel\" required>\n      </div>\n      <div>\n        <label for=\"reg-dob\">Date of birth</label>\n        <input id=\"reg-dob\" name=\"date_of_birth\" type=\"date\" autocomplete=\"bday\" required>\n      </div>\n    </div>\n    <p class=\"j2-reg-msg\" id=\"reg-age-msg\" role=\"status\"></p>\n  </fieldset>\n\n  <fieldset>\n    <legend>Race and T-shirt</legend>\n    <label for=\"reg-race\">Race</label>\n    <select id=\"reg-race\" name=\"race\" required>\n      <option value=\"\" selected>Choose a race</option>\n      <option value=\"5K\">5K</option>\n      <option value=\"10K\">10K</option>\n      <option value=\"Half Marathon\">Half Marathon</option>\n    </select>\n    <fieldset>\n      <legend>T-shirt (Rs 250 each, optional)</legend>\n      <div class=\"j2-reg-radios\">\n        <label for=\"reg-tshirt-yes\"><input id=\"reg-tshirt-yes\" type=\"radio\" name=\"tshirt\" value=\"Yes\"> <span>Yes</span></label>\n        <label for=\"reg-tshirt-no\"><input id=\"reg-tshirt-no\" type=\"radio\" name=\"tshirt\" value=\"No\" checked> <span>No</span></label>\n      </div>\n    </fieldset>\n    <div id=\"reg-size-wrap\" class=\"j2-reg-size\" hidden>\n      <label for=\"reg-size\">T-shirt size</label>\n      <select id=\"reg-size\" name=\"tshirt_size\" disabled>\n        <option value=\"\" selected>Choose a size</option>\n        <option value=\"S\">S</option>\n        <option value=\"M\">M</option>\n        <option value=\"L\">L</option>\n        <option value=\"XL\">XL</option>\n      </select>\n    </div>\n  </fieldset>\n\n  <fieldset>\n    <legend>Emergency contact</legend>\n    <div class=\"j2-reg-grid\">\n      <div>\n        <label for=\"reg-emerg-name\">Emergency contact name</label>\n        <input id=\"reg-emerg-name\" name=\"emergency_contact_name\" type=\"text\" required>\n      </div>\n      <div>\n        <label for=\"reg-emerg-phone\">Emergency contact phone</label>\n        <input id=\"reg-emerg-phone\" name=\"emergency_contact_phone\" type=\"tel\" inputmode=\"tel\" required>\n      </div>\n    </div>\n  </fieldset>\n\n  <fieldset>\n    <legend>Guardian</legend>\n    <label for=\"reg-guardian\">Guardian name</label>\n    <input id=\"reg-guardian\" name=\"guardian_name\" type=\"text\" autocomplete=\"off\">\n    <p class=\"j2-reg-hint\" id=\"reg-guardian-hint\">Needed only if the runner is under 18 on race day, 14 February 2027.</p>\n  </fieldset>\n\n  <div class=\"j2-reg-actions\">\n    <button class=\"j2-btn j2-btn-primary\" type=\"submit\">Send registration</button>\n    <p id=\"reg-status\" role=\"status\">Sending opens your email app with the details filled in, addressed to run@example.com. Press send there to finish.</p>\n  </div>\n</form>\n</div>\n<script>\n(function () {\n  var $ = function (id) { return document.getElementById(id); };\n  var form = $('reg-form'), dob = $('reg-dob'), race = $('reg-race');\n  var yes = $('reg-tshirt-yes'), no = $('reg-tshirt-no');\n  var wrap = $('reg-size-wrap'), size = $('reg-size');\n  var guardian = $('reg-guardian'), hint = $('reg-guardian-hint');\n  var ageMsg = $('reg-age-msg');\n  if (!form || !dob || !race || !yes || !no || !wrap || !size || !guardian) { return; }\n\n  var MIN_AGE = { '5K': 12, '10K': 16, 'Half Marathon': 18 };\n\n  function pad(n) { return n < 10 ? '0' + n : String(n); }\n  var now = new Date();\n  dob.setAttribute('max', now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate()));\n\n  function ageOnRaceDay(v) {\n    var p = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(v || '');\n    if (!p) { return NaN; }\n    var y = parseInt(p[1], 10), m = parseInt(p[2], 10), d = parseInt(p[3], 10);\n    var age = 2027 - y;\n    if (m > 2 || (m === 2 && d > 14)) { age--; }\n    return age;\n  }\n\n  function updateSize() {\n    var on = yes.checked;\n    wrap.hidden = !on;\n    size.disabled = !on;\n    size.required = on;\n    if (!on) { size.value = ''; }\n  }\n\n  function updateAge() {\n    var age = ageOnRaceDay(dob.value);\n    var under18 = !isNaN(age) && age < 18;\n    guardian.required = under18;\n    if (hint) {\n      hint.textContent = under18\n        ? 'Required: the runner is under 18 on race day, 14 February 2027.'\n        : 'Needed only if the runner is under 18 on race day, 14 February 2027.';\n    }\n    var min = MIN_AGE[race.value];\n    var text = '';\n    if (!isNaN(age) && min !== undefined && age < min) {\n      text = 'The ' + race.value + ' has a minimum age of ' + min + '. Choose a different race or check the date of birth.';\n    }\n    dob.setCustomValidity(text);\n    if (ageMsg) { ageMsg.textContent = text; }\n  }\n\n  yes.addEventListener('change', updateSize);\n  no.addEventListener('change', updateSize);\n  dob.addEventListener('input', updateAge);\n  dob.addEventListener('change', updateAge);\n  race.addEventListener('change', updateAge);\n  updateSize();\n  updateAge();\n})();\n</script>\n</section>",
    "workflow": "Registration form"
  },
  "W-5": {
    "owner": "W-5",
    "head": "",
    "body": "<section id=\"volunteer\" aria-labelledby=\"volunteer-title\">\n<style>\n.j2-vol-lead{color:var(--j2-muted)}\n.j2-vol-panel{background:var(--j2-surface);color:var(--j2-text);border:1px solid var(--j2-border);border-top:4px solid var(--j2-accent);border-radius:var(--j2-radius);padding:24px;box-shadow:0 2px 8px rgba(11,31,58,.08);min-width:0}\n.j2-vol-panel legend{font-family:var(--j2-font-heading);font-weight:800;font-size:clamp(1.25rem,4vw,1.5rem);text-transform:uppercase;letter-spacing:.01em;color:var(--j2-text);padding:0;margin:0 0 12px}\n.j2-vol-grid{display:grid;gap:0 24px;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))}\n.j2-vol-grid>*{min-width:0}\n.j2-vol-hint{font-size:.9375rem;color:var(--j2-muted);margin:-8px 0 16px}\n.j2-vol-actions{margin-top:8px}\n.j2-vol-actions p{margin:12px 0 0;color:var(--j2-muted);font-size:.9375rem}\n@media (max-width:480px){.j2-vol-panel{padding:16px}}\n</style>\n<h2 id=\"volunteer-title\">Volunteer with us</h2>\n<p class=\"j2-vol-lead\">Want to help on the day? Tell us where you would like to help and when you are free. Your sign-up goes by email to volunteers@example.com.</p>\n<div class=\"j2-vol-panel\">\n<form id=\"vol-form\" action=\"mailto:volunteers@example.com\" method=\"post\" enctype=\"text/plain\" aria-describedby=\"vol-status\">\n  <fieldset>\n    <legend>Volunteer details</legend>\n    <div class=\"j2-vol-grid\">\n      <div>\n        <label for=\"vol-name\">Full name</label>\n        <input id=\"vol-name\" name=\"name\" type=\"text\" autocomplete=\"name\" required>\n      </div>\n      <div>\n        <label for=\"vol-email\">Email</label>\n        <input id=\"vol-email\" name=\"email\" type=\"email\" autocomplete=\"email\" inputmode=\"email\" required>\n      </div>\n      <div>\n        <label for=\"vol-role\">Preferred role</label>\n        <select id=\"vol-role\" name=\"preferred_role\" required>\n          <option value=\"\" selected>Choose a role</option>\n          <option value=\"Water station\">Water station</option>\n          <option value=\"Registration desk\">Registration desk</option>\n          <option value=\"Route marshal\">Route marshal</option>\n        </select>\n      </div>\n      <div>\n        <label for=\"vol-avail\">Availability</label>\n        <select id=\"vol-avail\" name=\"availability\" required>\n          <option value=\"\" selected>Choose when you are free</option>\n          <option value=\"Saturday\">Saturday (expo day, 13 February 2027)</option>\n          <option value=\"Sunday\">Sunday (race day, 14 February 2027)</option>\n          <option value=\"Both\">Both (Saturday and Sunday)</option>\n        </select>\n      </div>\n    </div>\n  </fieldset>\n  <div class=\"j2-vol-actions\">\n    <button class=\"j2-btn j2-btn-primary\" type=\"submit\">Send volunteer sign-up</button>\n    <p id=\"vol-status\" role=\"status\">Sending opens your email app with the details filled in, addressed to volunteers@example.com. Press send there to finish.</p>\n  </div>\n</form>\n</div>\n</section>",
    "workflow": "Volunteer sign-up form"
  },
  "W-6": {
    "owner": "W-6",
    "head": "",
    "body": "<section id=\"schedule\" aria-labelledby=\"schedule-title\">\n<style>\n.j2-sr-lead{color:var(--j2-muted)}\n.j2-sr-days{display:grid;gap:24px;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))}\n.j2-sr-days>*{min-width:0}\n.j2-sr-day,.j2-sr-route{background:var(--j2-surface);color:var(--j2-text);border:1px solid var(--j2-border);border-top:4px solid var(--j2-primary);border-radius:var(--j2-radius);padding:24px;box-shadow:0 2px 8px rgba(11,31,58,.08);min-width:0}\n.j2-sr-day h3,.j2-sr-route h3{margin:0 0 4px}\n.j2-sr-when{margin:0 0 16px;font-weight:600;color:var(--j2-muted)}\n.j2-time-list{list-style:none;margin:0;padding:0}\n.j2-time-list li{padding:12px 0 12px 16px;border-top:1px solid var(--j2-border);border-left:6px solid var(--j2-accent);margin-top:8px;font-size:1.125rem;font-weight:700;background:var(--j2-background);border-radius:8px}\n.j2-time-list li:first-child{margin-top:0}\n.j2-sr-routes{background:var(--j2-surface)}\n.j2-sr-grid{display:grid;gap:24px;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))}\n.j2-sr-grid>*{min-width:0}\n.j2-sr-route{background:var(--j2-background);border-top-color:var(--j2-accent)}\n.j2-sr-route .j2-route-map{margin:0 0 16px}\n.j2-sr-water-label{margin:0 0 4px;font-size:.875rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--j2-muted)}\n.j2-sr-water{margin:0;font-weight:700;font-size:1.125rem;color:var(--j2-text)}\n@media (max-width:480px){.j2-sr-day,.j2-sr-route{padding:16px}}\n</style>\n<h2 id=\"schedule-title\">Schedule</h2>\n<p class=\"j2-sr-lead\">Two days to plan for: collect your bib at the expo on Saturday, then run on Sunday.</p>\n<div class=\"j2-sr-days\">\n  <div class=\"j2-sr-day\">\n    <h3>Expo day</h3>\n    <p class=\"j2-sr-when\">Saturday 13 February 2027, Riverside Grounds</p>\n    <ul class=\"j2-time-list\">\n      <li>10am bib collection opens</li>\n      <li>4pm route briefing</li>\n      <li>6pm expo closes</li>\n    </ul>\n  </div>\n  <div class=\"j2-sr-day\">\n    <h3>Race day</h3>\n    <p class=\"j2-sr-when\">Sunday 14 February 2027</p>\n    <ul class=\"j2-time-list\">\n      <li>5:00am gates open</li>\n      <li>6:00am Half Marathon</li>\n      <li>6:45am 10K</li>\n      <li>7:30am 5K</li>\n      <li>10:00am prize ceremony</li>\n    </ul>\n  </div>\n</div>\n</section>\n\n<section id=\"routes\" class=\"j2-sr-routes\" aria-labelledby=\"routes-title\">\n<h2 id=\"routes-title\">Routes and water stations</h2>\n<p class=\"j2-sr-lead\">Each race has its own route and water stops. Route maps are placeholders for now.</p>\n<div class=\"j2-sr-grid\">\n  <article class=\"j2-route j2-sr-route\">\n    <h3>5K</h3>\n    <div class=\"j2-route-map\" role=\"img\" aria-label=\"Placeholder for the 5K route map\">Route map placeholder: 5K</div>\n    <p class=\"j2-sr-water-label\">Water stations</p>\n    <p class=\"j2-sr-water\">Water station at 2.5 km</p>\n  </article>\n  <article class=\"j2-route j2-sr-route\">\n    <h3>10K</h3>\n    <div class=\"j2-route-map\" role=\"img\" aria-label=\"Placeholder for the 10K route map\">Route map placeholder: 10K</div>\n    <p class=\"j2-sr-water-label\">Water stations</p>\n    <p class=\"j2-sr-water\">Water stations at 2.5, 5 and 7.5 km</p>\n  </article>\n  <article class=\"j2-route j2-sr-route\">\n    <h3>Half Marathon</h3>\n    <div class=\"j2-route-map\" role=\"img\" aria-label=\"Placeholder for the Half Marathon route map\">Route map placeholder: Half Marathon</div>\n    <p class=\"j2-sr-water-label\">Water stations</p>\n    <p class=\"j2-sr-water\">Water stations every 3 km</p>\n  </article>\n</div>\n</section>",
    "workflow": "Schedule, routes and water stations"
  },
  "W-7": {
    "owner": "W-7",
    "head": "",
    "body": "<section id=\"faq\" aria-labelledby=\"faq-title\">\n<style>\n.j2-fq-lead{color:var(--j2-muted)}\n.j2-fq-list{display:grid;gap:12px}\n.j2-faq-item{background:var(--j2-surface);color:var(--j2-text);border:1px solid var(--j2-border);border-left:6px solid var(--j2-accent);border-radius:var(--j2-radius);padding:0 16px;min-width:0}\n.j2-faq-item summary{list-style:none;justify-content:space-between;gap:16px;padding:8px 0;font-size:1.0625rem;color:var(--j2-text)}\n.j2-faq-item summary::-webkit-details-marker{display:none}\n.j2-faq-item summary::after{content:\"+\";flex:none;display:inline-grid;place-items:center;width:32px;height:32px;font-family:var(--j2-font-heading);font-weight:800;font-size:1.5rem;line-height:1;color:var(--j2-primary)}\n.j2-faq-item[open] summary::after{content:\"\\2212\"}\n.j2-faq-item[open]{border-left-color:var(--j2-primary)}\n.j2-fq-answer{margin:0;padding:0 0 16px;font-size:1.0625rem;color:var(--j2-text)}\n.j2-fq-answer strong{color:var(--j2-primary)}\n.sponsors-wrap{display:block}\n#sponsors{background:var(--j2-surface)}\n.j2-sp-lead{color:var(--j2-muted)}\n.j2-sp-tiers{display:grid;gap:24px}\n.j2-tier{background:var(--j2-background);color:var(--j2-text);border:1px solid var(--j2-border);border-top:6px solid var(--j2-accent);border-radius:var(--j2-radius);padding:24px;min-width:0}\n.j2-tier-silver{border-top-color:var(--j2-muted)}\n.j2-tier-community{border-top-color:var(--j2-primary)}\n.j2-tier h3{margin:0 0 16px}\n.j2-sp-grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr))}\n.j2-sp-grid>*{min-width:0}\n.j2-sp-item{margin:0;min-width:0}\n.j2-sp-item .j2-logo-ph{background:var(--j2-surface);margin:0 0 8px}\n.j2-sp-name{margin:0;font-weight:700;font-size:1.125rem;text-align:center;color:var(--j2-text)}\n@media (max-width:480px){.j2-tier{padding:16px}.j2-faq-item{padding:0 12px}}\n</style>\n<h2 id=\"faq-title\">FAQs</h2>\n<p class=\"j2-fq-lead\">Quick answers to the questions runners ask most.</p>\n<div class=\"j2-fq-list\">\n  <details class=\"j2-faq-item\">\n    <summary>Can I change my race?</summary>\n    <p class=\"j2-fq-answer\"><strong>Yes</strong>, until 31 January 2027 by email.</p>\n  </details>\n  <details class=\"j2-faq-item\">\n    <summary>Is there parking?</summary>\n    <p class=\"j2-fq-answer\"><strong>Yes</strong>, free at Gate 2.</p>\n  </details>\n  <details class=\"j2-faq-item\">\n    <summary>Are refunds available?</summary>\n    <p class=\"j2-fq-answer\"><strong>No.</strong></p>\n  </details>\n  <details class=\"j2-faq-item\">\n    <summary>Where do I collect my bib?</summary>\n    <p class=\"j2-fq-answer\">At the expo on 13 February.</p>\n  </details>\n  <details class=\"j2-faq-item\">\n    <summary>Is there a bag drop?</summary>\n    <p class=\"j2-fq-answer\"><strong>Yes</strong>, near the start line.</p>\n  </details>\n  <details class=\"j2-faq-item\">\n    <summary>Are pacers provided?</summary>\n    <p class=\"j2-fq-answer\"><strong>Yes</strong>, for the 10K and Half Marathon.</p>\n  </details>\n</div>\n</section>\n\n<section id=\"sponsors\" aria-labelledby=\"sponsors-title\">\n<h2 id=\"sponsors-title\">Sponsors</h2>\n<p class=\"j2-sp-lead\">Thank you to the partners who make Riverside Run 2027 possible. Logos are placeholders for now.</p>\n<div class=\"j2-sp-tiers\">\n  <div class=\"j2-tier j2-tier-gold\">\n    <h3>Gold</h3>\n    <div class=\"j2-sp-grid\">\n      <figure class=\"j2-sp-item\">\n        <div class=\"j2-logo-ph\" role=\"img\" aria-label=\"Logo placeholder for Meridian Bank\">Logo placeholder</div>\n        <figcaption class=\"j2-sp-name\">Meridian Bank</figcaption>\n      </figure>\n    </div>\n  </div>\n  <div class=\"j2-tier j2-tier-silver\">\n    <h3>Silver</h3>\n    <div class=\"j2-sp-grid\">\n      <figure class=\"j2-sp-item\">\n        <div class=\"j2-logo-ph\" role=\"img\" aria-label=\"Logo placeholder for Trailhead Sports\">Logo placeholder</div>\n        <figcaption class=\"j2-sp-name\">Trailhead Sports</figcaption>\n      </figure>\n      <figure class=\"j2-sp-item\">\n        <div class=\"j2-logo-ph\" role=\"img\" aria-label=\"Logo placeholder for Aqua Pure\">Logo placeholder</div>\n        <figcaption class=\"j2-sp-name\">Aqua Pure</figcaption>\n      </figure>\n    </div>\n  </div>\n  <div class=\"j2-tier j2-tier-community\">\n    <h3>Community</h3>\n    <div class=\"j2-sp-grid\">\n      <figure class=\"j2-sp-item\">\n        <div class=\"j2-logo-ph\" role=\"img\" aria-label=\"Logo placeholder for Pune Runners Club\">Logo placeholder</div>\n        <figcaption class=\"j2-sp-name\">Pune Runners Club</figcaption>\n      </figure>\n    </div>\n  </div>\n</div>\n</section>",
    "workflow": "FAQs and sponsors by tier"
  },
  "W-8": {
    "owner": "W-8",
    "head": "",
    "body": "<section id=\"contact\" aria-labelledby=\"contact-title\">\n<style>\n.j2-ct-lead{color:var(--j2-muted)}\n.j2-ct-grid{display:grid;gap:24px;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr))}\n.j2-ct-grid>*{min-width:0}\n.j2-ct-item{background:var(--j2-surface);color:var(--j2-text);border:1px solid var(--j2-border);border-left:6px solid var(--j2-accent);border-radius:var(--j2-radius);padding:24px;box-shadow:0 2px 8px rgba(11,31,58,.08)}\n.j2-ct-item h3{margin:0 0 8px}\n.j2-ct-item p{margin:0 0 16px;color:var(--j2-muted)}\n.j2-ct-item .j2-btn{text-transform:none;letter-spacing:.02em;width:100%}\n@media (max-width:480px){.j2-ct-item{padding:16px}}\n</style>\n<h2 id=\"contact-title\">Contact</h2>\n<p class=\"j2-ct-lead\">Questions about Riverside Run 2027? Email us or message us on WhatsApp.</p>\n<div class=\"j2-ct-grid\">\n  <div class=\"j2-ct-item\">\n    <h3>Email</h3>\n    <p>Best for race changes and registration questions.</p>\n    <a class=\"j2-btn\" href=\"mailto:run@example.com\">run@example.com</a>\n  </div>\n  <div class=\"j2-ct-item\">\n    <h3>WhatsApp</h3>\n    <p>Send us a quick message.</p>\n    <a class=\"j2-btn\" href=\"https://wa.me/910000044444\" target=\"_blank\" rel=\"noopener noreferrer\">WhatsApp +91 00000 44444</a>\n  </div>\n</div>\n</section>",
    "workflow": "Contact section"
  },
  "W-2": {
    "owner": "W-2",
    "head": "",
    "body": "<nav id=\"site-nav\" class=\"j2-nav\" aria-label=\"Main menu\">\n<style>\nhtml{scroll-padding-top:calc(var(--j2-nav-h,59px) + 8px)}\nbody{padding-top:var(--j2-nav-h,59px)}\n\n.j2-nav{position:fixed;top:0;left:0;right:0;z-index:1000;background:var(--j2-secondary);color:var(--j2-surface);border-bottom:3px solid var(--j2-accent);font-family:var(--j2-font-body)}\n.j2-nav-bar{display:flex;align-items:center;gap:8px;max-width:1440px;margin:0 auto;padding:4px 8px;min-width:0}\n.j2-nav-brand{display:none;flex:none;font-family:var(--j2-font-heading);font-weight:800;font-size:1.125rem;line-height:1;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;color:var(--j2-surface)}\n.j2-nav-list{list-style:none;margin:0;padding:0;display:flex;flex:1 1 0;min-width:0;position:relative;overflow-x:auto;overflow-y:hidden;scrollbar-width:none;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain}\n.j2-nav-list::-webkit-scrollbar{display:none}\n.j2-nav-list>li{flex:none;margin:0}\n#site-nav .j2-nav-link{display:inline-flex;align-items:center;min-height:48px;min-width:48px;padding:0 10px;border-top:4px solid transparent;border-bottom:4px solid transparent;color:var(--j2-surface);font-size:.8125rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;text-decoration:none;white-space:nowrap}\n#site-nav .j2-nav-link:hover{color:var(--j2-accent)}\n#site-nav .j2-nav-link.j2-active{color:var(--j2-accent);border-bottom-color:var(--j2-accent)}\n#site-nav .j2-nav-link:focus-visible{outline:3px solid var(--j2-accent);outline-offset:-4px}\n\n#site-nav .j2-btn{flex:none;width:auto;min-height:44px;min-width:44px;padding:6px 12px;gap:6px;font-size:.8125rem;background:var(--j2-accent);border-color:var(--j2-accent);color:var(--j2-on-accent)}\n#site-nav .j2-btn[aria-pressed=\"true\"]{background:var(--j2-surface);border-color:var(--j2-surface);color:var(--j2-secondary)}\n#site-nav .j2-btn:focus-visible{outline:3px solid var(--j2-surface);outline-offset:2px}\n.j2-nav-hc-long,.j2-nav-hc-state{display:none}\n\n@media (min-width:768px){\n  .j2-nav-bar{padding:4px 16px;gap:16px}\n  .j2-nav-list>li:first-child{margin-left:auto}\n  .j2-nav-list>li:last-child{margin-right:auto}\n  .j2-nav-hc-long,.j2-nav-hc-state{display:inline}\n  #site-nav .j2-btn{padding:6px 16px}\n}\n@media (min-width:1360px){\n  .j2-nav-brand{display:block}\n}\n\n/* High-contrast mode: every section reads colours from these variables */\nbody.j2-hc{\n  --j2-primary:#0000B3;\n  --j2-secondary:#000000;\n  --j2-accent:#B33000;\n  --j2-background:#FFFFFF;\n  --j2-surface:#FFFFFF;\n  --j2-text:#000000;\n  --j2-muted:#000000;\n  --j2-border:#000000;\n  --j2-field-border:#000000;\n  --j2-on-primary:#FFFFFF;\n  --j2-on-accent:#FFFFFF;\n}\nbody.j2-hc .j2-top,body.j2-hc .j2-nav{--j2-accent:#FFD400;--j2-on-accent:#000000}\nbody.j2-hc *{box-shadow:none!important}\nbody.j2-hc a:not(.j2-btn):not(.j2-nav-link){text-decoration-thickness:2px}\nbody.j2-hc :focus-visible{outline-width:4px}\n</style>\n<div class=\"j2-nav-bar\">\n  <span class=\"j2-nav-brand\">Riverside Run 2027</span>\n  <ul class=\"j2-nav-list\" id=\"j2-nav-list\">\n    <li><a class=\"j2-nav-link\" href=\"#races\">Races</a></li>\n    <li><a class=\"j2-nav-link\" href=\"#calculator\">Calculator</a></li>\n    <li><a class=\"j2-nav-link\" href=\"#register\">Register</a></li>\n    <li><a class=\"j2-nav-link\" href=\"#volunteer\">Volunteer</a></li>\n    <li><a class=\"j2-nav-link\" href=\"#schedule\">Schedule</a></li>\n    <li><a class=\"j2-nav-link\" href=\"#routes\">Routes</a></li>\n    <li><a class=\"j2-nav-link\" href=\"#faq\">FAQs</a></li>\n    <li><a class=\"j2-nav-link\" href=\"#sponsors\">Sponsors</a></li>\n    <li><a class=\"j2-nav-link\" href=\"#contact\">Contact</a></li>\n  </ul>\n  <button id=\"contrast-toggle\" class=\"j2-btn\" type=\"button\" aria-pressed=\"false\" aria-label=\"High contrast mode\">\n    <span class=\"j2-nav-hc-icon\" aria-hidden=\"true\">&#9680;</span>\n    <span class=\"j2-nav-hc-text\"><span class=\"j2-nav-hc-long\">High </span>contrast</span>\n    <span class=\"j2-nav-hc-state\" aria-hidden=\"true\">Off</span>\n  </button>\n</div>\n<script>\n(function () {\n  var nav = document.getElementById('site-nav');\n  if (!nav) { return; }\n  var root = document.documentElement;\n  var body = document.body;\n  var list = document.getElementById('j2-nav-list');\n  var btn = document.getElementById('contrast-toggle');\n  var links = [].slice.call(nav.querySelectorAll('.j2-nav-link'));\n  var KEY = 'j2-high-contrast';\n  var reduce = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);\n\n  /* Keep page content clear of the fixed bar */\n  function setNavHeight() {\n    root.style.setProperty('--j2-nav-h', nav.offsetHeight + 'px');\n  }\n\n  /* High-contrast toggle: one class on body switches every colour variable */\n  var stateEl = btn ? btn.querySelector('.j2-nav-hc-state') : null;\n  var iconEl = btn ? btn.querySelector('.j2-nav-hc-icon') : null;\n  function applyContrast(on, save) {\n    if (on) { body.classList.add('j2-hc'); } else { body.classList.remove('j2-hc'); }\n    if (btn) { btn.setAttribute('aria-pressed', on ? 'true' : 'false'); }\n    if (stateEl) { stateEl.textContent = on ? 'On' : 'Off'; }\n    if (iconEl) { iconEl.innerHTML = on ? '&#9679;' : '&#9680;'; }\n    if (save) {\n      try { window.localStorage.setItem(KEY, on ? '1' : '0'); } catch (e) { /* storage not available */ }\n    }\n  }\n  var saved = null;\n  try { saved = window.localStorage.getItem(KEY); } catch (e) { saved = null; }\n  applyContrast(saved === '1', false);\n  if (btn) {\n    btn.addEventListener('click', function () {\n      applyContrast(!body.classList.contains('j2-hc'), true);\n    });\n  }\n\n  /* Current-section highlight */\n  var items = [];\n  links.forEach(function (a) {\n    var href = a.getAttribute('href') || '';\n    var el = href.charAt(0) === '#' ? document.getElementById(href.slice(1)) : null;\n    if (el) { items.push({ a: a, el: el }); }\n  });\n  var active = null;\n\n  function reveal(a) {\n    if (!list || list.scrollWidth <= list.clientWidth) { return; }\n    var li = a.parentNode;\n    var left = li.offsetLeft - (list.clientWidth - li.offsetWidth) / 2;\n    if (list.scrollTo) {\n      list.scrollTo({ left: left, behavior: reduce ? 'auto' : 'smooth' });\n    } else {\n      list.scrollLeft = left;\n    }\n  }\n\n  function setActive(item) {\n    if (item === active) { return; }\n    active = item;\n    links.forEach(function (a) {\n      a.classList.remove('j2-active');\n      a.removeAttribute('aria-current');\n    });\n    if (item) {\n      item.a.classList.add('j2-active');\n      item.a.setAttribute('aria-current', 'true');\n      reveal(item.a);\n    }\n  }\n\n  function update() {\n    var line = Math.max(nav.offsetHeight + 16, window.innerHeight * 0.3);\n    var current = null;\n    items.forEach(function (item) {\n      var r = item.el.getBoundingClientRect();\n      if (r.top <= line && r.bottom > line) { current = item; }\n    });\n    var atBottom = window.innerHeight + (window.pageYOffset || root.scrollTop) >= root.scrollHeight - 2;\n    if (atBottom && items.length) { current = items[items.length - 1]; }\n    setActive(current);\n  }\n\n  if ('IntersectionObserver' in window) {\n    var io = new IntersectionObserver(function () { update(); }, {\n      rootMargin: '-10% 0px -70% 0px',\n      threshold: [0, 0.1, 0.25, 0.5, 0.75, 1]\n    });\n    items.forEach(function (item) { io.observe(item.el); });\n  }\n\n  /* Scroll check covers the end of the page and browsers without IntersectionObserver */\n  var ticking = false;\n  window.addEventListener('scroll', function () {\n    if (ticking) { return; }\n    ticking = true;\n    window.requestAnimationFrame(function () { ticking = false; update(); });\n  }, { passive: true });\n\n  window.addEventListener('resize', function () { setNavHeight(); update(); });\n  if (window.ResizeObserver) { new ResizeObserver(setNavHeight).observe(nav); }\n  if (document.fonts && document.fonts.ready) { document.fonts.ready.then(function () { setNavHeight(); update(); }); }\n  setNavHeight();\n  update();\n})();\n</script>\n</nav>",
    "workflow": "Sticky menu and high-contrast mode"
  }
}