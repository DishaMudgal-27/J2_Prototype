{
  "W-1": {
    "owner": "W-1",
    "head": "",
    "body": "<header class=\"bl-header\" id=\"top\">\n  <style>\n    .bl-header { background: #3b2416; color: #fdf6ec; padding: 1rem 1rem 0.75rem; text-align: center; box-sizing: border-box; max-width: 100%; }\n    .bl-header *, .bl-header *::before, .bl-header *::after { box-sizing: border-box; }\n    .bl-header .bl-name { margin: 0; font-size: 2rem; line-height: 1.2; letter-spacing: 0.04em; overflow-wrap: anywhere; }\n    .bl-header .bl-tagline { margin: 0.25rem 0 0.75rem; font-size: 1rem; color: #e8d3b9; }\n    .bl-header .bl-nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.25rem 0.5rem; }\n    .bl-header .bl-nav a { display: inline-block; padding: 0.5rem 0.75rem; color: #fdf6ec; text-decoration: none; border-radius: 4px; }\n    .bl-header .bl-nav a:hover, .bl-header .bl-nav a:focus { background: #5a3a24; text-decoration: underline; }\n    @media (min-width: 768px) {\n      .bl-header { padding: 1.5rem 2rem 1rem; }\n      .bl-header .bl-name { font-size: 2.75rem; }\n    }\n  </style>\n  <h1 class=\"bl-name\">Brew Lab</h1>\n  <p class=\"bl-tagline\">A cafe in Indiranagar, Bengaluru</p>\n  <nav class=\"bl-nav\" aria-label=\"Main\">\n    <ul>\n      <li><a href=\"#menu\">Menu</a></li>\n      <li><a href=\"#timings\">Timings</a></li>\n      <li><a href=\"#location\">Location</a></li>\n      <li><a href=\"#gallery\">Gallery</a></li>\n      <li><a href=\"#stories\">Coffee stories</a></li>\n    </ul>\n  </nav>\n</header>",
    "workflow": "Header and navigation"
  },
  "W-2": {
    "owner": "W-2",
    "head": "",
    "body": "<section class=\"bl-menu\" id=\"menu\" aria-labelledby=\"bl-menu-title\">\n  <style>\n    .bl-menu { background: #fdf6ec; color: #3b2416; padding: 2rem 1rem; box-sizing: border-box; max-width: 100%; }\n    .bl-menu *, .bl-menu *::before, .bl-menu *::after { box-sizing: border-box; }\n    .bl-menu .bl-menu-title { margin: 0 0 1rem; text-align: center; font-size: 1.75rem; line-height: 1.2; }\n    .bl-menu .bl-menu-list { list-style: none; margin: 0 auto; padding: 0; max-width: 32rem; }\n    .bl-menu .bl-menu-item { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 0.75rem 0; border-bottom: 1px solid #e0cbb0; }\n    .bl-menu .bl-menu-item:last-child { border-bottom: 0; }\n    .bl-menu .bl-menu-name { font-size: 1.1rem; overflow-wrap: anywhere; }\n    .bl-menu .bl-menu-price { font-weight: 700; white-space: nowrap; }\n    @media (min-width: 768px) {\n      .bl-menu { padding: 3rem 2rem; }\n      .bl-menu .bl-menu-title { font-size: 2.25rem; }\n    }\n  </style>\n  <h2 class=\"bl-menu-title\" id=\"bl-menu-title\">Menu</h2>\n  <ul class=\"bl-menu-list\">\n    <li class=\"bl-menu-item\"><span class=\"bl-menu-name\">Espresso</span><span class=\"bl-menu-price\">₹120</span></li>\n    <li class=\"bl-menu-item\"><span class=\"bl-menu-name\">Cappuccino</span><span class=\"bl-menu-price\">₹180</span></li>\n    <li class=\"bl-menu-item\"><span class=\"bl-menu-name\">Cold brew</span><span class=\"bl-menu-price\">₹200</span></li>\n    <li class=\"bl-menu-item\"><span class=\"bl-menu-name\">Pour-over</span><span class=\"bl-menu-price\">₹220</span></li>\n    <li class=\"bl-menu-item\"><span class=\"bl-menu-name\">Croissant</span><span class=\"bl-menu-price\">₹150</span></li>\n    <li class=\"bl-menu-item\"><span class=\"bl-menu-name\">Banana bread</span><span class=\"bl-menu-price\">₹130</span></li>\n  </ul>\n</section>",
    "workflow": "Menu section"
  },
  "W-3": {
    "owner": "W-3",
    "head": "",
    "body": "<section class=\"bl-timings\" id=\"timings\" aria-labelledby=\"bl-timings-title\">\n  <style>\n    .bl-timings { background: #f3e6d3; color: #3b2416; padding: 2rem 1rem; box-sizing: border-box; max-width: 100%; text-align: center; }\n    .bl-timings *, .bl-timings *::before, .bl-timings *::after { box-sizing: border-box; }\n    .bl-timings .bl-timings-title { margin: 0 0 1rem; font-size: 1.75rem; line-height: 1.2; }\n    .bl-timings .bl-timings-hours { margin: 0 auto 0.5rem; font-size: 1.5rem; font-weight: 700; overflow-wrap: anywhere; }\n    .bl-timings .bl-timings-note { margin: 0; font-size: 1.1rem; }\n    @media (min-width: 768px) {\n      .bl-timings { padding: 3rem 2rem; }\n      .bl-timings .bl-timings-title { font-size: 2.25rem; }\n      .bl-timings .bl-timings-hours { font-size: 2rem; }\n    }\n  </style>\n  <h2 class=\"bl-timings-title\" id=\"bl-timings-title\">Timings</h2>\n  <p class=\"bl-timings-hours\">Open 8am to 10pm</p>\n  <p class=\"bl-timings-note\">Every day of the week, with no days off.</p>\n</section>",
    "workflow": "Timings section"
  },
  "W-4": {
    "owner": "W-4",
    "head": "",
    "body": "<section class=\"bl-location\" id=\"location\" aria-labelledby=\"bl-location-title\">\n  <style>\n    .bl-location { background: #fdf6ec; color: #3b2416; padding: 2rem 1rem; box-sizing: border-box; max-width: 100%; text-align: center; }\n    .bl-location *, .bl-location *::before, .bl-location *::after { box-sizing: border-box; }\n    .bl-location .bl-location-title { margin: 0 0 1rem; font-size: 1.75rem; line-height: 1.2; }\n    .bl-location .bl-location-address { margin: 0 auto 1rem; font-style: normal; font-size: 1.25rem; line-height: 1.5; max-width: 32rem; overflow-wrap: anywhere; }\n    .bl-location .bl-location-phone { margin: 0; font-size: 1.1rem; }\n    .bl-location .bl-location-call { display: inline-block; margin-top: 0.5rem; padding: 0.75rem 1.25rem; background: #3b2416; color: #fdf6ec; font-weight: 700; text-decoration: none; border-radius: 4px; overflow-wrap: anywhere; }\n    .bl-location .bl-location-call:hover, .bl-location .bl-location-call:focus { background: #5a3a24; text-decoration: underline; }\n    @media (min-width: 768px) {\n      .bl-location { padding: 3rem 2rem; }\n      .bl-location .bl-location-title { font-size: 2.25rem; }\n      .bl-location .bl-location-address { font-size: 1.5rem; }\n    }\n  </style>\n  <h2 class=\"bl-location-title\" id=\"bl-location-title\">Location</h2>\n  <address class=\"bl-location-address\">100 Feet Road, Indiranagar, Bengaluru 560038</address>\n  <p class=\"bl-location-phone\">Call us:<br><a class=\"bl-location-call\" href=\"tel:+918040002468\">+91 80 4000 2468</a></p>\n</section>",
    "workflow": "Location and phone section"
  },
  "W-5": {
    "owner": "W-5",
    "head": "",
    "body": "<section class=\"bl-gallery\" id=\"gallery\" aria-labelledby=\"bl-gallery-title\">\n  <style>\n    .bl-gallery { background: #f3e6d3; color: #3b2416; padding: 2rem 1rem; box-sizing: border-box; max-width: 100%; }\n    .bl-gallery *, .bl-gallery *::before, .bl-gallery *::after { box-sizing: border-box; }\n    .bl-gallery .bl-gallery-title { margin: 0 0 1rem; text-align: center; font-size: 1.75rem; line-height: 1.2; }\n    .bl-gallery .bl-gallery-grid { list-style: none; margin: 0 auto; padding: 0; max-width: 64rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr)); gap: 0.75rem; }\n    .bl-gallery .bl-gallery-spot { display: flex; align-items: center; justify-content: center; text-align: center; aspect-ratio: 4 / 3; padding: 0.75rem; border: 2px dashed #b89572; border-radius: 6px; background: #fdf6ec; color: #5a3a24; font-size: 1rem; overflow-wrap: anywhere; }\n    @media (min-width: 768px) {\n      .bl-gallery { padding: 3rem 2rem; }\n      .bl-gallery .bl-gallery-title { font-size: 2.25rem; }\n      .bl-gallery .bl-gallery-grid { gap: 1rem; }\n    }\n  </style>\n  <h2 class=\"bl-gallery-title\" id=\"bl-gallery-title\">Gallery</h2>\n  <ul class=\"bl-gallery-grid\">\n    <li class=\"bl-gallery-spot\" aria-label=\"Empty photo spot 1\">Empty photo spot 1</li>\n    <li class=\"bl-gallery-spot\" aria-label=\"Empty photo spot 2\">Empty photo spot 2</li>\n    <li class=\"bl-gallery-spot\" aria-label=\"Empty photo spot 3\">Empty photo spot 3</li>\n    <li class=\"bl-gallery-spot\" aria-label=\"Empty photo spot 4\">Empty photo spot 4</li>\n    <li class=\"bl-gallery-spot\" aria-label=\"Empty photo spot 5\">Empty photo spot 5</li>\n    <li class=\"bl-gallery-spot\" aria-label=\"Empty photo spot 6\">Empty photo spot 6</li>\n  </ul>\n</section>",
    "workflow": "Gallery with empty photo spots"
  },
  "W-6": {
    "owner": "W-6",
    "head": "",
    "body": "<section class=\"bl-stories\" id=\"stories\" aria-labelledby=\"bl-stories-title\">\n  <style>\n    .bl-stories { background: #fdf6ec; color: #3b2416; padding: 2rem 1rem; box-sizing: border-box; max-width: 100%; }\n    .bl-stories *, .bl-stories *::before, .bl-stories *::after { box-sizing: border-box; }\n    .bl-stories .bl-stories-title { margin: 0 0 0.5rem; text-align: center; font-size: 1.75rem; line-height: 1.2; }\n    .bl-stories .bl-stories-intro { margin: 0 auto 1.5rem; text-align: center; font-size: 1.1rem; max-width: 32rem; }\n    .bl-stories .bl-stories-list { list-style: none; margin: 0 auto; padding: 0; max-width: 64rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 1rem; }\n    .bl-stories .bl-story { padding: 1.25rem; background: #f3e6d3; border-left: 4px solid #5a3a24; border-radius: 6px; }\n    .bl-stories .bl-story-place { display: block; margin: 0 0 0.25rem; font-size: 0.9rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #5a3a24; }\n    .bl-stories .bl-story-name { margin: 0 0 0.5rem; font-size: 1.35rem; line-height: 1.25; overflow-wrap: anywhere; }\n    .bl-stories .bl-story-text { margin: 0; font-size: 1.05rem; line-height: 1.55; overflow-wrap: anywhere; }\n    @media (min-width: 768px) {\n      .bl-stories { padding: 3rem 2rem; }\n      .bl-stories .bl-stories-title { font-size: 2.25rem; }\n      .bl-stories .bl-stories-list { gap: 1.5rem; }\n    }\n  </style>\n  <h2 class=\"bl-stories-title\" id=\"bl-stories-title\">Coffee stories</h2>\n  <p class=\"bl-stories-intro\">Where our coffee comes from.</p>\n  <ul class=\"bl-stories-list\">\n    <li class=\"bl-story\">\n      <span class=\"bl-story-place\">Chikmagalur</span>\n      <h3 class=\"bl-story-name\">Ratnagiri Estate</h3>\n      <p class=\"bl-story-text\">Ratnagiri Estate in Chikmagalur grows shade-grown coffee.</p>\n    </li>\n    <li class=\"bl-story\">\n      <span class=\"bl-story-place\">Chikmagalur</span>\n      <h3 class=\"bl-story-name\">Kerehaklu</h3>\n      <p class=\"bl-story-text\">Kerehaklu in Chikmagalur grows coffee alongside pepper and cardamom.</p>\n    </li>\n    <li class=\"bl-story\">\n      <span class=\"bl-story-place\">Coorg</span>\n      <h3 class=\"bl-story-name\">Baarbara Estate</h3>\n      <p class=\"bl-story-text\">Baarbara Estate in Coorg hand-picks only ripe cherries.</p>\n    </li>\n  </ul>\n</section>",
    "workflow": "Coffee stories section"
  },
  "W-7": {
    "owner": "W-7",
    "head": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<style>\n  *, *::before, *::after { box-sizing: border-box; }\n  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: 0.5rem; }\n  body { margin: 0; max-width: 100%; overflow-x: clip; font-family: Georgia, \"Times New Roman\", serif; line-height: 1.5; background: #fdf6ec; color: #3b2416; }\n  img, svg, video { max-width: 100%; height: auto; }\n  h1, h2, h3, p, li, address, a { overflow-wrap: anywhere; }\n  a:focus-visible { outline: 3px solid #c97b2a; outline-offset: 2px; }\n  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }\n</style>",
    "body": "<footer class=\"bl-footer\">\n  <style>\n    .bl-footer { background: #3b2416; color: #e8d3b9; padding: 1.5rem 1rem; text-align: center; max-width: 100%; }\n    .bl-footer p { margin: 0 0 0.5rem; }\n    .bl-footer a { display: inline-block; padding: 0.5rem 0.75rem; color: #fdf6ec; border-radius: 4px; }\n    .bl-footer a:hover, .bl-footer a:focus { background: #5a3a24; }\n    @media (min-width: 768px) { .bl-footer { padding: 2rem; } }\n  </style>\n  <p>Brew Lab, a cafe in Indiranagar, Bengaluru</p>\n  <a href=\"#top\">Back to top</a>\n</footer>",
    "workflow": "Warm responsive styling"
  }
}