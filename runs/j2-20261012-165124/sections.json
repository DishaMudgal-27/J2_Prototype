    "body": "<section id=\"venue\">\n<style>\n#venue{padding:var(--j2-section,64px) 20px}\n#venue .ve-inner{max-width:1100px;margin:0 auto;min-width:0}\n#venue h2{margin:0 0 8px;font-family:var(--j2-font-heading);font-size:clamp(2rem,8vw,3rem);line-height:1.1;font-weight:700;color:var(--j2-text)}\n#venue .ve-intro{margin:0 0 24px;color:var(--j2-muted)}\n#venue .ve-card{display:grid;gap:20px;min-width:0;border-radius:var(--j2-radius);border-left:6px solid var(--j2-secondary)}\n#venue .ve-label{margin:0;font-size:.85rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--j2-secondary)}\n#venue .ve-address{margin:0;font-style:normal;font-family:var(--j2-font-heading);font-size:clamp(1.25rem,5vw,1.75rem);font-weight:700;line-height:1.3;color:var(--j2-text);overflow-wrap:break-word}\n#venue .map-link{border-radius:var(--j2-radius);width:100%;text-align:center;font-family:var(--j2-font-heading);font-size:1.05rem}\n#venue .map-link:focus-visible{outline:3px solid var(--j2-accent);outline-offset:2px}\n@media (min-width:800px){\n#venue{padding:var(--j2-section,64px) 32px}\n#venue .map-link{width:auto;justify-self:start;min-width:240px}\n}\n</style>\n<div class=\"ve-inner\">\n<h2>Venue</h2>\n<p class=\"ve-intro\">Find us on campus at Northfield College of Engineering.</p>\n<div class=\"ve-card j2-card\">\n<p class=\"ve-label\">Address</p>\n<address class=\"ve-address\">Northfield College of Engineering, 22 University Road, Pune 411007</address>\n<a class=\"map-link j2-btn\" href=\"https://www.google.com/maps/search/?api=1&amp;query=Northfield+College+of+Engineering%2C+22+University+Road%2C+Pune+411007\" target=\"_blank\" rel=\"noopener noreferrer\">Open in Google Maps</a>\n</div>\n</div>\n</section>",
