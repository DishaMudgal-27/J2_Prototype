    "body": "<section id=\"contact\">\n<style>\n#contact{padding:var(--j2-section,64px) 20px}\n#contact .ct-inner{max-width:1100px;margin:0 auto;min-width:0}\n#contact h2{margin:0 0 8px;font-family:var(--j2-font-heading);font-size:clamp(2rem,8vw,3rem);line-height:1.1;font-weight:700;color:var(--j2-text)}\n#contact .ct-intro{margin:0 0 24px;color:var(--j2-muted)}\n#contact .ct-card{display:grid;gap:20px;min-width:0;border-radius:var(--j2-radius);border-left:6px solid var(--j2-primary)}\n#contact .ct-row{display:grid;gap:4px;min-width:0}\n#contact .ct-label{margin:0;font-size:.85rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--j2-secondary)}\n#contact .ct-value{margin:0;font-family:var(--j2-font-heading);font-size:clamp(1.15rem,5vw,1.6rem);font-weight:700;line-height:1.3;color:var(--j2-text);overflow-wrap:anywhere}\n#contact .ct-email{color:var(--j2-text);text-decoration:underline;text-decoration-color:var(--j2-accent);text-underline-offset:4px}\n#contact .ct-email:focus-visible{outline:3px solid var(--j2-accent);outline-offset:2px}\n#contact .ct-link{margin:0;font-size:.9rem;color:var(--j2-muted);overflow-wrap:anywhere}\n#contact .ct-link a{color:var(--j2-secondary);text-decoration:underline;text-underline-offset:3px}\n#contact .ct-link a:focus-visible{outline:3px solid var(--j2-accent);outline-offset:2px}\n#contact .whatsapp-btn{border-radius:var(--j2-radius);width:100%;text-align:center;font-family:var(--j2-font-heading);font-size:1.05rem}\n#contact .whatsapp-btn:focus-visible{outline:3px solid var(--j2-accent);outline-offset:2px}\n@media (min-width:800px){\n#contact{padding:var(--j2-section,64px) 32px}\n#contact .whatsapp-btn{width:auto;justify-self:start;min-width:260px}\n}\n</style>\n<div class=\"ct-inner\">\n<h2>Contact the organisers</h2>\n<p class=\"ct-intro\">Questions about Spark 2026? Message us on WhatsApp or send an email.</p>\n<div class=\"ct-card j2-card\">\n<div class=\"ct-row\">\n<p class=\"ct-label\">WhatsApp</p>\n<p class=\"ct-value\">+91 00000 33333</p>\n</div>\n<a class=\"whatsapp-btn j2-btn\" href=\"https://wa.me/910000033333\" target=\"_blank\" rel=\"noopener noreferrer\">Chat on WhatsApp</a>\n<p class=\"ct-link\">Direct link: <a href=\"https://wa.me/910000033333\" target=\"_blank\" rel=\"noopener noreferrer\">wa.me/910000033333</a></p>\n<div class=\"ct-row\">\n<p class=\"ct-label\">Email</p>\n<p class=\"ct-value\"><a class=\"ct-email\" href=\"mailto:spark2026@example.com\">spark2026@example.com</a></p>\n</div>\n</div>\n</div>\n</section>",
