{
  "style": {
    "owner": "W-1",
    "head": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&amp;family=Space+Grotesk:wght@500;700&amp;display=swap\"><style>:root{--j2-primary:#FFD60A;--j2-secondary:#22D3EE;--j2-accent:#FF3D9A;--j2-background:#0B0B1A;--j2-surface:#171730;--j2-text:#F5F5FF;--j2-muted:#B4B4D0;--j2-font-heading:'Space Grotesk', 'Segoe UI', system-ui, sans-serif;--j2-font-body:'Inter', 'Segoe UI', system-ui, sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:14px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;background:#FFD60A;color:#0B0B1A;border:2px solid #FFD60A;min-height:48px;padding:12px 24px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer}.j2-btn-secondary{display:inline-block;background:transparent;color:#22D3EE;border:2px solid #22D3EE;min-height:48px;padding:12px 24px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer}.j2-card{background:#171730;border:1px solid #2C2C52;padding:24px;color:#F5F5FF}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-1": {
    "owner": "W-8",
    "head": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<style>\n*,*::before,*::after{box-sizing:border-box}\nhtml,body{margin:0;padding:0;max-width:100%}\nhtml{overflow-x:hidden;scroll-padding-top:104px}\nbody{overflow-x:clip;background:var(--j2-background,#0B0B1A);color:var(--j2-text,#F5F5FF);font-family:var(--j2-font-body,'Inter',system-ui,sans-serif);line-height:1.6}\nimg,svg{max-width:100%}\n@media (min-width:600px){html{scroll-padding-top:56px}}\n</style>",
    "body": "<style>\n.site-nav{position:sticky;top:0;z-index:50;background:var(--j2-surface,#171730);border-bottom:2px solid var(--j2-primary,#FFD60A)}\n.site-nav .nav-inner{max-width:1100px;margin:0 auto;padding:0 8px;display:flex;flex-wrap:wrap;justify-content:center}\n.site-nav .nav-link{flex:1 1 33.333%;min-width:0;min-height:48px;display:flex;align-items:center;justify-content:center;padding:8px 4px;color:var(--j2-text,#F5F5FF);font-family:var(--j2-font-heading,'Space Grotesk',sans-serif);font-size:.95rem;font-weight:700;line-height:1.2;text-align:center;text-decoration:none}\n.site-nav .nav-link:hover{color:var(--j2-secondary,#22D3EE)}\n.site-nav .nav-link:focus-visible{outline:3px solid var(--j2-accent,#FF3D9A);outline-offset:-3px}\n.site-nav .nav-link[href=\"#register\"]{color:var(--j2-primary,#FFD60A)}\n@media (min-width:600px){\n.site-nav .nav-inner{padding:0 24px}\n.site-nav .nav-link{flex:0 0 auto;padding:8px 20px;font-size:1rem}\n}\n</style>\n<nav class=\"site-nav\" aria-label=\"Main\">\n<div class=\"nav-inner\">\n<a class=\"nav-link\" href=\"#schedule\">Schedule</a>\n<a class=\"nav-link\" href=\"#events\">Events</a>\n<a class=\"nav-link\" href=\"#register\">Register</a>\n<a class=\"nav-link\" href=\"#sponsors\">Sponsors</a>\n<a class=\"nav-link\" href=\"#venue\">Venue</a>\n<a class=\"nav-link\" href=\"#contact\">Contact</a>\n</div>\n</nav>\n<section id=\"hero\">\n<style>\n#hero{position:relative;overflow:hidden;padding:48px 20px 56px;background:radial-gradient(circle at 15% 10%,rgba(255,61,154,.28),transparent 45%),radial-gradient(circle at 90% 30%,rgba(34,211,238,.22),transparent 45%),var(--j2-background,#0B0B1A)}\n#hero .hero-inner{max-width:1100px;margin:0 auto;display:grid;gap:32px;align-items:center}\n#hero .hero-eyebrow{display:inline-block;margin:0 0 16px;padding:6px 14px;border:1px solid var(--j2-secondary,#22D3EE);border-radius:999px;color:var(--j2-secondary,#22D3EE);font-size:.85rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase}\n#hero h1{margin:0 0 16px;font-family:var(--j2-font-heading,'Space Grotesk',sans-serif);font-size:clamp(2.75rem,13vw,5.75rem);line-height:1;font-weight:700;letter-spacing:-.02em;overflow-wrap:break-word;background:linear-gradient(90deg,var(--j2-primary,#FFD60A),var(--j2-accent,#FF3D9A));-webkit-background-clip:text;background-clip:text;color:transparent}\n#hero .hero-college{margin:0 0 8px;font-family:var(--j2-font-heading,'Space Grotesk',sans-serif);font-size:clamp(1.15rem,5vw,1.75rem);font-weight:700;overflow-wrap:break-word}\n#hero .hero-dates{margin:0;font-size:clamp(1.05rem,4.5vw,1.4rem);font-weight:600;color:var(--j2-primary,#FFD60A)}\n#hero .hero-copy{min-width:0}\n#hero .hero-register{margin-top:24px;border-radius:var(--j2-radius,14px);font-family:var(--j2-font-heading,'Space Grotesk',sans-serif);font-size:1.05rem}\n#hero .hero-register:focus-visible{outline:3px solid var(--j2-accent,#FF3D9A);outline-offset:2px}\n#hero .photo-placeholder{display:flex;align-items:center;justify-content:center;text-align:center;width:100%;aspect-ratio:4/3;padding:16px;border:2px dashed var(--j2-secondary,#22D3EE);border-radius:var(--j2-radius,14px);background:repeating-linear-gradient(135deg,rgba(255,255,255,.04) 0 14px,rgba(255,255,255,.08) 14px 28px);color:var(--j2-muted,#B4B4D0);font-weight:600;letter-spacing:.04em}\n@media (min-width:800px){\n#hero{padding:88px 32px 96px}\n#hero .hero-inner{grid-template-columns:1.1fr .9fr;gap:56px}\n}\n</style>\n<div class=\"hero-inner\">\n<div class=\"hero-copy\">\n<p class=\"hero-eyebrow\">College tech fest</p>\n<h1>Spark 2026</h1>\n<p class=\"hero-college\">Northfield College of Engineering, Pune</p>\n<p class=\"hero-dates\">14 to 16 February 2027</p>\n<a class=\"hero-register j2-btn\" href=\"#register\">Register</a>\n</div>\n<div class=\"photo-placeholder\" role=\"img\" aria-label=\"Photo placeholder\">Photo placeholder</div>\n</div>\n</section>",
    "workflow": "Navigation and hero Register button"
  },
  "W-2": {
    "owner": "W-2",
    "head": "",
    "body": "<section id=\"schedule\">\n<style>\n#schedule{padding:var(--j2-section,64px) 20px}\n#schedule .sch-inner{max-width:1100px;margin:0 auto;min-width:0}\n#schedule h2{margin:0 0 8px;font-family:var(--j2-font-heading);font-size:clamp(2rem,8vw,3rem);line-height:1.1;font-weight:700;color:var(--j2-text)}\n#schedule .sch-intro{margin:0 0 24px;color:var(--j2-muted)}\n#schedule .tab-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:0 0 24px}\n#schedule .day-tab{min-width:0;min-height:48px;padding:12px 8px;border:2px solid var(--j2-secondary);border-radius:var(--j2-radius);background:transparent;color:var(--j2-secondary);font-family:var(--j2-font-heading);font-size:.95rem;font-weight:700;line-height:1.2;cursor:pointer;overflow-wrap:break-word}\n#schedule .day-tab[aria-selected=\"true\"]{background:var(--j2-primary);border-color:var(--j2-primary);color:var(--j2-background)}\n#schedule .day-tab:focus-visible{outline:3px solid var(--j2-accent);outline-offset:2px}\n#schedule .day-panel[hidden]{display:none}\n#schedule .sch-list{list-style:none;margin:0;padding:0;display:grid;gap:16px}\n#schedule .schedule-item{display:flex;flex-wrap:wrap;align-items:center;gap:8px 24px;border-radius:var(--j2-radius);border-left:6px solid var(--j2-accent);min-width:0}\n#schedule .si-time{flex:0 0 auto;font-family:var(--j2-font-heading);font-size:1.25rem;font-weight:700;color:var(--j2-primary)}\n#schedule .si-body{flex:1 1 180px;min-width:0}\n#schedule .si-name{margin:0 0 4px;font-size:1.25rem;line-height:1.2;color:var(--j2-text);overflow-wrap:break-word}\n#schedule .si-cat{margin:0;font-size:.85rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--j2-secondary)}\n@media (min-width:800px){\n#schedule{padding:var(--j2-section,64px) 32px}\n#schedule .tab-row{max-width:560px;gap:16px}\n#schedule .day-tab{font-size:1.05rem}\n#schedule .si-time{min-width:160px}\n}\n</style>\n<div class=\"sch-inner\">\n<h2>Schedule</h2>\n<p class=\"sch-intro\">Pick a day to see what is on.</p>\n<div class=\"tab-row\" role=\"tablist\" aria-label=\"Fest days\">\n<button type=\"button\" class=\"day-tab\" role=\"tab\" id=\"tab-day1\" aria-controls=\"panel-day1\" aria-selected=\"true\" data-day=\"1\">Day 1 14 Feb</button>\n<button type=\"button\" class=\"day-tab\" role=\"tab\" id=\"tab-day2\" aria-controls=\"panel-day2\" aria-selected=\"false\" tabindex=\"-1\" data-day=\"2\">Day 2 15 Feb</button>\n<button type=\"button\" class=\"day-tab\" role=\"tab\" id=\"tab-day3\" aria-controls=\"panel-day3\" aria-selected=\"false\" tabindex=\"-1\" data-day=\"3\">Day 3 16 Feb</button>\n</div>\n\n<div class=\"day-panel\" role=\"tabpanel\" id=\"panel-day1\" aria-labelledby=\"tab-day1\" data-day=\"1\">\n<ul class=\"sch-list\">\n<li class=\"schedule-item j2-card\">\n<span class=\"si-time\">10am-1pm</span>\n<div class=\"si-body\"><h3 class=\"si-name\">Code Sprint</h3><p class=\"si-cat\">Coding</p></div>\n</li>\n<li class=\"schedule-item j2-card\">\n<span class=\"si-time\">2pm-5pm</span>\n<div class=\"si-body\"><h3 class=\"si-name\">Line Follower</h3><p class=\"si-cat\">Robotics</p></div>\n</li>\n<li class=\"schedule-item j2-card\">\n<span class=\"si-time\">5:30pm-6:30pm</span>\n<div class=\"si-body\"><h3 class=\"si-name\">AI in Daily Life</h3><p class=\"si-cat\">Talks</p></div>\n</li>\n</ul>\n</div>\n\n<div class=\"day-panel\" role=\"tabpanel\" id=\"panel-day2\" aria-labelledby=\"tab-day2\" data-day=\"2\" hidden>\n<ul class=\"sch-list\">\n<li class=\"schedule-item j2-card\">\n<span class=\"si-time\">11am-1pm</span>\n<div class=\"si-body\"><h3 class=\"si-name\">Bug Hunt</h3><p class=\"si-cat\">Coding</p></div>\n</li>\n<li class=\"schedule-item j2-card\">\n<span class=\"si-time\">2pm-4pm</span>\n<div class=\"si-body\"><h3 class=\"si-name\">Poster Jam</h3><p class=\"si-cat\">Design</p></div>\n</li>\n</ul>\n</div>\n\n<div class=\"day-panel\" role=\"tabpanel\" id=\"panel-day3\" aria-labelledby=\"tab-day3\" data-day=\"3\" hidden>\n<ul class=\"sch-list\">\n<li class=\"schedule-item j2-card\">\n<span class=\"si-time\">10am-1pm</span>\n<div class=\"si-body\"><h3 class=\"si-name\">Drone Dash</h3><p class=\"si-cat\">Robotics</p></div>\n</li>\n<li class=\"schedule-item j2-card\">\n<span class=\"si-time\">2pm-5pm</span>\n<div class=\"si-body\"><h3 class=\"si-name\">UI Duel</h3><p class=\"si-cat\">Design</p></div>\n</li>\n<li class=\"schedule-item j2-card\">\n<span class=\"si-time\">5:30pm-6:30pm</span>\n<div class=\"si-body\"><h3 class=\"si-name\">Startup Stories</h3><p class=\"si-cat\">Talks</p></div>\n</li>\n</ul>\n</div>\n</div>\n<script>\n(function () {\n  var root = document.getElementById('schedule');\n  if (!root) return;\n  var tabs = Array.prototype.slice.call(root.querySelectorAll('.day-tab'));\n  var panels = Array.prototype.slice.call(root.querySelectorAll('.day-panel'));\n  function show(day, focus) {\n    tabs.forEach(function (t) {\n      var on = t.getAttribute('data-day') === day;\n      t.setAttribute('aria-selected', on ? 'true' : 'false');\n      t.setAttribute('tabindex', on ? '0' : '-1');\n      if (on && focus) t.focus();\n    });\n    panels.forEach(function (p) {\n      if (p.getAttribute('data-day') === day) p.removeAttribute('hidden');\n      else p.setAttribute('hidden', '');\n    });\n  }\n  tabs.forEach(function (t, i) {\n    t.addEventListener('click', function () { show(t.getAttribute('data-day'), false); });\n    t.addEventListener('keydown', function (e) {\n      var n = null;\n      if (e.key === 'ArrowRight') n = (i + 1) % tabs.length;\n      else if (e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;\n      if (n !== null) { e.preventDefault(); show(tabs[n].getAttribute('data-day'), true); }\n    });\n  });\n  show('1', false);\n})();\n</script>\n</section>",
    "workflow": "Day-by-day schedule"
  },
  "W-3": {
    "owner": "W-3",
    "head": "",
    "body": "<section id=\"events\">\n<style>\n#events{padding:var(--j2-section,64px) 20px}\n#events .ev-inner{max-width:1100px;margin:0 auto;min-width:0}\n#events h2{margin:0 0 8px;font-family:var(--j2-font-heading);font-size:clamp(2rem,8vw,3rem);line-height:1.1;font-weight:700;color:var(--j2-text)}\n#events .ev-intro{margin:0 0 24px;color:var(--j2-muted)}\n#events .filter-row{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px}\n#events .filter-btn{flex:1 1 auto;min-width:0;min-height:48px;padding:12px 16px;border:2px solid var(--j2-secondary);border-radius:var(--j2-radius);background:transparent;color:var(--j2-secondary);font-family:var(--j2-font-heading);font-size:.95rem;font-weight:700;line-height:1.2;cursor:pointer}\n#events .filter-btn[aria-pressed=\"true\"]{background:var(--j2-primary);border-color:var(--j2-primary);color:var(--j2-background)}\n#events .filter-btn:focus-visible{outline:3px solid var(--j2-accent);outline-offset:2px}\n#events .ev-count{margin:0 0 24px;font-size:.9rem;color:var(--j2-muted)}\n#events .ev-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:minmax(0,1fr);gap:16px}\n#events .event-card{display:flex;flex-direction:column;gap:8px;min-width:0;border-radius:var(--j2-radius);border-top:6px solid var(--j2-accent)}\n#events .event-card[hidden]{display:none}\n#events .ev-cat{margin:0;font-size:.85rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--j2-secondary)}\n#events .ev-name{margin:0;font-size:1.35rem;line-height:1.2;color:var(--j2-text);overflow-wrap:break-word}\n#events .ev-fee{margin:8px 0 0;font-family:var(--j2-font-heading);font-size:1.5rem;font-weight:700;color:var(--j2-primary)}\n@media (min-width:600px){\n#events .ev-grid{grid-template-columns:repeat(2,minmax(0,1fr))}\n#events .filter-btn{flex:0 0 auto;min-width:112px}\n}\n@media (min-width:800px){\n#events{padding:var(--j2-section,64px) 32px}\n}\n@media (min-width:1000px){\n#events .ev-grid{grid-template-columns:repeat(4,minmax(0,1fr))}\n}\n</style>\n<div class=\"ev-inner\">\n<h2>Events</h2>\n<p class=\"ev-intro\">Pick a category to see the events and their fees.</p>\n<div class=\"filter-row\" role=\"group\" aria-label=\"Filter events by category\">\n<button type=\"button\" class=\"filter-btn\" data-filter=\"All\" aria-pressed=\"true\">All</button>\n<button type=\"button\" class=\"filter-btn\" data-filter=\"Coding\" aria-pressed=\"false\">Coding</button>\n<button type=\"button\" class=\"filter-btn\" data-filter=\"Robotics\" aria-pressed=\"false\">Robotics</button>\n<button type=\"button\" class=\"filter-btn\" data-filter=\"Design\" aria-pressed=\"false\">Design</button>\n<button type=\"button\" class=\"filter-btn\" data-filter=\"Talks\" aria-pressed=\"false\">Talks</button>\n</div>\n<p class=\"ev-count\" id=\"ev-count\" aria-live=\"polite\">Showing 8 events</p>\n<ul class=\"ev-grid\">\n<li class=\"event-card j2-card\" data-category=\"Coding\">\n<p class=\"ev-cat\">Coding</p>\n<h3 class=\"ev-name\">Code Sprint</h3>\n<p class=\"ev-fee\">Rs 100</p>\n</li>\n<li class=\"event-card j2-card\" data-category=\"Coding\">\n<p class=\"ev-cat\">Coding</p>\n<h3 class=\"ev-name\">Bug Hunt</h3>\n<p class=\"ev-fee\">Rs 50</p>\n</li>\n<li class=\"event-card j2-card\" data-category=\"Robotics\">\n<p class=\"ev-cat\">Robotics</p>\n<h3 class=\"ev-name\">Line Follower</h3>\n<p class=\"ev-fee\">Rs 150</p>\n</li>\n<li class=\"event-card j2-card\" data-category=\"Robotics\">\n<p class=\"ev-cat\">Robotics</p>\n<h3 class=\"ev-name\">Drone Dash</h3>\n<p class=\"ev-fee\">Rs 200</p>\n</li>\n<li class=\"event-card j2-card\" data-category=\"Design\">\n<p class=\"ev-cat\">Design</p>\n<h3 class=\"ev-name\">Poster Jam</h3>\n<p class=\"ev-fee\">Free</p>\n</li>\n<li class=\"event-card j2-card\" data-category=\"Design\">\n<p class=\"ev-cat\">Design</p>\n<h3 class=\"ev-name\">UI Duel</h3>\n<p class=\"ev-fee\">Rs 100</p>\n</li>\n<li class=\"event-card j2-card\" data-category=\"Talks\">\n<p class=\"ev-cat\">Talks</p>\n<h3 class=\"ev-name\">AI in Daily Life</h3>\n<p class=\"ev-fee\">Free</p>\n</li>\n<li class=\"event-card j2-card\" data-category=\"Talks\">\n<p class=\"ev-cat\">Talks</p>\n<h3 class=\"ev-name\">Startup Stories</h3>\n<p class=\"ev-fee\">Free</p>\n</li>\n</ul>\n</div>\n<script>\n(function () {\n  var root = document.getElementById('events');\n  if (!root) return;\n  var buttons = Array.prototype.slice.call(root.querySelectorAll('.filter-btn'));\n  var cards = Array.prototype.slice.call(root.querySelectorAll('.event-card'));\n  var count = root.querySelector('#ev-count');\n  function apply(cat) {\n    var shown = 0;\n    buttons.forEach(function (b) {\n      b.setAttribute('aria-pressed', b.getAttribute('data-filter') === cat ? 'true' : 'false');\n    });\n    cards.forEach(function (c) {\n      var match = cat === 'All' || c.getAttribute('data-category') === cat;\n      if (match) { c.removeAttribute('hidden'); shown++; }\n      else { c.setAttribute('hidden', ''); }\n    });\n    if (count) count.textContent = 'Showing ' + shown + (shown === 1 ? ' event' : ' events');\n  }\n  buttons.forEach(function (b) {\n    b.addEventListener('click', function () { apply(b.getAttribute('data-filter')); });\n  });\n  apply('All');\n})();\n</script>\n</section>",
    "workflow": "Events by category"
  },
  "W-4": {
    "owner": "W-4",
    "head": "",
    "body": "<section id=\"register\">\n<style>\n#register{padding:var(--j2-section,64px) 20px}\n#register .reg-inner{max-width:720px;margin:0 auto;min-width:0}\n#register h2{margin:0 0 8px;font-family:var(--j2-font-heading);font-size:clamp(2rem,8vw,3rem);line-height:1.1;font-weight:700;color:var(--j2-text)}\n#register .reg-intro{margin:0 0 24px;color:var(--j2-muted)}\n#register .reg-form{display:grid;gap:20px;min-width:0;border-radius:var(--j2-radius);border-top:6px solid var(--j2-primary)}\n#register .reg-field{display:grid;gap:8px;min-width:0}\n#register label{font-family:var(--j2-font-heading);font-size:1rem;font-weight:700;color:var(--j2-text)}\n#register .reg-input{width:100%;min-width:0;min-height:48px;padding:12px 16px;border:2px solid var(--j2-muted);border-radius:var(--j2-radius);background:var(--j2-background);color:var(--j2-text);font-family:var(--j2-font-body);font-size:1rem;line-height:1.4}\n#register select.reg-input{appearance:auto}\n#register .reg-input:focus-visible{outline:3px solid var(--j2-accent);outline-offset:2px;border-color:var(--j2-secondary)}\n#register .reg-hp{display:none}\n#register .reg-submit{width:100%;border-radius:var(--j2-radius);font-family:var(--j2-font-heading);font-size:1.05rem}\n#register .reg-submit:focus-visible{outline:3px solid var(--j2-accent);outline-offset:2px}\n#register .reg-submit[disabled]{opacity:.6;cursor:not-allowed}\n#register .reg-status{margin:0;min-height:1.6em;font-weight:600;overflow-wrap:break-word}\n#register .reg-status[data-state=\"success\"]{color:var(--j2-secondary)}\n#register .reg-status[data-state=\"error\"]{color:var(--j2-accent)}\n#register .reg-note{margin:0;font-size:.9rem;color:var(--j2-muted);overflow-wrap:break-word}\n@media (min-width:800px){\n#register{padding:var(--j2-section,64px) 32px}\n#register .reg-submit{width:auto;justify-self:start;min-width:220px}\n}\n</style>\n<div class=\"reg-inner\">\n<h2>Register</h2>\n<p class=\"reg-intro\">Choose an event and send us your details. We receive them at spark2026@example.com.</p>\n<form class=\"reg-form j2-card\" id=\"reg-form\" method=\"post\" action=\"https://formsubmit.co/spark2026@example.com\">\n<div class=\"reg-field\">\n<label for=\"reg-name\">Name</label>\n<input class=\"reg-input\" type=\"text\" id=\"reg-name\" name=\"name\" autocomplete=\"name\" required>\n</div>\n<div class=\"reg-field\">\n<label for=\"reg-email\">Email</label>\n<input class=\"reg-input\" type=\"email\" id=\"reg-email\" name=\"email\" autocomplete=\"email\" required>\n</div>\n<div class=\"reg-field\">\n<label for=\"reg-college\">College</label>\n<input class=\"reg-input\" type=\"text\" id=\"reg-college\" name=\"college\" autocomplete=\"organization\" required>\n</div>\n<div class=\"reg-field\">\n<label for=\"reg-event\">Event</label>\n<select class=\"reg-input\" id=\"reg-event\" name=\"event\" required>\n<option value=\"\" selected disabled>Choose an event</option>\n<option class=\"event-option\" value=\"Code Sprint\">Code Sprint</option>\n<option class=\"event-option\" value=\"Bug Hunt\">Bug Hunt</option>\n<option class=\"event-option\" value=\"Line Follower\">Line Follower</option>\n<option class=\"event-option\" value=\"Drone Dash\">Drone Dash</option>\n<option class=\"event-option\" value=\"Poster Jam\">Poster Jam</option>\n<option class=\"event-option\" value=\"UI Duel\">UI Duel</option>\n<option class=\"event-option\" value=\"AI in Daily Life\">AI in Daily Life</option>\n<option class=\"event-option\" value=\"Startup Stories\">Startup Stories</option>\n</select>\n</div>\n<input class=\"reg-hp\" type=\"text\" name=\"_honey\" tabindex=\"-1\" autocomplete=\"off\" aria-hidden=\"true\">\n<button type=\"submit\" class=\"j2-btn reg-submit\" id=\"reg-submit\">Register now</button>\n<p class=\"reg-status\" id=\"reg-status\" role=\"status\" aria-live=\"polite\"></p>\n<p class=\"reg-note\">Prefer email? Write to spark2026@example.com.</p>\n</form>\n</div>\n<script>\n(function () {\n  var root = document.getElementById('register');\n  if (!root) return;\n  var form = root.querySelector('.reg-form');\n  var status = root.querySelector('#reg-status');\n  var submit = root.querySelector('#reg-submit');\n  if (!form || !status || !submit) return;\n  var ENDPOINT = 'https://formsubmit.co/ajax/spark2026@example.com';\n  function setStatus(state, text) {\n    status.setAttribute('data-state', state);\n    status.textContent = text;\n  }\n  form.addEventListener('submit', function (e) {\n    e.preventDefault();\n    if (!form.checkValidity()) {\n      if (form.reportValidity) form.reportValidity();\n      setStatus('error', 'Please fill in your name, email, college and event.');\n      return;\n    }\n    var payload = {\n      name: form.elements['name'].value.trim(),\n      email: form.elements['email'].value.trim(),\n      college: form.elements['college'].value.trim(),\n      event: form.elements['event'].value,\n      _subject: 'Spark 2026 registration: ' + form.elements['event'].value,\n      _honey: form.elements['_honey'].value\n    };\n    submit.disabled = true;\n    setStatus('', 'Sending your registration...');\n    fetch(ENDPOINT, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },\n      body: JSON.stringify(payload)\n    }).then(function (res) {\n      return res.json().catch(function () { return {}; }).then(function (data) {\n        var failed = !res.ok || data.success === false || data.success === 'false';\n        if (failed) throw new Error('send failed');\n        setStatus('success', 'Thanks ' + payload.name + '! Your registration for ' + payload.event + ' has been sent.');\n        form.reset();\n      });\n    }).catch(function () {\n      setStatus('error', 'Sorry, we could not send your registration. Please try again or email spark2026@example.com.');\n    }).then(function () {\n      submit.disabled = false;\n    });\n  });\n})();\n</script>\n</section>",
    "workflow": "Registration form"
  },
  "W-5": {
