    "body": "<section id=\"sponsors\">\n<style>\n#sponsors{padding:var(--j2-section,64px) 20px}\n#sponsors .sp-inner{max-width:1100px;margin:0 auto;min-width:0}\n#sponsors h2{margin:0 0 8px;font-family:var(--j2-font-heading);font-size:clamp(2rem,8vw,3rem);line-height:1.1;font-weight:700;color:var(--j2-text)}\n#sponsors .sp-intro{margin:0 0 24px;color:var(--j2-muted)}\n#sponsors .sp-list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:minmax(0,1fr);gap:16px}\n#sponsors .sp-item{min-width:0}\n#sponsors .sponsor-name{display:flex;align-items:center;justify-content:center;text-align:center;min-height:96px;min-width:0;margin:0;border-radius:var(--j2-radius);border-bottom:6px solid var(--j2-primary);font-family:var(--j2-font-heading);font-size:clamp(1.35rem,6vw,1.75rem);font-weight:700;line-height:1.2;color:var(--j2-text);overflow-wrap:break-word}\n#sponsors .sp-item:nth-child(2) .sponsor-name{border-bottom-color:var(--j2-secondary)}\n#sponsors .sp-item:nth-child(3) .sponsor-name{border-bottom-color:var(--j2-accent)}\n@media (min-width:600px){\n#sponsors .sp-list{grid-template-columns:repeat(3,minmax(0,1fr))}\n}\n@media (min-width:800px){\n#sponsors{padding:var(--j2-section,64px) 32px}\n}\n</style>\n<div class=\"sp-inner\">\n<h2>Sponsors</h2>\n<p class=\"sp-intro\">Spark 2026 is backed by these sponsors.</p>\n<ul class=\"sp-list\">\n<li class=\"sp-item\"><p class=\"sponsor-name j2-card\">Nimbus Cloud</p></li>\n<li class=\"sp-item\"><p class=\"sponsor-name j2-card\">Orbit Labs</p></li>\n<li class=\"sp-item\"><p class=\"sponsor-name j2-card\">Pixel Press</p></li>\n</ul>\n</div>\n</section>",
    "workflow": "Sponsors"
  },
