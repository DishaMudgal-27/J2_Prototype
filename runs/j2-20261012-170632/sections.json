    "body": "<section id=\"contact\" class=\"contact-section\" aria-labelledby=\"contact-title\">\n  <style>\n    #contact.contact-section {\n      box-sizing: border-box;\n      width: 100%;\n      padding: var(--j2-section) 20px;\n      background: var(--j2-background);\n      color: var(--j2-text);\n      font-family: var(--j2-font-body);\n    }\n    #contact .contact-inner {\n      max-width: 1100px;\n      margin: 0 auto;\n    }\n    #contact .contact-title {\n      margin: 0 0 var(--j2-space);\n      font-family: var(--j2-font-heading);\n      font-size: clamp(2rem, 8vw, 3rem);\n      line-height: 1.1;\n      font-weight: 700;\n      color: var(--j2-text);\n    }\n    #contact .contact-intro {\n      margin: 0 0 calc(var(--j2-space) * 3);\n      max-width: 36rem;\n      line-height: 1.6;\n      color: var(--j2-muted);\n    }\n    #contact .contact-grid {\n      display: grid;\n      grid-template-columns: minmax(0, 1fr);\n      gap: calc(var(--j2-space) * 3);\n      align-items: stretch;\n    }\n    #contact .contact-card {\n      box-sizing: border-box;\n      min-width: 0;\n      border-top: 4px solid var(--j2-primary);\n    }\n    #contact .contact-label {\n      margin: 0 0 var(--j2-space);\n      font-weight: 600;\n      font-size: 0.875rem;\n      letter-spacing: 0.04em;\n      text-transform: uppercase;\n      color: var(--j2-accent);\n    }\n    #contact .contact-heading {\n      margin: 0 0 var(--j2-space);\n      font-family: var(--j2-font-heading);\n      font-size: 1.5rem;\n      line-height: 1.2;\n      font-weight: 700;\n      color: var(--j2-text);\n    }\n    #contact .contact-detail {\n      margin: 0 0 var(--j2-space);\n      line-height: 1.6;\n      color: var(--j2-text);\n      overflow-wrap: anywhere;\n    }\n    #contact .contact-detail strong {\n      color: var(--j2-muted);\n      font-weight: 600;\n    }\n    #contact .contact-detail a {\n      color: var(--j2-accent);\n      font-weight: 600;\n    }\n    #contact .contact-actions {\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n      margin: calc(var(--j2-space) * 3) 0 0;\n    }\n    #contact .contact-actions a {\n      width: 100%;\n      min-height: 48px;\n    }\n    #contact .img-placeholder {\n      box-sizing: border-box;\n      width: 100%;\n      min-height: 220px;\n      aspect-ratio: 4 / 3;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      text-align: center;\n      padding: 16px;\n      border: 2px dashed var(--j2-secondary);\n      border-radius: var(--j2-radius);\n      background: var(--j2-surface);\n      color: var(--j2-muted);\n      font-size: 0.95rem;\n    }\n    @media (min-width: 700px) {\n      #contact .contact-actions { flex-direction: row; flex-wrap: wrap; }\n      #contact .contact-actions a { width: auto; }\n    }\n    @media (min-width: 900px) {\n      #contact.contact-section { padding-left: 32px; padding-right: 32px; }\n      #contact .contact-grid {\n        grid-template-columns: repeat(2, minmax(0, 1fr));\n        gap: calc(var(--j2-space) * 4);\n      }\n    }\n  </style>\n  <div class=\"contact-inner\">\n    <h2 id=\"contact-title\" class=\"contact-title\">Contact the organisers</h2>\n    <p class=\"contact-intro\">Questions about events, fees or registration? Message the Spark 2026 team on WhatsApp or send an email.</p>\n    <div class=\"contact-grid\">\n      <div class=\"contact-card j2-card\">\n        <p class=\"contact-label\">Get in touch</p>\n        <h3 class=\"contact-heading\">Chat with us on WhatsApp</h3>\n        <p class=\"contact-detail\"><strong>WhatsApp:</strong> +91 00000 33333</p>\n        <p class=\"contact-detail\"><strong>Email:</strong> <a href=\"mailto:spark2026@example.com\">spark2026@example.com</a></p>\n        <div class=\"contact-actions\">\n          <a class=\"j2-btn whatsapp-link\" href=\"https://wa.me/910000033333\" target=\"_blank\" rel=\"noopener noreferrer\">Chat on WhatsApp</a>\n        </div>\n      </div>\n      <div class=\"img-placeholder\" role=\"img\" aria-label=\"Photo placeholder: Spark 2026 organising team\">\n        Photo placeholder: Spark 2026 organising team\n      </div>\n    </div>\n  </div>\n</section>",
    "workflow": "WhatsApp and email contact"
  }
}