{
  "style": {
    "owner": "W-1",
    "head": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&amp;family=Inter:wght@400;600&amp;display=swap\"><style>:root{--j2-primary:#FF3D81;--j2-secondary:#7C4DFF;--j2-accent:#FFD60A;--j2-background:#0B0B1E;--j2-surface:#17173A;--j2-text:#FFFFFF;--j2-muted:#B8B8D9;--j2-font-heading:'Space Grotesk', 'Segoe UI', system-ui, sans-serif;--j2-font-body:'Inter', 'Segoe UI', system-ui, sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:16px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;background:#FFD60A;color:#0B0B1E;border:2px solid #FFD60A;font-weight:700;min-height:48px;padding:12px 24px;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer}.j2-btn-secondary{display:inline-block;background:transparent;color:#FFFFFF;border:2px solid #FF3D81;font-weight:700;min-height:48px;padding:12px 24px;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer}.j2-card{background:#17173A;border:1px solid #2C2C5E;border-radius:16px;padding:24px;color:#FFFFFF}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-1": {
    "owner": "W-1",
    "head": "",
    "body": "<section id=\"hero\" class=\"hero-banner\" aria-labelledby=\"hero-title\">\n  <style>\n    #hero.hero-banner {\n      position: relative;\n      overflow: hidden;\n      box-sizing: border-box;\n      width: 100%;\n      padding: 56px 20px 48px;\n      background:\n        radial-gradient(circle at 15% 10%, rgba(255, 61, 129, 0.35), transparent 45%),\n        radial-gradient(circle at 90% 85%, rgba(124, 77, 255, 0.40), transparent 50%),\n        #0B0B1E;\n      color: #FFFFFF;\n      font-family: var(--j2-font-body, 'Inter', system-ui, sans-serif);\n    }\n    #hero .hero-inner {\n      position: relative;\n      z-index: 1;\n      max-width: 1100px;\n      margin: 0 auto;\n      display: grid;\n      grid-template-columns: 1fr;\n      gap: 32px;\n      align-items: center;\n    }\n    #hero .hero-kicker {\n      display: inline-block;\n      margin: 0 0 16px;\n      padding: 6px 14px;\n      border-radius: 999px;\n      background: #17173A;\n      border: 1px solid #FF3D81;\n      color: #FFD60A;\n      font-weight: 600;\n      font-size: 0.875rem;\n      letter-spacing: 0.04em;\n      text-transform: uppercase;\n    }\n    #hero .hero-title {\n      margin: 0 0 12px;\n      font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif);\n      font-size: clamp(2.75rem, 13vw, 5.5rem);\n      line-height: 1;\n      font-weight: 700;\n      letter-spacing: -0.02em;\n      color: #FFFFFF;\n      overflow-wrap: anywhere;\n    }\n    #hero .hero-college {\n      margin: 0 0 8px;\n      font-size: clamp(1.05rem, 4.5vw, 1.5rem);\n      font-weight: 600;\n      color: #FFFFFF;\n    }\n    #hero .hero-dates {\n      margin: 0 0 16px;\n      font-family: var(--j2-font-heading, 'Space Grotesk', system-ui, sans-serif);\n      font-size: clamp(1.25rem, 5.5vw, 1.9rem);\n      font-weight: 700;\n      color: #FFD60A;\n    }\n    #hero .hero-tagline {\n      margin: 0 0 28px;\n      max-width: 36rem;\n      font-size: 1rem;\n      line-height: 1.6;\n      color: #B8B8D9;\n    }\n    #hero .hero-actions {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 12px;\n    }\n    #hero .hero-actions a {\n      min-height: 48px;\n    }\n    #hero .img-placeholder {\n      box-sizing: border-box;\n      width: 100%;\n      aspect-ratio: 4 / 3;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      text-align: center;\n      padding: 16px;\n      border: 2px dashed #7C4DFF;\n      border-radius: var(--j2-radius, 16px);\n      background: linear-gradient(135deg, #17173A, #231F5C);\n      color: #B8B8D9;\n      font-size: 0.95rem;\n    }\n    @media (min-width: 800px) {\n      #hero.hero-banner { padding: 88px 32px 80px; }\n      #hero .hero-inner { grid-template-columns: 1.1fr 0.9fr; gap: 48px; }\n    }\n  </style>\n  <div class=\"hero-inner\">\n    <div class=\"hero-copy\">\n      <p class=\"hero-kicker\">College tech fest</p>\n      <h1 id=\"hero-title\" class=\"hero-title\">Spark 2026</h1>\n      <p class=\"hero-college\">Northfield College of Engineering, Pune</p>\n      <p class=\"hero-dates\">14 to 16 February 2027</p>\n      <p class=\"hero-tagline\">Three days of coding, robotics, design and talks. See the schedule and register for your events.</p>\n      <div class=\"hero-actions\">\n        <a class=\"j2-btn\" href=\"#register\">Register now</a>\n        <a class=\"j2-btn j2-btn-secondary\" href=\"#schedule\">See the schedule</a>\n      </div>\n    </div>\n    <div class=\"img-placeholder\" role=\"img\" aria-label=\"Photo placeholder: Spark 2026 hero image\">\n      Photo placeholder: Spark 2026 hero image\n    </div>\n  </div>\n</section>",
    "workflow": "Hero and event identity"
  },
  "W-2": {
    "owner": "W-8",
    "head": "",
    "body": "<section id=\"schedule\" class=\"schedule-section\" aria-labelledby=\"schedule-title\">\n  <style>\n    #schedule.schedule-section {\n      box-sizing: border-box;\n      width: 100%;\n      padding: var(--j2-section) 20px;\n      background: var(--j2-background);\n      color: var(--j2-text);\n      font-family: var(--j2-font-body);\n    }\n    #schedule .schedule-inner {\n      max-width: 1100px;\n      margin: 0 auto;\n    }\n    #schedule .schedule-head {\n      margin: 0 0 calc(var(--j2-space) * 4);\n    }\n    #schedule .schedule-title {\n      margin: 0 0 var(--j2-space);\n      font-family: var(--j2-font-heading);\n      font-size: clamp(2rem, 8vw, 3rem);\n      line-height: 1.1;\n      font-weight: 700;\n      color: var(--j2-text);\n    }\n    #schedule .schedule-intro {\n      margin: 0;\n      max-width: 36rem;\n      line-height: 1.6;\n      color: var(--j2-muted);\n    }\n    #schedule .schedule-grid {\n      display: grid;\n      grid-template-columns: minmax(0, 1fr);\n      gap: calc(var(--j2-space) * 3);\n    }\n    #schedule .day-card {\n      box-sizing: border-box;\n      min-width: 0;\n      border-top: 4px solid var(--j2-primary);\n    }\n    #schedule .day-card.day-two { border-top-color: var(--j2-secondary); }\n    #schedule .day-card.day-three { border-top-color: var(--j2-accent); }\n    #schedule .day-head {\n      margin: 0 0 calc(var(--j2-space) * 2);\n    }\n    #schedule .day-label {\n      margin: 0;\n      font-family: var(--j2-font-heading);\n      font-size: 1.75rem;\n      line-height: 1.1;\n      font-weight: 700;\n      color: var(--j2-text);\n    }\n    #schedule .day-date {\n      margin: 4px 0 0;\n      font-weight: 600;\n      color: var(--j2-accent);\n    }\n    #schedule .event-list {\n      list-style: none;\n      margin: 0;\n      padding: 0;\n      display: grid;\n      gap: calc(var(--j2-space) * 2);\n    }\n    #schedule .event-item {\n      display: flex;\n      flex-direction: column;\n      gap: 4px;\n      padding: calc(var(--j2-space) * 2);\n      border-left: 3px solid var(--j2-primary);\n      border-radius: 0 calc(var(--j2-radius) / 2) calc(var(--j2-radius) / 2) 0;\n      background: var(--j2-background);\n      min-width: 0;\n    }\n    #schedule .day-two .event-item { border-left-color: var(--j2-secondary); }\n    #schedule .day-three .event-item { border-left-color: var(--j2-accent); }\n    #schedule .event-meta {\n      display: flex;\n      flex-wrap: wrap;\n      align-items: center;\n      justify-content: space-between;\n      gap: var(--j2-space);\n      min-width: 0;\n    }\n    #schedule .event-time {\n      font-weight: 600;\n      font-size: 0.9rem;\n      letter-spacing: 0.02em;\n      color: var(--j2-accent);\n    }\n    #schedule .fee-tag {\n      display: inline-block;\n      padding: 2px 12px;\n      border-radius: 999px;\n      border: 2px solid var(--j2-accent);\n      background: var(--j2-accent);\n      color: var(--j2-background);\n      font-weight: 700;\n      font-size: 0.85rem;\n      line-height: 1.5;\n      white-space: nowrap;\n    }\n    #schedule .fee-tag.fee-free {\n      background: transparent;\n      border-color: var(--j2-primary);\n      color: var(--j2-text);\n      text-transform: capitalize;\n    }\n    #schedule .event-name {\n      margin: 0;\n      font-family: var(--j2-font-heading);\n      font-size: 1.15rem;\n      font-weight: 700;\n      line-height: 1.25;\n      color: var(--j2-text);\n      overflow-wrap: anywhere;\n    }\n    #schedule .schedule-cta {\n      margin: calc(var(--j2-space) * 4) 0 0;\n    }\n    @media (min-width: 900px) {\n      #schedule.schedule-section { padding-left: 32px; padding-right: 32px; }\n      #schedule .schedule-grid {\n        grid-template-columns: repeat(3, minmax(0, 1fr));\n        gap: calc(var(--j2-space) * 3);\n        align-items: start;\n      }\n    }\n  </style>\n  <div class=\"schedule-inner\">\n    <div class=\"schedule-head\">\n      <h2 id=\"schedule-title\" class=\"schedule-title\">Schedule</h2>\n      <p class=\"schedule-intro\">Three days, eight events. Pick your day and plan your Spark 2026.</p>\n    </div>\n    <div class=\"schedule-grid\">\n      <article class=\"day-card j2-card day-one\" aria-labelledby=\"day1-label\">\n        <div class=\"day-head\">\n          <h3 id=\"day1-label\" class=\"day-label\">Day 1</h3>\n          <p class=\"day-date\">14 February 2027</p>\n        </div>\n        <ul class=\"event-list\">\n          <li class=\"event-item\">\n            <div class=\"event-meta\">\n              <span class=\"event-time\">10am to 1pm</span>\n              <span class=\"fee-tag\">Rs 100</span>\n            </div>\n            <h4 class=\"event-name\">Code Sprint</h4>\n          </li>\n          <li class=\"event-item\">\n            <div class=\"event-meta\">\n              <span class=\"event-time\">2pm to 5pm</span>\n              <span class=\"fee-tag\">Rs 150</span>\n            </div>\n            <h4 class=\"event-name\">Line Follower</h4>\n          </li>\n          <li class=\"event-item\">\n            <div class=\"event-meta\">\n              <span class=\"event-time\">5:30pm to 6:30pm</span>\n              <span class=\"fee-tag fee-free\">free</span>\n            </div>\n            <h4 class=\"event-name\">AI in Daily Life</h4>\n          </li>\n        </ul>\n      </article>\n      <article class=\"day-card j2-card day-two\" aria-labelledby=\"day2-label\">\n        <div class=\"day-head\">\n          <h3 id=\"day2-label\" class=\"day-label\">Day 2</h3>\n          <p class=\"day-date\">15 February 2027</p>\n        </div>\n        <ul class=\"event-list\">\n          <li class=\"event-item\">\n            <div class=\"event-meta\">\n              <span class=\"event-time\">11am to 1pm</span>\n              <span class=\"fee-tag\">Rs 50</span>\n            </div>\n            <h4 class=\"event-name\">Bug Hunt</h4>\n          </li>\n          <li class=\"event-item\">\n            <div class=\"event-meta\">\n              <span class=\"event-time\">2pm to 4pm</span>\n              <span class=\"fee-tag fee-free\">free</span>\n            </div>\n            <h4 class=\"event-name\">Poster Jam</h4>\n          </li>\n        </ul>\n      </article>\n      <article class=\"day-card j2-card day-three\" aria-labelledby=\"day3-label\">\n        <div class=\"day-head\">\n          <h3 id=\"day3-label\" class=\"day-label\">Day 3</h3>\n          <p class=\"day-date\">16 February 2027</p>\n        </div>\n        <ul class=\"event-list\">\n          <li class=\"event-item\">\n            <div class=\"event-meta\">\n              <span class=\"event-time\">10am to 1pm</span>\n              <span class=\"fee-tag\">Rs 200</span>\n            </div>\n            <h4 class=\"event-name\">Drone Dash</h4>\n          </li>\n          <li class=\"event-item\">\n            <div class=\"event-meta\">\n              <span class=\"event-time\">2pm to 5pm</span>\n              <span class=\"fee-tag\">Rs 100</span>\n            </div>\n            <h4 class=\"event-name\">UI Duel</h4>\n          </li>\n          <li class=\"event-item\">\n            <div class=\"event-meta\">\n              <span class=\"event-time\">5:30pm to 6:30pm</span>\n              <span class=\"fee-tag fee-free\">free</span>\n            </div>\n            <h4 class=\"event-name\">Startup Stories</h4>\n          </li>\n        </ul>\n      </article>\n    </div>\n    <p class=\"schedule-cta\">\n      <a class=\"j2-btn\" href=\"#register\">Register for an event</a>\n    </p>\n  </div>\n</section>",
    "workflow": "Event fees on schedule"
  },
  "W-3": {
    "owner": "W-3",
    "head": "",
    "body": "<section id=\"register\" class=\"register-section\" aria-labelledby=\"register-title\">\n  <style>\n    #register.register-section {\n      box-sizing: border-box;\n      width: 100%;\n      padding: var(--j2-section) 20px;\n      background: var(--j2-background);\n      color: var(--j2-text);\n      font-family: var(--j2-font-body);\n    }\n    #register .register-inner {\n      max-width: 640px;\n      margin: 0 auto;\n    }\n    #register .register-title {\n      margin: 0 0 var(--j2-space);\n      font-family: var(--j2-font-heading);\n      font-size: clamp(2rem, 8vw, 3rem);\n      line-height: 1.1;\n      font-weight: 700;\n      color: var(--j2-text);\n    }\n    #register .register-intro {\n      margin: 0 0 calc(var(--j2-space) * 3);\n      line-height: 1.6;\n      color: var(--j2-muted);\n    }\n    #register .register-card {\n      box-sizing: border-box;\n      min-width: 0;\n      border-top: 4px solid var(--j2-primary);\n    }\n    #register .reg-field {\n      margin: 0 0 calc(var(--j2-space) * 2);\n      min-width: 0;\n    }\n    #register .reg-field label {\n      display: block;\n      margin: 0 0 calc(var(--j2-space) * 0.75);\n      font-weight: 600;\n      color: var(--j2-text);\n    }\n    #register .reg-field input,\n    #register .reg-field select {\n      box-sizing: border-box;\n      display: block;\n      width: 100%;\n      max-width: 100%;\n      min-height: 48px;\n      padding: 12px 16px;\n      font-family: var(--j2-font-body);\n      font-size: 1rem;\n      color: var(--j2-text);\n      background: var(--j2-background);\n      border: 2px solid #2C2C5E;\n      border-radius: calc(var(--j2-radius) * 0.75);\n      color-scheme: dark;\n    }\n    #register .reg-field input::placeholder {\n      color: var(--j2-muted);\n    }\n    #register .reg-field input:focus,\n    #register .reg-field select:focus {\n      outline: 3px solid var(--j2-accent);\n      outline-offset: 2px;\n      border-color: var(--j2-accent);\n    }\n    #register .reg-field .reg-invalid {\n      border-color: var(--j2-primary);\n    }\n    #register .reg-submit {\n      width: 100%;\n      font-family: var(--j2-font-body);\n      font-size: 1rem;\n      margin-top: var(--j2-space);\n    }\n    #register .reg-submit:focus-visible {\n      outline: 3px solid var(--j2-text);\n      outline-offset: 2px;\n    }\n    #register .reg-status {\n      min-height: 1.5em;\n      margin: calc(var(--j2-space) * 2) 0 0;\n      line-height: 1.5;\n      color: var(--j2-accent);\n      font-weight: 600;\n    }\n    #register .reg-status.is-error {\n      color: var(--j2-primary);\n    }\n    #register .reg-note {\n      margin: calc(var(--j2-space) * 2) 0 0;\n      font-size: 0.95rem;\n      line-height: 1.6;\n      color: var(--j2-muted);\n      overflow-wrap: anywhere;\n    }\n    #register .reg-note a {\n      color: var(--j2-accent);\n      font-weight: 600;\n    }\n    @media (min-width: 900px) {\n      #register.register-section { padding-left: 32px; padding-right: 32px; }\n      #register .submit-wrap .reg-submit { width: auto; min-width: 240px; }\n    }\n  </style>\n  <div class=\"register-inner\">\n    <h2 id=\"register-title\" class=\"register-title\">Register for an event</h2>\n    <p class=\"register-intro\">Fill in your details and pick an event. Submitting opens an email to the organisers with your details filled in.</p>\n    <div class=\"register-card j2-card\">\n      <form id=\"reg-form\" action=\"mailto:spark2026@example.com\" method=\"post\" enctype=\"text/plain\" novalidate>\n        <div class=\"reg-field\">\n          <label for=\"reg-name\">Name</label>\n          <input id=\"reg-name\" name=\"name\" type=\"text\" autocomplete=\"name\" placeholder=\"Your full name\" required>\n        </div>\n        <div class=\"reg-field\">\n          <label for=\"reg-email\">Email</label>\n          <input id=\"reg-email\" name=\"email\" type=\"email\" autocomplete=\"email\" inputmode=\"email\" placeholder=\"you@example.com\" required>\n        </div>\n        <div class=\"reg-field\">\n          <label for=\"reg-college\">College</label>\n          <input id=\"reg-college\" name=\"college\" type=\"text\" autocomplete=\"organization\" placeholder=\"Your college\" required>\n        </div>\n        <div class=\"reg-field\">\n          <label for=\"reg-event\">Event</label>\n          <select id=\"reg-event\" name=\"event\" required>\n            <option value=\"\">Choose an event</option>\n            <option class=\"event-option\" value=\"Code Sprint\">Code Sprint</option>\n            <option class=\"event-option\" value=\"Bug Hunt\">Bug Hunt</option>\n            <option class=\"event-option\" value=\"Line Follower\">Line Follower</option>\n            <option class=\"event-option\" value=\"Drone Dash\">Drone Dash</option>\n            <option class=\"event-option\" value=\"Poster Jam\">Poster Jam</option>\n            <option class=\"event-option\" value=\"UI Duel\">UI Duel</option>\n            <option class=\"event-option\" value=\"AI in Daily Life\">AI in Daily Life</option>\n            <option class=\"event-option\" value=\"Startup Stories\">Startup Stories</option>\n          </select>\n        </div>\n        <div class=\"submit-wrap\">\n          <button type=\"submit\" class=\"j2-btn reg-submit\">Send registration</button>\n        </div>\n        <p id=\"reg-status\" class=\"reg-status\" role=\"status\" aria-live=\"polite\"></p>\n      </form>\n      <p class=\"reg-note\">Registrations go to <a href=\"mailto:spark2026@example.com\">spark2026@example.com</a>. If your email app does not open, send the same details to that address.</p>\n    </div>\n  </div>\n  <script>\n    (function () {\n      var form = document.getElementById('reg-form');\n      if (!form) { return; }\n      var status = document.getElementById('reg-status');\n      var fields = ['reg-name', 'reg-email', 'reg-college', 'reg-event'];\n\n      function setStatus(message, isError) {\n        if (!status) { return; }\n        status.textContent = message;\n        status.className = 'reg-status' + (isError ? ' is-error' : '');\n      }\n\n      form.addEventListener('submit', function (e) {\n        e.preventDefault();\n        var values = {};\n        var firstBad = null;\n        fields.forEach(function (id) {\n          var el = document.getElementById(id);\n          if (!el) { return; }\n          var v = (el.value || '').trim();\n          values[id] = v;\n          var bad = !v;\n          if (id === 'reg-email' && v && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)) { bad = true; }\n          el.classList.toggle('reg-invalid', bad);\n          if (bad && !firstBad) { firstBad = el; }\n        });\n        if (firstBad) {\n          setStatus('Please fill in every field with valid details.', true);\n          firstBad.focus();\n          return;\n        }\n        var subject = 'Spark 2026 registration: ' + values['reg-event'];\n        var body = 'Name: ' + values['reg-name'] + '\\n' +\n                   'Email: ' + values['reg-email'] + '\\n' +\n                   'College: ' + values['reg-college'] + '\\n' +\n                   'Event: ' + values['reg-event'];\n        var href = 'mailto:spark2026@example.com?subject=' + encodeURIComponent(subject) +\n                   '&body=' + encodeURIComponent(body);\n        setStatus('Opening your email app. Press send there to complete your registration.', false);\n        window.location.href = href;\n      });\n    })();\n  </script>\n</section>",
    "workflow": "Registration form"
  },
  "W-4": {
    "owner": "W-4",
    "head": "<style id=\"site-style\">\n  :root { --site-nav-h: 56px; }\n  *, *::before, *::after { box-sizing: border-box; }\n  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }\n  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }\n  body {\n    min-width: 0;\n    padding-top: var(--site-nav-h);\n    line-height: 1.5;\n    overflow-wrap: break-word;\n  }\n  img, svg, video { max-width: 100%; height: auto; }\n  section[id] { scroll-margin-top: var(--site-nav-h); }\n  section { max-width: 100%; }\n  h1, h2, h3, h4 { overflow-wrap: anywhere; }\n  a { color: var(--j2-accent); }\n  .j2-btn, .j2-btn-secondary { max-width: 100%; text-align: center; }\n  .j2-btn:hover { background: var(--j2-text); border-color: var(--j2-text); }\n  .j2-btn-secondary:hover { background: var(--j2-primary); }\n  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible {\n    outline: 3px solid var(--j2-accent);\n    outline-offset: 2px;\n  }\n\n  .site-nav {\n    position: fixed;\n    top: 0;\n    left: 0;\n    right: 0;\n    z-index: 100;\n    height: var(--site-nav-h);\n    background: var(--j2-surface);\n    border-bottom: 2px solid var(--j2-primary);\n    font-family: var(--j2-font-body);\n  }\n  .site-nav .site-nav-inner {\n    height: 100%;\n    max-width: 1100px;\n    margin: 0 auto;\n    padding: 0 12px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: var(--j2-space);\n  }\n  .site-nav .site-nav-brand {\n    font-family: var(--j2-font-heading);\n    font-weight: 700;\n    font-size: 1.15rem;\n    color: var(--j2-text);\n    text-decoration: none;\n    white-space: nowrap;\n  }\n  .site-nav .site-nav-links {\n    display: flex;\n    align-items: center;\n    gap: calc(var(--j2-space) / 2);\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n  .site-nav .site-nav-links a {\n    display: inline-flex;\n    align-items: center;\n    min-height: 44px;\n    padding: 0 12px;\n    border-radius: 999px;\n    font-weight: 600;\n    font-size: 0.95rem;\n    color: var(--j2-text);\n    text-decoration: none;\n  }\n  .site-nav .site-nav-links a:hover { background: var(--j2-secondary); }\n  .site-nav .site-nav-links a.site-nav-cta {\n    background: var(--j2-accent);\n    color: var(--j2-background);\n    font-weight: 700;\n  }\n  .site-nav .site-nav-links a.site-nav-cta:hover {\n    background: var(--j2-text);\n  }\n\n  @media (min-width: 900px) {\n    :root { --site-nav-h: 64px; }\n    .site-nav .site-nav-inner { padding: 0 32px; }\n    .site-nav .site-nav-brand { font-size: 1.35rem; }\n    .site-nav .site-nav-links { gap: var(--j2-space); }\n    .site-nav .site-nav-links a { padding: 0 20px; font-size: 1rem; }\n  }\n</style>",
    "body": "<nav class=\"site-nav\" aria-label=\"Main\">\n  <div class=\"site-nav-inner\">\n    <a class=\"site-nav-brand\" href=\"#hero\">Spark 2026</a>\n    <ul class=\"site-nav-links\">\n      <li><a href=\"#schedule\">Schedule</a></li>\n      <li><a class=\"site-nav-cta\" href=\"#register\">Register</a></li>\n    </ul>\n  </div>\n</nav>",
    "workflow": "Base styling and page health"
  },
  "W-5": {
    "owner": "W-5",
    "head": "",
    "body": "<section id=\"categories\" class=\"categories-section\" aria-labelledby=\"categories-title\">\n  <style>\n    #categories.categories-section {\n      box-sizing: border-box;\n      width: 100%;\n      padding: var(--j2-section) 20px;\n      background: var(--j2-background);\n      color: var(--j2-text);\n      font-family: var(--j2-font-body);\n    }\n    #categories .categories-inner {\n      max-width: 1100px;\n      margin: 0 auto;\n    }\n    #categories .categories-title {\n      margin: 0 0 var(--j2-space);\n      font-family: var(--j2-font-heading);\n      font-size: clamp(2rem, 8vw, 3rem);\n      line-height: 1.1;\n      font-weight: 700;\n      color: var(--j2-text);\n    }\n    #categories .categories-intro {\n      margin: 0 0 calc(var(--j2-space) * 3);\n      max-width: 36rem;\n      line-height: 1.6;\n      color: var(--j2-muted);\n    }\n    #categories .img-placeholder {\n      box-sizing: border-box;\n      width: 100%;\n      aspect-ratio: 16 / 7;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      text-align: center;\n      padding: 16px;\n      margin: 0 0 calc(var(--j2-space) * 4);\n      border: 2px dashed var(--j2-secondary);\n      border-radius: var(--j2-radius);\n      background: var(--j2-surface);\n      color: var(--j2-muted);\n      font-size: 0.95rem;\n    }\n    #categories .category-grid {\n      display: grid;\n      grid-template-columns: minmax(0, 1fr);\n      gap: calc(var(--j2-space) * 3);\n    }\n    #categories .category-group {\n      box-sizing: border-box;\n      min-width: 0;\n      border-top: 4px solid var(--j2-primary);\n    }\n    #categories .category-group.cat-robotics { border-top-color: var(--j2-secondary); }\n    #categories .category-group.cat-design { border-top-color: var(--j2-accent); }\n    #categories .category-group.cat-talks { border-top-color: var(--j2-primary); }\n    #categories .category-name {\n      margin: 0 0 calc(var(--j2-space) * 2);\n      font-family: var(--j2-font-heading);\n      font-size: 1.75rem;\n      line-height: 1.1;\n      font-weight: 700;\n      color: var(--j2-text);\n    }\n    #categories .event-cards {\n      list-style: none;\n      margin: 0;\n      padding: 0;\n      display: grid;\n      gap: calc(var(--j2-space) * 2);\n    }\n    #categories .event-card {\n      display: flex;\n      flex-direction: column;\n      gap: 4px;\n      min-width: 0;\n      padding: calc(var(--j2-space) * 2);\n      border-left: 3px solid var(--j2-primary);\n      border-radius: 0 calc(var(--j2-radius) / 2) calc(var(--j2-radius) / 2) 0;\n      background: var(--j2-background);\n    }\n    #categories .cat-robotics .event-card { border-left-color: var(--j2-secondary); }\n    #categories .cat-design .event-card { border-left-color: var(--j2-accent); }\n    #categories .event-card-name {\n      margin: 0;\n      font-family: var(--j2-font-heading);\n      font-size: 1.15rem;\n      font-weight: 700;\n      line-height: 1.25;\n      color: var(--j2-text);\n      overflow-wrap: anywhere;\n    }\n    #categories .event-card-when {\n      font-weight: 600;\n      font-size: 0.9rem;\n      letter-spacing: 0.02em;\n      color: var(--j2-accent);\n    }\n    #categories .categories-cta {\n      margin: calc(var(--j2-space) * 4) 0 0;\n    }\n    @media (min-width: 700px) {\n      #categories .category-grid {\n        grid-template-columns: repeat(2, minmax(0, 1fr));\n        align-items: start;\n      }\n    }\n    @media (min-width: 900px) {\n      #categories.categories-section { padding-left: 32px; padding-right: 32px; }\n    }\n  </style>\n  <div class=\"categories-inner\">\n    <h2 id=\"categories-title\" class=\"categories-title\">Events by category</h2>\n    <p class=\"categories-intro\">Find your thing. Eight events across four categories: Coding, Robotics, Design and Talks.</p>\n    <div class=\"img-placeholder\" role=\"img\" aria-label=\"Photo placeholder: Spark 2026 events\">\n      Photo placeholder: Spark 2026 events\n    </div>\n    <div class=\"category-grid\">\n      <article class=\"category-group j2-card cat-coding\" aria-labelledby=\"cat-coding-name\">\n        <h3 id=\"cat-coding-name\" class=\"category-name\">Coding</h3>\n        <ul class=\"event-cards\">\n          <li class=\"event-card\">\n            <h4 class=\"event-card-name\">Code Sprint</h4>\n            <span class=\"event-card-when\">Day 1, 10am to 1pm</span>\n          </li>\n          <li class=\"event-card\">\n            <h4 class=\"event-card-name\">Bug Hunt</h4>\n            <span class=\"event-card-when\">Day 2, 11am to 1pm</span>\n          </li>\n        </ul>\n      </article>\n      <article class=\"category-group j2-card cat-robotics\" aria-labelledby=\"cat-robotics-name\">\n        <h3 id=\"cat-robotics-name\" class=\"category-name\">Robotics</h3>\n        <ul class=\"event-cards\">\n          <li class=\"event-card\">\n            <h4 class=\"event-card-name\">Line Follower</h4>\n            <span class=\"event-card-when\">Day 1, 2pm to 5pm</span>\n          </li>\n          <li class=\"event-card\">\n            <h4 class=\"event-card-name\">Drone Dash</h4>\n            <span class=\"event-card-when\">Day 3, 10am to 1pm</span>\n          </li>\n        </ul>\n      </article>\n      <article class=\"category-group j2-card cat-design\" aria-labelledby=\"cat-design-name\">\n        <h3 id=\"cat-design-name\" class=\"category-name\">Design</h3>\n        <ul class=\"event-cards\">\n          <li class=\"event-card\">\n            <h4 class=\"event-card-name\">Poster Jam</h4>\n            <span class=\"event-card-when\">Day 2, 2pm to 4pm</span>\n          </li>\n          <li class=\"event-card\">\n            <h4 class=\"event-card-name\">UI Duel</h4>\n            <span class=\"event-card-when\">Day 3, 2pm to 5pm</span>\n          </li>\n        </ul>\n      </article>\n      <article class=\"category-group j2-card cat-talks\" aria-labelledby=\"cat-talks-name\">\n        <h3 id=\"cat-talks-name\" class=\"category-name\">Talks</h3>\n        <ul class=\"event-cards\">\n          <li class=\"event-card\">\n            <h4 class=\"event-card-name\">AI in Daily Life</h4>\n            <span class=\"event-card-when\">Day 1, 5:30pm to 6:30pm</span>\n          </li>\n          <li class=\"event-card\">\n            <h4 class=\"event-card-name\">Startup Stories</h4>\n            <span class=\"event-card-when\">Day 3, 5:30pm to 6:30pm</span>\n          </li>\n        </ul>\n      </article>\n    </div>\n    <p class=\"categories-cta\">\n      <a class=\"j2-btn\" href=\"#register\">Register for an event</a>\n    </p>\n  </div>\n</section>",
    "workflow": "Events by category"
  },
  "W-6": {
    "owner": "W-6",
    "head": "",
    "body": "<section id=\"venue\" class=\"venue-section\" aria-labelledby=\"venue-title\">\n  <style>\n    #venue.venue-section {\n      box-sizing: border-box;\n      width: 100%;\n      padding: var(--j2-section) 20px;\n      background: var(--j2-background);\n      color: var(--j2-text);\n      font-family: var(--j2-font-body);\n    }\n    #venue .venue-inner {\n      max-width: 1100px;\n      margin: 0 auto;\n    }\n    #venue .venue-title {\n      margin: 0 0 var(--j2-space);\n      font-family: var(--j2-font-heading);\n      font-size: clamp(2rem, 8vw, 3rem);\n      line-height: 1.1;\n      font-weight: 700;\n      color: var(--j2-text);\n    }\n    #venue .venue-intro {\n      margin: 0 0 calc(var(--j2-space) * 3);\n      max-width: 36rem;\n      line-height: 1.6;\n      color: var(--j2-muted);\n    }\n    #venue .venue-grid {\n      display: grid;\n      grid-template-columns: minmax(0, 1fr);\n      gap: calc(var(--j2-space) * 3);\n      align-items: stretch;\n    }\n    #venue .venue-card {\n      box-sizing: border-box;\n      min-width: 0;\n      border-top: 4px solid var(--j2-accent);\n    }\n    #venue .venue-label {\n      margin: 0 0 var(--j2-space);\n      font-weight: 600;\n      font-size: 0.875rem;\n      letter-spacing: 0.04em;\n      text-transform: uppercase;\n      color: var(--j2-accent);\n    }\n    #venue .venue-college {\n      margin: 0 0 var(--j2-space);\n      font-family: var(--j2-font-heading);\n      font-size: 1.5rem;\n      line-height: 1.2;\n      font-weight: 700;\n      color: var(--j2-text);\n      overflow-wrap: anywhere;\n    }\n    #venue .venue-address {\n      margin: 0 0 calc(var(--j2-space) * 3);\n      font-style: normal;\n      font-size: 1.1rem;\n      line-height: 1.6;\n      color: var(--j2-text);\n      overflow-wrap: anywhere;\n    }\n    #venue .venue-card .map-link {\n      max-width: 100%;\n      width: 100%;\n    }\n    #venue .img-placeholder {\n      box-sizing: border-box;\n      width: 100%;\n      min-height: 220px;\n      aspect-ratio: 4 / 3;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      text-align: center;\n      padding: 16px;\n      border: 2px dashed var(--j2-secondary);\n      border-radius: var(--j2-radius);\n      background: var(--j2-surface);\n      color: var(--j2-muted);\n      font-size: 0.95rem;\n    }\n    @media (min-width: 700px) {\n      #venue .venue-card .map-link { width: auto; }\n    }\n    @media (min-width: 900px) {\n      #venue.venue-section { padding-left: 32px; padding-right: 32px; }\n      #venue .venue-grid {\n        grid-template-columns: repeat(2, minmax(0, 1fr));\n        gap: calc(var(--j2-space) * 4);\n      }\n    }\n  </style>\n  <div class=\"venue-inner\">\n    <h2 id=\"venue-title\" class=\"venue-title\">Venue</h2>\n    <p class=\"venue-intro\">Spark 2026 takes place at our college campus in Pune. Open the map to get directions from where you are.</p>\n    <div class=\"venue-grid\">\n      <div class=\"venue-card j2-card\">\n        <p class=\"venue-label\">Find us here</p>\n        <h3 class=\"venue-college\">Northfield College of Engineering</h3>\n        <address class=\"venue-address\">22 University Road, Pune 411007</address>\n        <a class=\"j2-btn map-link\" href=\"https://www.google.com/maps/search/?api=1&amp;query=Northfield%20College%20of%20Engineering%2C%2022%20University%20Road%2C%20Pune%20411007\" target=\"_blank\" rel=\"noopener noreferrer\">Open in map</a>\n      </div>\n      <div class=\"img-placeholder\" role=\"img\" aria-label=\"Photo placeholder: Northfield College of Engineering campus\">\n        Photo placeholder: Northfield College of Engineering campus\n      </div>\n    </div>\n  </div>\n</section>",
    "workflow": "Venue and map link"
  },
  "W-7": {
