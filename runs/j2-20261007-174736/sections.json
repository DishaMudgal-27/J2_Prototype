{
  "W-1": {
    "owner": "W-4",
    "head": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
    "body": "<section id=\"w1\" class=\"w1-root\" aria-labelledby=\"w1-title\">\n<style>\n#w1, #w1 * { box-sizing: border-box; }\n#w1 { font-family: Georgia, \"Times New Roman\", serif; color: #2b2b2b; background: #fffaf7; width: 100%; overflow-x: hidden; }\n#w1 .w1-header { background: #f9e3e6; text-align: center; padding: 40px 16px 32px; border-bottom: 1px solid #efc9cf; }\n#w1 .w1-header h1 { margin: 0 0 8px; font-size: 2.2rem; line-height: 1.15; color: #8a2f45; overflow-wrap: anywhere; }\n#w1 .w1-header p { margin: 0; font-size: 1.1rem; color: #5a4046; }\n#w1 .w1-wrap { max-width: 1100px; margin: 0 auto; padding: 32px 16px; }\n#w1 .w1-wrap h2 { margin: 0 0 20px; font-size: 1.5rem; color: #8a2f45; text-align: center; }\n#w1 .w1-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); }\n#w1 .w1-card { background: #fff; border: 1px solid #ecd9dc; border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; min-width: 0; }\n#w1 .w1-photo { aspect-ratio: 4 / 3; width: 100%; background: #f6eef0; border-bottom: 2px dashed #d7b3ba; display: flex; align-items: center; justify-content: center; color: #8d6f76; font-size: 0.9rem; text-align: center; padding: 8px; }\n#w1 .w1-body { padding: 14px 16px 18px; }\n#w1 .w1-body h3 { margin: 0 0 6px; font-size: 1.1rem; overflow-wrap: anywhere; }\n#w1 .w1-price { margin: 0; font-size: 1.25rem; font-weight: bold; color: #8a2f45; }\n@media (min-width: 900px) {\n  #w1 .w1-header { padding: 56px 24px 44px; }\n  #w1 .w1-header h1 { font-size: 3rem; }\n}\n</style>\n\n<header class=\"w1-header\">\n  <h1 id=\"w1-title\">Petal &amp; Stem</h1>\n  <p>A flower shop in Jaipur</p>\n</header>\n\n<div class=\"w1-wrap\">\n  <h2>Our bouquets</h2>\n  <ul class=\"w1-grid\">\n    <li class=\"w1-card\">\n      <div class=\"w1-photo\" role=\"img\" aria-label=\"Photo of Red rose dozen to be added\">Photo coming soon</div>\n      <div class=\"w1-body\">\n        <h3>Red rose dozen</h3>\n        <p class=\"w1-price\">₹899</p>\n      </div>\n    </li>\n    <li class=\"w1-card\">\n      <div class=\"w1-photo\" role=\"img\" aria-label=\"Photo of Sunflower bunch to be added\">Photo coming soon</div>\n      <div class=\"w1-body\">\n        <h3>Sunflower bunch</h3>\n        <p class=\"w1-price\">₹699</p>\n      </div>\n    </li>\n    <li class=\"w1-card\">\n      <div class=\"w1-photo\" role=\"img\" aria-label=\"Photo of Mixed seasonal to be added\">Photo coming soon</div>\n      <div class=\"w1-body\">\n        <h3>Mixed seasonal</h3>\n        <p class=\"w1-price\">₹999</p>\n      </div>\n    </li>\n    <li class=\"w1-card\">\n      <div class=\"w1-photo\" role=\"img\" aria-label=\"Photo of White lilies to be added\">Photo coming soon</div>\n      <div class=\"w1-body\">\n        <h3>White lilies</h3>\n        <p class=\"w1-price\">₹1,199</p>\n      </div>\n    </li>\n    <li class=\"w1-card\">\n      <div class=\"w1-photo\" role=\"img\" aria-label=\"Photo of Orchid box to be added\">Photo coming soon</div>\n      <div class=\"w1-body\">\n        <h3>Orchid box</h3>\n        <p class=\"w1-price\">₹1,499</p>\n      </div>\n    </li>\n  </ul>\n</div>\n</section>",
    "workflow": "Add mobile viewport declaration"
  },
  "W-2": {
    "owner": "W-2",
    "head": "",
    "body": "<section id=\"w2\" class=\"w2-root\" aria-labelledby=\"w2-title\">\n<style>\n#w2, #w2 * { box-sizing: border-box; }\n#w2 { font-family: Georgia, \"Times New Roman\", serif; color: #2b2b2b; background: #fff; width: 100%; overflow-x: hidden; border-top: 1px solid #ecd9dc; }\n#w2 .w2-wrap { max-width: 640px; margin: 0 auto; padding: 32px 16px 40px; }\n#w2 h2 { margin: 0 0 8px; font-size: 1.5rem; color: #8a2f45; text-align: center; }\n#w2 .w2-intro { margin: 0 0 20px; text-align: center; color: #5a4046; }\n#w2 .w2-terms { background: #f9e3e6; border: 1px solid #efc9cf; border-radius: 12px; padding: 14px 16px; margin: 0 0 24px; color: #5a4046; overflow-wrap: anywhere; }\n#w2 .w2-terms p { margin: 0; }\n#w2 form { display: block; }\n#w2 .w2-field { margin: 0 0 16px; }\n#w2 label { display: block; margin: 0 0 6px; font-weight: bold; color: #2b2b2b; }\n#w2 select, #w2 input, #w2 textarea { display: block; width: 100%; max-width: 100%; font: inherit; font-size: 16px; padding: 10px 12px; border: 1px solid #d7b3ba; border-radius: 8px; background: #fff; color: #2b2b2b; }\n#w2 textarea { min-height: 96px; resize: vertical; }\n#w2 select:focus, #w2 input:focus, #w2 textarea:focus, #w2 button:focus-visible, #w2 a:focus-visible { outline: 3px solid #c9708a; outline-offset: 1px; }\n#w2 .w2-invalid { border-color: #b3261e; background: #fff6f5; }\n#w2 .w2-error { margin: 6px 0 0; color: #b3261e; font-size: 0.9rem; min-height: 0; }\n#w2 .w2-error:empty { display: none; }\n#w2 button { width: 100%; font: inherit; font-size: 1.05rem; font-weight: bold; padding: 14px 16px; border: 0; border-radius: 10px; background: #8a2f45; color: #fff; cursor: pointer; }\n#w2 button:hover { background: #722639; }\n#w2 .w2-status { margin: 16px 0 0; text-align: center; color: #5a4046; overflow-wrap: anywhere; }\n#w2 .w2-status:empty { display: none; }\n#w2 .w2-status a { color: #8a2f45; font-weight: bold; }\n@media (min-width: 900px) {\n  #w2 .w2-wrap { padding: 48px 24px 56px; }\n  #w2 h2 { font-size: 1.8rem; }\n}\n</style>\n\n<div class=\"w2-wrap\" id=\"order\">\n  <h2 id=\"w2-title\">Order a bouquet for delivery</h2>\n  <p class=\"w2-intro\">Fill in the form and your order opens as a WhatsApp message to the shop.</p>\n\n  <div class=\"w2-terms\">\n    <p>Delivery: same day delivery inside Jaipur for orders placed before 4pm, ₹99 delivery charge, pay on delivery.</p>\n  </div>\n\n  <form id=\"w2-form\" novalidate>\n    <div class=\"w2-field\">\n      <label for=\"w2-bouquet\">Bouquet</label>\n      <select id=\"w2-bouquet\" name=\"bouquet\" required aria-describedby=\"w2-err-bouquet\">\n        <option value=\"\">Choose a bouquet</option>\n        <option value=\"Red rose dozen\">Red rose dozen (₹899)</option>\n        <option value=\"Sunflower bunch\">Sunflower bunch (₹699)</option>\n        <option value=\"Mixed seasonal\">Mixed seasonal (₹999)</option>\n        <option value=\"White lilies\">White lilies (₹1,199)</option>\n        <option value=\"Orchid box\">Orchid box (₹1,499)</option>\n      </select>\n      <p class=\"w2-error\" id=\"w2-err-bouquet\" aria-live=\"polite\"></p>\n    </div>\n\n    <div class=\"w2-field\">\n      <label for=\"w2-name\">Your name</label>\n      <input type=\"text\" id=\"w2-name\" name=\"name\" autocomplete=\"name\" required aria-describedby=\"w2-err-name\">\n      <p class=\"w2-error\" id=\"w2-err-name\" aria-live=\"polite\"></p>\n    </div>\n\n    <div class=\"w2-field\">\n      <label for=\"w2-phone\">Your phone number</label>\n      <input type=\"tel\" id=\"w2-phone\" name=\"phone\" inputmode=\"tel\" autocomplete=\"tel\" required aria-describedby=\"w2-err-phone\">\n      <p class=\"w2-error\" id=\"w2-err-phone\" aria-live=\"polite\"></p>\n    </div>\n\n    <div class=\"w2-field\">\n      <label for=\"w2-address\">Delivery address</label>\n      <textarea id=\"w2-address\" name=\"address\" autocomplete=\"street-address\" required aria-describedby=\"w2-err-address\"></textarea>\n      <p class=\"w2-error\" id=\"w2-err-address\" aria-live=\"polite\"></p>\n    </div>\n\n    <button type=\"submit\">Send order on WhatsApp</button>\n    <p class=\"w2-status\" id=\"w2-status\" aria-live=\"polite\"></p>\n  </form>\n</div>\n\n<script>\n(function () {\n  var form = document.getElementById(\"w2-form\");\n  if (!form) { return; }\n  var status = document.getElementById(\"w2-status\");\n  var WA_NUMBER = \"919829011223\";\n  var fields = [\n    { id: \"w2-bouquet\", err: \"w2-err-bouquet\", msg: \"Please choose a bouquet.\" },\n    { id: \"w2-name\", err: \"w2-err-name\", msg: \"Please enter your name.\" },\n    { id: \"w2-phone\", err: \"w2-err-phone\", msg: \"Please enter your phone number.\" },\n    { id: \"w2-address\", err: \"w2-err-address\", msg: \"Please enter the delivery address.\" }\n  ];\n\n  function clearErrors() {\n    fields.forEach(function (f) {\n      var el = document.getElementById(f.id);\n      el.classList.remove(\"w2-invalid\");\n      el.removeAttribute(\"aria-invalid\");\n      document.getElementById(f.err).textContent = \"\";\n    });\n    status.textContent = \"\";\n  }\n\n  form.addEventListener(\"submit\", function (e) {\n    e.preventDefault();\n    clearErrors();\n\n    var firstBad = null;\n    var values = {};\n    fields.forEach(function (f) {\n      var el = document.getElementById(f.id);\n      var v = (el.value || \"\").trim();\n      values[f.id] = v;\n      if (!v) {\n        el.classList.add(\"w2-invalid\");\n        el.setAttribute(\"aria-invalid\", \"true\");\n        document.getElementById(f.err).textContent = f.msg;\n        if (!firstBad) { firstBad = el; }\n      }\n    });\n    if (firstBad) {\n      firstBad.focus();\n      return;\n    }\n\n    var text = \"Hello Petal & Stem, I would like to order a bouquet for delivery.\\n\" +\n      \"Bouquet: \" + values[\"w2-bouquet\"] + \"\\n\" +\n      \"Name: \" + values[\"w2-name\"] + \"\\n\" +\n      \"Phone: \" + values[\"w2-phone\"] + \"\\n\" +\n      \"Address: \" + values[\"w2-address\"] + \"\\n\" +\n      \"Payment: on delivery\";\n    var url = \"https://wa.me/\" + WA_NUMBER + \"?text=\" + encodeURIComponent(text);\n\n    var win = null;\n    try { win = window.open(url, \"_blank\"); } catch (err) { win = null; }\n    if (!win) {\n      window.location.href = url;\n      return;\n    }\n    status.innerHTML = \"\";\n    var msg = document.createTextNode(\"WhatsApp should have opened with your order. If it did not, \");\n    var link = document.createElement(\"a\");\n    link.href = url;\n    link.target = \"_blank\";\n    link.rel = \"noopener\";\n    link.textContent = \"tap here to open it\";\n    status.appendChild(msg);\n    status.appendChild(link);\n    status.appendChild(document.createTextNode(\".\"));\n  });\n\n  fields.forEach(function (f) {\n    var el = document.getElementById(f.id);\n    var handler = function () {\n      if ((el.value || \"\").trim()) {\n        el.classList.remove(\"w2-invalid\");\n        el.removeAttribute(\"aria-invalid\");\n        document.getElementById(f.err).textContent = \"\";\n      }\n    };\n    el.addEventListener(\"input\", handler);\n    el.addEventListener(\"change\", handler);\n  });\n})();\n</script>\n</section>",
    "workflow": "Order form with WhatsApp and delivery terms"
  },
  "W-3": {
    "owner": "W-3",
    "head": "",
    "body": "<section id=\"w3\" class=\"w3-root\" aria-labelledby=\"w3-title\">\n<style>\n#w3, #w3 * { box-sizing: border-box; }\n#w3 { font-family: Georgia, \"Times New Roman\", serif; color: #2b2b2b; background: #fffaf7; width: 100%; overflow-x: hidden; border-top: 1px solid #ecd9dc; }\n#w3 .w3-wrap { max-width: 1100px; margin: 0 auto; padding: 32px 16px 40px; }\n#w3 h2 { margin: 0 0 20px; font-size: 1.5rem; color: #8a2f45; text-align: center; }\n#w3 .w3-grid { display: grid; gap: 20px; grid-template-columns: 1fr; }\n#w3 .w3-card { background: #fff; border: 1px solid #ecd9dc; border-radius: 12px; padding: 18px 16px; min-width: 0; overflow-wrap: anywhere; }\n#w3 .w3-card h3 { margin: 0 0 10px; font-size: 1.1rem; color: #8a2f45; }\n#w3 .w3-card p { margin: 0 0 8px; line-height: 1.5; }\n#w3 .w3-card p:last-child { margin-bottom: 0; }\n#w3 .w3-closed { color: #5a4046; }\n#w3 a { color: #8a2f45; font-weight: bold; }\n#w3 .w3-btn { display: inline-block; margin-top: 8px; padding: 12px 16px; border-radius: 10px; background: #8a2f45; color: #fff; text-decoration: none; font-weight: bold; }\n#w3 .w3-btn:hover { background: #722639; }\n#w3 a:focus-visible { outline: 3px solid #c9708a; outline-offset: 2px; }\n@media (min-width: 900px) {\n  #w3 .w3-wrap { padding: 48px 24px 56px; }\n  #w3 h2 { font-size: 1.8rem; }\n  #w3 .w3-grid { grid-template-columns: repeat(3, 1fr); }\n}\n</style>\n\n<div class=\"w3-wrap\" id=\"visit\">\n  <h2 id=\"w3-title\">Visit Petal &amp; Stem in Jaipur</h2>\n  <div class=\"w3-grid\">\n    <div class=\"w3-card\">\n      <h3>Opening hours</h3>\n      <p>9am to 8pm, Monday to Saturday</p>\n      <p class=\"w3-closed\">Closed on Sunday</p>\n    </div>\n    <div class=\"w3-card\">\n      <h3>Address</h3>\n      <p>12 MI Road, near Panch Batti, Jaipur 302001</p>\n      <a class=\"w3-btn\" href=\"https://www.google.com/maps/search/?api=1&amp;query=12+MI+Road+near+Panch+Batti+Jaipur+302001\" target=\"_blank\" rel=\"noopener\">Open in Google Maps</a>\n    </div>\n    <div class=\"w3-card\">\n      <h3>Phone</h3>\n      <p><a href=\"tel:+911414005566\">+91 141 400 5566</a></p>\n      <p>Tap the number to call the shop.</p>\n    </div>\n  </div>\n</div>\n</section>",
    "workflow": "Hours, address, phone and map"
  }
}