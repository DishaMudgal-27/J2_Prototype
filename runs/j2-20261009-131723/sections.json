    "body": "<div class=\"tl-w7\">\n<style>\n  .tl-w7 .tl-pol { padding: var(--j2-section, 64px) 0; background: var(--j2-surface); }\n  .tl-w7 .tl-rev { padding: var(--j2-section, 64px) 0; }\n  .tl-w7 .tl-intro { color: var(--j2-muted); margin: 0 0 24px; max-width: 60ch; }\n  .tl-w7 .tl-pol-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }\n  .tl-w7 .tl-pol-card { padding: 24px 16px; min-width: 0; }\n  .tl-w7 .tl-pol-card h3 { margin: 0 0 12px; font-size: 1.5rem; color: var(--j2-primary); }\n  .tl-w7 .tl-pol-list { list-style: none; margin: 0; padding: 0; }\n  .tl-w7 .tl-pol-list li { padding: 12px 0; border-bottom: 1px solid #E3D6C0; }\n  .tl-w7 .tl-pol-list li:first-child { padding-top: 0; }\n  .tl-w7 .tl-pol-list li:last-child { border-bottom: 0; padding-bottom: 0; }\n  .tl-w7 .tl-pol-label { display: block; font-size: .85rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--j2-secondary); }\n  .tl-w7 .tl-pol-value { display: block; font-weight: 600; font-size: 1.05rem; color: var(--j2-text); }\n  .tl-w7 .tl-pol-cta { margin-top: 24px; border-radius: var(--j2-radius); }\n  .tl-w7 .tl-rev-grid { display: grid; grid-template-columns: 1fr; gap: 16px; list-style: none; margin: 0; padding: 0; }\n  .tl-w7 .tl-rev-card { margin: 0; padding: 24px 16px; display: flex; flex-direction: column; gap: 16px; min-width: 0; height: 100%; }\n  .tl-w7 .tl-rev-card blockquote { margin: 0; font-family: var(--j2-font-heading); font-size: 1.5rem; line-height: 1.3; color: var(--j2-text); }\n  .tl-w7 .tl-rev-card figcaption { margin-top: auto; font-weight: 700; color: var(--j2-primary); }\n  .tl-w7 .tl-rev-card figcaption::before { content: \"\"; display: block; width: 40px; height: 3px; margin-bottom: 12px; background: var(--j2-accent); border-radius: 2px; }\n  @media (min-width: 760px) {\n    .tl-w7 .tl-pol-grid { grid-template-columns: 1fr 1fr; gap: 24px; }\n    .tl-w7 .tl-pol-card { padding: 32px 24px; }\n    .tl-w7 .tl-rev-grid { grid-template-columns: repeat(3, 1fr); gap: 24px; }\n    .tl-w7 .tl-rev-card { padding: 32px 24px; }\n  }\n</style>\n\n<section id=\"policies\" class=\"tl-pol\" aria-labelledby=\"tl-pol-title\">\n  <div class=\"j2-container\">\n    <h2 id=\"tl-pol-title\">Exchange and Delivery</h2>\n    <p class=\"tl-intro\">What to know before you order from Thread &amp; Loom.</p>\n\n    <div class=\"tl-pol-grid\">\n      <div class=\"j2-card tl-pol-card\">\n        <h3>Exchange policy</h3>\n        <ul class=\"tl-pol-list\">\n          <li>\n            <span class=\"tl-pol-label\">Exchange window</span>\n            <span class=\"tl-pol-value\">Exchange within 7 days if unworn with tags.</span>\n          </li>\n          <li>\n            <span class=\"tl-pol-label\">Returns</span>\n            <span class=\"tl-pol-value\">No returns on sale items.</span>\n          </li>\n        </ul>\n      </div>\n\n      <div class=\"j2-card tl-pol-card\">\n        <h3>Delivery</h3>\n        <ul class=\"tl-pol-list\">\n          <li>\n            <span class=\"tl-pol-label\">Where and when</span>\n            <span class=\"tl-pol-value\">Pune in 2 days</span>\n          </li>\n          <li>\n            <span class=\"tl-pol-label\">Delivery charge</span>\n            <span class=\"tl-pol-value\">Rs 79, free above Rs 2,999</span>\n          </li>\n          <li>\n            <span class=\"tl-pol-label\">Payment</span>\n            <span class=\"tl-pol-value\">Pay on delivery</span>\n          </li>\n        </ul>\n      </div>\n    </div>\n\n    <a class=\"j2-btn tl-pol-cta\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20have%20a%20question%20about%20exchange%20or%20delivery.\" target=\"_blank\" rel=\"noopener\" aria-label=\"Ask about exchange or delivery on WhatsApp\">Ask us on WhatsApp</a>\n  </div>\n</section>\n\n<section id=\"reviews\" class=\"tl-rev\" aria-labelledby=\"tl-rev-title\">\n  <div class=\"j2-container\">\n    <h2 id=\"tl-rev-title\">Customer Reviews</h2>\n    <p class=\"tl-intro\">What our customers say.</p>\n\n    <ul class=\"tl-rev-grid\">\n      <li>\n        <figure class=\"j2-card tl-rev-card\">\n          <blockquote>&ldquo;Beautiful fabric, fits perfectly&rdquo;</blockquote>\n          <figcaption>Meera K.</figcaption>\n        </figure>\n      </li>\n      <li>\n        <figure class=\"j2-card tl-rev-card\">\n          <blockquote>&ldquo;Fast delivery and lovely packing&rdquo;</blockquote>\n          <figcaption>Arjun S.</figcaption>\n        </figure>\n      </li>\n      <li>\n        <figure class=\"j2-card tl-rev-card\">\n          <blockquote>&ldquo;My go-to for festive kurtas&rdquo;</blockquote>\n          <figcaption>Priya D.</figcaption>\n        </figure>\n      </li>\n    </ul>\n  </div>\n</section>\n</div>",
    "workflow": "Exchange, delivery policy and reviews"
  }
