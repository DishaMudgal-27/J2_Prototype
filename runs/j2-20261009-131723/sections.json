{
  "style": {
    "owner": "W-1",
    "head": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&amp;family=Nunito+Sans:wght@400;600;700&amp;display=swap\"><style>:root{--j2-primary:#7A3E22;--j2-secondary:#4A5A32;--j2-accent:#B8742A;--j2-background:#FAF5EC;--j2-surface:#F1E8D8;--j2-text:#2B2118;--j2-muted:#6A5846;--j2-font-heading:'Cormorant Garamond', Georgia, 'Times New Roman', serif;--j2-font-body:'Nunito Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:10px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;background:#7A3E22;color:#FFFFFF;border:2px solid #7A3E22;min-height:44px;padding:10px 22px;font-weight:700;letter-spacing:.02em;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer}.j2-btn-secondary{display:inline-block;background:transparent;color:#7A3E22;border:2px solid #7A3E22;min-height:44px;padding:10px 22px;font-weight:700;letter-spacing:.02em;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer}.j2-card{background:#FFFFFF;border:1px solid #E3D6C0;border-radius:10px;box-shadow:0 2px 10px rgba(43,33,24,.07);overflow:hidden}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-1": {
    "owner": "W-1",
    "head": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"theme-color\" content=\"#FAF5EC\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>",
    "body": "<style>\n  *, *::before, *::after { box-sizing: border-box; }\n  html { scroll-behavior: smooth; scroll-padding-top: 76px; -webkit-text-size-adjust: 100%; }\n  body {\n    margin: 0;\n    max-width: 100%;\n    overflow-x: clip;\n    background: var(--j2-background, #FAF5EC);\n    color: var(--j2-text, #2B2118);\n    font-family: var(--j2-font-body, 'Nunito Sans', system-ui, sans-serif);\n    font-size: 16px;\n    line-height: 1.6;\n  }\n  img, svg, video, iframe { max-width: 100%; }\n  img { height: auto; }\n  h1, h2, h3, h4 {\n    font-family: var(--j2-font-heading, 'Cormorant Garamond', Georgia, serif);\n    color: var(--j2-text, #2B2118);\n    line-height: 1.2;\n    margin: 0 0 .5em;\n    overflow-wrap: anywhere;\n  }\n  h1 { font-size: clamp(2rem, 7vw, 3.25rem); }\n  h2 { font-size: clamp(1.6rem, 5vw, 2.4rem); }\n  p, li, td, th, a { overflow-wrap: anywhere; }\n  a { color: var(--j2-primary, #7A3E22); }\n  section[id], header[id] { scroll-margin-top: 76px; }\n  :focus-visible { outline: 3px solid var(--j2-accent, #B8742A); outline-offset: 2px; }\n  .j2-container { width: 100%; max-width: 1120px; margin: 0 auto; padding-left: 16px; padding-right: 16px; }\n\n  .tl-header {\n    position: sticky; top: 0; z-index: 50;\n    background: var(--j2-background, #FAF5EC);\n    border-bottom: 1px solid #E3D6C0;\n  }\n  .tl-header-inner {\n    display: flex; align-items: center; justify-content: space-between;\n    gap: 12px; min-height: 64px;\n  }\n  .tl-brand {\n    font-family: var(--j2-font-heading, 'Cormorant Garamond', Georgia, serif);\n    font-size: 1.6rem; font-weight: 700; letter-spacing: .01em;\n    color: var(--j2-primary, #7A3E22); text-decoration: none;\n    display: inline-flex; align-items: center; min-height: 44px;\n  }\n  .tl-menu-btn {\n    min-height: 44px; min-width: 44px; padding: 8px 14px;\n    background: transparent; color: var(--j2-primary, #7A3E22);\n    border: 2px solid var(--j2-primary, #7A3E22);\n    border-radius: var(--j2-radius, 10px);\n    font: inherit; font-weight: 700; cursor: pointer;\n  }\n  .tl-nav { display: none; }\n  .tl-nav.tl-open {\n    display: block; position: absolute; left: 0; right: 0; top: 100%;\n    background: var(--j2-background, #FAF5EC);\n    border-bottom: 1px solid #E3D6C0;\n    box-shadow: 0 8px 16px rgba(43,33,24,.08);\n  }\n  .tl-nav ul { list-style: none; margin: 0; padding: 8px 16px 16px; }\n  .tl-nav a {\n    display: flex; align-items: center; min-height: 44px; padding: 6px 4px;\n    color: var(--j2-text, #2B2118); text-decoration: none; font-weight: 600;\n    border-bottom: 1px solid #EADFCB;\n  }\n  .tl-nav a:hover { color: var(--j2-primary, #7A3E22); }\n  .tl-nav a[hidden] { display: none; }\n  .tl-nav li:has(a[hidden]) { display: none; }\n\n  @media (min-width: 900px) {\n    .tl-menu-btn { display: none; }\n    .tl-nav, .tl-nav.tl-open { display: block; position: static; border: 0; box-shadow: none; background: transparent; }\n    .tl-nav ul { display: flex; gap: 4px; padding: 0; flex-wrap: wrap; justify-content: flex-end; }\n    .tl-nav a { border-bottom: 0; padding: 6px 12px; border-radius: var(--j2-radius, 10px); }\n    .tl-nav a:hover { background: var(--j2-surface, #F1E8D8); }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    html { scroll-behavior: auto; }\n  }\n</style>\n\n<header class=\"tl-header\" id=\"top\">\n  <div class=\"j2-container tl-header-inner\">\n    <a class=\"tl-brand\" href=\"#top\">Thread &amp; Loom</a>\n    <button class=\"tl-menu-btn\" id=\"tl-menu-btn\" type=\"button\" aria-expanded=\"false\" aria-controls=\"tl-nav\">Menu</button>\n    <nav class=\"tl-nav\" id=\"tl-nav\" aria-label=\"Main\">\n      <ul>\n        <li><a href=\"#shop\" data-alt=\"catalogue,products,collection\">Shop</a></li>\n        <li><a href=\"#new-arrivals\" data-alt=\"new,arrivals\">New Arrivals</a></li>\n        <li><a href=\"#lookbook\" data-alt=\"look-book,outfits\">Lookbook</a></li>\n        <li><a href=\"#size-guide\" data-alt=\"sizes,size-chart,sizeguide\">Size Guide</a></li>\n        <li><a href=\"#visit\" data-alt=\"visit-us,contact,location,timings,store\">Visit Us</a></li>\n        <li><a href=\"#policies\" data-alt=\"policy,exchange,delivery,returns\">Policies</a></li>\n        <li><a href=\"#reviews\" data-alt=\"testimonials,customer-reviews\">Reviews</a></li>\n      </ul>\n    </nav>\n  </div>\n</header>\n\n<script>\n(function () {\n  function init() {\n    try {\n      var btn = document.getElementById('tl-menu-btn');\n      var nav = document.getElementById('tl-nav');\n      if (!btn || !nav) return;\n\n      var links = nav.querySelectorAll('a[href^=\"#\"]');\n      for (var i = 0; i < links.length; i++) {\n        var a = links[i];\n        var id = a.getAttribute('href').slice(1);\n        if (document.getElementById(id)) continue;\n        var alts = (a.getAttribute('data-alt') || '').split(',');\n        var found = null;\n        for (var j = 0; j < alts.length; j++) {\n          var alt = alts[j].trim();\n          if (alt && document.getElementById(alt)) { found = alt; break; }\n        }\n        if (found) { a.setAttribute('href', '#' + found); }\n        else { a.hidden = true; }\n      }\n\n      function setOpen(open) {\n        nav.classList.toggle('tl-open', open);\n        btn.setAttribute('aria-expanded', open ? 'true' : 'false');\n        btn.textContent = open ? 'Close' : 'Menu';\n      }\n      btn.addEventListener('click', function () {\n        setOpen(!nav.classList.contains('tl-open'));\n      });\n      nav.addEventListener('click', function (e) {\n        if (e.target && e.target.closest && e.target.closest('a')) setOpen(false);\n      });\n      document.addEventListener('keydown', function (e) {\n        if (e.key === 'Escape') setOpen(false);\n      });\n    } catch (err) { /* nav stays usable without the toggle */ }\n  }\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);\n  else init();\n})();\n</script>",
    "workflow": "Page shell and earthy styling"
  },
  "W-3": {
    "owner": "W-9",
