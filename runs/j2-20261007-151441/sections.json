{
  "W-1": {
    "owner": "W-1",
    "head": "<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Brew Lab | Cafe in Indiranagar, Bengaluru</title>\n<meta name=\"description\" content=\"Brew Lab on 100 Feet Road, Indiranagar, Bengaluru: opening hours, menu, pre-order for pickup, loyalty card and directions.\">\n<style>\n:root{--bl-bg:#faf6f0;--bl-ink:#2b1d14;--bl-accent:#8a4b24;--bl-accent-soft:#f3e1cf;--bl-card:#fff;--bl-line:#e6dccf}\n*,*::before,*::after{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%;scroll-behavior:smooth}\nbody{margin:0;font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;background:var(--bl-bg);color:var(--bl-ink)}\nimg,svg,video{max-width:100%;height:auto}\nh1,h2,h3{line-height:1.2;margin:0 0 .5em}\nh2{font-size:1.5rem}\np{margin:0 0 1em}\na{color:var(--bl-accent)}\na:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--bl-accent);outline-offset:2px}\nbutton,input,select,textarea{font:inherit;max-width:100%}\n.bl-wrap{width:100%;max-width:960px;margin:0 auto;padding:0 16px}\n.bl-section{padding:32px 0;border-top:1px solid var(--bl-line)}\n.bl-card{background:var(--bl-card);border:1px solid var(--bl-line);border-radius:12px;padding:16px}\n</style>",
    "body": "<style>\n#top.bl-hero{background:#2b1d14;color:#fff;padding:40px 0 24px}\n#top .bl-hero-sub{color:#f3e1cf;margin-bottom:16px}\n#top h1{font-size:2.25rem;margin-bottom:.25em}\n#bl-nav{display:flex;flex-wrap:wrap;gap:8px 16px;margin:0;padding:0}\n#bl-nav a{color:#f3e1cf;text-decoration:none;font-weight:600;padding:6px 0;border-bottom:2px solid transparent}\n#bl-nav a:hover{border-bottom-color:#f3e1cf}\n#hours .bl-hours{width:100%;border-collapse:collapse;background:var(--bl-card);border:1px solid var(--bl-line);border-radius:12px;overflow:hidden}\n#hours .bl-hours th,#hours .bl-hours td{padding:12px 14px;border-bottom:1px solid var(--bl-line);text-align:left;font-weight:400}\n#hours .bl-hours tr:last-child th,#hours .bl-hours tr:last-child td{border-bottom:0}\n#hours .bl-hours td{text-align:right;white-space:nowrap}\n#hours .bl-hours tr.today th,#hours .bl-hours tr.today td{background:var(--bl-accent-soft);font-weight:700}\n#hours .bl-hours tr.today th{border-left:4px solid var(--bl-accent)}\n#hours .bl-badge{display:inline-block;margin-left:8px;padding:2px 8px;border-radius:999px;background:var(--bl-accent);color:#fff;font-size:.75rem;font-weight:600;vertical-align:middle}\n@media (min-width:640px){#top h1{font-size:3rem}}\n</style>\n\n<header id=\"top\" class=\"bl-hero\">\n  <div class=\"bl-wrap\">\n    <h1>Brew Lab</h1>\n    <p class=\"bl-hero-sub\">Cafe on 100 Feet Road, Indiranagar, Bengaluru</p>\n    <nav id=\"bl-nav\" aria-label=\"Page sections\"></nav>\n  </div>\n</header>\n\n<main>\n<section id=\"hours\" class=\"bl-section\" aria-labelledby=\"hours-title\">\n  <div class=\"bl-wrap\">\n    <h2 id=\"hours-title\">Opening hours</h2>\n    <p>Open every day. Today is highlighted.</p>\n    <table class=\"bl-hours\">\n      <tbody>\n        <tr data-day=\"1\"><th scope=\"row\">Monday</th><td>8am to 10pm</td></tr>\n        <tr data-day=\"2\"><th scope=\"row\">Tuesday</th><td>8am to 10pm</td></tr>\n        <tr data-day=\"3\"><th scope=\"row\">Wednesday</th><td>8am to 10pm</td></tr>\n        <tr data-day=\"4\"><th scope=\"row\">Thursday</th><td>8am to 10pm</td></tr>\n        <tr data-day=\"5\"><th scope=\"row\">Friday</th><td>8am to 10pm</td></tr>\n        <tr data-day=\"6\"><th scope=\"row\">Saturday</th><td>9am to 11pm</td></tr>\n        <tr data-day=\"0\"><th scope=\"row\">Sunday</th><td>9am to 11pm</td></tr>\n      </tbody>\n    </table>\n  </div>\n</section>\n<!-- Other agents' sections follow this one; the page assembler closes <main> after the last section. -->\n\n<script>\n(function () {\n  var NAMES = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];\n  var WEEKDAY = { open: '08:00', close: '22:00' };\n  var WEEKEND = { open: '09:00', close: '23:00' };\n\n  function toMin(s) { var p = s.split(':'); return Number(p[0]) * 60 + Number(p[1]); }\n\n  var days = NAMES.map(function (name, i) {\n    var h = (i === 0 || i === 6) ? WEEKEND : WEEKDAY;\n    return { index: i, name: name, open: h.open, close: h.close, openMin: toMin(h.open), closeMin: toMin(h.close) };\n  });\n\n  // Current day (0 = Sunday) and minutes since midnight, in Bengaluru time (Asia/Kolkata).\n  function now() {\n    try {\n      var parts = new Intl.DateTimeFormat('en-US', {\n        timeZone: 'Asia/Kolkata', weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false\n      }).formatToParts(new Date());\n      var map = {};\n      parts.forEach(function (p) { map[p.type] = p.value; });\n      var idx = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(map.weekday);\n      if (idx > -1) {\n        return { day: idx, minutes: (Number(map.hour) % 24) * 60 + Number(map.minute) };\n      }\n    } catch (e) { /* fall through to local time */ }\n    var d = new Date();\n    return { day: d.getDay(), minutes: d.getHours() * 60 + d.getMinutes() };\n  }\n\n  // Shared with other sections, e.g. the pre-order form validates pickup time against forDay().\n  window.BrewLab = window.BrewLab || {};\n  window.BrewLab.hours = {\n    days: days,\n    forDay: function (i) { return days[i]; },\n    now: now,\n    today: function () { return days[now().day]; }\n  };\n\n  function highlightToday() {\n    var rows = document.querySelectorAll('#hours .bl-hours tr[data-day]');\n    var today = now().day;\n    Array.prototype.forEach.call(rows, function (row) {\n      var badge = row.querySelector('.bl-badge');\n      if (Number(row.getAttribute('data-day')) === today) {\n        row.classList.add('today');\n        row.setAttribute('aria-current', 'date');\n        if (!badge) {\n          badge = document.createElement('span');\n          badge.className = 'bl-badge';\n          badge.textContent = 'Today';\n          row.querySelector('th').appendChild(badge);\n        }\n      } else {\n        row.classList.remove('today');\n        row.removeAttribute('aria-current');\n        if (badge) { badge.parentNode.removeChild(badge); }\n      }\n    });\n  }\n\n  // Header nav lists only sections that exist, so no in-page link can be broken.\n  function buildNav() {\n    var nav = document.getElementById('bl-nav');\n    if (!nav) { return; }\n    nav.innerHTML = '';\n    [['hours', 'Hours'], ['menu', 'Menu'], ['preorder', 'Pre-order'], ['loyalty', 'Loyalty'], ['location', 'Location']]\n      .forEach(function (item) {\n        if (document.getElementById(item[0])) {\n          var a = document.createElement('a');\n          a.href = '#' + item[0];\n          a.textContent = item[1];\n          nav.appendChild(a);\n        }\n      });\n  }\n\n  highlightToday();\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', buildNav);\n  } else {\n    buildNav();\n  }\n  document.addEventListener('visibilitychange', function () {\n    if (!document.hidden) { highlightToday(); }\n  });\n})();\n</script>",
    "workflow": "Page shell and opening hours"
  },
  "W-2": {
    "owner": "W-6",
    "head": "",
    "body": "<style>\n#menu .bl-menu-groups{display:grid;grid-template-columns:minmax(0,1fr);gap:16px}\n#menu .bl-menu-group h3{font-size:1.1rem;margin:0 0 .5em;color:var(--bl-accent)}\n#menu .bl-menu-list{list-style:none;margin:0;padding:0}\n#menu .bl-menu-list li{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:baseline;column-gap:12px;padding:10px 0;border-bottom:1px solid var(--bl-line)}\n#menu .bl-menu-list li:last-child{border-bottom:0}\n#menu .bl-item-name{min-width:0;overflow-wrap:anywhere;color:var(--bl-ink,#2b1d14)}\n#menu .bl-item-price{display:inline-block;visibility:visible;opacity:1;font-weight:700;white-space:nowrap;color:var(--bl-ink,#2b1d14);text-align:right}\n@media (min-width:768px){#menu .bl-menu-groups{grid-template-columns:repeat(3,minmax(0,1fr));align-items:start}}\n</style>\n<section id=\"menu\" class=\"bl-section\" aria-labelledby=\"menu-title\">\n  <div class=\"bl-wrap\">\n    <h2 id=\"menu-title\">Menu</h2>\n    <p>All prices in rupees. Pay at pickup.</p>\n    <div class=\"bl-menu-groups\">\n      <div class=\"bl-card bl-menu-group\">\n        <h3>Coffee</h3>\n        <ul class=\"bl-menu-list\">\n          <li data-item=\"espresso\" data-name=\"Espresso\" data-price=\"120\"><span class=\"bl-item-name\">Espresso</span><span class=\"bl-item-price\">₹120</span></li>\n          <li data-item=\"cappuccino\" data-name=\"Cappuccino\" data-price=\"180\"><span class=\"bl-item-name\">Cappuccino</span><span class=\"bl-item-price\">₹180</span></li>\n          <li data-item=\"pour-over\" data-name=\"Pour-over\" data-price=\"220\"><span class=\"bl-item-name\">Pour-over</span><span class=\"bl-item-price\">₹220</span></li>\n        </ul>\n      </div>\n      <div class=\"bl-card bl-menu-group\">\n        <h3>Cold</h3>\n        <ul class=\"bl-menu-list\">\n          <li data-item=\"cold-brew\" data-name=\"Cold brew\" data-price=\"200\"><span class=\"bl-item-name\">Cold brew</span><span class=\"bl-item-price\">₹200</span></li>\n        </ul>\n      </div>\n      <div class=\"bl-card bl-menu-group\">\n        <h3>Food</h3>\n        <ul class=\"bl-menu-list\">\n          <li data-item=\"croissant\" data-name=\"Croissant\" data-price=\"150\"><span class=\"bl-item-name\">Croissant</span><span class=\"bl-item-price\">₹150</span></li>\n          <li data-item=\"banana-bread\" data-name=\"Banana bread\" data-price=\"130\"><span class=\"bl-item-name\">Banana bread</span><span class=\"bl-item-price\">₹130</span></li>\n        </ul>\n      </div>\n    </div>\n  </div>\n  <script>\n  (function () {\n    // Shared with the pre-order form (W-3): window.BrewLab.menu.items = [{id, name, price, group}]\n    var items = [];\n    var rows = document.querySelectorAll('#menu li[data-item]');\n    Array.prototype.forEach.call(rows, function (li) {\n      var price = Number(li.getAttribute('data-price'));\n      // Self-check: every row must show its charter price next to the name.\n      var el = li.querySelector('.bl-item-price');\n      var label = '\\u20B9' + price;\n      if (!el) {\n        el = document.createElement('span');\n        el.className = 'bl-item-price';\n        li.appendChild(el);\n      }\n      if (el.textContent.trim() !== label) { el.textContent = label; }\n      var group = li.closest('.bl-menu-group');\n      var heading = group ? group.querySelector('h3') : null;\n      items.push({\n        id: li.getAttribute('data-item'),\n        name: li.getAttribute('data-name'),\n        price: price,\n        group: heading ? heading.textContent : ''\n      });\n    });\n    window.BrewLab = window.BrewLab || {};\n    window.BrewLab.menu = {\n      items: items,\n      byId: function (id) {\n        for (var i = 0; i < items.length; i++) { if (items[i].id === id) { return items[i]; } }\n        return null;\n      }\n    };\n  })();\n  </script>\n</section>",
    "workflow": "Menu price visibility fix"
  },
  "W-3": {
    "owner": "W-3",
    "head": "",
    "body": "<style>\n#preorder .bl-form{display:grid;gap:20px}\n#preorder fieldset{border:0;margin:0;padding:0;min-width:0}\n#preorder legend{font-weight:700;font-size:1.1rem;padding:0;margin-bottom:8px;color:var(--bl-accent)}\n#preorder .bl-po-row{display:flex;align-items:center;justify-content:space-between;gap:8px 12px;padding:10px 0;border-bottom:1px solid var(--bl-line)}\n#preorder .bl-po-row:last-child{border-bottom:0}\n#preorder .bl-po-info{flex:1 1 auto;min-width:0;display:flex;flex-direction:column}\n#preorder .bl-po-name{overflow-wrap:anywhere;font-weight:600}\n#preorder .bl-po-price{color:#5b4636;font-size:.95rem}\n#preorder .bl-po-step{flex:0 0 auto;display:flex;align-items:center;gap:6px}\n#preorder .bl-po-step button{width:40px;height:40px;border-radius:50%;border:1px solid var(--bl-accent);background:#fff;color:var(--bl-accent);font-size:1.25rem;line-height:1;cursor:pointer;padding:0}\n#preorder .bl-po-step button:hover{background:var(--bl-accent-soft)}\n#preorder .bl-po-step input{width:48px;height:40px;text-align:center;border:1px solid var(--bl-line);border-radius:8px;padding:0;-moz-appearance:textfield;appearance:textfield}\n#preorder .bl-po-step input::-webkit-outer-spin-button,#preorder .bl-po-step input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}\n#preorder .bl-total{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:12px 14px;background:var(--bl-accent-soft);border-radius:10px;font-weight:700;font-size:1.15rem}\n#preorder .bl-field{display:grid;gap:4px;margin-bottom:12px}\n#preorder .bl-field:last-child{margin-bottom:0}\n#preorder .bl-field label{font-weight:600}\n#preorder .bl-field input{width:100%;min-height:44px;padding:8px 12px;border:1px solid #bfae9b;border-radius:8px;background:#fff;color:var(--bl-ink)}\n#preorder .bl-field input[aria-invalid=\"true\"]{border-color:#b00020;border-width:2px}\n#preorder .bl-hint{font-size:.9rem;color:#5b4636;margin:0}\n#preorder .bl-err{color:#b00020;font-size:.92rem;margin:0;min-height:0;overflow-wrap:anywhere}\n#preorder .bl-err:empty{display:none}\n#preorder .bl-submit{width:100%;min-height:48px;border:0;border-radius:10px;background:var(--bl-accent);color:#fff;font-weight:700;font-size:1.05rem;cursor:pointer;padding:10px 16px}\n#preorder .bl-submit:hover{background:#6f3b1b}\n#preorder .bl-pay{font-weight:600;margin:0}\n#preorder .bl-status{margin:0;overflow-wrap:anywhere}\n#preorder .bl-status:empty{display:none}\n@media (min-width:768px){#preorder .bl-submit{width:auto}}\n</style>\n<section id=\"preorder\" class=\"bl-section\" aria-labelledby=\"preorder-title\">\n  <div class=\"bl-wrap\">\n    <h2 id=\"preorder-title\">Pre-order for pickup</h2>\n    <p>Choose your items, tell us when you will pick up, and send the order to us on WhatsApp.</p>\n    <form id=\"bl-order\" class=\"bl-card bl-form\" novalidate>\n      <fieldset>\n        <legend>1. Pick your items</legend>\n        <div id=\"bl-order-items\"></div>\n        <div class=\"bl-total\" aria-live=\"polite\" aria-atomic=\"true\">\n          <span>Total</span>\n          <span id=\"bl-order-total\">₹0</span>\n        </div>\n        <p id=\"bl-err-items\" class=\"bl-err\" role=\"alert\"></p>\n      </fieldset>\n      <fieldset>\n        <legend>2. Your details</legend>\n        <div class=\"bl-field\">\n          <label for=\"bl-name\">Name</label>\n          <input id=\"bl-name\" name=\"name\" type=\"text\" autocomplete=\"name\" required aria-describedby=\"bl-err-name\">\n          <p id=\"bl-err-name\" class=\"bl-err\" role=\"alert\"></p>\n        </div>\n        <div class=\"bl-field\">\n          <label for=\"bl-phone\">Phone</label>\n          <input id=\"bl-phone\" name=\"phone\" type=\"tel\" inputmode=\"tel\" autocomplete=\"tel\" placeholder=\"98450 00000\" required aria-describedby=\"bl-err-phone\">\n          <p id=\"bl-err-phone\" class=\"bl-err\" role=\"alert\"></p>\n        </div>\n        <div class=\"bl-field\">\n          <label for=\"bl-time\">Pickup time (today)</label>\n          <input id=\"bl-time\" name=\"time\" type=\"time\" required aria-describedby=\"bl-time-hint bl-err-time\">\n          <p id=\"bl-time-hint\" class=\"bl-hint\"></p>\n          <p id=\"bl-err-time\" class=\"bl-err\" role=\"alert\"></p>\n        </div>\n      </fieldset>\n      <p class=\"bl-pay\">Payment is at pickup. This site takes no online payment.</p>\n      <button type=\"submit\" class=\"bl-submit\">Send order on WhatsApp</button>\n      <p id=\"bl-order-status\" class=\"bl-status\" aria-live=\"polite\"></p>\n    </form>\n  </div>\n  <script>\n  (function () {\n    var WA_NUMBER = '919845000000';\n    var MAX_QTY = 20;\n    var FALLBACK_ITEMS = [\n      { id: 'espresso', name: 'Espresso', price: 120 },\n      { id: 'cappuccino', name: 'Cappuccino', price: 180 },\n      { id: 'pour-over', name: 'Pour-over', price: 220 },\n      { id: 'cold-brew', name: 'Cold brew', price: 200 },\n      { id: 'croissant', name: 'Croissant', price: 150 },\n      { id: 'banana-bread', name: 'Banana bread', price: 130 }\n    ];\n\n    var form = document.getElementById('bl-order');\n    if (!form) { return; }\n    var itemsBox = document.getElementById('bl-order-items');\n    var totalEl = document.getElementById('bl-order-total');\n    var nameEl = document.getElementById('bl-name');\n    var phoneEl = document.getElementById('bl-phone');\n    var timeEl = document.getElementById('bl-time');\n    var hintEl = document.getElementById('bl-time-hint');\n    var statusEl = document.getElementById('bl-order-status');\n    var errItems = document.getElementById('bl-err-items');\n    var errName = document.getElementById('bl-err-name');\n    var errPhone = document.getElementById('bl-err-phone');\n    var errTime = document.getElementById('bl-err-time');\n\n    var BL = window.BrewLab || {};\n    var items = (BL.menu && BL.menu.items && BL.menu.items.length) ? BL.menu.items : FALLBACK_ITEMS;\n    var qtyInputs = [];\n\n    function pad(n) { return n < 10 ? '0' + n : String(n); }\n    function money(n) { return '\\u20B9' + Number(n).toLocaleString('en-IN'); }\n    function toMin(s) { var p = s.split(':'); return Number(p[0]) * 60 + Number(p[1]); }\n    function to12(min, withMinutes) {\n      var h = Math.floor(min / 60), m = min % 60;\n      var suffix = h >= 12 ? 'pm' : 'am';\n      var h12 = h % 12 || 12;\n      return h12 + ((m || withMinutes) ? ':' + pad(m) : '') + suffix;\n    }\n\n    // Today's hours: shared W-1 data, with a same-facts fallback.\n    function today() {\n      if (BL.hours && typeof BL.hours.today === 'function') {\n        var t = BL.hours.today();\n        var n = BL.hours.now();\n        return { name: t.name, openMin: t.openMin, closeMin: t.closeMin, nowMin: n.minutes };\n      }\n      var d = new Date(), wd = d.getDay(), weekend = (wd === 0 || wd === 6);\n      var names = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];\n      return { name: names[wd], openMin: weekend ? 540 : 480, closeMin: weekend ? 1380 : 1320, nowMin: d.getHours() * 60 + d.getMinutes() };\n    }\n\n    function clampQty(v) {\n      var n = parseInt(v, 10);\n      if (isNaN(n) || n < 0) { return 0; }\n      return n > MAX_QTY ? MAX_QTY : n;\n    }\n\n    function lines() {\n      var out = [];\n      items.forEach(function (it, i) {\n        var q = clampQty(qtyInputs[i].value);\n        if (q > 0) { out.push({ name: it.name, qty: q, price: it.price, sub: q * it.price }); }\n      });\n      return out;\n    }\n\n    function total() {\n      return lines().reduce(function (sum, l) { return sum + l.sub; }, 0);\n    }\n\n    function updateTotal() {\n      totalEl.textContent = money(total());\n      if (total() > 0) { errItems.textContent = ''; }\n    }\n\n    function buildItems() {\n      itemsBox.innerHTML = '';\n      items.forEach(function (it, i) {\n        var row = document.createElement('div');\n        row.className = 'bl-po-row';\n\n        var info = document.createElement('div');\n        info.className = 'bl-po-info';\n        var nm = document.createElement('span');\n        nm.className = 'bl-po-name';\n        nm.id = 'bl-po-n-' + i;\n        nm.textContent = it.name;\n        var pr = document.createElement('span');\n        pr.className = 'bl-po-price';\n        pr.textContent = money(it.price) + ' each';\n        info.appendChild(nm);\n        info.appendChild(pr);\n\n        var step = document.createElement('div');\n        step.className = 'bl-po-step';\n        var minus = document.createElement('button');\n        minus.type = 'button';\n        minus.textContent = '\\u2212';\n        minus.setAttribute('aria-label', 'Remove one ' + it.name);\n        var input = document.createElement('input');\n        input.type = 'number';\n        input.min = '0';\n        input.max = String(MAX_QTY);\n        input.step = '1';\n        input.value = '0';\n        input.inputMode = 'numeric';\n        input.setAttribute('aria-labelledby', 'bl-po-n-' + i);\n        var plus = document.createElement('button');\n        plus.type = 'button';\n        plus.textContent = '+';\n        plus.setAttribute('aria-label', 'Add one ' + it.name);\n\n        minus.addEventListener('click', function () {\n          input.value = clampQty(input.value) - 1 < 0 ? 0 : clampQty(input.value) - 1;\n          updateTotal();\n        });\n        plus.addEventListener('click', function () {\n          input.value = Math.min(MAX_QTY, clampQty(input.value) + 1);\n          updateTotal();\n        });\n        input.addEventListener('input', updateTotal);\n        input.addEventListener('change', function () {\n          input.value = clampQty(input.value);\n          updateTotal();\n        });\n\n        step.appendChild(minus);\n        step.appendChild(input);\n        step.appendChild(plus);\n        row.appendChild(info);\n        row.appendChild(step);\n        itemsBox.appendChild(row);\n        qtyInputs.push(input);\n      });\n      updateTotal();\n    }\n\n    function updateHint() {\n      var t = today();\n      var range = to12(t.openMin) + ' to ' + to12(t.closeMin);\n      hintEl.textContent = 'Today is ' + t.name + '. We are open ' + range + '. Pickup must be in that window.';\n      timeEl.min = pad(Math.floor(t.openMin / 60)) + ':' + pad(t.openMin % 60);\n      timeEl.max = pad(Math.floor(t.closeMin / 60)) + ':' + pad(t.closeMin % 60);\n    }\n\n    // Returns normalised 10-digit Indian mobile number, or '' if invalid.\n    function cleanPhone(raw) {\n      var d = String(raw).replace(/[\\s\\-().]/g, '');\n      if (d.indexOf('+91') === 0) { d = d.slice(3); }\n      else if (d.indexOf('0091') === 0) { d = d.slice(4); }\n      else if (d.length === 12 && d.indexOf('91') === 0) { d = d.slice(2); }\n      else if (d.length === 11 && d.charAt(0) === '0') { d = d.slice(1); }\n      return /^[6-9]\\d{9}$/.test(d) ? d : '';\n    }\n\n    function setErr(input, el, msg) {\n      el.textContent = msg;\n      if (input) {\n        if (msg) { input.setAttribute('aria-invalid', 'true'); }\n        else { input.removeAttribute('aria-invalid'); }\n      }\n    }\n\n    function validate() {\n      var first = null;\n      var t = today();\n\n      var name = nameEl.value.trim();\n      if (!name) { setErr(nameEl, errName, 'Please enter your name.'); first = first || nameEl; }\n      else { setErr(nameEl, errName, ''); }\n\n      var phone = cleanPhone(phoneEl.value);\n      if (!phone) { setErr(phoneEl, errPhone, 'Enter a valid 10-digit mobile number, for example 98450 00000.'); first = first || phoneEl; }\n      else { setErr(phoneEl, errPhone, ''); }\n\n      var tv = timeEl.value;\n      if (!/^\\d{1,2}:\\d{2}$/.test(tv)) {\n        setErr(timeEl, errTime, 'Please choose a pickup time.');\n        first = first || timeEl;\n      } else {\n        var m = toMin(tv);\n        if (m < t.openMin || m > t.closeMin) {\n          setErr(timeEl, errTime, 'Pickup time must be between ' + to12(t.openMin) + ' and ' + to12(t.closeMin) + ' today (' + t.name + ').');\n          first = first || timeEl;\n        } else { setErr(timeEl, errTime, ''); }\n      }\n\n      var ls = lines();\n      if (!ls.length) { errItems.textContent = 'Add at least one item to your order.'; first = first || qtyInputs[0]; }\n      else { errItems.textContent = ''; }\n\n      if (first) { return { ok: false, focus: first }; }\n      return { ok: true, name: name, phone: phone, time: tv, lines: ls, day: t.name };\n    }\n\n    function buildMessage(o) {\n      var parts = [];\n      parts.push('Brew Lab pre-order');\n      parts.push('Name: ' + o.name);\n      parts.push('Phone: +91 ' + o.phone.slice(0, 5) + ' ' + o.phone.slice(5));\n      parts.push('Pickup time: ' + to12(toMin(o.time), true) + ' today (' + o.day + ')');\n      parts.push('Items:');\n      o.lines.forEach(function (l) {\n        parts.push('- ' + l.qty + ' x ' + l.name + ' (' + money(l.sub) + ')');\n      });\n      parts.push('Total: ' + money(o.lines.reduce(function (s, l) { return s + l.sub; }, 0)));\n      parts.push('Payment at pickup.');\n      return parts.join('\\n');\n    }\n\n    function buildUrl(o) {\n      return 'https://wa.me/' + WA_NUMBER + '?text=' + encodeURIComponent(buildMessage(o));\n    }\n\n    form.addEventListener('submit', function (e) {\n      e.preventDefault();\n      statusEl.textContent = '';\n      var o = validate();\n      if (!o.ok) {\n        try { o.focus.focus(); } catch (err) { /* ignore */ }\n        return;\n      }\n      var url = buildUrl(o);\n      var w = null;\n      try { w = window.open(url, '_blank'); if (w) { w.opener = null; } } catch (err) { w = null; }\n      statusEl.textContent = '';\n      var msg = document.createElement('span');\n      msg.textContent = w ? 'Opening WhatsApp. Send the message to confirm your order. Payment is at pickup. ' : 'If WhatsApp did not open, tap this link to send your order. Payment is at pickup. ';\n      var a = document.createElement('a');\n      a.href = url;\n      a.target = '_blank';\n      a.rel = 'noopener';\n      a.textContent = 'Open WhatsApp';\n      statusEl.appendChild(msg);\n      statusEl.appendChild(a);\n    });\n\n    // Clear field errors as the visitor fixes them.\n    nameEl.addEventListener('input', function () { setErr(nameEl, errName, ''); });\n    phoneEl.addEventListener('input', function () { setErr(phoneEl, errPhone, ''); });\n    timeEl.addEventListener('input', function () { setErr(timeEl, errTime, ''); });\n\n    // Exposed for checks and other sections.\n    window.BrewLab = window.BrewLab || {};\n    window.BrewLab.preorder = { total: total, buildUrl: buildUrl, buildMessage: buildMessage };\n\n    buildItems();\n    updateHint();\n    document.addEventListener('visibilitychange', function () { if (!document.hidden) { updateHint(); } });\n  })();\n  </script>\n</section>",
    "workflow": "Pre-order form with WhatsApp handoff"
  },
