    "body": "<style>\n#loyalty .bl-stamps{list-style:none;margin:16px 0;padding:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}\n#loyalty .bl-stamp{display:flex;align-items:center;justify-content:center;aspect-ratio:1/1;min-width:0;border:2px dashed var(--bl-accent);border-radius:50%;background:#fff;color:var(--bl-accent);font-weight:700;font-size:1rem;line-height:1}\n#loyalty .bl-stamp-free{border-style:solid;background:var(--bl-accent);color:#fff;font-size:.8rem;letter-spacing:.03em}\n#loyalty .bl-loyalty-note{margin:0;font-weight:600}\n@media (min-width:640px){\n  #loyalty .bl-stamps{grid-template-columns:repeat(10,minmax(0,1fr));gap:10px}\n  #loyalty .bl-stamp{font-size:1.1rem}\n  #loyalty .bl-stamp-free{font-size:.85rem}\n}\n</style>\n<section id=\"loyalty\" class=\"bl-section\" aria-labelledby=\"loyalty-title\">\n  <div class=\"bl-wrap\">\n    <h2 id=\"loyalty-title\">Loyalty card</h2>\n    <div class=\"bl-card\">\n      <p>Collect 10 stamps on your card.</p>\n      <ol class=\"bl-stamps\" aria-label=\"Loyalty card with 10 stamps\">\n        <li class=\"bl-stamp\" aria-label=\"Stamp 1\">1</li>\n        <li class=\"bl-stamp\" aria-label=\"Stamp 2\">2</li>\n        <li class=\"bl-stamp\" aria-label=\"Stamp 3\">3</li>\n        <li class=\"bl-stamp\" aria-label=\"Stamp 4\">4</li>\n        <li class=\"bl-stamp\" aria-label=\"Stamp 5\">5</li>\n        <li class=\"bl-stamp\" aria-label=\"Stamp 6\">6</li>\n        <li class=\"bl-stamp\" aria-label=\"Stamp 7\">7</li>\n        <li class=\"bl-stamp\" aria-label=\"Stamp 8\">8</li>\n        <li class=\"bl-stamp\" aria-label=\"Stamp 9\">9</li>\n        <li class=\"bl-stamp bl-stamp-free\" aria-label=\"Stamp 10: FREE\">FREE</li>\n      </ol>\n      <p class=\"bl-loyalty-note\">The 10th stamp gives you one free drink of any size.</p>\n    </div>\n  </div>\n</section>",
    "workflow": "Loyalty card"
  },
