{
  "W-1": {
    "owner": "W-1",
    "head": "<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"description\" content=\"Brew Lab, a cafe on 100 Feet Road, Indiranagar, Bengaluru. Menu, hours, location and pickup pre-orders.\">\n<style>\n*,*::before,*::after{box-sizing:border-box}\n:root{--bg:#faf6f0;--ink:#2b1d14;--muted:#6b5a4d;--accent:#8a4b24;--accent-dark:#6d3a1b;--card:#ffffff;--line:#e6dccd}\nhtml{scroll-behavior:smooth}\nbody{margin:0;font:16px/1.6 system-ui,-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif;color:var(--ink);background:var(--bg)}\nimg,svg{max-width:100%}\nh1,h2,h3{line-height:1.2;margin:0 0 .5em}\nh2{font-size:1.75rem}\na{color:var(--accent)}\n.section{max-width:1100px;margin:0 auto;padding:48px 16px;scroll-margin-top:8px}\n.btn{display:inline-block;padding:12px 20px;border-radius:8px;background:var(--accent);color:#fff;text-decoration:none;font-weight:600}\n.btn:hover,.btn:focus{background:var(--accent-dark)}\n</style>",
    "body": "<style>\n.bl-header{background:var(--ink);color:#fff}\n.bl-header-inner{max-width:1100px;margin:0 auto;padding:16px}\n.bl-brand{font-size:1.5rem;font-weight:700;color:#fff;text-decoration:none}\n.bl-nav ul{list-style:none;margin:12px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:4px 16px}\n.bl-nav a{color:#f3e6d6;text-decoration:none;padding:6px 0;display:inline-block}\n.bl-nav a:hover,.bl-nav a:focus{color:#fff;text-decoration:underline}\n.bl-hero{max-width:1100px;margin:0 auto;padding:40px 16px 8px}\n.bl-hero h1{font-size:2.25rem}\n.bl-hero p{margin:0 0 20px;color:var(--muted);max-width:40em}\n.bl-menu-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:16px}\n.bl-card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:20px}\n.bl-card h3{font-size:1.15rem;color:var(--accent)}\n.bl-menu-list{list-style:none;margin:0;padding:0}\n.bl-menu-list li{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px dashed var(--line)}\n.bl-menu-list li:last-child{border-bottom:0}\n.bl-price{font-weight:600;white-space:nowrap}\n.bl-info{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:16px}\n.bl-info address{font-style:normal;overflow-wrap:anywhere}\n.bl-info p{margin:0 0 .6em}\n.bl-big{font-size:1.4rem;font-weight:600;margin:0 0 .3em}\n.bl-gallery{display:grid;grid-template-columns:1fr;gap:12px}\n.bl-gallery figure{margin:0;border-radius:12px;overflow:hidden;background:var(--card);border:1px solid var(--line)}\n.bl-gallery img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover}\n.bl-note{color:var(--muted);margin:0 0 16px}\n@media(min-width:600px){.bl-gallery{grid-template-columns:repeat(2,1fr)}}\n@media(min-width:900px){\n.bl-gallery{grid-template-columns:repeat(3,1fr)}\n.bl-gallery figure:first-child{grid-column:span 2;grid-row:span 2;display:flex}\n.bl-gallery figure:first-child img{height:100%;aspect-ratio:auto;flex:1}\n.bl-hero h1{font-size:2.75rem}\n}\n</style>\n\n<header class=\"bl-header\" id=\"top\">\n  <div class=\"bl-header-inner\">\n    <a class=\"bl-brand\" href=\"#top\">Brew Lab</a>\n    <nav class=\"bl-nav\" aria-label=\"Main\">\n      <ul>\n        <li><a href=\"#menu\">Menu</a></li>\n        <li><a href=\"#hours\">Hours</a></li>\n        <li><a href=\"#location\">Location</a></li>\n        <li><a href=\"#gallery\">Gallery</a></li>\n        <li><a href=\"#farms\">Our farms</a></li>\n        <li><a href=\"#preorder\">Pre-order</a></li>\n      </ul>\n    </nav>\n  </div>\n</header>\n\n<div class=\"bl-hero\">\n  <h1>Brew Lab, Indiranagar</h1>\n  <p>A cafe on 100 Feet Road, Indiranagar, Bengaluru. See the menu, find us, and pre-order for pickup.</p>\n  <a class=\"btn\" href=\"#preorder\">Pre-order for pickup</a>\n</div>\n\n<section class=\"section\" id=\"menu\" aria-labelledby=\"menu-h\">\n  <h2 id=\"menu-h\">Menu</h2>\n  <div class=\"bl-menu-grid\">\n    <div class=\"bl-card\">\n      <h3>Coffee</h3>\n      <ul class=\"bl-menu-list\">\n        <li><span>Espresso</span><span class=\"bl-price\">₹120</span></li>\n        <li><span>Cappuccino</span><span class=\"bl-price\">₹180</span></li>\n        <li><span>Pour-over</span><span class=\"bl-price\">₹220</span></li>\n      </ul>\n    </div>\n    <div class=\"bl-card\">\n      <h3>Cold</h3>\n      <ul class=\"bl-menu-list\">\n        <li><span>Cold brew</span><span class=\"bl-price\">₹200</span></li>\n      </ul>\n    </div>\n    <div class=\"bl-card\">\n      <h3>Food</h3>\n      <ul class=\"bl-menu-list\">\n        <li><span>Croissant</span><span class=\"bl-price\">₹150</span></li>\n        <li><span>Banana bread</span><span class=\"bl-price\">₹130</span></li>\n      </ul>\n    </div>\n  </div>\n</section>\n\n<section class=\"section\" id=\"hours\" aria-labelledby=\"hours-h\">\n  <h2 id=\"hours-h\">Hours</h2>\n  <div class=\"bl-card\">\n    <p class=\"bl-big\">8am to 10pm</p>\n    <p>Open every day.</p>\n  </div>\n</section>\n\n<section class=\"section\" id=\"location\" aria-labelledby=\"location-h\">\n  <h2 id=\"location-h\">Location</h2>\n  <div class=\"bl-info\">\n    <div class=\"bl-card\">\n      <h3>Address</h3>\n      <address>100 Feet Road, Indiranagar, Bengaluru 560038</address>\n      <p style=\"margin-top:12px\"><a href=\"https://www.google.com/maps/search/?api=1&amp;query=100+Feet+Road+Indiranagar+Bengaluru+560038\" target=\"_blank\" rel=\"noopener\">Open in Google Maps</a></p>\n    </div>\n    <div class=\"bl-card\">\n      <h3>Phone</h3>\n      <p class=\"bl-big\"><a href=\"tel:+918040002468\">+91 80 4000 2468</a></p>\n    </div>\n  </div>\n</section>\n\n<section class=\"section\" id=\"gallery\" aria-labelledby=\"gallery-h\">\n  <h2 id=\"gallery-h\">Gallery</h2>\n  <p class=\"bl-note\">Drawings for now. Real cafe photos will replace them when we have them.</p>\n  <div class=\"bl-gallery\">\n    <figure><img alt=\"Drawing of a white coffee cup on a saucer with three curls of steam rising\" src=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'><rect width='400' height='300' fill='rgb(245,230,211)'/><path d='M130 130h140v70a50 50 0 0 1-50 50h-40a50 50 0 0 1-50-50z' fill='white' stroke='rgb(60,36,21)' stroke-width='6'/><path d='M270 150h20a25 25 0 0 1 0 50h-22' fill='none' stroke='rgb(60,36,21)' stroke-width='6'/><ellipse cx='200' cy='130' rx='70' ry='10' fill='rgb(111,78,55)'/><path d='M170 105q-15-20 0-40M200 105q-15-20 0-40M230 105q-15-20 0-40' fill='none' stroke='rgb(150,120,100)' stroke-width='5' stroke-linecap='round'/><rect x='90' y='250' width='220' height='10' rx='5' fill='rgb(60,36,21)'/></svg>\"></figure>\n    <figure><img alt=\"Drawing of an espresso machine with two dials and a cup catching a stream of coffee\" src=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'><rect width='400' height='300' fill='rgb(226,236,232)'/><rect x='80' y='50' width='240' height='150' rx='14' fill='rgb(90,90,100)'/><rect x='100' y='70' width='200' height='40' rx='6' fill='rgb(60,60,70)'/><circle cx='130' cy='90' r='10' fill='rgb(230,190,90)'/><circle cx='170' cy='90' r='10' fill='rgb(230,190,90)'/><rect x='180' y='140' width='40' height='24' fill='rgb(40,40,45)'/><path d='M200 164v20' stroke='rgb(111,78,55)' stroke-width='5'/><rect x='170' y='184' width='60' height='36' rx='8' fill='white' stroke='rgb(60,36,21)' stroke-width='4'/><rect x='60' y='220' width='280' height='20' rx='6' fill='rgb(60,36,21)'/></svg>\"></figure>\n    <figure><img alt=\"Drawing of a pour-over dripper sitting on a glass carafe half full of coffee\" src=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'><rect width='400' height='300' fill='rgb(240,228,214)'/><polygon points='120,60 280,60 220,140 180,140' fill='white' stroke='rgb(60,36,21)' stroke-width='5'/><rect x='190' y='140' width='20' height='30' fill='rgb(60,36,21)'/><path d='M150 170h100l20 90h-140z' fill='rgb(200,220,230)' stroke='rgb(60,36,21)' stroke-width='5'/><polygon points='140,215 260,215 270,260 130,260' fill='rgb(111,78,55)'/><circle cx='200' cy='195' r='4' fill='rgb(111,78,55)'/><rect x='90' y='260' width='220' height='10' rx='5' fill='rgb(60,36,21)'/></svg>\"></figure>\n    <figure><img alt=\"Drawing of a golden croissant on a white plate\" src=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'><rect width='400' height='300' fill='rgb(250,236,214)'/><ellipse cx='200' cy='235' rx='140' ry='22' fill='white' stroke='rgb(180,160,140)' stroke-width='4'/><path d='M90 205Q110 110 200 100Q290 110 310 205Q280 175 250 195Q220 165 200 195Q180 165 150 195Q120 175 90 205z' fill='rgb(222,158,72)' stroke='rgb(150,90,30)' stroke-width='5'/><path d='M150 195Q155 140 175 108M200 195L200 100M250 195Q245 140 225 108' fill='none' stroke='rgb(150,90,30)' stroke-width='4'/></svg>\"></figure>\n    <figure><img alt=\"Drawing of the cafe storefront with a striped awning, a wooden door and a Brew Lab sign\" src=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'><rect width='400' height='300' fill='rgb(214,232,245)'/><rect x='60' y='90' width='280' height='170' fill='rgb(180,110,80)'/><rect x='50' y='90' width='50' height='40' fill='rgb(190,60,50)'/><rect x='100' y='90' width='50' height='40' fill='white'/><rect x='150' y='90' width='50' height='40' fill='rgb(190,60,50)'/><rect x='200' y='90' width='50' height='40' fill='white'/><rect x='250' y='90' width='50' height='40' fill='rgb(190,60,50)'/><rect x='300' y='90' width='50' height='40' fill='white'/><rect x='130' y='40' width='140' height='34' rx='6' fill='rgb(60,36,21)'/><text x='200' y='63' text-anchor='middle' font-family='sans-serif' font-size='20' font-weight='bold' fill='white'>Brew Lab</text><rect x='170' y='160' width='60' height='100' fill='rgb(60,36,21)'/><rect x='80' y='150' width='70' height='60' fill='rgb(255,244,214)' stroke='rgb(60,36,21)' stroke-width='4'/><rect x='250' y='150' width='70' height='60' fill='rgb(255,244,214)' stroke='rgb(60,36,21)' stroke-width='4'/><rect y='260' width='400' height='40' fill='rgb(130,130,130)'/></svg>\"></figure>\n    <figure><img alt=\"Drawing of a tall glass of cold brew coffee with ice cubes and a red straw\" src=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'><rect width='400' height='300' fill='rgb(232,238,226)'/><line x1='230' y1='40' x2='200' y2='150' stroke='rgb(200,60,60)' stroke-width='8' stroke-linecap='round'/><path d='M140 70h120l-12 180h-96z' fill='rgb(255,255,255)' fill-opacity='0.6' stroke='rgb(60,36,21)' stroke-width='5'/><polygon points='143,120 257,120 248,250 152,250' fill='rgb(80,50,30)'/><rect x='160' y='130' width='34' height='34' rx='6' fill='white' fill-opacity='0.5' transform='rotate(-10 177 147)'/><rect x='205' y='155' width='34' height='34' rx='6' fill='white' fill-opacity='0.5' transform='rotate(12 222 172)'/><rect x='110' y='250' width='180' height='10' rx='5' fill='rgb(60,36,21)'/></svg>\"></figure>\n  </div>\n</section>",
    "workflow": "Page shell, menu, hours, location and gallery"
  },
  "W-2": {
    "owner": "W-2",
    "head": "",
    "body": "<style>\n.bl-farms-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:16px}\n.bl-farm{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:20px;display:flex;flex-direction:column}\n.bl-farm h3{font-size:1.25rem;color:var(--accent);margin-bottom:.2em;overflow-wrap:anywhere}\n.bl-farm-loc{margin:0 0 12px;color:var(--muted);font-weight:600}\n.bl-farm p{margin:0 0 .8em}\n.bl-farm-facts{margin:auto 0 0;padding:12px 0 0 1.1em;border-top:1px dashed var(--line)}\n.bl-farm-facts li{margin:0 0 .3em;overflow-wrap:anywhere}\n</style>\n<section class=\"section\" id=\"farms\" aria-labelledby=\"farms-h\">\n  <h2 id=\"farms-h\">Our farms</h2>\n  <p class=\"bl-note\">The story behind our coffee, from three farms in Chikmagalur and Coorg.</p>\n  <div class=\"bl-farms-grid\">\n    <article class=\"bl-farm\" aria-labelledby=\"farm-ratnagiri-h\">\n      <h3 id=\"farm-ratnagiri-h\">Ratnagiri Estate</h3>\n      <p class=\"bl-farm-loc\">Chikmagalur</p>\n      <p>Ratnagiri Estate is a family estate. It grows its Arabica in the shade, at an altitude of 1,400 m.</p>\n      <p>The estate is known for its natural-process lots, which have fruity notes.</p>\n      <ul class=\"bl-farm-facts\">\n        <li>Family estate</li>\n        <li>Shade-grown Arabica</li>\n        <li>1,400 m</li>\n        <li>Natural-process lots with fruity notes</li>\n      </ul>\n    </article>\n    <article class=\"bl-farm\" aria-labelledby=\"farm-kerehaklu-h\">\n      <h3 id=\"farm-kerehaklu-h\">Kerehaklu</h3>\n      <p class=\"bl-farm-loc\">Chikmagalur</p>\n      <p>Kerehaklu is a fourth-generation farm. It replants native forest trees on the land.</p>\n      <p>Coffee here grows alongside pepper and cardamom.</p>\n      <ul class=\"bl-farm-facts\">\n        <li>Fourth-generation farm</li>\n        <li>Replants native forest trees</li>\n        <li>Coffee grown alongside pepper and cardamom</li>\n      </ul>\n    </article>\n    <article class=\"bl-farm\" aria-labelledby=\"farm-baarbara-h\">\n      <h3 id=\"farm-baarbara-h\">Baarbara Estate</h3>\n      <p class=\"bl-farm-loc\">Coorg</p>\n      <p>Baarbara Estate is a small estate. Only ripe cherries are hand-picked.</p>\n      <p>The cherries are then dried slowly on raised beds.</p>\n      <ul class=\"bl-farm-facts\">\n        <li>Small estate</li>\n        <li>Only ripe cherries, hand-picked</li>\n        <li>Dried slowly on raised beds</li>\n      </ul>\n    </article>\n  </div>\n</section>",
    "workflow": "Three coffee farm story blocks"
  },
  "W-3": {
    "owner": "W-3",
    "head": "",
    "body": "<style>\n.bl-po{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:20px;max-width:640px}\n.bl-po-terms{margin:0 0 16px;padding:12px 14px;background:var(--bg);border-left:4px solid var(--accent);border-radius:6px}\n.bl-po-terms p{margin:0 0 .3em}\n.bl-po-terms p:last-child{margin:0}\n.bl-po fieldset{border:0;margin:0 0 16px;padding:0;min-width:0}\n.bl-po legend{font-weight:600;padding:0;margin:0 0 8px}\n.bl-po-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px dashed var(--line)}\n.bl-po-row:last-child{border-bottom:0}\n.bl-po-row label{flex:1 1 auto;min-width:0;overflow-wrap:anywhere}\n.bl-po-row input{flex:0 0 72px;width:72px}\n.bl-po-name{display:block;font-weight:600;margin:0 0 6px}\n.bl-po input[type=text],.bl-po input[type=number]{font:inherit;padding:10px;border:1px solid var(--muted);border-radius:8px;background:#fff;color:var(--ink)}\n.bl-po input[type=text]{width:100%;margin-bottom:16px}\n.bl-po-total{font-weight:600;margin:0 0 12px}\n.bl-po-error{color:#a11d1d;background:#fdeeee;border:1px solid #e3b4b4;border-radius:8px;padding:10px 12px;margin:0 0 12px}\n.bl-po-error[hidden]{display:none}\n.bl-po button{font:inherit;border:0;cursor:pointer;width:100%}\n</style>\n<section class=\"section\" id=\"preorder\" aria-labelledby=\"preorder-h\">\n  <h2 id=\"preorder-h\">Pre-order for pickup</h2>\n  <div class=\"bl-po\">\n    <div class=\"bl-po-terms\">\n      <p><strong>Payment is at pickup.</strong></p>\n      <p>Pickup is within 15 minutes of ordering.</p>\n      <p>Your order opens as a WhatsApp message to Brew Lab. Send it to place the order.</p>\n    </div>\n    <form id=\"po-form\" novalidate>\n      <fieldset>\n        <legend>Choose items and quantities</legend>\n        <div class=\"bl-po-row\"><label for=\"po-q0\">Espresso (₹120)</label><input type=\"number\" id=\"po-q0\" min=\"0\" max=\"20\" step=\"1\" value=\"0\" inputmode=\"numeric\" data-name=\"Espresso\" data-price=\"120\"></div>\n        <div class=\"bl-po-row\"><label for=\"po-q1\">Cappuccino (₹180)</label><input type=\"number\" id=\"po-q1\" min=\"0\" max=\"20\" step=\"1\" value=\"0\" inputmode=\"numeric\" data-name=\"Cappuccino\" data-price=\"180\"></div>\n        <div class=\"bl-po-row\"><label for=\"po-q2\">Pour-over (₹220)</label><input type=\"number\" id=\"po-q2\" min=\"0\" max=\"20\" step=\"1\" value=\"0\" inputmode=\"numeric\" data-name=\"Pour-over\" data-price=\"220\"></div>\n        <div class=\"bl-po-row\"><label for=\"po-q3\">Cold brew (₹200)</label><input type=\"number\" id=\"po-q3\" min=\"0\" max=\"20\" step=\"1\" value=\"0\" inputmode=\"numeric\" data-name=\"Cold brew\" data-price=\"200\"></div>\n        <div class=\"bl-po-row\"><label for=\"po-q4\">Croissant (₹150)</label><input type=\"number\" id=\"po-q4\" min=\"0\" max=\"20\" step=\"1\" value=\"0\" inputmode=\"numeric\" data-name=\"Croissant\" data-price=\"150\"></div>\n        <div class=\"bl-po-row\"><label for=\"po-q5\">Banana bread (₹130)</label><input type=\"number\" id=\"po-q5\" min=\"0\" max=\"20\" step=\"1\" value=\"0\" inputmode=\"numeric\" data-name=\"Banana bread\" data-price=\"130\"></div>\n      </fieldset>\n      <label class=\"bl-po-name\" for=\"po-name\">Your name</label>\n      <input type=\"text\" id=\"po-name\" maxlength=\"60\" autocomplete=\"name\">\n      <p class=\"bl-po-total\" id=\"po-total\" aria-live=\"polite\">Total: ₹0</p>\n      <p class=\"bl-po-error\" id=\"po-error\" role=\"alert\" hidden></p>\n      <button type=\"submit\" class=\"btn\">Send order on WhatsApp</button>\n    </form>\n  </div>\n  <script>\n  (function () {\n    var form = document.getElementById('po-form');\n    var nameEl = document.getElementById('po-name');\n    var errEl = document.getElementById('po-error');\n    var totalEl = document.getElementById('po-total');\n    if (!form || !nameEl || !errEl || !totalEl) { return; }\n    var inputs = form.querySelectorAll('input[type=number]');\n\n    function readItems() {\n      var items = [], bad = false, total = 0, i, el, raw, q, price;\n      for (i = 0; i < inputs.length; i++) {\n        el = inputs[i];\n        raw = String(el.value).trim();\n        if (raw === '') { continue; }\n        q = Number(raw);\n        if (!isFinite(q) || q % 1 !== 0 || q < 0 || q > 20) { bad = true; continue; }\n        if (q > 0) {\n          price = Number(el.getAttribute('data-price'));\n          items.push({ name: el.getAttribute('data-name'), qty: q, price: price });\n          total += q * price;\n        }\n      }\n      return { items: items, bad: bad, total: total };\n    }\n\n    function updateTotal() {\n      var r = readItems();\n      totalEl.textContent = 'Total: \\u20B9' + (r.bad ? 0 : r.total);\n    }\n\n    function showError(msg) { errEl.textContent = msg; errEl.hidden = false; }\n    function clearError() { errEl.textContent = ''; errEl.hidden = true; }\n\n    form.addEventListener('input', function () { updateTotal(); clearError(); });\n\n    form.addEventListener('submit', function (e) {\n      e.preventDefault();\n      var r = readItems();\n      var name = nameEl.value.replace(/\\s+/g, ' ').trim();\n      if (r.bad) { showError('Quantities must be whole numbers from 0 to 20.'); return; }\n      if (r.items.length === 0) { showError('Please choose at least one item.'); return; }\n      if (!name) { showError('Please enter your name.'); nameEl.focus(); return; }\n      clearError();\n      var lines = ['Brew Lab pickup order', 'Name: ' + name, 'Items:'], i;\n      for (i = 0; i < r.items.length; i++) {\n        lines.push('- ' + r.items[i].qty + ' x ' + r.items[i].name + ' (\\u20B9' + (r.items[i].qty * r.items[i].price) + ')');\n      }\n      lines.push('Total: \\u20B9' + r.total, 'Payment at pickup.');\n      var url = 'https://wa.me/919845000000?text=' + encodeURIComponent(lines.join('\\n'));\n      var w = null;\n      try { w = window.open(url, '_blank', 'noopener'); } catch (err) { w = null; }\n      if (!w) { window.location.href = url; }\n    });\n\n    updateTotal();\n  })();\n  </script>\n</section>",
    "workflow": "Pickup pre-order form via WhatsApp"
  }
}