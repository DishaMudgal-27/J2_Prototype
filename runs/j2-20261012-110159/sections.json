{
  "style": {
    "owner": "W-1",
    "head": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&amp;family=Nunito:wght@400;600;700&amp;display=swap\"><style>:root{--j2-primary:#9C3D12;--j2-secondary:#2F5D3A;--j2-accent:#E3A72F;--j2-background:#FFF8EC;--j2-surface:#FFFFFF;--j2-text:#2E1F14;--j2-muted:#6B5646;--j2-font-heading:'Fraunces', Georgia, 'Times New Roman', serif;--j2-font-body:'Nunito', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:12px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;background:#9C3D12;color:#FFFFFF;border:2px solid #9C3D12;min-height:44px;padding:0 24px;border-radius:999px;font-weight:700;font-size:1rem;cursor:pointer}.j2-btn-secondary{display:inline-block;background:transparent;color:#9C3D12;border:2px solid #9C3D12;min-height:44px;padding:0 24px;border-radius:999px;font-weight:700;font-size:1rem;cursor:pointer}.j2-card{background:#FFFFFF;border:1px solid #EAD7B8;border-radius:12px;padding:20px;box-shadow:0 2px 8px rgba(94,52,20,0.08)}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-1": {
    "owner": "W-1",
    "head": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"description\" content=\"Kaveri Kitchen, a South Indian restaurant in Kothrud, Pune. See the menu with prices, today's specials, opening hours and book a table on WhatsApp.\">\n<meta name=\"theme-color\" content=\"#9C3D12\">\n<style>\n*,*::before,*::after{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%;scroll-padding-top:72px}\n@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}\nbody{margin:0;max-width:100%;overflow-x:hidden;overflow-x:clip;background:var(--j2-background,#FFF8EC);color:var(--j2-text,#2E1F14);font-family:var(--j2-font-body,'Nunito',system-ui,sans-serif);font-size:1rem;line-height:1.6}\nimg,video,svg{max-width:100%;height:auto}\n:where(h1,h2,h3,h4){font-family:var(--j2-font-heading,'Fraunces',Georgia,serif);line-height:1.2;color:var(--j2-text,#2E1F14);overflow-wrap:break-word}\n:where(p,li,a,td,th,label,button,input,select,textarea){overflow-wrap:break-word}\n:where(section[id]){padding:48px 16px}\n@media (min-width:768px){:where(section[id]){padding:var(--j2-section,64px) 24px}}\n:where(a){color:var(--j2-primary,#9C3D12)}\n:where(a,button,input,select,textarea):focus-visible{outline:3px solid var(--j2-secondary,#2F5D3A);outline-offset:2px}\n</style>",
    "body": "<div class=\"kk-shell\">\n<style>\n.kk-shell{display:block;max-width:100%}\n.kk-shell .kk-wrap{max-width:1080px;margin:0 auto;padding:0 16px}\n.kk-shell .kk-header{background:var(--j2-surface,#FFFFFF);border-bottom:4px solid var(--j2-accent,#E3A72F);z-index:50}\n.kk-shell .kk-bar{max-width:1080px;margin:0 auto;padding:8px 16px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:4px 16px}\n.kk-shell .kk-brand{font-family:var(--j2-font-heading,'Fraunces',Georgia,serif);font-weight:700;font-size:1.4rem;color:var(--j2-primary,#9C3D12);text-decoration:none;min-height:44px;display:inline-flex;align-items:center}\n.kk-shell .kk-nav ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:0 4px}\n.kk-shell .kk-nav a{display:inline-flex;align-items:center;min-height:44px;padding:0 10px;color:var(--j2-text,#2E1F14);font-weight:600;text-decoration:none;border-radius:8px}\n.kk-shell .kk-nav a:hover{color:var(--j2-primary,#9C3D12);text-decoration:underline;text-underline-offset:4px}\n@media (min-width:768px){.kk-shell .kk-header{position:sticky;top:0}.kk-shell .kk-nav a{padding:0 14px}}\n.kk-shell .kk-hero{background:linear-gradient(165deg,#FFF1D6 0%,#FBE0B8 100%);padding:48px 0 56px;position:relative}\n.kk-shell .kk-hero::after{content:\"\";position:absolute;left:0;right:0;bottom:0;height:8px;background:repeating-linear-gradient(90deg,var(--j2-primary,#9C3D12) 0 16px,var(--j2-accent,#E3A72F) 16px 32px,var(--j2-secondary,#2F5D3A) 32px 48px)}\n.kk-shell .kk-kicker{margin:0 0 8px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;font-size:.85rem;color:var(--j2-secondary,#2F5D3A)}\n.kk-shell .kk-hero h1{margin:0 0 12px;font-size:clamp(2.2rem,9vw,3.8rem);color:var(--j2-primary,#9C3D12)}\n.kk-shell .kk-lead{margin:0 0 24px;max-width:36em;font-size:1.125rem;color:var(--j2-text,#2E1F14)}\n.kk-shell .kk-actions{display:flex;flex-wrap:wrap;gap:12px}\n.kk-shell .j2-btn,.kk-shell .j2-btn-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:44px;text-decoration:none}\n.kk-shell .j2-btn-secondary{background:rgba(255,255,255,.6)}\n</style>\n\n<!-- Anchors expected from the other sections: menu, specials, photos, reviews, book, visit -->\n<header class=\"kk-header\" id=\"top\">\n  <div class=\"kk-bar\">\n    <a class=\"kk-brand\" href=\"#top\">Kaveri Kitchen</a>\n    <nav class=\"kk-nav\" aria-label=\"Main\">\n      <ul>\n        <li><a href=\"#menu\">Menu</a></li>\n        <li><a href=\"#specials\">Specials</a></li>\n        <li><a href=\"#photos\">Photos</a></li>\n        <li><a href=\"#reviews\">Reviews</a></li>\n        <li><a href=\"#book\">Book</a></li>\n        <li><a href=\"#visit\">Visit</a></li>\n      </ul>\n    </nav>\n  </div>\n</header>\n\n<div class=\"kk-hero\">\n  <div class=\"kk-wrap\">\n    <p class=\"kk-kicker\">South Indian restaurant &middot; Kothrud, Pune</p>\n    <h1>Kaveri Kitchen</h1>\n    <p class=\"kk-lead\">Welcome! Pull up a chair, have a look at the menu and book your table in a minute.</p>\n    <div class=\"kk-actions\">\n      <a class=\"j2-btn\" href=\"#book\">Book a table</a>\n      <a class=\"j2-btn j2-btn-secondary\" href=\"#menu\">See the menu</a>\n    </div>\n  </div>\n</div>\n\n<script>\n(function () {\n  function tidyLinks() {\n    var links = document.querySelectorAll('.kk-shell a[href^=\"#\"]');\n    for (var i = 0; i < links.length; i++) {\n      var a = links[i];\n      var id = a.getAttribute('href').slice(1);\n      if (id && !document.getElementById(id)) {\n        var li = a.closest('li');\n        (li || a).remove();\n      }\n    }\n  }\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', tidyLinks);\n  } else {\n    tidyLinks();\n  }\n})();\n</script>\n</div>",
    "workflow": "Page shell, warm styling, no-offer wording"
  },
  "W-2": {
    "owner": "W-2",
    "head": "",
    "body": "<section id=\"visit\" class=\"kk-visit\" aria-labelledby=\"kk-visit-title\">\n<style>\n.kk-visit{max-width:100%}\n.kk-visit .kk-visit-inner{max-width:1080px;margin:0 auto}\n.kk-visit h2{margin:0 0 8px;font-size:clamp(1.7rem,6vw,2.4rem);color:var(--j2-primary)}\n.kk-visit .kk-visit-intro{margin:0 0 24px;color:var(--j2-muted)}\n.kk-visit .kk-visit-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:16px}\n@media (min-width:768px){.kk-visit .kk-visit-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}}\n.kk-visit .j2-card{min-width:0}\n.kk-visit h3{margin:0 0 12px;font-size:1.2rem;color:var(--j2-secondary)}\n.kk-visit address{font-style:normal;line-height:1.7}\n.kk-visit .kk-place{display:block;font-family:var(--j2-font-heading);font-weight:700;font-size:1.15rem;color:var(--j2-primary)}\n.kk-visit .kk-contact{margin:0;padding:0;list-style:none;display:grid;gap:16px}\n.kk-visit .kk-label{display:block;font-size:.85rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--j2-muted)}\n.kk-visit .kk-number{font-weight:700;font-size:1.1rem;color:var(--j2-text)}\n.kk-visit .kk-number a{color:var(--j2-text)}\n.kk-visit .kk-call{margin-top:8px}\n.kk-visit .kk-hours-main{margin:0 0 12px;font-weight:700;font-size:1.1rem}\n.kk-visit .kk-hours-note{margin:0;padding:8px 12px;border-left:4px solid var(--j2-accent);background:var(--j2-background);border-radius:0 8px 8px 0}\n</style>\n<div class=\"kk-visit-inner\">\n  <h2 id=\"kk-visit-title\">Visit Kaveri Kitchen</h2>\n  <p class=\"kk-visit-intro\">Come find us in Kothrud, or give us a call.</p>\n  <div class=\"kk-visit-grid\">\n    <div class=\"j2-card\">\n      <h3>Address</h3>\n      <address>\n        <span class=\"kk-place\">Kaveri Kitchen</span>\n        7 Karve Road, Kothrud,<br>\n        Pune 411038\n      </address>\n    </div>\n    <div class=\"j2-card\">\n      <h3>Contact</h3>\n      <ul class=\"kk-contact\">\n        <li>\n          <span class=\"kk-label\">WhatsApp bookings</span>\n          <span class=\"kk-number\"><a href=\"https://wa.me/910000033333\">+91 00000 33333</a></span>\n        </li>\n        <li>\n          <span class=\"kk-label\">Restaurant phone</span>\n          <span class=\"kk-number\">+91 00000 44444</span>\n          <div class=\"kk-call\"><a class=\"j2-btn\" href=\"tel:+910000044444\" aria-label=\"Call Kaveri Kitchen on +91 00000 44444\">Call us</a></div>\n        </li>\n      </ul>\n    </div>\n    <div class=\"j2-card\">\n      <h3>Opening hours</h3>\n      <p class=\"kk-hours-main\">8am to 10:30pm, every day</p>\n      <p class=\"kk-hours-note\">The kitchen closes at 10pm.</p>\n    </div>\n  </div>\n</div>\n</section>",
    "workflow": "Name, address, contacts and opening hours"
  },
  "W-3": {
    "owner": "W-3",
    "head": "",
    "body": "<section id=\"menu\" class=\"kk-menu\" aria-labelledby=\"kk-menu-title\">\n<style>\n.kk-menu{max-width:100%}\n.kk-menu .kk-menu-inner{max-width:1080px;margin:0 auto}\n.kk-menu h2{margin:0 0 8px;font-size:clamp(1.7rem,6vw,2.4rem);color:var(--j2-primary)}\n.kk-menu .kk-menu-intro{margin:0 0 20px;color:var(--j2-muted)}\n.kk-menu .kk-filter{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 12px}\n.kk-menu .kk-filter button{font-family:var(--j2-font-body);min-width:88px}\n.kk-menu .kk-filter button[aria-pressed=\"true\"]{background:var(--j2-primary);color:var(--j2-surface)}\n.kk-menu .kk-legend{display:flex;flex-wrap:wrap;gap:4px 16px;margin:0 0 8px;font-size:.9rem;color:var(--j2-muted)}\n.kk-menu .kk-legend span{display:inline-flex;align-items:center;gap:6px}\n.kk-menu .kk-menu-status{margin:0 0 20px;font-size:.9rem;font-weight:700;color:var(--j2-muted)}\n.kk-menu .kk-menu-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:16px}\n@media (min-width:960px){.kk-menu .kk-menu-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;align-items:start}}\n.kk-menu .j2-card{min-width:0}\n.kk-menu h3{margin:0 0 12px;font-size:1.3rem;color:var(--j2-secondary)}\n.kk-menu .kk-dishes{list-style:none;margin:0;padding:0}\n.kk-menu .kk-dish{padding:12px 0;border-top:1px solid #EAD7B8}\n.kk-menu .kk-dish:first-child{border-top:0;padding-top:0}\n.kk-menu .kk-dish:last-child{padding-bottom:0}\n.kk-menu .kk-dish-row{display:flex;justify-content:space-between;align-items:baseline;gap:12px}\n.kk-menu .kk-dish-name{min-width:0;font-weight:700;font-size:1.05rem}\n.kk-menu .kk-price{flex:none;white-space:nowrap;font-weight:700;font-size:1.05rem;color:var(--j2-primary)}\n.kk-menu .kk-mark{display:inline-flex;align-items:center;gap:6px;margin-top:4px;font-size:.85rem;font-weight:700}\n.kk-menu .kk-box{display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;border:2px solid currentColor;border-radius:3px;flex:none}\n.kk-menu .kk-box::after{content:\"\";width:8px;height:8px;border-radius:50%;background:currentColor}\n.kk-menu .kk-nonveg .kk-box::after{border-radius:0;width:0;height:0;background:transparent;border-left:4px solid transparent;border-right:4px solid transparent;border-bottom:8px solid currentColor}\n.kk-menu .kk-veg{color:var(--j2-secondary)}\n.kk-menu .kk-nonveg{color:var(--j2-primary)}\n</style>\n<div class=\"kk-menu-inner\">\n  <h2 id=\"kk-menu-title\">Our menu</h2>\n  <p class=\"kk-menu-intro\">All prices are in rupees.</p>\n  <div class=\"kk-filter\" role=\"group\" aria-label=\"Filter the menu\">\n    <button type=\"button\" class=\"j2-btn-secondary\" data-kk-filter=\"all\" aria-pressed=\"true\">All</button>\n    <button type=\"button\" class=\"j2-btn-secondary\" data-kk-filter=\"veg\" aria-pressed=\"false\">Veg</button>\n    <button type=\"button\" class=\"j2-btn-secondary\" data-kk-filter=\"nonveg\" aria-pressed=\"false\">Non-veg</button>\n  </div>\n  <div class=\"kk-legend\" aria-hidden=\"true\">\n    <span class=\"kk-veg\"><span class=\"kk-box\"></span>Veg</span>\n    <span class=\"kk-nonveg\"><span class=\"kk-box\"></span>Non-veg</span>\n  </div>\n  <p class=\"kk-menu-status\" id=\"kk-menu-status\" role=\"status\" aria-live=\"polite\"></p>\n  <div class=\"kk-menu-grid\" id=\"kk-menu-list\"></div>\n  <noscript><p>Please turn on JavaScript to see the menu.</p></noscript>\n</div>\n<script>\n/* MENU DATA: edit dishes here. veg: true/false. special: true shows the dish in Today's specials. */\nvar KK_MENU = window.KK_MENU = {\n  categories: [\"Starters\", \"Mains\", \"Desserts\"],\n  dishes: [\n    { name: \"Medu vada\",        category: \"Starters\", price: 120, veg: true,  special: false },\n    { name: \"Veg cutlet\",       category: \"Starters\", price: 140, veg: true,  special: false },\n    { name: \"Chicken 65\",       category: \"Starters\", price: 260, veg: false, special: false },\n    { name: \"Masala dosa\",      category: \"Mains\",    price: 160, veg: true,  special: false },\n    { name: \"Mysore dosa\",      category: \"Mains\",    price: 180, veg: true,  special: true  },\n    { name: \"Idli sambar\",      category: \"Mains\",    price: 110, veg: true,  special: false },\n    { name: \"Veg thali\",        category: \"Mains\",    price: 280, veg: true,  special: false },\n    { name: \"Chicken chettinad\",category: \"Mains\",    price: 340, veg: false, special: false },\n    { name: \"Fish curry meal\",  category: \"Mains\",    price: 360, veg: false, special: true  },\n    { name: \"Payasam\",          category: \"Desserts\", price: 100, veg: true,  special: false },\n    { name: \"Filter coffee\",    category: \"Desserts\", price: 60,  veg: true,  special: false }\n  ]\n};\n\n(function () {\n  var list = document.getElementById('kk-menu-list');\n  var status = document.getElementById('kk-menu-status');\n  var buttons = document.querySelectorAll('.kk-menu [data-kk-filter]');\n  if (!list || !status) { return; }\n\n  function matches(dish, f) {\n    if (f === 'veg') { return dish.veg === true; }\n    if (f === 'nonveg') { return dish.veg === false; }\n    return true;\n  }\n\n  function makeDish(d) {\n    var li = document.createElement('li');\n    li.className = 'kk-dish';\n    var row = document.createElement('div');\n    row.className = 'kk-dish-row';\n    var name = document.createElement('span');\n    name.className = 'kk-dish-name';\n    name.textContent = d.name;\n    var price = document.createElement('span');\n    price.className = 'kk-price';\n    price.textContent = '\\u20B9' + d.price;\n    row.appendChild(name);\n    row.appendChild(price);\n    var mark = document.createElement('span');\n    mark.className = 'kk-mark ' + (d.veg ? 'kk-veg' : 'kk-nonveg');\n    var box = document.createElement('span');\n    box.className = 'kk-box';\n    box.setAttribute('aria-hidden', 'true');\n    mark.appendChild(box);\n    mark.appendChild(document.createTextNode(d.veg ? 'Veg' : 'Non-veg'));\n    li.appendChild(row);\n    li.appendChild(mark);\n    return li;\n  }\n\n  function render(f) {\n    list.textContent = '';\n    var shown = 0;\n    KK_MENU.categories.forEach(function (cat) {\n      var items = KK_MENU.dishes.filter(function (d) {\n        return d.category === cat && matches(d, f);\n      });\n      if (!items.length) { return; }\n      var card = document.createElement('div');\n      card.className = 'j2-card';\n      var h3 = document.createElement('h3');\n      h3.textContent = cat;\n      var ul = document.createElement('ul');\n      ul.className = 'kk-dishes';\n      items.forEach(function (d) { ul.appendChild(makeDish(d)); shown++; });\n      card.appendChild(h3);\n      card.appendChild(ul);\n      list.appendChild(card);\n    });\n    var label = f === 'veg' ? 'veg ' : (f === 'nonveg' ? 'non-veg ' : '');\n    status.textContent = 'Showing ' + shown + ' ' + label + (shown === 1 ? 'dish' : 'dishes');\n  }\n\n  for (var i = 0; i < buttons.length; i++) {\n    buttons[i].addEventListener('click', function () {\n      for (var j = 0; j < buttons.length; j++) {\n        buttons[j].setAttribute('aria-pressed', buttons[j] === this ? 'true' : 'false');\n      }\n      render(this.getAttribute('data-kk-filter'));\n    });\n  }\n\n  render('all');\n})();\n</script>\n</section>",
    "workflow": "Priced menu with veg and non-veg filter"
  },
  "W-4": {
    "owner": "W-4",
    "head": "",
    "body": "<section id=\"specials\" class=\"kk-specials\" aria-labelledby=\"kk-specials-title\">\n<style>\n.kk-specials{max-width:100%}\n.kk-specials .kk-sp-inner{max-width:1080px;margin:0 auto}\n.kk-specials h2{margin:0 0 8px;font-size:clamp(1.7rem,6vw,2.4rem);color:var(--j2-primary)}\n.kk-specials .kk-sp-intro{margin:0 0 24px;color:var(--j2-muted)}\n.kk-specials .kk-sp-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:16px}\n@media (min-width:600px){.kk-specials .kk-sp-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}}\n.kk-specials .j2-card{min-width:0;border-left:6px solid var(--j2-accent)}\n.kk-specials .kk-sp-tag{display:inline-block;margin:0 0 8px;padding:2px 10px;border-radius:999px;background:var(--j2-accent);color:var(--j2-text);font-size:.8rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase}\n.kk-specials .kk-sp-row{display:flex;justify-content:space-between;align-items:baseline;gap:12px}\n.kk-specials h3{margin:0;min-width:0;font-size:1.3rem;color:var(--j2-secondary)}\n.kk-specials .kk-sp-price{flex:none;white-space:nowrap;font-weight:700;font-size:1.2rem;color:var(--j2-primary)}\n.kk-specials .kk-sp-meta{display:flex;flex-wrap:wrap;align-items:center;gap:4px 12px;margin-top:8px;font-size:.9rem;color:var(--j2-muted)}\n.kk-specials .kk-sp-mark{display:inline-flex;align-items:center;gap:6px;font-weight:700}\n.kk-specials .kk-sp-box{display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;border:2px solid currentColor;border-radius:3px;flex:none}\n.kk-specials .kk-sp-box::after{content:\"\";width:8px;height:8px;border-radius:50%;background:currentColor}\n.kk-specials .kk-sp-nonveg .kk-sp-box::after{border-radius:0;width:0;height:0;background:transparent;border-left:4px solid transparent;border-right:4px solid transparent;border-bottom:8px solid currentColor}\n.kk-specials .kk-sp-veg{color:var(--j2-secondary)}\n.kk-specials .kk-sp-nonveg{color:var(--j2-primary)}\n.kk-specials .kk-sp-empty{margin:0;color:var(--j2-muted)}\n.kk-specials .kk-sp-cta{margin-top:24px}\n.kk-specials .kk-sp-cta a{display:inline-flex;align-items:center;justify-content:center;text-decoration:none}\n</style>\n<div class=\"kk-sp-inner\">\n  <h2 id=\"kk-specials-title\">Today's specials</h2>\n  <p class=\"kk-sp-intro\">Fresh on the kitchen's list today. Prices are in rupees.</p>\n  <div class=\"kk-sp-grid\" id=\"kk-specials-list\"></div>\n  <noscript><p>Please turn on JavaScript to see today's specials.</p></noscript>\n  <div class=\"kk-sp-cta\"><a class=\"j2-btn-secondary\" href=\"#menu\">See the full menu</a></div>\n</div>\n<script>\n/* Specials are read from KK_MENU (defined in the menu section). To change them, set special: true or false on a dish there. */\n(function () {\n  function renderSpecials() {\n    var list = document.getElementById('kk-specials-list');\n    if (!list) { return; }\n    var menu = window.KK_MENU;\n    list.textContent = '';\n    var dishes = (menu && menu.dishes) ? menu.dishes.filter(function (d) { return d.special === true; }) : [];\n    if (!dishes.length) {\n      var empty = document.createElement('p');\n      empty.className = 'kk-sp-empty';\n      empty.textContent = \"Today's specials will be shown here soon. Please see the full menu below.\";\n      list.appendChild(empty);\n      return;\n    }\n    dishes.forEach(function (d) {\n      var card = document.createElement('div');\n      card.className = 'j2-card';\n\n      var tag = document.createElement('span');\n      tag.className = 'kk-sp-tag';\n      tag.textContent = \"Today's special\";\n\n      var row = document.createElement('div');\n      row.className = 'kk-sp-row';\n      var h3 = document.createElement('h3');\n      h3.textContent = d.name;\n      var price = document.createElement('span');\n      price.className = 'kk-sp-price';\n      price.textContent = '\\u20B9' + d.price;\n      row.appendChild(h3);\n      row.appendChild(price);\n\n      var meta = document.createElement('div');\n      meta.className = 'kk-sp-meta';\n      var mark = document.createElement('span');\n      mark.className = 'kk-sp-mark ' + (d.veg ? 'kk-sp-veg' : 'kk-sp-nonveg');\n      var box = document.createElement('span');\n      box.className = 'kk-sp-box';\n      box.setAttribute('aria-hidden', 'true');\n      mark.appendChild(box);\n      mark.appendChild(document.createTextNode(d.veg ? 'Veg' : 'Non-veg'));\n      meta.appendChild(mark);\n      if (d.category) {\n        var cat = document.createElement('span');\n        cat.textContent = d.category;\n        meta.appendChild(cat);\n      }\n\n      card.appendChild(tag);\n      card.appendChild(row);\n      card.appendChild(meta);\n      list.appendChild(card);\n    });\n  }\n  window.kkRenderSpecials = renderSpecials;\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', renderSpecials);\n  } else {\n    renderSpecials();\n  }\n})();\n</script>\n</section>",
    "workflow": "Today's specials from menu data"
  },
  "W-5": {
    "owner": "W-5",
    "head": "",
    "body": "<section id=\"book\" class=\"kk-book\" aria-labelledby=\"kk-book-title\">\n<style>\n.kk-book{max-width:100%}\n.kk-book .kk-book-inner{max-width:1080px;margin:0 auto}\n.kk-book h2{margin:0 0 8px;font-size:clamp(1.7rem,6vw,2.4rem);color:var(--j2-primary)}\n.kk-book .kk-book-intro{margin:0 0 24px;max-width:36em;color:var(--j2-muted)}\n.kk-book .j2-card{max-width:640px;min-width:0}\n.kk-book .kk-book-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:16px}\n@media (min-width:600px){.kk-book .kk-book-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 24px}.kk-book .kk-book-wide{grid-column:1 / -1}}\n.kk-book .kk-field{min-width:0}\n.kk-book label{display:block;margin:0 0 4px;font-weight:700}\n.kk-book input,.kk-book select{display:block;width:100%;max-width:100%;min-height:44px;padding:8px 12px;font-family:var(--j2-font-body);font-size:1rem;color:var(--j2-text);background:var(--j2-surface);border:2px solid var(--j2-muted);border-radius:8px}\n.kk-book input[aria-invalid=\"true\"],.kk-book select[aria-invalid=\"true\"]{border-color:var(--j2-primary)}\n.kk-book .kk-hint{margin:4px 0 0;font-size:.85rem;color:var(--j2-muted)}\n.kk-book .kk-err{margin:4px 0 0;min-height:0;font-size:.9rem;font-weight:700;color:var(--j2-primary)}\n.kk-book .kk-err:empty{display:none}\n.kk-book .kk-book-actions{margin-top:24px}\n.kk-book .kk-book-actions .j2-btn{display:inline-flex;align-items:center;justify-content:center;max-width:100%;font-family:var(--j2-font-body)}\n.kk-book .kk-book-note{margin:12px 0 0;font-size:.9rem;color:var(--j2-muted)}\n.kk-book .kk-book-status{margin:16px 0 0;padding:8px 12px;border-left:4px solid var(--j2-accent);background:var(--j2-background);border-radius:0 8px 8px 0}\n.kk-book .kk-book-status:empty{display:none}\n</style>\n<div class=\"kk-book-inner\">\n  <h2 id=\"kk-book-title\">Book a table</h2>\n  <p class=\"kk-book-intro\">Fill in your details and tap the button. WhatsApp opens with your message ready to send. Tables are for 1 to 8 people.</p>\n  <div class=\"j2-card\">\n    <form id=\"kk-book-form\" novalidate>\n      <div class=\"kk-book-grid\">\n        <div class=\"kk-field kk-book-wide\">\n          <label for=\"kk-book-name\">Your name</label>\n          <input id=\"kk-book-name\" name=\"name\" type=\"text\" maxlength=\"60\" autocomplete=\"name\" required aria-describedby=\"kk-book-name-err\">\n          <p class=\"kk-err\" id=\"kk-book-name-err\" role=\"alert\"></p>\n        </div>\n        <div class=\"kk-field\">\n          <label for=\"kk-book-date\">Date</label>\n          <input id=\"kk-book-date\" name=\"date\" type=\"date\" required aria-describedby=\"kk-book-date-err\">\n          <p class=\"kk-err\" id=\"kk-book-date-err\" role=\"alert\"></p>\n        </div>\n        <div class=\"kk-field\">\n          <label for=\"kk-book-time\">Time</label>\n          <input id=\"kk-book-time\" name=\"time\" type=\"time\" min=\"08:00\" max=\"22:30\" required aria-describedby=\"kk-book-time-hint kk-book-time-err\">\n          <p class=\"kk-hint\" id=\"kk-book-time-hint\">Open 8am to 10:30pm. Kitchen closes at 10pm.</p>\n          <p class=\"kk-err\" id=\"kk-book-time-err\" role=\"alert\"></p>\n        </div>\n        <div class=\"kk-field kk-book-wide\">\n          <label for=\"kk-book-people\">Number of people</label>\n          <select id=\"kk-book-people\" name=\"people\" required aria-describedby=\"kk-book-people-err\">\n            <option value=\"\">Choose 1 to 8</option>\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n            <option value=\"7\">7</option>\n            <option value=\"8\">8</option>\n          </select>\n          <p class=\"kk-err\" id=\"kk-book-people-err\" role=\"alert\"></p>\n        </div>\n      </div>\n      <div class=\"kk-book-actions\">\n        <button type=\"submit\" class=\"j2-btn\" id=\"kk-book-submit\">Book on WhatsApp</button>\n      </div>\n      <p class=\"kk-book-note\">Press send in WhatsApp to finish. You need WhatsApp on your phone or computer.</p>\n      <p class=\"kk-book-status\" id=\"kk-book-status\" role=\"status\" aria-live=\"polite\"></p>\n    </form>\n  </div>\n  <noscript><p>Please turn on JavaScript to use the booking form, or message us on WhatsApp at +91 00000 33333.</p></noscript>\n</div>\n<script>\n(function () {\n  var form = document.getElementById('kk-book-form');\n  if (!form) { return; }\n  var WA_NUMBER = '910000033333';\n  var fName = document.getElementById('kk-book-name');\n  var fDate = document.getElementById('kk-book-date');\n  var fTime = document.getElementById('kk-book-time');\n  var fPeople = document.getElementById('kk-book-people');\n  var status = document.getElementById('kk-book-status');\n  var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];\n\n  function pad(n) { return (n < 10 ? '0' : '') + n; }\n\n  function todayString() {\n    var d = new Date();\n    return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());\n  }\n\n  function setError(input, msg) {\n    var box = document.getElementById(input.id + '-err');\n    if (box) { box.textContent = msg || ''; }\n    if (msg) { input.setAttribute('aria-invalid', 'true'); }\n    else { input.removeAttribute('aria-invalid'); }\n  }\n\n  function validDate(v) {\n    var m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(v);\n    if (!m) { return null; }\n    var y = +m[1], mo = +m[2], d = +m[3];\n    var t = new Date(y, mo - 1, d);\n    if (t.getFullYear() !== y || t.getMonth() !== mo - 1 || t.getDate() !== d) { return null; }\n    return { y: y, mo: mo, d: d };\n  }\n\n  function validTime(v) {\n    var m = /^(\\d{2}):(\\d{2})$/.exec(v);\n    if (!m) { return null; }\n    var h = +m[1], mi = +m[2];\n    if (h > 23 || mi > 59) { return null; }\n    return { h: h, mi: mi, mins: h * 60 + mi };\n  }\n\n  function checkName() {\n    var v = fName.value.replace(/\\s+/g, ' ').trim();\n    if (!v) { setError(fName, 'Please enter your name.'); return false; }\n    setError(fName, '');\n    return true;\n  }\n\n  function checkDate() {\n    var v = fDate.value.trim();\n    if (!v) { setError(fDate, 'Please choose a date.'); return false; }\n    if (!validDate(v)) { setError(fDate, 'Please choose a valid date.'); return false; }\n    if (v < todayString()) { setError(fDate, 'Please choose today or a later date.'); return false; }\n    setError(fDate, '');\n    return true;\n  }\n\n  function checkTime() {\n    var v = fTime.value.trim();\n    if (!v) { setError(fTime, 'Please choose a time.'); return false; }\n    var t = validTime(v);\n    if (!t) { setError(fTime, 'Please choose a valid time.'); return false; }\n    if (t.mins < 480 || t.mins > 1350) { setError(fTime, 'Please choose a time between 8am and 10:30pm.'); return false; }\n    setError(fTime, '');\n    return true;\n  }\n\n  function checkPeople() {\n    var v = fPeople.value;\n    if (!v) { setError(fPeople, 'Please choose how many people.'); return false; }\n    var n = Number(v);\n    if (!/^\\d+$/.test(v) || n < 1 || n > 8) { setError(fPeople, 'Tables are for 1 to 8 people.'); return false; }\n    setError(fPeople, '');\n    return true;\n  }\n\n  function prettyDate(v) {\n    var d = validDate(v);\n    return d.d + ' ' + MONTHS[d.mo - 1] + ' ' + d.y;\n  }\n\n  function prettyTime(v) {\n    var t = validTime(v);\n    var h12 = t.h % 12 || 12;\n    return h12 + ':' + pad(t.mi) + ' ' + (t.h < 12 ? 'am' : 'pm');\n  }\n\n  function buildLink() {\n    var name = fName.value.replace(/\\s+/g, ' ').trim();\n    var lines = [\n      'Hello Kaveri Kitchen, I would like to book a table.',\n      'Name: ' + name,\n      'Date: ' + prettyDate(fDate.value.trim()),\n      'Time: ' + prettyTime(fTime.value.trim()),\n      'People: ' + Number(fPeople.value)\n    ];\n    return 'https://wa.me/' + WA_NUMBER + '?text=' + encodeURIComponent(lines.join('\\n'));\n  }\n\n  if (fDate) { fDate.setAttribute('min', todayString()); }\n\n  fName.addEventListener('input', function () { if (fName.getAttribute('aria-invalid')) { checkName(); } });\n  fDate.addEventListener('change', function () { if (fDate.getAttribute('aria-invalid')) { checkDate(); } });\n  fTime.addEventListener('change', function () { if (fTime.getAttribute('aria-invalid')) { checkTime(); } });\n  fPeople.addEventListener('change', function () { if (fPeople.getAttribute('aria-invalid')) { checkPeople(); } });\n\n  form.addEventListener('submit', function (e) {\n    e.preventDefault();\n    status.textContent = '';\n    var results = [\n      [fName, checkName()],\n      [fDate, checkDate()],\n      [fTime, checkTime()],\n      [fPeople, checkPeople()]\n    ];\n    for (var i = 0; i < results.length; i++) {\n      if (!results[i][1]) { results[i][0].focus(); return; }\n    }\n    var url = buildLink();\n    status.textContent = '';\n    status.appendChild(document.createTextNode('Opening WhatsApp. If nothing opens, '));\n    var a = document.createElement('a');\n    a.href = url;\n    a.target = '_blank';\n    a.rel = 'noopener';\n    a.textContent = 'tap here to open the chat';\n    status.appendChild(a);\n    status.appendChild(document.createTextNode('.'));\n    window.open(url, '_blank', 'noopener');\n  });\n})();\n</script>\n</section>",
    "workflow": "WhatsApp table booking form"
  },
  "W-6": {
    "owner": "W-6",
