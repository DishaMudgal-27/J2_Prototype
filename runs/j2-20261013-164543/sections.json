{
  "style": {
    "owner": "W-1",
    "head": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&amp;family=Space+Grotesk:wght@700&amp;display=swap\"><style>:root{--j2-primary:#FFD23F;--j2-secondary:#6B46FF;--j2-accent:#FF4D8D;--j2-background:#120D2E;--j2-surface:#1E1747;--j2-text:#FFFFFF;--j2-muted:#C9C3E8;--j2-font-heading:'Space Grotesk', 'Segoe UI', Arial, sans-serif;--j2-font-body:'Inter', 'Segoe UI', Arial, sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:16px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 28px;background:#FFD23F;color:#120D2E;border:2px solid #FFD23F;border-radius:999px;font-weight:800;text-decoration:none;cursor:pointer}.j2-btn-secondary{display:inline-block;display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 28px;background:transparent;color:#FFFFFF;border:2px solid #FFD23F;border-radius:999px;font-weight:800;text-decoration:none;cursor:pointer}.j2-card{background:#1E1747;color:#FFFFFF;border:1px solid #3A2F7A;border-radius:16px;padding:20px}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-1": {
    "owner": "W-8",
    "head": "<meta class=\"viewport-meta\" name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<style>\nhtml{scroll-behavior:smooth}\nbody{margin:0;background:var(--j2-background);color:var(--j2-text);font-family:var(--j2-font-body)}\nsection[id]{scroll-margin-top:72px}\n*,*::before,*::after{box-sizing:border-box}\nimg,svg{max-width:100%}\n</style>",
    "body": "<style>\n#site-nav{position:sticky;top:0;z-index:50;background:var(--j2-background);border-bottom:2px solid var(--j2-secondary)}\n#site-nav .w1-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;max-width:1200px;margin:0 auto;padding:8px 16px}\n#site-nav .w1-brand{display:inline-flex;align-items:center;min-height:48px;font-family:var(--j2-font-heading);font-size:1.5rem;font-weight:700;color:var(--j2-primary);text-decoration:none}\n#site-nav .nav-toggle{min-width:48px;min-height:48px;padding:0 16px;background:var(--j2-secondary);color:#fff;border:0;border-radius:999px;font:inherit;font-weight:800;cursor:pointer}\n#site-nav .w1-menu{display:none;list-style:none;margin:0;padding:8px 16px 16px;max-width:1200px;margin:0 auto}\n#site-nav .w1-menu.is-open{display:block}\n#site-nav .w1-menu a{display:flex;align-items:center;min-height:48px;padding:0 8px;color:var(--j2-text);font-weight:600;text-decoration:none;border-bottom:1px solid var(--j2-surface)}\n#site-nav .w1-menu a:hover,#site-nav .w1-menu a:focus-visible{color:var(--j2-primary)}\n#hero.w1-hero{position:relative;overflow:hidden;padding:48px 20px 64px;background:radial-gradient(circle at 90% 0%,var(--j2-secondary),transparent 55%),radial-gradient(circle at 0% 100%,var(--j2-accent),transparent 45%),var(--j2-background)}\n#hero .w1-inner{position:relative;display:grid;gap:32px;max-width:1200px;margin:0 auto}\n#hero .w1-eyebrow{margin:0 0 12px;color:var(--j2-primary);font-weight:800;letter-spacing:.12em;text-transform:uppercase;font-size:.9rem}\n#hero h1{margin:0 0 16px;font-family:var(--j2-font-heading);font-size:clamp(2.75rem,13vw,6.5rem);line-height:1;color:var(--j2-text);overflow-wrap:anywhere}\n#hero .w1-college{margin:0 0 8px;font-size:clamp(1.15rem,4.5vw,1.75rem);font-weight:800;color:var(--j2-text)}\n#hero .w1-dates{display:inline-block;margin:0 0 28px;padding:8px 16px;background:var(--j2-accent);color:#120D2E;border-radius:var(--j2-radius);font-size:clamp(1.05rem,4vw,1.5rem);font-weight:800}\n#hero .hero-cta{max-width:100%}\n#hero .photo-placeholder{display:flex;align-items:center;justify-content:center;width:100%;aspect-ratio:4/3;padding:16px;text-align:center;background:var(--j2-surface);color:var(--j2-muted);border:3px dashed var(--j2-primary);border-radius:var(--j2-radius);font-weight:600;overflow-wrap:anywhere}\n@media (min-width:900px){\n#site-nav .nav-toggle{display:none}\n#site-nav .w1-bar{padding-right:0}\n#site-nav{display:flex;align-items:center;justify-content:space-between;padding:0 24px}\n#site-nav .w1-menu,#site-nav .w1-menu.is-open{display:flex;gap:4px;padding:0;margin:0}\n#site-nav .w1-menu a{border-bottom:0;padding:0 12px;border-radius:999px}\n#hero.w1-hero{padding:96px 32px}\n#hero .w1-inner{grid-template-columns:1.2fr 1fr;align-items:center;gap:48px}\n}\n</style>\n<nav id=\"site-nav\" aria-label=\"Main\">\n  <div class=\"w1-bar\">\n    <a class=\"w1-brand\" href=\"#hero\">Spark 2026</a>\n    <button class=\"nav-toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"w1-menu\">Menu</button>\n  </div>\n  <ul class=\"w1-menu\" id=\"w1-menu\">\n    <li><a href=\"#schedule\">Schedule</a></li>\n    <li><a href=\"#events\">Events</a></li>\n    <li><a href=\"#register\">Register</a></li>\n    <li><a href=\"#sponsors\">Sponsors</a></li>\n    <li><a href=\"#venue\">Venue</a></li>\n    <li><a href=\"#contact\">Contact</a></li>\n  </ul>\n</nav>\n<section id=\"hero\" class=\"w1-hero\">\n  <div class=\"w1-inner\">\n    <div class=\"w1-copy\">\n      <p class=\"w1-eyebrow\">College tech fest</p>\n      <h1>Spark 2026</h1>\n      <p class=\"w1-college\">Northfield College of Engineering, Pune</p>\n      <p class=\"w1-dates\">14 to 16 February 2027</p>\n      <div><a class=\"j2-btn hero-cta\" href=\"#register\">Register now</a></div>\n    </div>\n    <div class=\"photo-placeholder\" role=\"img\" aria-label=\"Photo placeholder\">Photo placeholder: fest photo goes here</div>\n  </div>\n</section>\n<script>\n(function(){\n  var nav=document.getElementById('site-nav');\n  if(!nav)return;\n  var btn=nav.querySelector('.nav-toggle');\n  var menu=document.getElementById('w1-menu');\n  if(!btn||!menu)return;\n  function setOpen(open){\n    menu.classList.toggle('is-open',open);\n    btn.setAttribute('aria-expanded',open?'true':'false');\n    btn.textContent=open?'Close':'Menu';\n  }\n  btn.addEventListener('click',function(){setOpen(!menu.classList.contains('is-open'));});\n  menu.addEventListener('click',function(e){if(e.target.closest&&e.target.closest('a'))setOpen(false);});\n  document.addEventListener('keydown',function(e){if(e.key==='Escape')setOpen(false);});\n})();\n</script>",
    "workflow": "Add mobile viewport tag to head"
  },
  "W-2": {
    "owner": "W-2",
    "head": "",
    "body": "<style>\n#schedule.w2-schedule{padding:var(--j2-section) 20px;background:var(--j2-background)}\n#schedule .w2-inner{max-width:1200px;margin:0 auto}\n#schedule h2{margin:0 0 8px;font-family:var(--j2-font-heading);font-size:clamp(2rem,8vw,3.5rem);line-height:1.05;color:var(--j2-text);overflow-wrap:anywhere}\n#schedule .w2-intro{margin:0 0 32px;color:var(--j2-muted);font-size:1.05rem}\n#schedule .w2-days{display:grid;grid-template-columns:minmax(0,1fr);gap:32px}\n#schedule .schedule-day{min-width:0}\n#schedule .schedule-day h3{margin:0 0 8px;font-family:var(--j2-font-heading);font-size:clamp(1.5rem,6vw,2rem);color:var(--j2-primary)}\n#schedule .day-date{display:inline-block;margin:0 0 16px;padding:6px 14px;background:var(--j2-accent);color:var(--j2-background);border-radius:var(--j2-radius);font-weight:800;font-size:1rem}\n#schedule .w2-list{display:grid;gap:16px}\n#schedule .schedule-item{border-left:6px solid var(--j2-secondary);min-width:0}\n#schedule .schedule-item h4{margin:0 0 8px;font-size:1.25rem;color:var(--j2-text);overflow-wrap:anywhere}\n#schedule .sch-time{display:block;margin:0;color:var(--j2-primary);font-weight:800;font-size:1.1rem}\n@media (min-width:900px){\n#schedule.w2-schedule{padding:96px 32px}\n#schedule .w2-days{grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}\n}\n</style>\n<section id=\"schedule\" class=\"w2-schedule\" aria-labelledby=\"schedule-title\">\n  <div class=\"w2-inner\">\n    <h2 id=\"schedule-title\">Schedule</h2>\n    <p class=\"w2-intro\">Three days, 14 to 16 February 2027. Pick your day and plan your slots.</p>\n    <div class=\"w2-days\">\n      <div class=\"schedule-day\">\n        <h3>Day 1</h3>\n        <span class=\"day-date\">14 February 2027</span>\n        <div class=\"w2-list\">\n          <div class=\"schedule-item j2-card\">\n            <h4>Code Sprint</h4>\n            <p class=\"sch-time\">10am-1pm</p>\n          </div>\n          <div class=\"schedule-item j2-card\">\n            <h4>Line Follower</h4>\n            <p class=\"sch-time\">2pm-5pm</p>\n          </div>\n          <div class=\"schedule-item j2-card\">\n            <h4>AI in Daily Life</h4>\n            <p class=\"sch-time\">5:30pm-6:30pm</p>\n          </div>\n        </div>\n      </div>\n      <div class=\"schedule-day\">\n        <h3>Day 2</h3>\n        <span class=\"day-date\">15 February 2027</span>\n        <div class=\"w2-list\">\n          <div class=\"schedule-item j2-card\">\n            <h4>Bug Hunt</h4>\n            <p class=\"sch-time\">11am-1pm</p>\n          </div>\n          <div class=\"schedule-item j2-card\">\n            <h4>Poster Jam</h4>\n            <p class=\"sch-time\">2pm-4pm</p>\n          </div>\n        </div>\n      </div>\n      <div class=\"schedule-day\">\n        <h3>Day 3</h3>\n        <span class=\"day-date\">16 February 2027</span>\n        <div class=\"w2-list\">\n          <div class=\"schedule-item j2-card\">\n            <h4>Drone Dash</h4>\n            <p class=\"sch-time\">10am-1pm</p>\n          </div>\n          <div class=\"schedule-item j2-card\">\n            <h4>UI Duel</h4>\n            <p class=\"sch-time\">2pm-5pm</p>\n          </div>\n          <div class=\"schedule-item j2-card\">\n            <h4>Startup Stories</h4>\n            <p class=\"sch-time\">5:30pm-6:30pm</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",
    "workflow": "Day-by-day schedule"
  },
  "W-3": {
    "owner": "W-3",
    "head": "",
    "body": "<style>\n#events.w3-events{padding:var(--j2-section) 20px;background:var(--j2-surface)}\n#events .w3-inner{max-width:1200px;margin:0 auto}\n#events h2{margin:0 0 8px;font-family:var(--j2-font-heading);font-size:clamp(2rem,8vw,3.5rem);line-height:1.05;color:var(--j2-text);overflow-wrap:anywhere}\n#events .w3-intro{margin:0 0 24px;color:var(--j2-muted);font-size:1.05rem}\n#events .filter-bar{display:flex;flex-wrap:wrap;gap:12px;margin:0 0 16px}\n#events .filter-btn{font:inherit;font-weight:800;padding:0 20px;min-width:48px}\n#events .filter-btn:not(.is-active){background:transparent;color:var(--j2-text)}\n#events .filter-btn.is-active{background:var(--j2-primary);color:var(--j2-background)}\n#events .filter-btn:focus-visible{outline:3px solid var(--j2-accent);outline-offset:2px}\n#events .w3-count{margin:0 0 24px;color:var(--j2-muted);font-size:.95rem}\n#events .event-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:16px}\n#events .event-card{display:block;min-width:0;background:var(--j2-background);border-top:6px solid var(--j2-secondary)}\n#events .event-card[hidden]{display:none}\n#events .event-card h3{margin:12px 0 12px;font-size:1.4rem;line-height:1.15;color:var(--j2-text);overflow-wrap:anywhere}\n#events .ev-cat{display:inline-block;padding:4px 12px;background:var(--j2-accent);color:var(--j2-background);border-radius:var(--j2-radius);font-weight:800;font-size:.9rem}\n#events .ev-meta{display:flex;flex-wrap:wrap;gap:4px 16px;margin:0 0 16px;color:var(--j2-muted);font-weight:600}\n#events .ev-price{margin:0;color:var(--j2-primary);font-family:var(--j2-font-heading);font-size:1.75rem;font-weight:700}\n@media (min-width:600px){\n#events .event-grid{grid-template-columns:repeat(2,minmax(0,1fr))}\n}\n@media (min-width:900px){\n#events.w3-events{padding:96px 32px}\n#events .event-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:24px}\n}\n</style>\n<section id=\"events\" class=\"w3-events\" aria-labelledby=\"events-title\">\n  <div class=\"w3-inner\">\n    <h2 id=\"events-title\">Events</h2>\n    <p class=\"w3-intro\">Eight events across four categories. Pick a category to narrow the list.</p>\n    <div class=\"filter-bar\" role=\"group\" aria-label=\"Filter events by category\">\n      <button type=\"button\" class=\"filter-btn j2-btn is-active\" data-filter=\"all\" aria-pressed=\"true\">All</button>\n      <button type=\"button\" class=\"filter-btn j2-btn\" data-filter=\"Coding\" aria-pressed=\"false\">Coding</button>\n      <button type=\"button\" class=\"filter-btn j2-btn\" data-filter=\"Robotics\" aria-pressed=\"false\">Robotics</button>\n      <button type=\"button\" class=\"filter-btn j2-btn\" data-filter=\"Design\" aria-pressed=\"false\">Design</button>\n      <button type=\"button\" class=\"filter-btn j2-btn\" data-filter=\"Talks\" aria-pressed=\"false\">Talks</button>\n    </div>\n    <p class=\"w3-count\" id=\"events-count\" aria-live=\"polite\">Showing 8 events</p>\n    <div class=\"event-grid\">\n      <article class=\"event-card j2-card\" data-category=\"Coding\">\n        <span class=\"ev-cat\">Coding</span>\n        <h3>Code Sprint</h3>\n        <p class=\"ev-meta\"><span>Day 1</span><span>10am-1pm</span></p>\n        <p class=\"ev-price\">Rs 100</p>\n      </article>\n      <article class=\"event-card j2-card\" data-category=\"Coding\">\n        <span class=\"ev-cat\">Coding</span>\n        <h3>Bug Hunt</h3>\n        <p class=\"ev-meta\"><span>Day 2</span><span>11am-1pm</span></p>\n        <p class=\"ev-price\">Rs 50</p>\n      </article>\n      <article class=\"event-card j2-card\" data-category=\"Robotics\">\n        <span class=\"ev-cat\">Robotics</span>\n        <h3>Line Follower</h3>\n        <p class=\"ev-meta\"><span>Day 1</span><span>2pm-5pm</span></p>\n        <p class=\"ev-price\">Rs 150</p>\n      </article>\n      <article class=\"event-card j2-card\" data-category=\"Robotics\">\n        <span class=\"ev-cat\">Robotics</span>\n        <h3>Drone Dash</h3>\n        <p class=\"ev-meta\"><span>Day 3</span><span>10am-1pm</span></p>\n        <p class=\"ev-price\">Rs 200</p>\n      </article>\n      <article class=\"event-card j2-card\" data-category=\"Design\">\n        <span class=\"ev-cat\">Design</span>\n        <h3>Poster Jam</h3>\n        <p class=\"ev-meta\"><span>Day 2</span><span>2pm-4pm</span></p>\n        <p class=\"ev-price\">Free</p>\n      </article>\n      <article class=\"event-card j2-card\" data-category=\"Design\">\n        <span class=\"ev-cat\">Design</span>\n        <h3>UI Duel</h3>\n        <p class=\"ev-meta\"><span>Day 3</span><span>2pm-5pm</span></p>\n        <p class=\"ev-price\">Rs 100</p>\n      </article>\n      <article class=\"event-card j2-card\" data-category=\"Talks\">\n        <span class=\"ev-cat\">Talks</span>\n        <h3>AI in Daily Life</h3>\n        <p class=\"ev-meta\"><span>Day 1</span><span>5:30pm-6:30pm</span></p>\n        <p class=\"ev-price\">Free</p>\n      </article>\n      <article class=\"event-card j2-card\" data-category=\"Talks\">\n        <span class=\"ev-cat\">Talks</span>\n        <h3>Startup Stories</h3>\n        <p class=\"ev-meta\"><span>Day 3</span><span>5:30pm-6:30pm</span></p>\n        <p class=\"ev-price\">Free</p>\n      </article>\n    </div>\n  </div>\n</section>\n<script>\n(function(){\n  var root=document.getElementById('events');\n  if(!root)return;\n  var buttons=root.querySelectorAll('.filter-btn');\n  var cards=root.querySelectorAll('.event-card');\n  var count=document.getElementById('events-count');\n  function apply(filter){\n    var shown=0;\n    for(var i=0;i<cards.length;i++){\n      var match=filter==='all'||cards[i].getAttribute('data-category')===filter;\n      if(match){cards[i].removeAttribute('hidden');shown++;}\n      else{cards[i].setAttribute('hidden','');}\n    }\n    for(var j=0;j<buttons.length;j++){\n      var on=buttons[j].getAttribute('data-filter')===filter;\n      buttons[j].classList.toggle('is-active',on);\n      buttons[j].setAttribute('aria-pressed',on?'true':'false');\n    }\n    if(count)count.textContent='Showing '+shown+(shown===1?' event':' events');\n  }\n  for(var k=0;k<buttons.length;k++){\n    buttons[k].addEventListener('click',function(){apply(this.getAttribute('data-filter'));});\n  }\n})();\n</script>",
    "workflow": "Events by category with filter"
  },
  "W-4": {
    "owner": "W-4",
    "head": "",
    "body": "<style>\n#register.w4-register{padding:var(--j2-section) 20px;background:var(--j2-background)}\n#register .w4-inner{display:grid;grid-template-columns:minmax(0,1fr);gap:32px;max-width:1200px;margin:0 auto}\n#register .w4-copy{min-width:0}\n#register h2{margin:0 0 8px;font-family:var(--j2-font-heading);font-size:clamp(2rem,8vw,3.5rem);line-height:1.05;color:var(--j2-text);overflow-wrap:anywhere}\n#register .w4-intro{margin:0 0 16px;color:var(--j2-muted);font-size:1.05rem}\n#register .w4-note{margin:0;color:var(--j2-muted);font-size:.95rem;overflow-wrap:anywhere}\n#register .w4-note strong{color:var(--j2-primary)}\n#register .w4-form{min-width:0;max-width:100%;border-top:6px solid var(--j2-accent)}\n#register .w4-field{margin:0 0 20px}\n#register .w4-form label{display:block;margin:0 0 8px;font-weight:800;color:var(--j2-text)}\n#register .req-field{display:block;width:100%;max-width:100%;min-height:48px;padding:0 16px;font:inherit;font-size:1rem;color:var(--j2-text);background:var(--j2-background);border:2px solid var(--j2-secondary);border-radius:var(--j2-radius)}\n#register .req-field::placeholder{color:var(--j2-muted);opacity:1}\n#register .req-field:focus-visible{outline:3px solid var(--j2-primary);outline-offset:2px}\n#register .req-field[aria-invalid=\"true\"]{border-color:var(--j2-accent)}\n#register .w4-error{margin:8px 0 0;color:var(--j2-accent);font-weight:600;font-size:.95rem;overflow-wrap:anywhere}\n#register .w4-error:empty{display:none}\n#register .w4-submit{width:100%;font:inherit;font-weight:800}\n#register .w4-submit:focus-visible{outline:3px solid var(--j2-accent);outline-offset:2px}\n#register .w4-status{margin:16px 0 0;color:var(--j2-primary);font-weight:600;overflow-wrap:anywhere}\n#register .w4-status.is-error{color:var(--j2-accent)}\n#register .w4-status:empty{display:none}\n@media (min-width:900px){\n#register.w4-register{padding:96px 32px}\n#register .w4-inner{grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:48px;align-items:start}\n#register .w4-submit{width:auto}\n}\n</style>\n<section id=\"register\" class=\"w4-register\" aria-labelledby=\"register-title\">\n  <div class=\"w4-inner\">\n    <div class=\"w4-copy\">\n      <h2 id=\"register-title\">Register</h2>\n      <p class=\"w4-intro\">Pick your event and fill in your details. All four fields are required.</p>\n      <p class=\"w4-note\">Submitting opens an email to <strong>spark2026@example.com</strong> with your details filled in. Press send in your email app to finish registering.</p>\n    </div>\n    <form id=\"register-form\" class=\"w4-form j2-card\" novalidate>\n      <div class=\"w4-field\">\n        <label for=\"reg-name\">Name</label>\n        <input class=\"req-field\" type=\"text\" id=\"reg-name\" name=\"name\" autocomplete=\"name\" placeholder=\"Your full name\" required aria-describedby=\"reg-name-err\">\n        <p class=\"w4-error\" id=\"reg-name-err\"></p>\n      </div>\n      <div class=\"w4-field\">\n        <label for=\"reg-email\">Email</label>\n        <input class=\"req-field\" type=\"email\" id=\"reg-email\" name=\"email\" autocomplete=\"email\" placeholder=\"Your email address\" required aria-describedby=\"reg-email-err\">\n        <p class=\"w4-error\" id=\"reg-email-err\"></p>\n      </div>\n      <div class=\"w4-field\">\n        <label for=\"reg-college\">College</label>\n        <input class=\"req-field\" type=\"text\" id=\"reg-college\" name=\"college\" autocomplete=\"organization\" placeholder=\"Your college\" required aria-describedby=\"reg-college-err\">\n        <p class=\"w4-error\" id=\"reg-college-err\"></p>\n      </div>\n      <div class=\"w4-field\">\n        <label for=\"reg-event\">Event</label>\n        <select class=\"req-field\" id=\"reg-event\" name=\"event\" required aria-describedby=\"reg-event-err\">\n          <option value=\"\" disabled selected>Choose an event</option>\n          <option class=\"event-option\" value=\"Code Sprint\">Code Sprint</option>\n          <option class=\"event-option\" value=\"Bug Hunt\">Bug Hunt</option>\n          <option class=\"event-option\" value=\"Line Follower\">Line Follower</option>\n          <option class=\"event-option\" value=\"Drone Dash\">Drone Dash</option>\n          <option class=\"event-option\" value=\"Poster Jam\">Poster Jam</option>\n          <option class=\"event-option\" value=\"UI Duel\">UI Duel</option>\n          <option class=\"event-option\" value=\"AI in Daily Life\">AI in Daily Life</option>\n          <option class=\"event-option\" value=\"Startup Stories\">Startup Stories</option>\n        </select>\n        <p class=\"w4-error\" id=\"reg-event-err\"></p>\n      </div>\n      <button class=\"j2-btn w4-submit\" type=\"submit\">Register</button>\n      <p class=\"w4-status\" id=\"register-status\" role=\"status\" aria-live=\"polite\"></p>\n    </form>\n  </div>\n</section>\n<script>\n(function(){\n  var form=document.getElementById('register-form');\n  if(!form)return;\n  var status=document.getElementById('register-status');\n  var TO='spark2026@example.com';\n  var defs=[\n    {id:'reg-name',msg:'Please enter your name.'},\n    {id:'reg-email',msg:'Please enter your email address.'},\n    {id:'reg-college',msg:'Please enter your college.'},\n    {id:'reg-event',msg:'Please choose an event.'}\n  ];\n  function setError(el,msg){\n    var err=document.getElementById(el.id+'-err');\n    if(err)err.textContent=msg;\n    if(msg){el.setAttribute('aria-invalid','true');}\n    else{el.removeAttribute('aria-invalid');}\n  }\n  function check(def){\n    var el=document.getElementById(def.id);\n    if(!el)return true;\n    var v=(el.value||'').trim();\n    if(!v){setError(el,def.msg);return false;}\n    if(el.type==='email'&&!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)){\n      setError(el,'Please enter a valid email address.');\n      return false;\n    }\n    setError(el,'');\n    return true;\n  }\n  function setStatus(text,isError){\n    if(!status)return;\n    status.textContent=text;\n    status.classList.toggle('is-error',!!isError);\n  }\n  for(var i=0;i<defs.length;i++){\n    (function(def){\n      var el=document.getElementById(def.id);\n      if(!el)return;\n      var evt=el.tagName==='SELECT'?'change':'input';\n      el.addEventListener(evt,function(){\n        if(el.getAttribute('aria-invalid')==='true')check(def);\n      });\n    })(defs[i]);\n  }\n  form.addEventListener('submit',function(e){\n    e.preventDefault();\n    var firstBad=null;\n    for(var j=0;j<defs.length;j++){\n      if(!check(defs[j])&&!firstBad)firstBad=document.getElementById(defs[j].id);\n    }\n    if(firstBad){\n      setStatus('Please fix the highlighted fields and try again.',true);\n      firstBad.focus();\n      return;\n    }\n    var name=document.getElementById('reg-name').value.trim();\n    var email=document.getElementById('reg-email').value.trim();\n    var college=document.getElementById('reg-college').value.trim();\n    var ev=document.getElementById('reg-event').value;\n    var body=[\n      'Spark 2026 registration',\n      '',\n      'Name: '+name,\n      'Email: '+email,\n      'College: '+college,\n      'Event: '+ev\n    ].join('\\r\\n');\n    var url='mailto:'+TO+'?subject='+encodeURIComponent('Spark 2026 registration: '+ev)+'&body='+encodeURIComponent(body);\n    setStatus('Almost done: your email app should open with your details. Press send to finish registering. If nothing opens, email '+TO+' with your name, college and event.',false);\n    window.location.href=url;\n  });\n})();\n</script>",
    "workflow": "Registration form"
  },
  "W-5": {
    "owner": "W-5",
    "head": "",
    "body": "<style>\n#sponsors.w5-sponsors{padding:var(--j2-section) 20px;background:var(--j2-surface)}\n#sponsors .w5-inner{max-width:1200px;margin:0 auto}\n#sponsors h2{margin:0 0 8px;font-family:var(--j2-font-heading);font-size:clamp(2rem,8vw,3.5rem);line-height:1.05;color:var(--j2-text);overflow-wrap:anywhere}\n#sponsors .w5-intro{margin:0 0 32px;color:var(--j2-muted);font-size:1.05rem}\n#sponsors .sponsor-list{display:grid;grid-template-columns:minmax(0,1fr);gap:16px}\n#sponsors .sponsor-name{display:flex;align-items:center;justify-content:center;min-width:0;min-height:96px;text-align:center;background:var(--j2-background);border-top:6px solid var(--j2-accent);font-family:var(--j2-font-heading);font-size:clamp(1.4rem,5vw,1.9rem);font-weight:700;color:var(--j2-primary);overflow-wrap:anywhere}\n@media (min-width:700px){\n#sponsors .sponsor-list{grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}\n}\n@media (min-width:900px){\n#sponsors.w5-sponsors{padding:96px 32px}\n}\n</style>\n<section id=\"sponsors\" class=\"w5-sponsors\" aria-labelledby=\"sponsors-title\">\n  <div class=\"w5-inner\">\n    <h2 id=\"sponsors-title\">Sponsors</h2>\n    <p class=\"w5-intro\">Spark 2026 is made possible by our sponsors.</p>\n    <div class=\"sponsor-list\">\n      <div class=\"sponsor-name j2-card\">Nimbus Cloud</div>\n      <div class=\"sponsor-name j2-card\">Orbit Labs</div>\n      <div class=\"sponsor-name j2-card\">Pixel Press</div>\n    </div>\n  </div>\n</section>",
    "workflow": "Sponsors"
  },
  "W-6": {
    "owner": "W-6",
    "head": "",
    "body": "<style>\n#venue.w6-venue{padding:var(--j2-section) 20px;background:var(--j2-background)}\n#venue .w6-inner{max-width:1200px;margin:0 auto}\n#venue h2{margin:0 0 8px;font-family:var(--j2-font-heading);font-size:clamp(2rem,8vw,3.5rem);line-height:1.05;color:var(--j2-text);overflow-wrap:anywhere}\n#venue .w6-intro{margin:0 0 32px;color:var(--j2-muted);font-size:1.05rem}\n#venue .w6-card{max-width:100%;min-width:0;border-top:6px solid var(--j2-primary)}\n#venue .w6-college{margin:0 0 12px;font-family:var(--j2-font-heading);font-size:clamp(1.4rem,5vw,2rem);line-height:1.15;color:var(--j2-primary);overflow-wrap:anywhere}\n#venue .w6-address{margin:0 0 24px;font-style:normal;font-size:1.2rem;font-weight:600;color:var(--j2-text);overflow-wrap:anywhere}\n#venue .map-link{max-width:100%;text-align:center}\n#venue .map-link:focus-visible{outline:3px solid var(--j2-accent);outline-offset:2px}\n@media (min-width:900px){\n#venue.w6-venue{padding:96px 32px}\n#venue .w6-card{max-width:640px}\n}\n</style>\n<section id=\"venue\" class=\"w6-venue\" aria-labelledby=\"venue-title\">\n  <div class=\"w6-inner\">\n    <h2 id=\"venue-title\">Venue</h2>\n    <p class=\"w6-intro\">Find us at the college campus in Pune.</p>\n    <div class=\"w6-card j2-card\">\n      <p class=\"w6-college\">Northfield College of Engineering</p>\n      <address class=\"w6-address\">22 University Road, Pune 411007</address>\n      <a class=\"map-link j2-btn\" href=\"https://www.google.com/maps/search/?api=1&amp;query=Northfield%20College%20of%20Engineering%2C%2022%20University%20Road%2C%20Pune%20411007\" target=\"_blank\" rel=\"noopener\">Open in Google Maps</a>\n    </div>\n  </div>\n</section>",
    "workflow": "Venue and map link"
  },
  "W-7": {
    "owner": "W-7",
    "head": "",
    "body": "<style>\n#contact.w7-contact{padding:var(--j2-section) 20px 0;background:var(--j2-surface)}\n#contact .w7-inner{max-width:1200px;margin:0 auto;min-width:0}\n#contact h2{margin:0 0 8px;font-family:var(--j2-font-heading);font-size:clamp(2rem,8vw,3.5rem);line-height:1.05;color:var(--j2-text);overflow-wrap:anywhere}\n#contact .w7-intro{margin:0 0 32px;color:var(--j2-muted);font-size:1.05rem;overflow-wrap:anywhere}\n#contact .w7-card{max-width:100%;min-width:0;background:var(--j2-background);border-top:6px solid var(--j2-accent)}\n#contact .w7-label{margin:0 0 8px;color:var(--j2-muted);font-weight:600;overflow-wrap:anywhere}\n#contact .w7-number{margin:0 0 24px;font-family:var(--j2-font-heading);font-size:clamp(1.4rem,5vw,2rem);color:var(--j2-primary);overflow-wrap:anywhere}\n#contact .w7-actions{display:flex;flex-wrap:wrap;gap:16px;margin:0 0 24px;max-width:100%}\n#contact .whatsapp-btn,#contact .w7-email{max-width:100%;text-align:center;overflow-wrap:anywhere}\n#contact .whatsapp-btn:focus-visible,#contact .w7-email:focus-visible,#contact .w7-top:focus-visible{outline:3px solid var(--j2-accent);outline-offset:2px}\n#contact .w7-note{margin:0 0 8px;color:var(--j2-muted);font-size:.95rem;overflow-wrap:anywhere}\n#contact .w7-note:last-child{margin-bottom:0}\n#contact .w7-note strong{color:var(--j2-text)}\n#contact .w7-footer{margin:var(--j2-section) auto 0;max-width:1200px;padding:24px 0;border-top:2px solid var(--j2-secondary);display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 24px}\n#contact .w7-footer p{margin:0;color:var(--j2-muted);font-size:.95rem;overflow-wrap:anywhere;min-width:0}\n#contact .w7-top{display:inline-flex;align-items:center;min-height:48px;padding:0 12px;color:var(--j2-primary);font-weight:800;text-decoration:none}\n@media (min-width:900px){\n#contact.w7-contact{padding:96px 32px 0}\n#contact .w7-card{max-width:640px}\n}\n</style>\n<section id=\"contact\" class=\"w7-contact\" aria-labelledby=\"contact-title\">\n  <div class=\"w7-inner\">\n    <h2 id=\"contact-title\">Contact</h2>\n    <p class=\"w7-intro\">Questions about an event or your registration? Message the organisers.</p>\n    <div class=\"w7-card j2-card\">\n      <p class=\"w7-label\">Organisers on WhatsApp</p>\n      <p class=\"w7-number\">+91 00000 33333</p>\n      <div class=\"w7-actions\">\n        <a class=\"whatsapp-btn j2-btn\" href=\"https://wa.me/910000033333\" target=\"_blank\" rel=\"noopener\">Chat on WhatsApp</a>\n        <a class=\"w7-email j2-btn j2-btn-secondary\" href=\"mailto:spark2026@example.com\">spark2026@example.com</a>\n      </div>\n      <p class=\"w7-note\">WhatsApp link: <strong>wa.me/910000033333</strong></p>\n      <p class=\"w7-note\">Prefer email? Write to spark2026@example.com.</p>\n    </div>\n    <footer class=\"w7-footer\">\n      <p>Spark 2026 &middot; Northfield College of Engineering, Pune &middot; 14 to 16 February 2027</p>\n      <a class=\"w7-top\" href=\"#hero\">Back to top</a>\n    </footer>\n  </div>\n</section>",
    "workflow": "Contact, WhatsApp and page-wide guards"
  }
