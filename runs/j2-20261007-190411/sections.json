{
  "style": {
    "owner": "W-1",
    "head": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&amp;family=Nunito+Sans:wght@400;600;700&amp;display=swap\"><style>:root{--j2-primary:#7A3E22;--j2-secondary:#4E5B31;--j2-accent:#B8742A;--j2-background:#FAF5EC;--j2-surface:#FFFFFF;--j2-text:#2B2118;--j2-muted:#6B5B4D;--j2-font-heading:'Cormorant Garamond', Georgia, serif;--j2-font-body:'Nunito Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:12px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;background:#7A3E22;color:#FFFFFF;border:2px solid #7A3E22;min-height:46px;padding:12px 22px;font-weight:700;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer}.j2-btn-secondary{display:inline-block;background:transparent;color:#7A3E22;border:2px solid #7A3E22;min-height:46px;padding:12px 22px;font-weight:700;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer}.j2-card{background:#FFFFFF;border:1px solid #E6D9C3;border-radius:12px;padding:16px;box-shadow:0 2px 8px rgba(43,33,24,0.06)}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-1": {
    "owner": "W-1",
    "head": "",
    "body": "<div id=\"shop\" class=\"tl-shop\">\n<style>\n#shop{background:var(--j2-background,#FAF5EC);color:var(--j2-text,#2B2118);font-family:var(--j2-font-body,system-ui,sans-serif);padding:48px 16px;overflow-x:hidden}\n#shop *,#shop *::before,#shop *::after{box-sizing:border-box}\n#shop .tl-wrap{max-width:1120px;margin:0 auto}\n#shop .tl-block{margin-bottom:64px;scroll-margin-top:72px}\n#shop .tl-block:last-child{margin-bottom:0}\n#shop h2{font-family:var(--j2-font-heading,Georgia,serif);color:var(--j2-primary,#7A3E22);font-size:clamp(1.7rem,5vw,2.4rem);line-height:1.15;margin:0 0 8px}\n#shop .tl-lead{color:var(--j2-muted,#6B5B4D);margin:0 0 24px;max-width:60ch}\n#shop .tl-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}\n#shop .tl-grid.tl-new{grid-template-columns:minmax(0,1fr)}\n@media(min-width:640px){#shop .tl-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}#shop .tl-grid.tl-new{grid-template-columns:repeat(3,minmax(0,1fr))}}\n@media(min-width:1000px){#shop #tl-products{grid-template-columns:repeat(4,minmax(0,1fr))}}\n#shop .tl-card{display:flex;flex-direction:column;gap:10px;padding:12px;min-width:0}\n#shop .tl-photo{position:relative;aspect-ratio:4/5;width:100%;border:2px dashed var(--j2-accent,#B8742A);border-radius:8px;background:#EFE6D6;color:var(--j2-muted,#6B5B4D);display:flex;align-items:center;justify-content:center;text-align:center;font-size:.85rem;padding:8px}\n#shop .tl-badge{position:absolute;top:8px;left:8px;background:var(--j2-secondary,#4E5B31);color:#fff;font-size:.72rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;padding:3px 8px;border-radius:999px}\n#shop .tl-cat{font-size:.75rem;letter-spacing:.06em;text-transform:uppercase;color:var(--j2-muted,#6B5B4D);margin:0}\n#shop .tl-name{font-family:var(--j2-font-heading,Georgia,serif);font-size:1.15rem;font-weight:700;line-height:1.2;margin:0;overflow-wrap:anywhere}\n#shop .tl-price{font-weight:700;font-size:1.05rem;margin:0}\n#shop .tl-sizes{font-size:.85rem;color:var(--j2-muted,#6B5B4D);margin:0}\n#shop .tl-card .j2-btn{margin-top:auto;width:100%;text-align:center;padding:10px 12px;font-size:.92rem}\n#shop .tl-filters{display:grid;gap:16px;margin-bottom:20px}\n#shop .tl-chips{display:flex;flex-wrap:wrap;gap:8px}\n#shop .tl-chip{min-height:44px;padding:8px 16px;border-radius:999px;border:2px solid var(--j2-primary,#7A3E22);background:transparent;color:var(--j2-primary,#7A3E22);font:inherit;font-weight:700;cursor:pointer}\n#shop .tl-chip[aria-pressed=\"true\"]{background:var(--j2-primary,#7A3E22);color:#fff}\n#shop .tl-selects{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}\n@media(min-width:640px){#shop .tl-selects{max-width:520px}}\n#shop label{display:block;font-size:.85rem;font-weight:700;margin-bottom:4px}\n#shop select{width:100%;min-height:44px;padding:8px 10px;border:1px solid #B9A98F;border-radius:8px;background:#fff;color:var(--j2-text,#2B2118);font:inherit}\n#shop .tl-status{display:flex;flex-wrap:wrap;gap:8px 16px;align-items:center;justify-content:space-between;margin:0 0 16px;color:var(--j2-muted,#6B5B4D);font-size:.9rem}\n#shop .tl-reset{min-height:44px;padding:8px 16px}\n#shop .tl-empty{grid-column:1/-1;text-align:center;padding:32px 16px}\n#shop .tl-empty p{margin:0 0 16px}\n#shop .tl-table-wrap{max-width:440px}\n#shop table{width:100%;border-collapse:collapse;background:var(--j2-surface,#fff);border:1px solid #E6D9C3;border-radius:8px;overflow:hidden}\n#shop caption{text-align:left;color:var(--j2-muted,#6B5B4D);font-size:.9rem;padding-bottom:8px}\n#shop th,#shop td{text-align:left;padding:12px 16px;border-bottom:1px solid #E6D9C3}\n#shop th{background:var(--j2-primary,#7A3E22);color:#fff}\n#shop tbody tr:last-child td{border-bottom:0}\n#shop .tl-note{color:var(--j2-muted,#6B5B4D);font-size:.9rem;margin:12px 0 0}\n</style>\n<div class=\"tl-wrap\">\n\n<div class=\"tl-block\" id=\"new-arrivals\">\n<h2>New Arrivals</h2>\n<p class=\"tl-lead\">Fresh on the racks at Thread &amp; Loom.</p>\n<div class=\"tl-grid tl-new\" id=\"tl-new\"></div>\n</div>\n\n<div class=\"tl-block\" id=\"products\">\n<h2>Shop</h2>\n<p class=\"tl-lead\">Handloom kurtas, sarees, cotton shirts and dupattas. Pick a category, then narrow by size or price.</p>\n<div class=\"tl-filters\">\n<div class=\"tl-chips\" role=\"group\" aria-label=\"Category\">\n<button type=\"button\" class=\"tl-chip\" data-cat=\"All\" aria-pressed=\"true\">All</button>\n<button type=\"button\" class=\"tl-chip\" data-cat=\"Kurtas\" aria-pressed=\"false\">Kurtas</button>\n<button type=\"button\" class=\"tl-chip\" data-cat=\"Sarees\" aria-pressed=\"false\">Sarees</button>\n<button type=\"button\" class=\"tl-chip\" data-cat=\"Shirts\" aria-pressed=\"false\">Shirts</button>\n<button type=\"button\" class=\"tl-chip\" data-cat=\"Dupattas\" aria-pressed=\"false\">Dupattas</button>\n</div>\n<div class=\"tl-selects\">\n<div>\n<label for=\"tl-size\">Size</label>\n<select id=\"tl-size\">\n<option value=\"All\">All sizes</option>\n<option value=\"XS\">XS</option>\n<option value=\"S\">S</option>\n<option value=\"M\">M</option>\n<option value=\"L\">L</option>\n<option value=\"XL\">XL</option>\n<option value=\"XXL\">XXL</option>\n<option value=\"Free size\">Free size</option>\n</select>\n</div>\n<div>\n<label for=\"tl-price\">Price</label>\n<select id=\"tl-price\">\n<option value=\"All\">All prices</option>\n<option value=\"low\">Under ₹1,500</option>\n<option value=\"mid\">₹1,500 to ₹2,999</option>\n<option value=\"high\">₹3,000 and above</option>\n</select>\n</div>\n</div>\n</div>\n<div class=\"tl-status\">\n<span id=\"tl-count\" aria-live=\"polite\" role=\"status\"></span>\n<button type=\"button\" class=\"j2-btn j2-btn-secondary tl-reset\" id=\"tl-reset\">Clear filters</button>\n</div>\n<div class=\"tl-grid\" id=\"tl-products\"></div>\n<p class=\"tl-note\">Sarees and dupattas are free size. Tap Order on WhatsApp on any item to message the shop.</p>\n</div>\n\n<div class=\"tl-block\" id=\"size-guide\">\n<h2>Size Guide</h2>\n<p class=\"tl-lead\">Find your size by chest measurement.</p>\n<div class=\"tl-table-wrap\">\n<table>\n<caption>Chest measurement in inches</caption>\n<thead><tr><th scope=\"col\">Size</th><th scope=\"col\">Chest (inches)</th></tr></thead>\n<tbody>\n<tr><td>XS</td><td>32</td></tr>\n<tr><td>S</td><td>34</td></tr>\n<tr><td>M</td><td>36</td></tr>\n<tr><td>L</td><td>38</td></tr>\n<tr><td>XL</td><td>40</td></tr>\n<tr><td>XXL</td><td>42</td></tr>\n</tbody>\n</table>\n</div>\n</div>\n\n</div>\n<script>\n(function(){\n  var root=document.getElementById('shop');\n  if(!root){return;}\n  var WA='910000011111';\n  var P=[\n    {name:'Indigo block-print kurta',cat:'Kurtas',price:1499,sizes:['S','M','L','XL','XXL'],label:'S-XXL'},\n    {name:'Mustard handloom kurta',cat:'Kurtas',price:1699,sizes:['S','M','L','XL'],label:'S-XL'},\n    {name:'White chikankari kurta',cat:'Kurtas',price:2199,sizes:['XS','S','M','L','XL'],label:'XS-XL',isNew:true},\n    {name:'Maheshwari cotton saree',cat:'Sarees',price:3499,sizes:['Free size'],label:'Free size'},\n    {name:'Chanderi silk-cotton saree',cat:'Sarees',price:4999,sizes:['Free size'],label:'Free size'},\n    {name:'Ikat handloom saree',cat:'Sarees',price:3999,sizes:['Free size'],label:'Free size',isNew:true},\n    {name:'Khadi cotton shirt',cat:'Shirts',price:1299,sizes:['S','M','L','XL','XXL'],label:'S-XXL'},\n    {name:'Linen-blend shirt',cat:'Shirts',price:1599,sizes:['M','L','XL','XXL'],label:'M-XXL',isNew:true},\n    {name:'Ajrakh dupatta',cat:'Dupattas',price:899,sizes:['Free size'],label:'Free size'},\n    {name:'Bandhani dupatta',cat:'Dupattas',price:1099,sizes:['Free size'],label:'Free size'}\n  ];\n  var state={cat:'All',size:'All',price:'All'};\n  var elProducts=root.querySelector('#tl-products');\n  var elNew=root.querySelector('#tl-new');\n  var elCount=root.querySelector('#tl-count');\n  var elSize=root.querySelector('#tl-size');\n  var elPrice=root.querySelector('#tl-price');\n  var chips=root.querySelectorAll('.tl-chip');\n\n  function money(n){return '\\u20B9'+String(n).replace(/\\B(?=(\\d{3})+(?!\\d))/g,',');}\n  function el(tag,cls,text){var e=document.createElement(tag);if(cls){e.className=cls;}if(text!==undefined){e.textContent=text;}return e;}\n  function priceOk(p){\n    if(state.price==='low'){return p.price<1500;}\n    if(state.price==='mid'){return p.price>=1500&&p.price<=2999;}\n    if(state.price==='high'){return p.price>=3000;}\n    return true;\n  }\n  function matches(p){\n    if(state.cat!=='All'&&p.cat!==state.cat){return false;}\n    if(state.size!=='All'&&p.sizes.indexOf(state.size)===-1){return false;}\n    return priceOk(p);\n  }\n  function card(p,showNewBadge){\n    var c=el('article','j2-card tl-card');\n    var ph=el('div','tl-photo','Photo coming soon');\n    ph.setAttribute('role','img');\n    ph.setAttribute('aria-label','Photo of '+p.name+' coming soon');\n    if(showNewBadge&&p.isNew){ph.appendChild(el('span','tl-badge','New'));}\n    c.appendChild(ph);\n    c.appendChild(el('p','tl-cat',p.cat));\n    c.appendChild(el('h3','tl-name',p.name));\n    c.appendChild(el('p','tl-price',money(p.price)));\n    c.appendChild(el('p','tl-sizes','Sizes: '+p.label));\n    var a=el('a','j2-btn','Order on WhatsApp');\n    a.href='https://wa.me/'+WA+'?text='+encodeURIComponent('Hi Thread & Loom, I would like to order: '+p.name);\n    a.target='_blank';\n    a.rel='noopener';\n    c.appendChild(a);\n    return c;\n  }\n  function render(){\n    var list=P.filter(matches);\n    elProducts.textContent='';\n    if(!list.length){\n      var e=el('div','j2-card tl-empty');\n      e.appendChild(el('p','', 'No products match these filters.'));\n      elProducts.appendChild(e);\n    }else{\n      list.forEach(function(p){elProducts.appendChild(card(p,true));});\n    }\n    elCount.textContent='Showing '+list.length+' of '+P.length+' products';\n  }\n  function renderNew(){\n    elNew.textContent='';\n    P.filter(function(p){return p.isNew;}).forEach(function(p){elNew.appendChild(card(p,false));});\n  }\n  chips.forEach(function(b){\n    b.addEventListener('click',function(){\n      state.cat=b.getAttribute('data-cat');\n      chips.forEach(function(x){x.setAttribute('aria-pressed',x===b?'true':'false');});\n      render();\n    });\n  });\n  elSize.addEventListener('change',function(){state.size=elSize.value;render();});\n  elPrice.addEventListener('change',function(){state.price=elPrice.value;render();});\n  root.querySelector('#tl-reset').addEventListener('click',function(){\n    state={cat:'All',size:'All',price:'All'};\n    elSize.value='All';elPrice.value='All';\n    chips.forEach(function(x){x.setAttribute('aria-pressed',x.getAttribute('data-cat')==='All'?'true':'false');});\n    render();\n  });\n  renderNew();\n  render();\n})();\n</script>\n</div>",
    "workflow": "Shop: categories, filters, new arrivals, size guide, WhatsApp ordering"
  },
  "W-2": {
    "owner": "W-3",
    "head": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"description\" content=\"Thread & Loom, a handloom clothing boutique in Pune selling kurtas, sarees, cotton shirts and dupattas.\">\n<style>html{scroll-behavior:smooth}body{display:flex;flex-direction:column;min-height:100vh;overflow-x:hidden}</style>",
    "body": "<style>\n.tl2,.tl2 *,.tl2 *::before,.tl2 *::after{box-sizing:border-box}\n.tl2-header{order:-3;position:sticky;top:0;z-index:50;background:var(--j2-surface);border-bottom:1px solid rgba(122,62,34,.2)}\n.tl2-bar{max-width:1120px;margin:0 auto;padding:8px 16px;min-height:60px;display:flex;align-items:center;justify-content:space-between;gap:12px}\n.tl2-brand{display:inline-flex;align-items:center;min-height:44px;min-width:44px;font-family:var(--j2-font-heading);font-weight:700;font-size:1.6rem;line-height:1;color:var(--j2-primary);text-decoration:none}\n.tl2-toggle{min-height:44px;padding:8px 16px;border:2px solid var(--j2-primary);border-radius:var(--j2-radius);background:transparent;color:var(--j2-primary);font:inherit;font-weight:700;cursor:pointer}\n.tl2-nav{display:none;position:absolute;left:0;right:0;top:100%;flex-direction:column;background:var(--j2-surface);border-bottom:1px solid rgba(122,62,34,.2);padding:4px 16px 12px}\n.tl2-nav.tl2-open{display:flex}\n.tl2-nav a{display:block;min-height:44px;padding:12px 4px;color:var(--j2-text);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(122,62,34,.12)}\n.tl2-nav a:hover,.tl2-nav a:focus{color:var(--j2-primary)}\n@media(min-width:960px){\n.tl2-toggle{display:none}\n.tl2-nav{display:flex;position:static;flex-direction:row;gap:2px;padding:0;border:0;background:none}\n.tl2-nav a{min-height:0;padding:8px 10px;border:0;font-size:.95rem}\n}\n.tl2-hero{order:-2;padding:64px 16px;text-align:center;background-color:var(--j2-background);background-image:repeating-linear-gradient(90deg,rgba(122,62,34,.05) 0 2px,transparent 2px 14px),repeating-linear-gradient(0deg,rgba(78,91,49,.05) 0 2px,transparent 2px 14px);border-bottom:1px solid rgba(122,62,34,.15)}\n.tl2-hero .tl2-wrap{max-width:720px}\n.tl2-eyebrow{margin:0 0 8px;font-size:.8rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--j2-secondary)}\n.tl2-hero h1{margin:0 0 16px;font-size:clamp(2.6rem,11vw,4.6rem);line-height:1.05;color:var(--j2-primary)}\n.tl2-hero p.tl2-sub{margin:0 auto 24px;max-width:48ch;font-size:1.1rem;color:var(--j2-muted)}\n.tl2-actions{display:flex;flex-wrap:wrap;gap:12px;justify-content:center}\n.tl2-wrap{max-width:1120px;margin:0 auto}\n.tl2-sec{order:1;padding:64px 16px;scroll-margin-top:72px}\n.tl2-alt{background:rgba(78,91,49,.08)}\n.tl2-sec h2{margin:0 0 8px;font-size:clamp(1.7rem,5vw,2.4rem);line-height:1.15;color:var(--j2-primary)}\n.tl2-lead{margin:0 0 24px;max-width:60ch;color:var(--j2-muted)}\n.tl2-grid{display:grid;gap:20px;grid-template-columns:minmax(0,1fr)}\n@media(min-width:768px){.tl2-grid.tl2-3{grid-template-columns:repeat(3,minmax(0,1fr))}}\n.tl2-card{display:flex;flex-direction:column;gap:12px;min-width:0}\n.tl2-card h3{margin:0;font-size:1.35rem;line-height:1.2;color:var(--j2-text)}\n.tl2-card p{margin:0;overflow-wrap:anywhere}\n.tl2-card a:not(.j2-btn){color:var(--j2-primary);font-weight:700;overflow-wrap:anywhere}\n.tl2-photo{aspect-ratio:4/5;width:100%;border:2px dashed var(--j2-accent);border-radius:8px;background:rgba(184,116,42,.12);color:var(--j2-muted);display:flex;align-items:center;justify-content:center;text-align:center;padding:8px;font-size:.9rem}\n.tl2-pieces{list-style:none;margin:0;padding:0;display:grid;gap:6px}\n.tl2-pieces li{display:flex;justify-content:space-between;gap:12px;padding-bottom:6px;border-bottom:1px solid rgba(122,62,34,.15)}\n.tl2-pieces span:last-child{font-weight:700;white-space:nowrap}\n.tl2-card .j2-btn{margin-top:auto;width:100%;text-align:center}\n.tl2-quote{margin:0;display:flex;flex-direction:column;gap:12px}\n.tl2-quote p{font-family:var(--j2-font-heading);font-size:1.4rem;line-height:1.3;font-weight:600;color:var(--j2-text)}\n.tl2-quote cite{font-style:normal;font-weight:700;color:var(--j2-secondary)}\n.tl2-big{font-size:1.15rem}\n.tl2-facts{list-style:none;margin:0;padding:0;display:grid;gap:6px;color:var(--j2-muted)}\n.tl2-map{margin-top:24px}\n.tl2-footer{order:2;background:var(--j2-text);color:var(--j2-background);padding:32px 16px}\n.tl2-footer .tl2-wrap{display:grid;gap:8px}\n.tl2-footer p{margin:0;overflow-wrap:anywhere}\n.tl2-footer .tl2-fbrand{font-family:var(--j2-font-heading);font-size:1.6rem;font-weight:700}\n.tl2-footer a{color:var(--j2-background);font-weight:600}\n</style>\n\n<header class=\"tl2 tl2-header\">\n  <div class=\"tl2-bar\">\n    <a class=\"tl2-brand\" href=\"#home\">Thread &amp; Loom</a>\n    <button class=\"tl2-toggle\" id=\"tl2-toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"tl2-nav\">Menu</button>\n    <nav class=\"tl2-nav\" id=\"tl2-nav\" aria-label=\"Main menu\">\n      <a href=\"#new-arrivals\">New Arrivals</a>\n      <a href=\"#products\">Shop</a>\n      <a href=\"#size-guide\">Size Guide</a>\n      <a href=\"#lookbook\">Lookbook</a>\n      <a href=\"#reviews\">Reviews</a>\n      <a href=\"#delivery\">Delivery</a>\n      <a href=\"#visit\">Visit Us</a>\n      <a href=\"#policy\">Returns</a>\n    </nav>\n  </div>\n</header>\n\n<section class=\"tl2 tl2-hero\" id=\"home\">\n  <div class=\"tl2-wrap\">\n    <p class=\"tl2-eyebrow\">Handloom boutique in Pune</p>\n    <h1>Thread &amp; Loom</h1>\n    <p class=\"tl2-sub\">Handloom kurtas, sarees, cotton shirts and dupattas, from our shop on FC Road, Pune.</p>\n    <div class=\"tl2-actions\">\n      <a class=\"j2-btn\" href=\"#products\">Shop now</a>\n      <a class=\"j2-btn j2-btn-secondary\" href=\"https://wa.me/910000011111?text=Hi%20Thread%20%26%20Loom%2C%20I%20would%20like%20to%20place%20an%20order\" target=\"_blank\" rel=\"noopener\">Order on WhatsApp</a>\n    </div>\n  </div>\n</section>\n\n<section class=\"tl2 tl2-sec\" id=\"lookbook\">\n  <div class=\"tl2-wrap\">\n    <h2>Lookbook</h2>\n    <p class=\"tl2-lead\">Three outfit ideas, styled from our own pieces.</p>\n    <div class=\"tl2-grid tl2-3\">\n      <article class=\"j2-card tl2-card\">\n        <div class=\"tl2-photo\" role=\"img\" aria-label=\"Photo of Look 1 coming soon\">Photo coming soon</div>\n  