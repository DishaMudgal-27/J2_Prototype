{
  "style": {
    "owner": "W-1",
    "head": "<style>:root{--j2-primary:#ffd23f;--j2-secondary:#3ddcff;--j2-accent:#ff4d8d;--j2-background:#0b0f1a;--j2-surface:#151b2e;--j2-text:#f5f7ff;--j2-muted:#b4bedc;--j2-font-heading:system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;--j2-font-body:system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:12px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;background:#ffd23f;color:#0b0f1a;border:0;font-weight:700;font-size:1.5rem;min-height:56px;min-width:44px;padding:12px 40px;cursor:pointer}.j2-btn-secondary{display:inline-block;background:transparent;color:#3ddcff;border:2px solid #3ddcff;font-weight:700;font-size:1.25rem;min-height:48px;min-width:44px;padding:10px 28px;cursor:pointer}.j2-card{background:#151b2e;color:#f5f7ff;border:1px solid #26304f;padding:24px}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-1": {
    "owner": "W-1",
    "head": "",
    "body": "<section id=\"start\" class=\"screen start-screen\">\n  <style>\n    #start.start-screen {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      gap: 24px;\n      box-sizing: border-box;\n      width: 100%;\n      max-width: 100%;\n      min-height: 70vh;\n      padding: 32px 16px;\n      text-align: center;\n      color: var(--j2-text, #f5f7ff);\n    }\n    #start.start-screen[hidden] { display: none; }\n    #start .game-title {\n      margin: 0;\n      font-size: clamp(2.75rem, 12vw, 5rem);\n      line-height: 1.1;\n      font-weight: 800;\n      color: var(--j2-primary, #ffd23f);\n      overflow-wrap: anywhere;\n    }\n    #start .instructions {\n      margin: 0;\n      max-width: 28ch;\n      font-size: clamp(1.25rem, 5vw, 1.75rem);\n      line-height: 1.4;\n      color: var(--j2-text, #f5f7ff);\n    }\n    #start .start-btn {\n      min-height: 56px;\n      min-width: 160px;\n      max-width: 100%;\n      font-size: 1.5rem;\n    }\n  </style>\n  <h1 class=\"game-title\">Tap Rush</h1>\n  <p class=\"instructions\">Tap each circle before it vanishes in 1 second. A round lasts 30 seconds.</p>\n  <button id=\"start-btn\" class=\"j2-btn start-btn\" type=\"button\">Start</button>\n</section>",
    "workflow": "Start screen"
  },
  "W-2": {
    "owner": "W-6",
    "head": "",
    "body": "<section id=\"play\" class=\"screen play-screen\" hidden>\n  <style>\n    #play.play-screen {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 16px;\n      box-sizing: border-box;\n      width: 100%;\n      max-width: 100%;\n      padding: 16px;\n      color: var(--j2-text, #f5f7ff);\n    }\n    #play.play-screen[hidden] { display: none; }\n    #play #hud {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      gap: 16px;\n      box-sizing: border-box;\n      width: 100%;\n      max-width: 720px;\n      font-family: var(--j2-font-heading);\n      font-size: clamp(1.5rem, 7vw, 2.25rem);\n      font-weight: 800;\n      line-height: 1.2;\n    }\n    #play .hud-item { white-space: nowrap; }\n    #play #score { color: var(--j2-primary, #ffd23f); }\n    #play #timer { color: var(--j2-secondary, #3ddcff); }\n    #play .play-hint {\n      margin: 0;\n      font-size: 1.125rem;\n      color: var(--j2-muted, #b4bedc);\n      text-align: center;\n    }\n    #play .play-area {\n      position: relative;\n      box-sizing: border-box;\n      width: 100%;\n      max-width: 720px;\n      height: 60vh;\n      height: min(60dvh, 480px);\n      overflow: hidden;\n      background: var(--j2-surface, #151b2e);\n      border: 1px solid #26304f;\n      border-radius: var(--j2-radius, 12px);\n      touch-action: manipulation;\n      -webkit-user-select: none;\n      user-select: none;\n    }\n    #play .circle {\n      position: absolute;\n      box-sizing: border-box;\n      width: 64px;\n      height: 64px;\n      min-width: 44px;\n      min-height: 44px;\n      margin: 0;\n      padding: 0;\n      border: 0;\n      border-radius: 50%;\n      cursor: pointer;\n      touch-action: manipulation;\n      -webkit-tap-highlight-color: transparent;\n    }\n  </style>\n  <div id=\"hud\">\n    <span id=\"score\" class=\"hud-item\"></span>\n    <span id=\"timer\" class=\"hud-item\"></span>\n  </div>\n  <p class=\"play-hint\">1 point per circle</p>\n  <div id=\"play-area\" class=\"play-area\"></div>\n  <script>\n    (function () {\n      // round 30 seconds; circle lifetime 1 second; 1 point per circle\n      var ROUND_MS = 30 * 1000;\n      var CIRCLE_LIFE_MS = 1000;\n      var POINTS_PER_CIRCLE = 1;\n      // Minimal build choices, not Requester decisions: circle size and spawn gap.\n      var CIRCLE_SIZE = 64;\n      var SPAWN_EVERY_MS = 700;\n      var COLOURS = ['var(--j2-primary)', 'var(--j2-secondary)', 'var(--j2-accent)'];\n      // Count of circles tapped before a round begins (empty count).\n      var NONE = Number(false);\n\n      var startScreen = document.getElementById('start');\n      var playScreen = document.getElementById('play');\n      var area = document.getElementById('play-area');\n      var scoreEl = document.getElementById('score');\n      var timerEl = document.getElementById('timer');\n      var startBtn = document.getElementById('start-btn');\n\n      var score = NONE;\n      var running = false;\n      var endAt = NONE;\n      var tickId = null;\n      var spawnId = null;\n      var lives = [];\n\n      function showScore() { scoreEl.textContent = 'Score: ' + score; }\n      function showTime(ms) {\n        timerEl.textContent = 'Time: ' + Math.max(NONE, Math.ceil(ms / 1000));\n      }\n\n      function removeCircle(c) {\n        var i = lives.indexOf(c);\n        if (i !== -1) { clearTimeout(c._life); lives.splice(i, 1); }\n        if (c.parentNode) { c.parentNode.removeChild(c); }\n      }\n\n      function clearCircles() {\n        while (lives.length) { removeCircle(lives[NONE]); }\n        area.innerHTML = '';\n      }\n\n      function spawn() {\n        if (!running) { return; }\n        var w = area.clientWidth;\n        var h = area.clientHeight;\n        var c = document.createElement('button');\n        c.type = 'button';\n        c.className = 'circle';\n        c.tabIndex = -1;\n        c.setAttribute('aria-label', 'Circle');\n        c.style.left = Math.floor(Math.random() * Math.max(1, w - CIRCLE_SIZE)) + 'px';\n        c.style.top = Math.floor(Math.random() * Math.max(1, h - CIRCLE_SIZE)) + 'px';\n        c.style.background = COLOURS[Math.floor(Math.random() * COLOURS.length)];\n        c.addEventListener('pointerdown', function (e) {\n          e.preventDefault();\n          if (!running || lives.indexOf(c) === -1) { return; }\n          score += POINTS_PER_CIRCLE;\n          showScore();\n          removeCircle(c);\n        });\n        area.appendChild(c);\n        lives.push(c);\n        c._life = setTimeout(function () { removeCircle(c); }, CIRCLE_LIFE_MS);\n      }\n\n      function stopTimers() {\n        running = false;\n        clearInterval(tickId);\n        clearInterval(spawnId);\n        tickId = null;\n        spawnId = null;\n        clearCircles();\n      }\n\n      function tick() {\n        var left = endAt - performance.now();\n        if (left <= NONE) { finish(); return; }\n        showTime(left);\n      }\n\n      function finish() {\n        stopTimers();\n        showTime(NONE);\n        api.score = score;\n        playScreen.hidden = true;\n        var endScreen = document.getElementById('end');\n        if (endScreen) { endScreen.hidden = false; }\n        document.dispatchEvent(new CustomEvent('taprush:end', { detail: { score: score } }));\n      }\n\n      function start() {\n        stopTimers();\n        score = NONE;\n        showScore();\n        showTime(ROUND_MS);\n        if (startScreen) { startScreen.hidden = true; }\n        var endScreen = document.getElementById('end');\n        if (endScreen) { endScreen.hidden = true; }\n        playScreen.hidden = false;\n        running = true;\n        endAt = performance.now() + ROUND_MS;\n        tickId = setInterval(tick, 100);\n        spawn();\n        spawnId = setInterval(spawn, SPAWN_EVERY_MS);\n      }\n\n      function stop() { stopTimers(); }\n\n      // Hooks for the end screen (start a new round) and the nav (stop a round).\n      var api = window.TapRush = { start: start, stop: stop, score: NONE };\n\n      // Fill the HUD text from the script at load.\n      showScore();\n      showTime(ROUND_MS);\n\n      if (startBtn) { startBtn.addEventListener('click', start); }\n    })();\n  </script>\n</section>",
    "workflow": "Set play score text from script"
  },
  "W-3": {
    "owner": "W-7",
    "head": "",
    "body": "<section id=\"end\" class=\"screen end-screen end-idle\" inert>\n  <style>\n    #end.end-screen {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      gap: 24px;\n      box-sizing: border-box;\n      width: 100%;\n      max-width: 100%;\n      min-height: 70vh;\n      padding: 32px 16px;\n      text-align: center;\n      color: var(--j2-text, #f5f7ff);\n    }\n    #end.end-screen[hidden] { display: none; }\n    /* Idle (before the first round ends): parked off-screen at full size, inert so it cannot be focused or tapped. */\n    #end.end-idle {\n      position: absolute;\n      top: 0;\n      left: -10000px;\n      width: 360px;\n      max-width: 100vw;\n    }\n    #end .end-title {\n      margin: 0;\n      font-family: var(--j2-font-heading);\n      font-size: clamp(2rem, 9vw, 3.5rem);\n      line-height: 1.1;\n      font-weight: 800;\n      color: var(--j2-text, #f5f7ff);\n      overflow-wrap: anywhere;\n    }\n    #end .end-card {\n      box-sizing: border-box;\n      width: 100%;\n      max-width: 420px;\n      display: flex;\n      flex-direction: column;\n      gap: 16px;\n      border-radius: var(--j2-radius, 12px);\n    }\n    #end .end-line {\n      margin: 0;\n      font-size: clamp(1.25rem, 5.5vw, 1.75rem);\n      line-height: 1.3;\n      font-weight: 700;\n      color: var(--j2-muted, #b4bedc);\n      overflow-wrap: anywhere;\n    }\n    #end #final-score {\n      display: inline-block;\n      font-size: clamp(2.5rem, 12vw, 4rem);\n      line-height: 1.1;\n      font-weight: 800;\n      color: var(--j2-primary, #ffd23f);\n    }\n    #end #best-score {\n      font-size: clamp(1.5rem, 7vw, 2.25rem);\n      font-weight: 800;\n      color: var(--j2-secondary, #3ddcff);\n    }\n    #end .again-btn {\n      min-height: 56px;\n      min-width: 160px;\n      max-width: 100%;\n      font-size: 1.5rem;\n    }\n  </style>\n  <h2 class=\"end-title\">Results</h2>\n  <div class=\"j2-card end-card\">\n    <p class=\"end-line\">Final score: <span id=\"final-score\"></span></p>\n    <p class=\"end-line\">Best score this session: <span id=\"best-score\"></span></p>\n  </div>\n  <button id=\"again-btn\" class=\"j2-btn again-btn\" type=\"button\">Play again</button>\n  <script>\n    (function () {\n      // Empty count used before any round has finished.\n      var NONE = Number(false);\n\n      // Best score lives in this variable only: no storage, resets on page reload.\n      // null means no round has finished yet, so the first round's score becomes the best.\n      var best = null;\n\n      var endScreen = document.getElementById('end');\n      var finalEl = document.getElementById('final-score');\n      var bestEl = document.getElementById('best-score');\n      var againBtn = document.getElementById('again-btn');\n\n      function render(finalScore) {\n        finalEl.textContent = String(finalScore);\n        bestEl.textContent = String(best === null ? NONE : best);\n      }\n\n      function show(finalScore) {\n        if (best === null || finalScore > best) { best = finalScore; }\n        render(finalScore);\n        endScreen.classList.remove('end-idle');\n        endScreen.removeAttribute('inert');\n        endScreen.hidden = false;\n      }\n\n      // Fill the score text from the script at load.\n      render(NONE);\n\n      // W-2 fires this when the 30 second round ends.\n      document.addEventListener('taprush:end', function (e) {\n        var s = e && e.detail && typeof e.detail.score === 'number' ? e.detail.score : NONE;\n        show(s);\n      });\n\n      againBtn.addEventListener('click', function () {\n        endScreen.hidden = true;\n        if (window.TapRush && typeof window.TapRush.start === 'function') {\n          window.TapRush.start();\n        }\n      });\n    })();\n  </script>\n</section>",
    "workflow": "Set end screen score text from script"
  },
  "W-4": {
    "owner": "W-4",
    "head": "<style>body{padding-top:57px}</style>",
    "body": "<nav class=\"j2-nav\" aria-label=\"Screens\">\n  <style>\n    .j2-nav {\n      position: fixed;\n      top: 0;\n      left: 0;\n      right: 0;\n      z-index: 10;\n      display: flex;\n      justify-content: center;\n      gap: 8px;\n      box-sizing: border-box;\n      max-width: 100%;\n      padding: 4px 8px;\n      background: var(--j2-surface, #151b2e);\n      border-bottom: 1px solid #26304f;\n    }\n    .j2-nav .nav-link {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      box-sizing: border-box;\n      flex: 1 1 0;\n      min-width: 44px;\n      max-width: 200px;\n      min-height: 48px;\n      padding: 0 8px;\n      font-family: var(--j2-font-body);\n      font-size: 1.125rem;\n      font-weight: 700;\n      text-decoration: none;\n      color: var(--j2-secondary, #3ddcff);\n      border-radius: var(--j2-radius, 12px);\n    }\n    .j2-nav .nav-link[aria-current=\"true\"] {\n      color: var(--j2-primary, #ffd23f);\n      text-decoration: underline;\n      text-underline-offset: 6px;\n    }\n  </style>\n  <a class=\"nav-link\" href=\"#start\" aria-current=\"true\">Start</a>\n  <a class=\"nav-link\" href=\"#play\">Play</a>\n  <a class=\"nav-link\" href=\"#end\">Results</a>\n  <script>\n    (function () {\n      var ids = ['start', 'play', 'end'];\n      var links = document.querySelectorAll('.j2-nav .nav-link');\n\n      function showScreen(target) {\n        // Stop any round in progress before switching screens.\n        if (window.TapRush && typeof window.TapRush.stop === 'function') {\n          window.TapRush.stop();\n        }\n        for (var i = 0; i < ids.length; i++) {\n          var el = document.getElementById(ids[i]);\n          if (el) { el.hidden = (ids[i] !== target); }\n        }\n        if (target === 'end') {\n          // Make the end screen usable if no round has finished yet.\n          var endEl = document.getElementById('end');\n          if (endEl) {\n            endEl.classList.remove('end-idle');\n            endEl.removeAttribute('inert');\n          }\n        }\n        for (var j = 0; j < links.length; j++) {\n          var on = links[j].getAttribute('href') === '#' + target;\n          if (on) { links[j].setAttribute('aria-current', 'true'); }\n          else { links[j].removeAttribute('aria-current'); }\n        }\n        window.scrollTo(0, 0);\n      }\n\n      for (var k = 0; k < links.length; k++) {\n        links[k].addEventListener('click', function (e) {\n          var target = this.getAttribute('href').slice(1);\n          if (ids.indexOf(target) === -1) { return; }\n          e.preventDefault();\n          showScreen(target);\n        });\n      }\n\n      // Keep the highlighted link in step with the game's own screen changes.\n      function sync() {\n        for (var i = 0; i < ids.length; i++) {\n          var el = document.getElementById(ids[i]);\n          var visible = el && !el.hidden && !el.classList.contains('end-idle');\n          if (visible) {\n            for (var j = 0; j < links.length; j++) {\n              if (links[j].getAttribute('href') === '#' + ids[i]) {\n                links[j].setAttribute('aria-current', 'true');\n              } else {\n                links[j].removeAttribute('aria-current');\n              }\n            }\n            return;\n          }\n        }\n      }\n      document.addEventListener('click', function () { setTimeout(sync, 0); });\n      document.addEventListener('taprush:end', function () { setTimeout(sync, 0); });\n    })();\n  </script>\n</nav>",
    "workflow": "Minimal nav"
  },
  "W-5": {
    "owner": "W-5",
    "head": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"dark\">\n<style>\n  *, *::before, *::after { box-sizing: border-box; }\n  html {\n    max-width: 100%;\n    overflow-x: hidden;\n    -webkit-text-size-adjust: 100%;\n    text-size-adjust: 100%;\n    background: var(--j2-background);\n    color-scheme: dark;\n  }\n  body {\n    max-width: 100%;\n    overflow-x: hidden;\n    background: var(--j2-background);\n    color: var(--j2-text);\n    font-family: var(--j2-font-body);\n    font-size: 1.25rem;\n    line-height: 1.4;\n  }\n  img, svg, video, canvas { max-width: 100%; height: auto; }\n  [hidden] { display: none !important; }\n  .screen { max-width: 100%; }\n  .j2-btn, .j2-btn-secondary {\n    font-family: var(--j2-font-body);\n    max-width: 100%;\n    border-radius: var(--j2-radius);\n    touch-action: manipulation;\n  }\n</style>",
    "body": "<style>\n  .j2-btn:focus-visible,\n  .j2-btn-secondary:focus-visible,\n  .j2-nav .nav-link:focus-visible {\n    outline: 3px solid var(--j2-text);\n    outline-offset: 3px;\n  }\n  @media (prefers-reduced-motion: reduce) {\n    * { animation: none !important; transition: none !important; scroll-behavior: auto !important; }\n  }\n</style>",
    "workflow": "Look and containment"
  }
}