{
  "style": {
    "owner": "W-26",
    "head": "<style>:root{--j2-primary:#3E2415;--j2-secondary:#7A4B2A;--j2-accent:#9A5216;--j2-background:#FBF6EF;--j2-surface:#FFFFFF;--j2-text:#2B1B12;--j2-muted:#6B5646;--j2-font-heading:Georgia, 'Times New Roman', serif;--j2-font-body:system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:12px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;background:#3E2415;color:#FFFFFF;border:2px solid #3E2415;min-height:48px;padding:12px 24px;font-weight:600;}.j2-btn-secondary{display:inline-block;background:transparent;color:#3E2415;border:2px solid #3E2415;min-height:48px;padding:12px 24px;font-weight:600;}.j2-card{background:#FFFFFF;border:1px solid #E6D8C8;box-shadow:0 2px 8px rgba(62,36,21,0.08);padding:24px;}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-26": {
    "owner": "W-26",
    "head": "",
    "body": "<section id=\"menu\" aria-labelledby=\"menu-heading\">\n  <style>\n    #menu { padding: 64px 16px; background: var(--j2-background, #FBF6EF); color: var(--j2-text, #2B1B12); }\n    #menu .menu-wrap { max-width: 640px; margin: 0 auto; box-sizing: border-box; }\n    #menu h2 { font-family: var(--j2-font-heading, Georgia, serif); color: var(--j2-primary, #3E2415); font-size: 2rem; line-height: 1.2; margin: 0 0 8px; overflow-wrap: anywhere; }\n    #menu .menu-note { color: var(--j2-muted, #6B5646); margin: 0 0 24px; }\n    #menu .menu-list { list-style: none; margin: 0; padding: 0; }\n    #menu .menu-item { font-family: var(--j2-font-body, system-ui, sans-serif); font-size: 1.125rem; padding: 16px 0; border-bottom: 1px solid #E6D8C8; overflow-wrap: anywhere; }\n    #menu .menu-item:last-child { border-bottom: 0; }\n    @media (max-width: 400px) { #menu { padding: 48px 16px; } #menu h2 { font-size: 1.625rem; } }\n  </style>\n  <div class=\"menu-wrap j2-card\">\n    <h2 id=\"menu-heading\">Menu</h2>\n    <p class=\"menu-note\">Prices in rupees.</p>\n    <ul class=\"menu-list\">\n      <li class=\"menu-item\">Filter coffee 90</li>\n      <li class=\"menu-item\">Cappuccino 160</li>\n      <li class=\"menu-item\">Latte 180</li>\n      <li class=\"menu-item\">Cold brew 200</li>\n      <li class=\"menu-item\">Masala chai 80</li>\n      <li class=\"menu-item\">Almond croissant 140</li>\n      <li class=\"menu-item\">Banana bread slice 120</li>\n    </ul>\n  </div>\n</section>",
    "workflow": "Site Menu section"
  },
  "W-27": {
    "owner": "W-27",
    "head": "",
    "body": "<section id=\"pre-order\" aria-labelledby=\"pre-order-heading\">\n  <style>\n    #pre-order { padding: var(--j2-section, 64px) 16px; box-sizing: border-box; scroll-margin-top: 16px; }\n    #pre-order *, #pre-order *::before, #pre-order *::after { box-sizing: border-box; }\n    #pre-order .po-wrap { width: 100%; max-width: 640px; margin: 0 auto; }\n    #pre-order h2 { font-family: var(--j2-font-heading, Georgia, 'Times New Roman', serif); color: var(--j2-primary, #3E2415); margin: 0 0 8px; overflow-wrap: anywhere; }\n    #pre-order .po-intro { color: var(--j2-text, #2B1B12); margin: 0 0 16px; overflow-wrap: anywhere; }\n    #pre-order .po-card { max-width: 100%; }\n    #pre-order .po-row { display: block; margin: 0 0 16px; }\n    #pre-order label { display: block; font-weight: 600; color: var(--j2-text, #2B1B12); margin: 0 0 8px; }\n    #pre-order .po-hint { display: block; font-weight: 400; color: var(--j2-muted, #6B5646); font-size: 0.9rem; margin-top: 4px; }\n    #pre-order .po-field { display: block; width: 100%; max-width: 100%; min-height: 48px; padding: 12px; font: inherit; color: var(--j2-text, #2B1B12); background: var(--j2-surface, #FFFFFF); border: 2px solid var(--j2-secondary, #7A4B2A); border-radius: var(--j2-radius, 12px); }\n    #pre-order textarea.po-field { min-height: 112px; resize: vertical; }\n    #pre-order .po-field:focus { outline: 3px solid var(--j2-accent, #9A5216); outline-offset: 2px; }\n    #pre-order .po-field[aria-invalid=\"true\"] { border-color: var(--j2-accent, #9A5216); }\n    #pre-order #po-submit { min-height: 48px; min-width: 48px; width: 100%; cursor: pointer; font: inherit; font-weight: 600; border-radius: var(--j2-radius, 12px); }\n    #pre-order #po-error { margin: 0 0 16px; padding: 12px; color: var(--j2-text, #2B1B12); background: var(--j2-background, #FBF6EF); border: 2px solid var(--j2-accent, #9A5216); border-radius: var(--j2-radius, 12px); overflow-wrap: anywhere; }\n    #pre-order #po-error[hidden] { display: none; }\n    #pre-order #no-payment-note { margin: 16px 0 0; font-weight: 600; color: var(--j2-primary, #3E2415); overflow-wrap: anywhere; }\n  </style>\n  <div class=\"po-wrap\">\n    <h2 id=\"pre-order-heading\">Pre-order for pickup</h2>\n    <p class=\"po-intro\">Tell us what you would like and when you will collect it. Your email app will open with the order ready to send to the shop.</p>\n    <div class=\"j2-card po-card\">\n      <form id=\"pre-order-form\" action=\"mailto:hello@brewlab.example\" method=\"post\" enctype=\"text/plain\" novalidate>\n        <div id=\"po-error\" role=\"alert\" hidden>Please fill in every field before sending your pre-order.</div>\n        <div class=\"po-row\">\n          <label for=\"po-name\">Name</label>\n          <input class=\"po-field\" type=\"text\" id=\"po-name\" name=\"customer-name\" autocomplete=\"name\" required>\n        </div>\n        <div class=\"po-row\">\n          <label for=\"po-phone\">Phone</label>\n          <input class=\"po-field\" type=\"tel\" id=\"po-phone\" name=\"customer-phone\" autocomplete=\"tel\" inputmode=\"tel\" required>\n        </div>\n        <div class=\"po-row\">\n          <label for=\"po-items\">Items<span class=\"po-hint\">List what you want from the menu, for example Cappuccino and Almond croissant.</span></label>\n          <textarea class=\"po-field\" id=\"po-items\" name=\"coffee-item\" rows=\"3\" required></textarea>\n        </div>\n        <div class=\"po-row\">\n          <label for=\"po-time\">Pickup time<span class=\"po-hint\">Choose the time you will collect, within opening hours.</span></label>\n          <input class=\"po-field\" type=\"time\" id=\"po-time\" name=\"pickup-time\" required>\n        </div>\n        <button type=\"submit\" id=\"po-submit\" class=\"j2-btn\">Send pre-order</button>\n      </form>\n      <p id=\"no-payment-note\">No payment, customers pay at pickup. Nothing is charged on this site.</p>\n    </div>\n  </div>\n  <script>\n    (function () {\n      var form = document.getElementById('pre-order-form');\n      var errorBox = document.getElementById('po-error');\n      if (!form || !errorBox) { return; }\n      var ids = ['po-name', 'po-phone', 'po-items', 'po-time'];\n      var fields = [];\n      ids.forEach(function (id) {\n        var el = document.getElementById(id);\n        if (el) { fields.push(el); }\n      });\n\n      function isEmpty(el) {\n        return String(el.value || '').replace(/\\s+/g, '') === '';\n      }\n\n      function refresh() {\n        var missing = [];\n        fields.forEach(function (el) {\n          var bad = isEmpty(el);\n          el.setAttribute('aria-invalid', bad ? 'true' : 'false');\n          if (bad) {\n            var lab = form.querySelector('label[for=\"' + el.id + '\"]');\n            var text = lab ? (lab.childNodes[0] ? lab.childNodes[0].textContent : lab.textContent) : el.name;\n            missing.push(String(text).trim());\n          }\n        });\n        return missing;\n      }\n\n      form.addEventListener('submit', function (e) {\n        var missing = refresh();\n        if (missing.length > 0) {\n          e.preventDefault();\n          errorBox.textContent = 'Please fill in: ' + missing.join(', ') + '.';\n          errorBox.hidden = false;\n          for (var i = 0; i < fields.length; i++) {\n            if (isEmpty(fields[i])) { try { fields[i].focus(); } catch (err) {} break; }\n          }\n        } else {\n          errorBox.hidden = true;\n        }\n      });\n\n      fields.forEach(function (el) {\n        el.addEventListener('change', function () {\n          var bad = isEmpty(el);\n          el.setAttribute('aria-invalid', bad ? 'true' : 'false');\n          if (!errorBox.hidden && refresh().length === 0) { errorBox.hidden = true; }\n        });\n      });\n    })();\n  </script>\n</section>",
    "workflow": "Site Pre-order section"
  },
  "W-28": {
    "owner": "W-28",
    "head": "",
    "body": "<section id=\"shop-address\" aria-label=\"Shop address and contact\">\n  <style>\n    #shop-address {\n      padding: var(--j2-section, 64px) 16px;\n      background: var(--j2-background, #FBF6EF);\n      color: var(--j2-text, #2B1B12);\n      font-family: var(--j2-font-body, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif);\n      box-sizing: border-box;\n    }\n    #shop-address *, #shop-address *::before, #shop-address *::after { box-sizing: border-box; }\n    #shop-address > .j2-card {\n      max-width: 640px;\n      margin: 0 auto;\n      border-radius: var(--j2-radius, 12px);\n      overflow-wrap: anywhere;\n    }\n    #shop-address h2 {\n      margin: 0 0 8px;\n      font-family: var(--j2-font-heading, Georgia, 'Times New Roman', serif);\n      color: var(--j2-primary, #3E2415);\n      font-size: 1.75rem;\n      line-height: 1.2;\n    }\n    #shop-address h3 {\n      margin: 0 0 16px;\n      font-family: var(--j2-font-heading, Georgia, 'Times New Roman', serif);\n      color: var(--j2-secondary, #7A4B2A);\n      font-size: 1.125rem;\n      font-weight: 400;\n    }\n    #shop-address dl { margin: 0; }\n    #shop-address dt {\n      margin: 16px 0 4px;\n      color: var(--j2-muted, #6B5646);\n      font-size: 0.875rem;\n      font-weight: 600;\n      text-transform: uppercase;\n      letter-spacing: 0.04em;\n    }\n    #shop-address dt:first-child { margin-top: 0; }\n    #shop-address dd {\n      margin: 0;\n      font-size: 1.0625rem;\n      line-height: 1.5;\n    }\n    #shop-address address { font-style: normal; }\n    #shop-address .contact-email {\n      display: inline-flex;\n      align-items: center;\n      min-height: 48px;\n      min-width: 48px;\n      color: var(--j2-primary, #3E2415);\n      font-weight: 600;\n      text-decoration: underline;\n      text-underline-offset: 3px;\n    }\n    #shop-address .contact-email:focus-visible {\n      outline: 3px solid var(--j2-accent, #9A5216);\n      outline-offset: 2px;\n    }\n    @media (min-width: 768px) {\n      #shop-address h2 { font-size: 2rem; }\n    }\n  </style>\n  <div class=\"j2-card\">\n    <h2>Find us</h2>\n    <h3>Brew Lab</h3>\n    <dl>\n      <dt>Address</dt>\n      <dd><address>12, 100 Feet Road, Indiranagar, Bengaluru 560038</address></dd>\n      <dt>Phone</dt>\n      <dd>+91 98450 12345</dd>\n      <dt>Email</dt>\n      <dd><a class=\"contact-email\" href=\"mailto:hello@brewlab.example\">hello@brewlab.example</a></dd>\n    </dl>\n  </div>\n</section>",
    "workflow": "Site Shop address section"
  },
  "W-29": {
    "owner": "W-29",
    "head": "",
    "body": "<section id=\"opening-hours\" aria-labelledby=\"opening-hours-heading\">\n  <style>\n    #opening-hours {\n      box-sizing: border-box;\n      width: 100%;\n      padding: 64px 16px;\n    }\n    #opening-hours .oh-wrap {\n      box-sizing: border-box;\n      max-width: 720px;\n      margin: 0 auto;\n    }\n    #opening-hours .oh-card {\n      box-sizing: border-box;\n      max-width: 100%;\n      border-radius: var(--j2-radius, 12px);\n      overflow-wrap: anywhere;\n    }\n    #opening-hours #opening-hours-heading {\n      margin: 0 0 16px;\n      font-family: var(--j2-font-heading);\n      color: var(--j2-primary);\n      line-height: 1.2;\n    }\n    #opening-hours .oh-list {\n      list-style: none;\n      margin: 0;\n      padding: 0;\n    }\n    #opening-hours .oh-list li {\n      margin: 0;\n      padding: 12px 0;\n      font-family: var(--j2-font-body);\n      color: var(--j2-text);\n      font-size: 1.125rem;\n      line-height: 1.4;\n      border-bottom: 1px solid #E6D8C8;\n    }\n    #opening-hours .oh-list li:last-child {\n      border-bottom: 0;\n    }\n    #opening-hours .oh-note {\n      margin: 16px 0 0;\n      font-family: var(--j2-font-body);\n      color: var(--j2-secondary);\n      font-weight: 600;\n      line-height: 1.4;\n    }\n  </style>\n  <div class=\"oh-wrap\">\n    <div class=\"j2-card oh-card\">\n      <h2 id=\"opening-hours-heading\">Opening hours</h2>\n      <ul class=\"oh-list\">\n        <li>Monday to Saturday 7:30 am to 9:00 pm</li>\n        <li>Sunday 8:30 am to 6:00 pm</li>\n      </ul>\n      <p class=\"oh-note\">No closed days</p>\n    </div>\n  </div>\n</section>",
    "workflow": "Site Opening hours section"
  },
  "W-30": {
    "owner": "W-31",
    "head": "",
    "body": "<style>\n  *, *::before, *::after { box-sizing: border-box; }\n  html { scroll-behavior: smooth; }\n  body {\n    margin: 0;\n    background: var(--j2-background, #FBF6EF);\n    color: var(--j2-text, #2B1B12);\n    font-family: var(--j2-font-body, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif);\n    line-height: 1.5;\n    overflow-wrap: break-word;\n  }\n  img, svg, video, iframe { max-width: 100%; height: auto; }\n  h1, h2, h3, p, li, a, dd, dt { overflow-wrap: break-word; }\n  #menu, #pre-order, #shop-address, #opening-hours { scroll-margin-top: 16px; }\n\n  #page-layout { width: 100%; }\n  #page-layout .pl-bar {\n    background: var(--j2-primary, #3E2415);\n    color: #FFFFFF;\n  }\n  #page-layout .pl-bar-inner {\n    max-width: 1100px;\n    margin: 0 auto;\n    padding: 8px 16px;\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    justify-content: space-between;\n    gap: 8px 24px;\n  }\n  #page-layout .pl-brand {\n    font-family: var(--j2-font-heading, Georgia, 'Times New Roman', serif);\n    font-size: 1.5rem;\n    font-weight: 700;\n    color: #FFFFFF;\n    margin: 0;\n  }\n  #page-layout #page-nav {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px;\n  }\n  #page-layout .nav-link {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 44px;\n    min-width: 44px;\n    padding: 8px 16px;\n    color: #FFFFFF;\n    text-decoration: none;\n    font-weight: 600;\n    border-radius: var(--j2-radius, 12px);\n  }\n  #page-layout .nav-link:hover { background: var(--j2-secondary, #7A4B2A); }\n  #page-layout .nav-link:focus-visible { outline: 3px solid #FFFFFF; outline-offset: 2px; }\n\n  #hero {\n    max-width: 1100px;\n    margin: 0 auto;\n    padding: 48px 16px;\n  }\n  #hero .hero-title {\n    font-family: var(--j2-font-heading, Georgia, 'Times New Roman', serif);\n    color: var(--j2-primary, #3E2415);\n    font-size: clamp(2rem, 8vw, 3rem);\n    line-height: 1.15;\n    margin: 0 0 16px;\n  }\n  #hero .hero-text {\n    color: var(--j2-text, #2B1B12);\n    font-size: 1.125rem;\n    max-width: 36rem;\n    margin: 0 0 16px;\n  }\n  #hero .hero-goal {\n    color: var(--j2-secondary, #7A4B2A);\n    font-weight: 600;\n    font-size: 1rem;\n    max-width: 36rem;\n    margin: 0 0 24px;\n  }\n  #hero .hero-cta {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 48px;\n    min-width: 48px;\n    text-decoration: none;\n    border-radius: var(--j2-radius, 12px);\n  }\n  #hero .hero-cta:focus-visible { outline: 3px solid var(--j2-accent, #9A5216); outline-offset: 3px; }\n\n  @media (max-width: 480px) {\n    #page-layout .pl-bar-inner { flex-direction: column; align-items: flex-start; }\n    #hero { padding: 32px 16px; }\n    #hero .hero-cta { width: 100%; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    html { scroll-behavior: auto; }\n  }\n</style>\n<header id=\"page-layout\">\n  <div class=\"pl-bar\">\n    <div class=\"pl-bar-inner\">\n      <p class=\"pl-brand\">Brew Lab</p>\n      <nav id=\"site-nav\" aria-label=\"Page sections\">\n        <ul id=\"page-nav\">\n          <li><a class=\"nav-link\" href=\"#menu\">Menu</a></li>\n          <li><a class=\"nav-link\" href=\"#pre-order\">Pre-order</a></li>\n          <li><a class=\"nav-link\" href=\"#shop-address\">Find us</a></li>\n          <li><a class=\"nav-link\" href=\"#opening-hours\">Opening hours</a></li>\n        </ul>\n      </nav>\n    </div>\n  </div>\n  <div id=\"hero\">\n    <h1 class=\"hero-title\">Brew Lab</h1>\n    <p class=\"hero-text\">Specialty coffee in Indiranagar, Bengaluru. Pre-order a coffee for pickup.</p>\n    <p class=\"hero-goal\">Our goal: 30 pre-orders per week.</p>\n    <a class=\"j2-btn hero-cta\" href=\"#pre-order\">Pre-order for pickup</a>\n  </div>\n</header>\n<script>\n  (function () {\n    try {\n      var layout = document.getElementById('page-layout');\n      if (layout && layout.parentNode && document.body.firstElementChild !== layout) {\n        document.body.insertBefore(layout, document.body.firstChild);\n      }\n    } catch (e) { /* layout stays where it is */ }\n  })();\n</script>",
    "workflow": "Revise Page layout hero text"
  }
}