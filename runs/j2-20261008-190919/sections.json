{
  "style": {
    "owner": "W-1",
    "head": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Lora:wght@600;700&amp;family=Nunito:wght@400;600;700&amp;display=swap\"><style>:root{--j2-primary:#8B2E1F;--j2-secondary:#2F6B3A;--j2-accent:#E8A317;--j2-background:#FFF8EC;--j2-surface:#FFFFFF;--j2-text:#2B1B14;--j2-muted:#6B5547;--j2-font-heading:'Lora', Georgia, serif;--j2-font-body:'Nunito', system-ui, -apple-system, 'Segoe UI', sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:12px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;background:#8B2E1F;color:#FFFFFF;border:2px solid #8B2E1F;min-height:48px;padding:12px 24px;border-radius:12px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer}.j2-btn-secondary{display:inline-block;background:transparent;color:#8B2E1F;border:2px solid #8B2E1F;min-height:48px;padding:12px 24px;border-radius:12px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer}.j2-card{background:#FFFFFF;border:1px solid #EBD9BF;border-radius:12px;padding:24px;box-shadow:0 2px 8px rgba(43,27,20,0.08)}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-1": {
    "owner": "W-1",
    "head": "<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Kaveri Kitchen | South Indian Restaurant in Kothrud, Pune</title>\n<meta name=\"description\" content=\"Kaveri Kitchen is a South Indian restaurant at Karve Road, Kothrud, Pune. See the menu with prices, today's specials, and book a table on WhatsApp.\">",
    "body": "<style>\n  html { scroll-behavior: smooth; }\n  *, *::before, *::after { box-sizing: border-box; }\n  body { margin: 0; background: var(--j2-background, #FFF8EC); color: var(--j2-text, #2B1B14); font-family: var(--j2-font-body, system-ui, sans-serif); line-height: 1.6; overflow-wrap: break-word; }\n  section[id] { scroll-margin-top: 16px; }\n  .kk-header { background: var(--j2-surface, #FFFFFF); border-bottom: 4px solid var(--j2-accent, #E8A317); text-align: center; padding: 24px 16px 8px; }\n  .kk-header-inner { max-width: 1100px; margin: 0 auto; }\n  .kk-brand { margin: 0; font-family: var(--j2-font-heading, Georgia, serif); font-size: 2.25rem; line-height: 1.2; color: var(--j2-primary, #8B2E1F); }\n  .kk-tagline { margin: 4px 0 16px; color: var(--j2-muted, #6B5547); font-size: 1.05rem; }\n  .kk-cta { margin-bottom: 8px; }\n  .kk-nav ul { list-style: none; margin: 0; padding: 8px 0 8px; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }\n  .kk-nav a { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 44px; padding: 8px 16px; border-radius: 999px; color: var(--j2-primary, #8B2E1F); font-weight: 700; text-decoration: none; border: 1px solid transparent; }\n  .kk-nav a:hover, .kk-nav a:focus-visible { background: var(--j2-background, #FFF8EC); border-color: var(--j2-primary, #8B2E1F); outline: none; }\n  @media (max-width: 480px) {\n    .kk-brand { font-size: 1.85rem; }\n    .kk-nav ul { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; }\n    .kk-nav a { padding: 8px 4px; width: 100%; }\n    .kk-cta .j2-btn { width: 100%; }\n  }\n</style>\n<header class=\"kk-header\" id=\"top\">\n  <div class=\"kk-header-inner\">\n    <h1 class=\"kk-brand\">Kaveri Kitchen</h1>\n    <p class=\"kk-tagline\">South Indian restaurant in Kothrud, Pune</p>\n    <div class=\"kk-cta\"><a class=\"j2-btn\" href=\"#booking\">Book a table</a></div>\n    <nav class=\"kk-nav\" aria-label=\"Main\">\n      <ul>\n        <li><a href=\"#menu\">Menu</a></li>\n        <li><a href=\"#specials\">Specials</a></li>\n        <li><a href=\"#booking\">Booking</a></li>\n        <li><a href=\"#photos\">Photos</a></li>\n        <li><a href=\"#reviews\">Reviews</a></li>\n        <li><a href=\"#contact\">Contact</a></li>\n      </ul>\n    </nav>\n  </div>\n</header>",
    "workflow": "Page shell, header and navigation"
  },
  "W-2": {
    "owner": "W-2",
    "head": "",
    "body": "<style>\n  .kk-menu { padding: var(--j2-section, 64px) 16px; }\n  .kk-menu [hidden] { display: none !important; }\n  .kk-menu-inner { max-width: 800px; margin: 0 auto; }\n  .kk-menu h2 { margin: 0 0 8px; font-size: 2rem; line-height: 1.2; color: var(--j2-primary); text-align: center; }\n  .kk-menu-intro { margin: 0 0 24px; text-align: center; color: var(--j2-muted); }\n  .kk-menu-filters { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-bottom: 16px; }\n  .kk-menu-filters button { font-family: inherit; font-size: 1rem; line-height: 1.2; min-width: 96px; }\n  .kk-menu-count { margin: 0 0 24px; text-align: center; color: var(--j2-muted); font-size: 0.95rem; }\n  .kk-menu-group { margin-bottom: 24px; }\n  .kk-menu-group h3 { margin: 0 0 8px; font-size: 1.4rem; color: var(--j2-primary); }\n  .kk-menu-list { list-style: none; margin: 0; padding: 0; }\n  .kk-dish { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px dashed #EBD9BF; }\n  .kk-dish:last-child { border-bottom: 0; }\n  .kk-dish-info { min-width: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }\n  .kk-dish-name { font-weight: 700; font-size: 1.05rem; }\n  .kk-dish-price { flex: 0 0 auto; font-weight: 700; font-size: 1.05rem; color: var(--j2-primary); white-space: nowrap; }\n  .kk-diet { display: inline-flex; align-items: center; gap: 6px; padding: 2px 10px; border-radius: 999px; font-size: 0.85rem; font-weight: 700; border: 1px solid currentColor; background: var(--j2-surface); }\n  .kk-diet::before { content: \"\"; width: 10px; height: 10px; border-radius: 2px; background: currentColor; }\n  .kk-diet-veg { color: var(--j2-secondary); }\n  .kk-diet-nonveg { color: var(--j2-primary); }\n  @media (max-width: 480px) {\n    .kk-menu h2 { font-size: 1.75rem; }\n    .kk-menu-filters button { flex: 1 1 0; min-width: 0; padding-left: 8px; padding-right: 8px; }\n    .kk-menu .j2-card { padding: 16px; }\n    .kk-dish { gap: 12px; }\n  }\n</style>\n<section class=\"kk-menu\" id=\"menu\" aria-labelledby=\"menu-title\">\n  <div class=\"kk-menu-inner\">\n    <h2 id=\"menu-title\">Our Menu</h2>\n    <p class=\"kk-menu-intro\">Prices are in rupees (&#8377;).</p>\n\n    <div class=\"kk-menu-filters\" role=\"group\" aria-label=\"Filter the menu by diet\">\n      <button type=\"button\" class=\"j2-btn\" data-filter=\"all\" aria-pressed=\"true\">All</button>\n      <button type=\"button\" class=\"j2-btn-secondary\" data-filter=\"veg\" aria-pressed=\"false\">Veg</button>\n      <button type=\"button\" class=\"j2-btn-secondary\" data-filter=\"nonveg\" aria-pressed=\"false\">Non-veg</button>\n    </div>\n    <p class=\"kk-menu-count\" id=\"kk-menu-count\" role=\"status\" aria-live=\"polite\"></p>\n\n    <!-- Dish list: edit a dish here. data-diet is \"veg\" or \"nonveg\". -->\n    <div class=\"kk-menu-group j2-card\" data-group>\n      <h3>Starters</h3>\n      <ul class=\"kk-menu-list\">\n        <li class=\"kk-dish\" data-diet=\"veg\"><div class=\"kk-dish-info\"><span class=\"kk-dish-name\">Medu vada</span><span class=\"kk-diet kk-diet-veg\">Veg</span></div><span class=\"kk-dish-price\">&#8377;120</span></li>\n        <li class=\"kk-dish\" data-diet=\"veg\"><div class=\"kk-dish-info\"><span class=\"kk-dish-name\">Veg cutlet</span><span class=\"kk-diet kk-diet-veg\">Veg</span></div><span class=\"kk-dish-price\">&#8377;140</span></li>\n        <li class=\"kk-dish\" data-diet=\"nonveg\"><div class=\"kk-dish-info\"><span class=\"kk-dish-name\">Chicken 65</span><span class=\"kk-diet kk-diet-nonveg\">Non-veg</span></div><span class=\"kk-dish-price\">&#8377;260</span></li>\n      </ul>\n    </div>\n\n    <div class=\"kk-menu-group j2-card\" data-group>\n      <h3>Mains</h3>\n      <ul class=\"kk-menu-list\">\n        <li class=\"kk-dish\" data-diet=\"veg\"><div class=\"kk-dish-info\"><span class=\"kk-dish-name\">Masala dosa</span><span class=\"kk-diet kk-diet-veg\">Veg</span></div><span class=\"kk-dish-price\">&#8377;160</span></li>\n        <li class=\"kk-dish\" data-diet=\"veg\"><div class=\"kk-dish-info\"><span class=\"kk-dish-name\">Mysore dosa</span><span class=\"kk-diet kk-diet-veg\">Veg</span></div><span class=\"kk-dish-price\">&#8377;180</span></li>\n        <li class=\"kk-dish\" data-diet=\"veg\"><div class=\"kk-dish-info\"><span class=\"kk-dish-name\">Idli sambar</span><span class=\"kk-diet kk-diet-veg\">Veg</span></div><span class=\"kk-dish-price\">&#8377;110</span></li>\n        <li class=\"kk-dish\" data-diet=\"veg\"><div class=\"kk-dish-info\"><span class=\"kk-dish-name\">Veg thali</span><span class=\"kk-diet kk-diet-veg\">Veg</span></div><span class=\"kk-dish-price\">&#8377;280</span></li>\n        <li class=\"kk-dish\" data-diet=\"nonveg\"><div class=\"kk-dish-info\"><span class=\"kk-dish-name\">Chicken chettinad</span><span class=\"kk-diet kk-diet-nonveg\">Non-veg</span></div><span class=\"kk-dish-price\">&#8377;340</span></li>\n        <li class=\"kk-dish\" data-diet=\"nonveg\"><div class=\"kk-dish-info\"><span class=\"kk-dish-name\">Fish curry meal</span><span class=\"kk-diet kk-diet-nonveg\">Non-veg</span></div><span class=\"kk-dish-price\">&#8377;360</span></li>\n      </ul>\n    </div>\n\n    <div class=\"kk-menu-group j2-card\" data-group>\n      <h3>Desserts</h3>\n      <ul class=\"kk-menu-list\">\n        <li class=\"kk-dish\" data-diet=\"veg\"><div class=\"kk-dish-info\"><span class=\"kk-dish-name\">Payasam</span><span class=\"kk-diet kk-diet-veg\">Veg</span></div><span class=\"kk-dish-price\">&#8377;100</span></li>\n        <li class=\"kk-dish\" data-diet=\"veg\"><div class=\"kk-dish-info\"><span class=\"kk-dish-name\">Filter coffee</span><span class=\"kk-diet kk-diet-veg\">Veg</span></div><span class=\"kk-dish-price\">&#8377;60</span></li>\n      </ul>\n    </div>\n  </div>\n  <script>\n    (function () {\n      var section = document.getElementById('menu');\n      if (!section) { return; }\n      var buttons = section.querySelectorAll('[data-filter]');\n      var dishes = section.querySelectorAll('.kk-dish');\n      var groups = section.querySelectorAll('[data-group]');\n      var countEl = document.getElementById('kk-menu-count');\n      var labels = { all: 'all dishes', veg: 'veg dishes', nonveg: 'non-veg dishes' };\n\n      function applyFilter(mode) {\n        var shown = 0;\n        Array.prototype.forEach.call(dishes, function (dish) {\n          var match = mode === 'all' || dish.getAttribute('data-diet') === mode;\n          dish.hidden = !match;\n          if (match) { shown += 1; }\n        });\n        Array.prototype.forEach.call(groups, function (group) {\n          var visible = group.querySelectorAll('.kk-dish:not([hidden])').length;\n          group.hidden = visible === 0;\n        });\n        Array.prototype.forEach.call(buttons, function (btn) {\n          var active = btn.getAttribute('data-filter') === mode;\n          btn.setAttribute('aria-pressed', active ? 'true' : 'false');\n          btn.className = active ? 'j2-btn' : 'j2-btn-secondary';\n        });\n        if (countEl) {\n          countEl.textContent = 'Showing ' + shown + ' ' + (labels[mode] || labels.all);\n        }\n      }\n\n      Array.prototype.forEach.call(buttons, function (btn) {\n        btn.addEventListener('click', function () {\n          applyFilter(btn.getAttribute('data-filter'));\n        });\n      });\n\n      applyFilter('all');\n    })();\n  </script>\n</section>",
    "workflow": "Priced menu with veg/non-veg filter"
  },
  "W-3": {
    "owner": "W-3",
    "head": "",
    "body": "<style>\n  .kk-specials { padding: var(--j2-section, 64px) 16px; background: var(--j2-surface); border-top: 4px solid var(--j2-accent); border-bottom: 4px solid var(--j2-accent); }\n  .kk-specials-inner { max-width: 800px; margin: 0 auto; }\n  .kk-specials h2 { margin: 0 0 8px; font-size: 2rem; line-height: 1.2; color: var(--j2-primary); text-align: center; }\n  .kk-specials-intro { margin: 0 0 24px; text-align: center; color: var(--j2-muted); }\n  .kk-specials-list { list-style: none; margin: 0 0 24px; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }\n  .kk-special { display: flex; flex-direction: column; gap: 8px; min-width: 0; border-left: 6px solid var(--j2-accent); }\n  .kk-special-name { margin: 0; font-family: var(--j2-font-heading); font-size: 1.4rem; line-height: 1.25; color: var(--j2-text); }\n  .kk-special-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }\n  .kk-special-price { font-weight: 700; font-size: 1.25rem; color: var(--j2-primary); white-space: nowrap; }\n  .kk-special-tag { display: inline-flex; align-items: center; gap: 6px; padding: 2px 10px; border-radius: 999px; font-size: 0.85rem; font-weight: 700; border: 1px solid currentColor; background: var(--j2-surface); }\n  .kk-special-tag::before { content: \"\"; width: 10px; height: 10px; border-radius: 2px; background: currentColor; }\n  .kk-special-tag-veg { color: var(--j2-secondary); }\n  .kk-special-tag-nonveg { color: var(--j2-primary); }\n  .kk-specials-more { text-align: center; }\n  @media (max-width: 600px) {\n    .kk-specials h2 { font-size: 1.75rem; }\n    .kk-specials-list { grid-template-columns: minmax(0, 1fr); }\n    .kk-specials .j2-card { padding: 16px; }\n    .kk-specials-more .j2-btn-secondary { width: 100%; }\n  }\n</style>\n<section class=\"kk-specials\" id=\"specials\" aria-labelledby=\"specials-title\">\n  <div class=\"kk-specials-inner\">\n    <h2 id=\"specials-title\">Today's specials</h2>\n    <p class=\"kk-specials-intro\">Two dishes our kitchen is serving up today, at their regular menu prices.</p>\n\n    <!-- Specials list: edit the dishes here. Keep each name and price the same as in the menu. -->\n    <ul class=\"kk-specials-list\">\n      <li class=\"kk-special j2-card\">\n        <h3 class=\"kk-special-name\">Mysore dosa</h3>\n        <div class=\"kk-special-meta\">\n          <span class=\"kk-special-tag kk-special-tag-veg\">Veg</span>\n          <span class=\"kk-special-price\">&#8377;180</span>\n        </div>\n      </li>\n      <li class=\"kk-special j2-card\">\n        <h3 class=\"kk-special-name\">Fish curry meal</h3>\n        <div class=\"kk-special-meta\">\n          <span class=\"kk-special-tag kk-special-tag-nonveg\">Non-veg</span>\n          <span class=\"kk-special-price\">&#8377;360</span>\n        </div>\n      </li>\n    </ul>\n\n    <div class=\"kk-specials-more\"><a class=\"j2-btn-secondary\" href=\"#menu\">See the full menu</a></div>\n  </div>\n</section>",
    "workflow": "Today's specials"
  },
  "W-4": {
    "owner": "W-4",
    "head": "",
    "body": "<style>\n  .kk-booking { padding: var(--j2-section, 64px) 16px; }\n  .kk-booking-inner { max-width: 800px; margin: 0 auto; }\n  .kk-booking h2 { margin: 0 0 8px; font-size: 2rem; line-height: 1.2; color: var(--j2-primary); text-align: center; }\n  .kk-booking-intro { margin: 0 0 24px; text-align: center; color: var(--j2-muted); }\n  .kk-booking .j2-card { text-align: center; }\n  .kk-booking-size { margin: 0 0 16px; font-family: var(--j2-font-heading); font-size: 1.25rem; font-weight: 600; color: var(--j2-text); }\n  .kk-booking-steps { list-style: none; margin: 0 auto 24px; padding: 0; max-width: 420px; text-align: left; display: grid; gap: 8px; }\n  .kk-booking-steps li { display: flex; align-items: center; gap: 12px; min-width: 0; }\n  .kk-booking-steps .kk-step-num { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: var(--j2-accent); color: var(--j2-text); font-weight: 700; }\n  .kk-booking-btn { font-size: 1.1rem; }\n  .kk-booking-note { margin: 16px 0 0; color: var(--j2-muted); font-size: 0.95rem; }\n  @media (max-width: 480px) {\n    .kk-booking h2 { font-size: 1.75rem; }\n    .kk-booking .j2-card { padding: 16px; }\n    .kk-booking-btn { width: 100%; }\n  }\n</style>\n<section class=\"kk-booking\" id=\"booking\" aria-labelledby=\"booking-title\">\n  <div class=\"kk-booking-inner\">\n    <h2 id=\"booking-title\">Book a table</h2>\n    <p class=\"kk-booking-intro\">Booking is by WhatsApp. Tap the button and send the message.</p>\n\n    <div class=\"j2-card\">\n      <p class=\"kk-booking-size\">Tables are for 1 to 8 people.</p>\n      <ol class=\"kk-booking-steps\">\n        <li><span class=\"kk-step-num\" aria-hidden=\"true\">1</span><span>Tap Book a table on WhatsApp.</span></li>\n        <li><span class=\"kk-step-num\" aria-hidden=\"true\">2</span><span>Fill in your name, date, time and number of people.</span></li>\n        <li><span class=\"kk-step-num\" aria-hidden=\"true\">3</span><span>Send the message to us.</span></li>\n      </ol>\n      <!-- Booking link: the number is in the URL (910000033333). The message text after ?text= is URL-encoded. -->\n      <a class=\"j2-btn kk-booking-btn\" id=\"kk-book-link\" target=\"_blank\" rel=\"noopener\"\n         href=\"https://wa.me/910000033333?text=Hello%20Kaveri%20Kitchen%2C%20I%20would%20like%20to%20book%20a%20table.%0A%0AName%3A%20%0ADate%3A%20%0ATime%3A%20%0ANumber%20of%20people%20%281%20to%208%29%3A%20\">Book a table on WhatsApp</a>\n      <p class=\"kk-booking-note\">WhatsApp number: +91 00000 33333</p>\n    </div>\n  </div>\n</section>",
    "workflow": "WhatsApp table booking"
  },
  "W-5": {
    "owner": "W-5",
    "head": "",
    "body": "<style>\n  .kk-photos { padding: var(--j2-section, 64px) 16px; }\n  .kk-photos-inner { max-width: 800px; margin: 0 auto; }\n  .kk-photos h2 { margin: 0 0 8px; font-size: 2rem; line-height: 1.2; color: var(--j2-primary); text-align: center; }\n  .kk-photos-intro { margin: 0 0 24px; text-align: center; color: var(--j2-muted); }\n  .kk-photos-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }\n  .kk-photo-spot { margin: 0; min-width: 0; }\n  .kk-photo-frame { display: flex; align-items: center; justify-content: center; aspect-ratio: 4 / 3; width: 100%; border: 2px dashed var(--j2-accent); border-radius: var(--j2-radius, 12px); background: var(--j2-surface); color: var(--j2-muted); font-size: 0.9rem; font-weight: 600; text-align: center; padding: 8px; }\n  .kk-photo-caption { margin: 8px 0 0; font-family: var(--j2-font-heading); font-size: 1.1rem; font-weight: 600; line-height: 1.3; color: var(--j2-text); text-align: center; overflow-wrap: break-word; }\n  @media (max-width: 600px) {\n    .kk-photos h2 { font-size: 1.75rem; }\n    .kk-photos-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\n    .kk-photo-caption { font-size: 1rem; }\n  }\n</style>\n<section class=\"kk-photos\" id=\"photos\" aria-labelledby=\"photos-title\">\n  <div class=\"kk-photos-inner\">\n    <h2 id=\"photos-title\">Dish photos</h2>\n    <p class=\"kk-photos-intro\">Photos of our dishes will be shown in the spots below.</p>\n\n    <!-- Photo spots: one list item per dish. Each spot is an empty frame with a label. -->\n    <ul class=\"kk-photos-grid\">\n      <li>\n        <figure class=\"kk-photo-spot\">\n          <div class=\"kk-photo-frame\">Photo spot</div>\n          <figcaption class=\"kk-photo-caption\">Masala dosa</figcaption>\n        </figure>\n      </li>\n      <li>\n        <figure class=\"kk-photo-spot\">\n          <div class=\"kk-photo-frame\">Photo spot</div>\n          <figcaption class=\"kk-photo-caption\">Mysore dosa</figcaption>\n        </figure>\n      </li>\n      <li>\n        <figure class=\"kk-photo-spot\">\n          <div class=\"kk-photo-frame\">Photo spot</div>\n          <figcaption class=\"kk-photo-caption\">Idli sambar</figcaption>\n        </figure>\n      </li>\n      <li>\n        <figure class=\"kk-photo-spot\">\n          <div class=\"kk-photo-frame\">Photo spot</div>\n          <figcaption class=\"kk-photo-caption\">Fish curry meal</figcaption>\n        </figure>\n      </li>\n      <li>\n        <figure class=\"kk-photo-spot\">\n          <div class=\"kk-photo-frame\">Photo spot</div>\n          <figcaption class=\"kk-photo-caption\">Veg thali</figcaption>\n        </figure>\n      </li>\n      <li>\n        <figure class=\"kk-photo-spot\">\n          <div class=\"kk-photo-frame\">Photo spot</div>\n          <figcaption class=\"kk-photo-caption\">Filter coffee</figcaption>\n        </figure>\n      </li>\n    </ul>\n  </div>\n</section>",
    "workflow": "Dish photo spots"
  },
  "W-6": {
    "owner": "W-6",
    "head": "",
    "body": "<style>\n  .kk-reviews { padding: var(--j2-section, 64px) 16px; }\n  .kk-reviews-inner { max-width: 800px; margin: 0 auto; }\n  .kk-reviews h2 { margin: 0 0 8px; font-size: 2rem; line-height: 1.2; color: var(--j2-primary); text-align: center; }\n  .kk-reviews-intro { margin: 0 0 24px; text-align: center; color: var(--j2-muted); }\n  .kk-reviews-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }\n  .kk-review { margin: 0; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 16px; border-top: 6px solid var(--j2-accent); }\n  .kk-review-quote { margin: 0; font-family: var(--j2-font-heading); font-size: 1.3rem; font-weight: 600; line-height: 1.35; color: var(--j2-text); overflow-wrap: break-word; }\n  .kk-review-by { margin: 0; font-weight: 700; color: var(--j2-secondary); font-style: normal; }\n  @media (max-width: 700px) {\n    .kk-reviews h2 { font-size: 1.75rem; }\n    .kk-reviews-list { grid-template-columns: minmax(0, 1fr); }\n    .kk-reviews .j2-card { padding: 16px; }\n  }\n</style>\n<section class=\"kk-reviews\" id=\"reviews\" aria-labelledby=\"reviews-title\">\n  <div class=\"kk-reviews-inner\">\n    <h2 id=\"reviews-title\">What our guests say</h2>\n    <p class=\"kk-reviews-intro\">A few words from people who have eaten with us.</p>\n\n    <!-- Reviews list: exactly three reviews. Edit the quote and the name here. -->\n    <ul class=\"kk-reviews-list\">\n      <li>\n        <figure class=\"kk-review j2-card\">\n          <blockquote class=\"kk-review-quote\">&ldquo;Best dosa in Kothrud&rdquo;</blockquote>\n          <figcaption class=\"kk-review-by\">Anita R.</figcaption>\n        </figure>\n      </li>\n      <li>\n        <figure class=\"kk-review j2-card\">\n          <blockquote class=\"kk-review-quote\">&ldquo;Feels like home&rdquo;</blockquote>\n          <figcaption class=\"kk-review-by\">Vikram S.</figcaption>\n        </figure>\n      </li>\n      <li>\n        <figure class=\"kk-review j2-card\">\n          <blockquote class=\"kk-review-quote\">&ldquo;Great filter coffee&rdquo;</blockquote>\n          <figcaption class=\"kk-review-by\">Neha P.</figcaption>\n        </figure>\n      </li>\n    </ul>\n  </div>\n</section>",
    "workflow": "Customer reviews"
  },
  "W-7": {
    "owner": "W-7",
    "head": "",
    "body": "<style>\n  .kk-contact { padding: var(--j2-section, 64px) 16px; background: var(--j2-surface); border-top: 4px solid var(--j2-accent); }\n  .kk-contact-inner { max-width: 800px; margin: 0 auto; }\n  .kk-contact h2 { margin: 0 0 8px; font-size: 2rem; line-height: 1.2; color: var(--j2-primary); text-align: center; }\n  .kk-contact-intro { margin: 0 0 24px; text-align: center; color: var(--j2-muted); }\n  .kk-contact-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }\n  .kk-contact-card { min-width: 0; display: flex; flex-direction: column; gap: 8px; border-top: 6px solid var(--j2-accent); }\n  .kk-contact-card h3 { margin: 0; font-size: 1.3rem; line-height: 1.25; color: var(--j2-primary); }\n  .kk-contact-card p { margin: 0; overflow-wrap: break-word; }\n  .kk-contact-address { font-style: normal; line-height: 1.6; overflow-wrap: break-word; }\n  .kk-contact-hours { font-weight: 700; }\n  .kk-contact-kitchen { color: var(--j2-muted); }\n  .kk-contact-call { margin-top: 8px; max-width: 100%; text-align: center; }\n  @media (max-width: 700px) {\n    .kk-contact h2 { font-size: 1.75rem; }\n    .kk-contact-grid { grid-template-columns: minmax(0, 1fr); }\n    .kk-contact .j2-card { padding: 16px; }\n    .kk-contact-call { width: 100%; }\n  }\n</style>\n<section class=\"kk-contact\" id=\"contact\" aria-labelledby=\"contact-title\">\n  <div class=\"kk-contact-inner\">\n    <h2 id=\"contact-title\">Find us</h2>\n    <p class=\"kk-contact-intro\">Come by for a meal, or call us before you visit.</p>\n\n    <!-- Contact details: edit the address, hours and phone here. Keep the tel link and the shown number the same. -->\n    <div class=\"kk-contact-grid\">\n      <div class=\"kk-contact-card j2-card\">\n        <h3>Address</h3>\n        <address class=\"kk-contact-address\">7 Karve Road, Kothrud, Pune 411038</address>\n      </div>\n      <div class=\"kk-contact-card j2-card\">\n        <h3>Opening hours</h3>\n        <p class=\"kk-contact-hours\">8am to 10:30pm every day</p>\n        <p class=\"kk-contact-kitchen\">Kitchen closes at 10pm</p>\n      </div>\n      <div class=\"kk-contact-card j2-card\">\n        <h3>Phone</h3>\n        <p>Call the restaurant:</p>\n        <a class=\"j2-btn kk-contact-call\" href=\"tel:+910000044444\">+91 00000 44444</a>\n      </div>\n    </div>\n  </div>\n</section>",
    "workflow": "Address, hours and phone"
  },
  "W-8": {
    "owner": "W-8",
    "head": "",
    "body": "<style>\n  .kk-footer { background: var(--j2-text); color: var(--j2-background); padding: 40px 16px 24px; border-top: 4px solid var(--j2-accent); }\n  .kk-footer-inner { max-width: 800px; margin: 0 auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }\n  .kk-footer-brand { margin: 0 0 4px; font-family: var(--j2-font-heading); font-size: 1.5rem; line-height: 1.2; color: var(--j2-accent); }\n  .kk-footer p, .kk-footer address { margin: 0 0 4px; font-style: normal; line-height: 1.6; overflow-wrap: break-word; }\n  .kk-footer-links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 8px; }\n  .kk-footer a { display: inline-flex; align-items: center; min-height: 44px; min-width: 44px; padding: 8px 8px; color: var(--j2-background); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }\n  .kk-footer a:hover, .kk-footer a:focus-visible { color: var(--j2-accent); outline: none; }\n  .kk-footer-bottom { max-width: 800px; margin: 16px auto 0; padding-top: 16px; border-top: 1px solid var(--j2-muted); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }\n  .kk-footer-bottom p { margin: 0; }\n  @media (max-width: 600px) {\n    .kk-footer-inner { grid-template-columns: minmax(0, 1fr); }\n    .kk-footer-bottom { flex-direction: column; align-items: flex-start; }\n  }\n</style>\n<footer class=\"kk-footer\" id=\"footer\">\n  <div class=\"kk-footer-inner\">\n    <div>\n      <p class=\"kk-footer-brand\">Kaveri Kitchen</p>\n      <p>South Indian restaurant in Kothrud, Pune</p>\n      <address>7 Karve Road, Kothrud, Pune 411038</address>\n      <p>Open 8am to 10:30pm every day</p>\n      <p>Kitchen closes at 10pm</p>\n      <a href=\"tel:+910000044444\">+91 00000 44444</a>\n    </div>\n    <nav aria-label=\"Footer\">\n      <ul class=\"kk-footer-links\">\n        <li><a href=\"#menu\">Menu</a></li>\n        <li><a href=\"#specials\">Specials</a></li>\n        <li><a href=\"#booking\">Booking</a></li>\n        <li><a href=\"#photos\">Photos</a></li>\n        <li><a href=\"#reviews\">Reviews</a></li>\n        <li><a href=\"#contact\">Contact</a></li>\n      </ul>\n    </nav>\n  </div>\n  <div class=\"kk-footer-bottom\">\n    <p>Tables are for 1 to 8 people, booked on WhatsApp.</p>\n    <a href=\"#top\">Back to top</a>\n  </div>\n</footer>",
    "workflow": "Footer and content hygiene"
  },
  "W-9": {
    "owner": "W-9",
    "head": "",
    "body": "<style>\n  /* W-9: warm look and responsive layout. Colours and fonts come only from the J2 variables. */\n\n  /* Overflow guards at every width */\n  html, body { max-width: 100%; overflow-x: clip; }\n  img, svg, video, iframe, table { max-width: 100%; height: auto; }\n  h1, h2, h3, h4, p, li, address, figcaption, blockquote, a, button { overflow-wrap: anywhere; }\n  .kk-header, section[id], .kk-footer { width: 100%; max-width: 100%; }\n\n  /* Readable base text */\n  body { font-size: 1rem; line-height: 1.6; -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }\n  h1, h2, h3, h4 { line-height: 1.25; }\n\n  /* Tap targets: at least 44px tall everywhere */\n  .j2-btn, .j2-btn-secondary, button,\n  .kk-nav a, .kk-footer a { min-height: 44px; }\n  .j2-btn, .j2-btn-secondary { max-width: 100%; text-align: center; }\n  .j2-btn, .j2-btn-secondary, .kk-nav a, .kk-footer a, button { -webkit-tap-highlight-color: transparent; }\n\n  /* Warm touches */\n  .kk-header { background: var(--j2-surface); }\n  .kk-brand { letter-spacing: 0.01em; }\n  .kk-menu h2::after, .kk-specials h2::after, .kk-booking h2::after,\n  .kk-photos h2::after, .kk-reviews h2::after, .kk-contact h2::after {\n    content: \"\"; display: block; width: 64px; height: 4px; margin: 12px auto 0;\n    border-radius: 999px; background: var(--j2-accent);\n  }\n  .j2-card { max-width: 100%; }\n  .j2-btn, .j2-btn-secondary { transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease; }\n  .j2-btn:hover { box-shadow: 0 4px 12px rgba(43, 27, 20, 0.18); transform: translateY(-1px); }\n  .j2-btn-secondary:hover { background: var(--j2-surface); box-shadow: 0 4px 12px rgba(43, 27, 20, 0.12); transform: translateY(-1px); }\n\n  /* Visible keyboard focus */\n  a:focus-visible, button:focus-visible {\n    outline: 3px solid var(--j2-accent);\n    outline-offset: 2px;\n  }\n\n  /* Phones: tighter spacing, full-width actions */\n  @media (max-width: 700px) {\n    :root { --j2-section: 48px; }\n    .kk-header { padding-left: 12px; padding-right: 12px; }\n    .kk-menu, .kk-specials, .kk-booking, .kk-photos, .kk-reviews, .kk-contact { padding-left: 16px; padding-right: 16px; }\n    .j2-card { padding: 16px; }\n  }\n  @media (max-width: 480px) {\n    :root { --j2-section: 40px; }\n    body { font-size: 1rem; }\n    .kk-tagline { font-size: 1rem; }\n    .kk-menu h2, .kk-specials h2, .kk-booking h2,\n    .kk-photos h2, .kk-reviews h2, .kk-contact h2 { font-size: 1.6rem; }\n    .kk-dish-name, .kk-dish-price { font-size: 1rem; }\n    .kk-footer { padding-left: 16px; padding-right: 16px; }\n    .kk-footer-links { gap: 4px; }\n  }\n  @media (max-width: 360px) {\n    .kk-brand { font-size: 1.65rem; }\n    .kk-nav a { font-size: 0.95rem; padding-left: 2px; padding-right: 2px; }\n    .kk-menu-filters { gap: 6px; }\n    .kk-menu-filters button { font-size: 0.95rem; padding-left: 4px; padding-right: 4px; }\n    .kk-review-quote { font-size: 1.15rem; }\n    .kk-photo-frame { font-size: 0.8rem; }\n  }\n\n  /* Tablets and small laptops */\n  @media (min-width: 701px) and (max-width: 1023px) {\n    .kk-reviews-list, .kk-contact-grid { gap: 12px; }\n    .kk-contact-card h3 { font-size: 1.2rem; }\n  }\n\n  /* Desktop: roomier header and sections */\n  @media (min-width: 1024px) {\n    :root { --j2-section: 80px; }\n    .kk-header { padding-top: 32px; }\n    .kk-brand { font-size: 3rem; }\n    .kk-tagline { font-size: 1.15rem; }\n    .kk-menu h2, .kk-specials h2, .kk-booking h2,\n    .kk-photos h2, .kk-reviews h2, .kk-contact h2 { font-size: 2.25rem; }\n    .kk-menu-inner, .kk-specials-inner, .kk-booking-inner, .kk-photos-inner,\n    .kk-reviews-inner, .kk-contact-inner { max-width: 960px; }\n    .kk-footer-inner, .kk-footer-bottom { max-width: 960px; }\n  }\n\n  /* Respect reduced-motion settings */\n  @media (prefers-reduced-motion: reduce) {\n    html { scroll-behavior: auto; }\n    .j2-btn, .j2-btn-secondary { transition: none; }\n    .j2-btn:hover, .j2-btn-secondary:hover { transform: none; }\n  }\n</style>",
    "workflow": "Warm look and responsive layout"
  }
}