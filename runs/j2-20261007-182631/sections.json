{
  "style": {
    "owner": "W-1",
    "head": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700&amp;family=Playfair+Display:wght@600;700&amp;display=swap\"><style>:root{--j2-primary:#9D2B5B;--j2-secondary:#2F5D46;--j2-accent:#F6C9D3;--j2-background:#FFF8F5;--j2-surface:#FFFFFF;--j2-text:#2B2024;--j2-muted:#66555B;--j2-font-heading:'Playfair Display', Georgia, serif;--j2-font-body:'Nunito Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;--j2-space:8px;--j2-section:64px;--j2-radius:12px;}body{margin:0;font-family:var(--j2-font-body);color:var(--j2-text);background:var(--j2-background)}h1,h2,h3,h4{font-family:var(--j2-font-heading)}.j2-btn{display:inline-block;display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 24px;background:#9D2B5B;color:#FFFFFF;border:2px solid #9D2B5B;border-radius:999px;font-weight:700;font-size:1rem;text-decoration:none;cursor:pointer;}.j2-btn-secondary{display:inline-block;display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 24px;background:transparent;color:#9D2B5B;border:2px solid #9D2B5B;border-radius:999px;font-weight:700;font-size:1rem;text-decoration:none;cursor:pointer;}.j2-card{background:#FFFFFF;border:1px solid #F0DDE2;border-radius:12px;padding:16px;box-shadow:0 2px 8px rgba(157,43,91,0.08);}</style>",
    "body": "",
    "workflow": "Style guide"
  },
  "W-1": {
    "owner": "W-1",
    "head": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Petal &amp; Stem | Flower shop in Jaipur</title>\n<meta name=\"description\" content=\"Petal &amp; Stem is a flower shop at 12 MI Road, Jaipur. See our bouquets with prices and order for delivery on WhatsApp.\">\n<style>\n*,*::before,*::after{box-sizing:border-box}\nhtml{scroll-behavior:smooth;-webkit-text-size-adjust:100%}\nbody{margin:0;background:var(--j2-background,#FFF8F5);color:var(--j2-text,#2B2024);font-family:var(--j2-font-body,system-ui,sans-serif);line-height:1.6}\nimg,svg,iframe{max-width:100%}\nh1,h2,h3{font-family:var(--j2-font-heading,Georgia,serif);line-height:1.2;overflow-wrap:break-word}\n</style>",
    "body": "<style>\n.ps-header{background:var(--j2-surface,#fff);border-bottom:1px solid #F0DDE2}\n.ps-header-inner{max-width:1100px;margin:0 auto;padding:12px 16px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px 24px}\n.ps-brand{display:inline-flex;align-items:center;gap:8px;min-height:44px;font-family:var(--j2-font-heading,Georgia,serif);font-weight:700;font-size:1.35rem;color:var(--j2-primary,#9D2B5B);text-decoration:none}\n.ps-brand svg{width:32px;height:32px;flex:none}\n.ps-nav{display:flex;flex-wrap:wrap;gap:0 4px}\n.ps-nav a{display:inline-flex;align-items:center;min-height:44px;padding:0 10px;color:var(--j2-text,#2B2024);font-weight:600;text-decoration:none;border-radius:8px}\n.ps-nav a:hover,.ps-nav a:focus-visible{background:var(--j2-accent,#F6C9D3);outline:none}\n.ps-hero{position:relative;overflow:hidden;background:linear-gradient(135deg,#FFF8F5 0%,var(--j2-accent,#F6C9D3) 100%)}\n.ps-hero-inner{position:relative;z-index:1;max-width:1100px;margin:0 auto;padding:56px 16px 64px}\n.ps-eyebrow{margin:0 0 8px;color:var(--j2-secondary,#2F5D46);font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:.85rem}\n.ps-hero h1{margin:0 0 16px;font-size:clamp(2.25rem,8vw,4rem);color:var(--j2-primary,#9D2B5B)}\n.ps-lead{max-width:36rem;margin:0 0 24px;font-size:1.125rem}\n.ps-cta{display:flex;flex-wrap:wrap;gap:12px}\n.ps-facts{list-style:none;margin:24px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:8px}\n.ps-facts li{background:var(--j2-surface,#fff);border-radius:999px;padding:6px 14px;font-size:.95rem;font-weight:600;color:var(--j2-secondary,#2F5D46)}\n.ps-blob{position:absolute;border-radius:50%;pointer-events:none}\n.ps-blob.b1{width:260px;height:260px;right:-80px;top:-70px;background:rgba(157,43,91,.12)}\n.ps-blob.b2{width:180px;height:180px;right:60px;bottom:-90px;background:rgba(47,93,70,.12)}\n@media (max-width:480px){.ps-hero-inner{padding:40px 16px 48px}.ps-cta .j2-btn,.ps-cta .j2-btn-secondary{width:100%}}\n</style>\n\n<header class=\"ps-header\" id=\"top\">\n  <div class=\"ps-header-inner\">\n    <a class=\"ps-brand\" href=\"#top\" aria-label=\"Petal &amp; Stem, back to top\">\n      <svg viewBox=\"0 0 32 32\" aria-hidden=\"true\" focusable=\"false\">\n        <g fill=\"#9D2B5B\">\n          <circle cx=\"16\" cy=\"8\" r=\"6\"/><circle cx=\"24\" cy=\"16\" r=\"6\"/>\n          <circle cx=\"16\" cy=\"24\" r=\"6\"/><circle cx=\"8\" cy=\"16\" r=\"6\"/>\n        </g>\n        <circle cx=\"16\" cy=\"16\" r=\"4.5\" fill=\"#F6C9D3\"/>\n      </svg>\n      <span>Petal &amp; Stem</span>\n    </a>\n    <nav class=\"ps-nav\" aria-label=\"Main\">\n      <a href=\"#bouquets\">Bouquets</a>\n      <a href=\"#order\">Order</a>\n      <a href=\"#delivery\">Delivery</a>\n      <a href=\"#visit\">Visit us</a>\n    </nav>\n  </div>\n</header>\n\n<section class=\"ps-hero\" aria-labelledby=\"ps-title\">\n  <span class=\"ps-blob b1\" aria-hidden=\"true\"></span>\n  <span class=\"ps-blob b2\" aria-hidden=\"true\"></span>\n  <div class=\"ps-hero-inner\">\n    <p class=\"ps-eyebrow\">Flower shop in Jaipur</p>\n    <h1 id=\"ps-title\">Petal &amp; Stem</h1>\n    <p class=\"ps-lead\">Bouquets for every occasion, from our shop at 12 MI Road, Jaipur. Pick a bouquet, send your order on WhatsApp, and pay when it arrives.</p>\n    <div class=\"ps-cta\">\n      <a class=\"j2-btn\" href=\"#order\">Order a bouquet</a>\n      <a class=\"j2-btn-secondary j2-btn j2-btn-secondary\" href=\"#bouquets\">See bouquets and prices</a>\n    </div>\n    <ul class=\"ps-facts\">\n      <li>Same day delivery in Jaipur</li>\n      <li>Pay on delivery</li>\n    </ul>\n  </div>\n</section>\n\n<script>\n(function () {\n  function prune() {\n    var links = document.querySelectorAll('.ps-nav a[href^=\"#\"]');\n    for (var i = 0; i < links.length; i++) {\n      var id = links[i].getAttribute('href').slice(1);\n      if (id && !document.getElementById(id)) { links[i].parentNode.removeChild(links[i]); }\n    }\n    var cta = document.querySelectorAll('.ps-cta a[href^=\"#\"]');\n    for (var j = 0; j < cta.length; j++) {\n      var cid = cta[j].getAttribute('href').slice(1);\n      if (cid && !document.getElementById(cid)) { cta[j].style.display = 'none'; }\n    }\n  }\n  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', prune); } else { prune(); }\n})();\n</script>",
    "workflow": "Scaffold and styling"
  },
  "W-2": {
    "owner": "W-2",
    "head": "",
    "body": "<style>\n.ps-bq{padding:var(--j2-section,64px) 16px}\n.ps-bq-inner{max-width:1100px;margin:0 auto}\n.ps-bq h2{margin:0 0 8px;font-size:clamp(1.75rem,5vw,2.5rem);color:var(--j2-primary,#9D2B5B)}\n.ps-bq-intro{margin:0 0 32px;color:var(--j2-muted,#66555B)}\n.ps-bq-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:24px}\n.ps-bq-card{display:flex;flex-direction:column;gap:12px;min-width:0}\n.ps-bq-photo{width:100%;aspect-ratio:4/3;border-radius:var(--j2-radius,12px);background:var(--j2-accent,#F6C9D3);border:2px dashed var(--j2-primary,#9D2B5B)}\n.ps-bq-name{margin:0;font-size:1.25rem;color:var(--j2-text,#2B2024);overflow-wrap:break-word}\n.ps-bq-price{margin:0;font-size:1.35rem;font-weight:700;color:var(--j2-primary,#9D2B5B)}\n.ps-bq-cta{margin:32px 0 0}\n</style>\n\n<section class=\"ps-bq\" id=\"bouquets\" aria-labelledby=\"ps-bq-title\">\n  <div class=\"ps-bq-inner\">\n    <h2 id=\"ps-bq-title\">Our bouquets</h2>\n    <p class=\"ps-bq-intro\">Five bouquets from Petal &amp; Stem, with prices in rupees.</p>\n    <ul class=\"ps-bq-grid\">\n      <li class=\"j2-card ps-bq-card\">\n        <div class=\"ps-bq-photo\" role=\"img\" aria-label=\"Photo of Red rose dozen not added yet\"></div>\n        <h3 class=\"ps-bq-name\">Red rose dozen</h3>\n        <p class=\"ps-bq-price\">₹899</p>\n      </li>\n      <li class=\"j2-card ps-bq-card\">\n        <div class=\"ps-bq-photo\" role=\"img\" aria-label=\"Photo of Sunflower bunch not added yet\"></div>\n        <h3 class=\"ps-bq-name\">Sunflower bunch</h3>\n        <p class=\"ps-bq-price\">₹699</p>\n      </li>\n      <li class=\"j2-card ps-bq-card\">\n        <div class=\"ps-bq-photo\" role=\"img\" aria-label=\"Photo of Mixed seasonal not added yet\"></div>\n        <h3 class=\"ps-bq-name\">Mixed seasonal</h3>\n        <p class=\"ps-bq-price\">₹999</p>\n      </li>\n      <li class=\"j2-card ps-bq-card\">\n        <div class=\"ps-bq-photo\" role=\"img\" aria-label=\"Photo of White lilies not added yet\"></div>\n        <h3 class=\"ps-bq-name\">White lilies</h3>\n        <p class=\"ps-bq-price\">₹1,199</p>\n      </li>\n      <li class=\"j2-card ps-bq-card\">\n        <div class=\"ps-bq-photo\" role=\"img\" aria-label=\"Photo of Orchid box not added yet\"></div>\n        <h3 class=\"ps-bq-name\">Orchid box</h3>\n        <p class=\"ps-bq-price\">₹1,499</p>\n      </li>\n    </ul>\n    <p class=\"ps-bq-cta\"><a class=\"j2-btn\" id=\"ps-bq-order\" href=\"#order\">Order a bouquet</a></p>\n  </div>\n</section>\n\n<script>\n(function () {\n  function check() {\n    var a = document.getElementById('ps-bq-order');\n    if (a && !document.getElementById('order')) { a.parentNode.style.display = 'none'; }\n  }\n  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', check); } else { check(); }\n})();\n</script>",
    "workflow": "Bouquets and prices"
  },
  "W-3": {
    "owner": "W-3",
    "head": "",
    "body": "<style>\n.ps-od{padding:var(--j2-section,64px) 16px;background:var(--j2-surface,#fff)}\n.ps-od-inner{max-width:640px;margin:0 auto}\n.ps-od h2{margin:0 0 8px;font-size:clamp(1.75rem,5vw,2.5rem);color:var(--j2-primary,#9D2B5B)}\n.ps-od-intro{margin:0 0 24px;color:var(--j2-muted,#66555B)}\n.ps-od-form{display:flex;flex-direction:column;gap:16px;min-width:0}\n.ps-od-field{display:flex;flex-direction:column;gap:6px;min-width:0}\n.ps-od-field label{font-weight:700;color:var(--j2-text,#2B2024)}\n.ps-od-field select,.ps-od-field input,.ps-od-field textarea{width:100%;min-height:48px;padding:10px 14px;font:inherit;font-size:1rem;color:var(--j2-text,#2B2024);background:var(--j2-surface,#fff);border:2px solid #F0DDE2;border-radius:var(--j2-radius,12px)}\n.ps-od-field textarea{min-height:104px;resize:vertical}\n.ps-od-field select:focus,.ps-od-field input:focus,.ps-od-field textarea:focus{outline:none;border-color:var(--j2-primary,#9D2B5B)}\n.ps-od-field [aria-invalid=\"true\"]{border-color:var(--j2-primary,#9D2B5B);background:var(--j2-background,#FFF8F5)}\n.ps-od-err{margin:0;min-height:0;font-size:.9rem;font-weight:600;color:var(--j2-primary,#9D2B5B)}\n.ps-od-note{margin:0;font-size:.95rem;color:var(--j2-secondary,#2F5D46);font-weight:600}\n.ps-od-form .j2-btn{width:100%}\n.ps-od-status{margin:16px 0 0;color:var(--j2-text,#2B2024);overflow-wrap:anywhere}\n.ps-od-status a{color:var(--j2-primary,#9D2B5B);font-weight:700}\n</style>\n\n<section class=\"ps-od\" id=\"order\" aria-labelledby=\"ps-od-title\">\n  <div class=\"ps-od-inner\">\n    <h2 id=\"ps-od-title\">Order a bouquet for delivery</h2>\n    <p class=\"ps-od-intro\">Choose a bouquet and tell us where to send it. Your order opens as a WhatsApp message to the shop, so you can check it before you send.</p>\n    <form class=\"j2-card ps-od-form\" id=\"ps-od-form\" novalidate>\n      <div class=\"ps-od-field\">\n        <label for=\"ps-od-bouquet\">Bouquet</label>\n        <select id=\"ps-od-bouquet\" name=\"bouquet\" required>\n          <option value=\"\">Choose a bouquet</option>\n          <option value=\"Red rose dozen (₹899)\">Red rose dozen, ₹899</option>\n          <option value=\"Sunflower bunch (₹699)\">Sunflower bunch, ₹699</option>\n          <option value=\"Mixed seasonal (₹999)\">Mixed seasonal, ₹999</option>\n          <option value=\"White lilies (₹1,199)\">White lilies, ₹1,199</option>\n          <option value=\"Orchid box (₹1,499)\">Orchid box, ₹1,499</option>\n        </select>\n        <p class=\"ps-od-err\" id=\"ps-od-bouquet-err\" role=\"alert\"></p>\n      </div>\n      <div class=\"ps-od-field\">\n        <label for=\"ps-od-name\">Your name</label>\n        <input id=\"ps-od-name\" name=\"name\" type=\"text\" autocomplete=\"name\" required>\n        <p class=\"ps-od-err\" id=\"ps-od-name-err\" role=\"alert\"></p>\n      </div>\n      <div class=\"ps-od-field\">\n        <label for=\"ps-od-phone\">Phone number</label>\n        <input id=\"ps-od-phone\" name=\"phone\" type=\"tel\" inputmode=\"tel\" autocomplete=\"tel\" required>\n        <p class=\"ps-od-err\" id=\"ps-od-phone-err\" role=\"alert\"></p>\n      </div>\n      <div class=\"ps-od-field\">\n        <label for=\"ps-od-address\">Delivery address in Jaipur</label>\n        <textarea id=\"ps-od-address\" name=\"address\" autocomplete=\"street-address\" required></textarea>\n        <p class=\"ps-od-err\" id=\"ps-od-address-err\" role=\"alert\"></p>\n      </div>\n      <p class=\"ps-od-note\">Pay on delivery. No online payment.</p>\n      <button type=\"submit\" class=\"j2-btn\">Send order on WhatsApp</button>\n    </form>\n    <p class=\"ps-od-status\" id=\"ps-od-status\" role=\"status\" aria-live=\"polite\"></p>\n  </div>\n</section>\n\n<script>\n(function () {\n  var WA_NUMBER = '919829011223';\n\n  function init() {\n    var form = document.getElementById('ps-od-form');\n    if (!form) { return; }\n    var status = document.getElementById('ps-od-status');\n    var fields = {\n      bouquet: document.getElementById('ps-od-bouquet'),\n      name: document.getElementById('ps-od-name'),\n      phone: document.getElementById('ps-od-phone'),\n      address: document.getElementById('ps-od-address')\n    };\n\n    function setError(key, msg) {\n      var el = fields[key];\n      var out = document.getElementById('ps-od-' + key + '-err');\n      if (msg) {\n        el.setAttribute('aria-invalid', 'true');\n        el.setAttribute('aria-describedby', 'ps-od-' + key + '-err');\n      } else {\n        el.removeAttribute('aria-invalid');\n        el.removeAttribute('aria-describedby');\n      }\n      if (out) { out.textContent = msg || ''; }\n    }\n\n    function validate() {\n      var ok = true;\n      var firstBad = null;\n      var bouquet = fields.bouquet.value;\n      var name = fields.name.value.replace(/^\\s+|\\s+$/g, '');\n      var phone = fields.phone.value.replace(/^\\s+|\\s+$/g, '');\n      var address = fields.address.value.replace(/^\\s+|\\s+$/g, '');\n      var digits = phone.replace(/\\D/g, '');\n\n      function fail(key, msg) {\n        setError(key, msg);\n        ok = false;\n        if (!firstBad) { firstBad = fields[key]; }\n      }\n\n      if (!bouquet) { fail('bouquet', 'Please choose a bouquet.'); } else { setError('bouquet', ''); }\n      if (!name) { fail('name', 'Please enter your name.'); } else { setError('name', ''); }\n      if (digits.length < 10 || digits.length > 15 || /[^0-9+\\s\\-()]/.test(phone)) {\n        fail('phone', 'Please enter a valid phone number with at least 10 digits.');\n      } else { setError('phone', ''); }\n      if (address.length < 5) { fail('address', 'Please enter the full delivery address.'); } else { setError('address', ''); }\n\n      if (!ok && firstBad && firstBad.focus) { firstBad.focus(); }\n      return ok ? { bouquet: bouquet, name: name, phone: phone, address: address } : null;\n    }\n\n    function buildUrl(d) {\n      var text = 'Hello Petal & Stem, I would like to order a bouquet for delivery.\\n' +\n        'Bouquet: ' + d.bouquet + '\\n' +\n        'Name: ' + d.name + '\\n' +\n        'Phone: ' + d.phone + '\\n' +\n        'Delivery address: ' + d.address + '\\n' +\n        'Payment: on delivery';\n      return 'https://wa.me/' + WA_NUMBER + '?text=' + encodeURIComponent(text);\n    }\n\n    form.addEventListener('submit', function (e) {\n      e.preventDefault();\n      var data = validate();\n      if (!data) {\n        status.textContent = 'Please fix the highlighted fields and try again.';\n        return;\n      }\n      var url = buildUrl(data);\n      var win = null;\n      try { win = window.open(url, '_blank'); } catch (err) { win = null; }\n      status.textContent = '';\n      if (!win) {\n        window.location.href = url;\n        return;\n      }\n      status.appendChild(document.createTextNode('Opening WhatsApp with your order. If it did not open, '));\n      var a = document.createElement('a');\n      a.href = url;\n      a.target = '_blank';\n      a.rel = 'noopener';\n      a.textContent = 'tap here to send it';\n      status.appendChild(a);\n      status.appendChild(document.createTextNode('.'));\n    });\n\n    ['bouquet', 'name', 'phone', 'address'].forEach(function (key) {\n      var ev = key === 'bouquet' ? 'change' : 'input';\n      fields[key].addEventListener(ev, function () {\n        if (fields[key].getAttribute('aria-invalid') === 'true') { setError(key, ''); }\n      });\n    });\n  }\n\n  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', init); } else { init(); }\n})();\n</script>",
    "workflow": "WhatsApp order form"
  },
  "W-4": {
    "owner": "W-4",
    "head": "",
    "body": "<style>\n.ps-dl{padding:var(--j2-section,64px) 16px;background:var(--j2-background,#FFF8F5)}\n.ps-dl-inner{max-width:1100px;margin:0 auto}\n.ps-dl h2,.ps-vs h2{margin:0 0 8px;font-size:clamp(1.75rem,5vw,2.5rem);color:var(--j2-primary,#9D2B5B)}\n.ps-dl-intro{margin:0 0 32px;color:var(--j2-muted,#66555B)}\n.ps-dl-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:24px}\n.ps-dl-item{display:flex;flex-direction:column;gap:8px;min-width:0}\n.ps-dl-item h3{margin:0;font-size:1.2rem;color:var(--j2-secondary,#2F5D46)}\n.ps-dl-big{margin:0;font-size:1.35rem;font-weight:700;color:var(--j2-primary,#9D2B5B);overflow-wrap:break-word}\n.ps-dl-item p{margin:0;overflow-wrap:break-word}\n.ps-dl-cta{margin:32px 0 0}\n.ps-vs{padding:var(--j2-section,64px) 16px;background:var(--j2-surface,#fff)}\n.ps-vs-inner{max-width:1100px;margin:0 auto}\n.ps-vs-intro{margin:0 0 32px;color:var(--j2-muted,#66555B)}\n.ps-vs-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:24px}\n.ps-vs-card{min-width:0}\n.ps-vs-card h3{margin:0 0 12px;font-size:1.3rem;color:var(--j2-secondary,#2F5D46)}\n.ps-vs-hours{margin:0;padding:0}\n.ps-vs-row{display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid #F0DDE2}\n.ps-vs-row:last-child{border-bottom:0}\n.ps-vs-hours dt{font-weight:700;margin:0}\n.ps-vs-hours dd{margin:0;color:var(--j2-text,#2B2024)}\n.ps-vs-closed dd{color:var(--j2-primary,#9D2B5B);font-weight:700}\n.ps-vs-address{margin:0 0 16px;font-style:normal;overflow-wrap:break-word}\n.ps-vs-line{margin:0 0 16px;overflow-wrap:anywhere}\n.ps-vs-line a.ps-vs-tel{color:var(--j2-primary,#9D2B5B);font-weight:700}\n.ps-vs-actions{display:flex;flex-wrap:wrap;gap:12px}\n@media (max-width:480px){.ps-vs-actions .j2-btn,.ps-vs-actions .j2-btn-secondary,.ps-dl-cta .j2-btn{width:100%}}\n</style>\n\n<section class=\"ps-dl\" id=\"delivery\" aria-labelledby=\"ps-dl-title\">\n  <div class=\"ps-dl-inner\">\n    <h2 id=\"ps-dl-title\">Delivery</h2>\n    <p class=\"ps-dl-intro\">Petal &amp; Stem delivers fresh flowers inside Jaipur.</p>\n    <ul class=\"ps-dl-grid\">\n      <li class=\"j2-card ps-dl-item\">\n        <h3>Same day delivery</h3>\n        <p class=\"ps-dl-big\">Inside Jaipur</p>\n        <p>Order before 4pm and we deliver the same day.</p>\n      </li>\n      <li class=\"j2-card ps-dl-item\">\n        <h3>Delivery charge</h3>\n        <p class=\"ps-dl-big\">₹99</p>\n        <p>One flat charge for delivery.</p>\n      </li>\n      <li class=\"j2-card ps-dl-item\">\n        <h3>Payment</h3>\n        <p class=\"ps-dl-big\">Pay on delivery</p>\n        <p>No online payment. You pay when your bouquet arrives.</p>\n      </li>\n    </ul>\n    <p class=\"ps-dl-cta\"><a class=\"j2-btn\" href=\"#order\">Order a bouquet</a></p>\n  </div>\n</section>\n\n<section class=\"ps-vs\" id=\"visit\" aria-labelledby=\"ps-vs-title\">\n  <div class=\"ps-vs-inner\">\n    <h2 id=\"ps-vs-title\">Visit us</h2>\n    <p class=\"ps-vs-intro\">Come to the Petal &amp; Stem shop in Jaipur, or call us.</p>\n    <div class=\"ps-vs-grid\">\n      <div class=\"j2-card ps-vs-card\">\n        <h3>Shop timings</h3>\n        <dl class=\"ps-vs-hours\">\n          <div class=\"ps-vs-row\"><dt>Monday to Saturday</dt><dd>9am to 8pm</dd></div>\n          <div class=\"ps-vs-row ps-vs-closed\"><dt>Sunday</dt><dd>Closed</dd></div>\n        </dl>\n      </div>\n      <div class=\"j2-card ps-vs-card\">\n        <h3>Find the shop</h3>\n        <address class=\"ps-vs-address\">Petal &amp; Stem<br>12 MI Road, near Panch Batti<br>Jaipur 302001</address>\n        <p class=\"ps-vs-line\">Phone: <a class=\"ps-vs-tel\" href=\"tel:+911414005566\">+91 141 400 5566</a></p>\n        <div class=\"ps-vs-actions\">\n          <a class=\"j2-btn\" href=\"tel:+911414005566\">Call the shop</a>\n          <a class=\"j2-btn-secondary j2-btn j2-btn-secondary\" href=\"https://www.google.com/maps/search/?api=1&amp;query=12+MI+Road+near+Panch+Batti+Jaipur+302001\" target=\"_blank\" rel=\"noopener\">Open in Google Maps</a>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",
    "workflow": "Delivery, timings and location"
  }
}